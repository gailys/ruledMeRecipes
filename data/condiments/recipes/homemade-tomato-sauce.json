  "ingredients": [
    "1 large green bell pepper",
    "2 tablespoon butter",
    "salt and pepper (to taste)",
    "1 tablespoon fresh thyme",
    "1 1/2 cup low-carb tomato sauce (such as Rao's)",
    "1/4 cup dry red wine"
  ],
  "instructions": [
    {
      "text": "Chop the green pepper into relatively small pieces.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/homemade-tomato-sauce/#wprm-recipe-50693-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/01/Homemade_Tomato_Sauce-01.jpg"
    },
    {
      "text": "Add the chopped green pepper to a pan with the butter. Season to taste.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/homemade-tomato-sauce/#wprm-recipe-50693-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/01/Homemade_Tomato_Sauce-2.jpg"
    },
    {
      "text": "Sauté the green pepper for about 4–5 minutes or until slightly softened.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/homemade-tomato-sauce/#wprm-recipe-50693-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/01/Homemade_Tomato_Sauce-4.jpg"
    },
    {
      "text": "While the green pepper is cooking, finely chop the thyme. If using dried thyme, use one-third of the amount.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/homemade-tomato-sauce/#wprm-recipe-50693-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/01/Homemade_Tomato_Sauce-5.jpg"
    },
    {
      "text": "Add the tomato sauce to the green peppers and stir well. Let cook for about 4–5 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/homemade-tomato-sauce/#wprm-recipe-50693-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/01/Homemade_Tomato_Sauce-6.jpg"
    },
    {
      "text": "Add the red wine to the sauce and mix well. Finally, add the thyme to the sauce and stir everything together well. Let cook and reduce for 5–10 minutes over medium-low heat.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/homemade-tomato-sauce/#wprm-recipe-50693-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/01/Homemade_Tomato_Sauce-10.jpg"
    },
    {
      "text": "Serve and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/homemade-tomato-sauce/#wprm-recipe-50693-step-0-6",
      "imageSource": null
    }
  ],
