  "ingredients": [
    "8 ounce blackberries",
    "1 ounce chipotle peppers in adobo sauce",
    "1/4 cup erythritol",
    "8 drop liquid stevia",
    "1/4 cup mct oil",
    "1/4 teaspoon guar gum"
  ],
  "instructions": [
    {
      "text": "Add the blackberries to a pan over low heat. Cook for about 5 minutes or until soft.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-blackberry-chipotle-jam/#wprm-recipe-51653-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/04/img_9563.jpg"
    },
    {
      "text": "Add the chipotle peppers to the mixture.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-blackberry-chipotle-jam/#wprm-recipe-51653-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/04/img_9577.jpg"
    },
    {
      "text": "Stir the erythritol and stevia into the pan. Crush the blackberries using a spoon or fork and mix together again.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-blackberry-chipotle-jam/#wprm-recipe-51653-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/04/img_9569.jpg"
    },
    {
      "text": "Add MCT Oil to the pan and turn the heat up to medium. Bring the jam to a boil, then reduce the heat to low and simmer for 6–8 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-blackberry-chipotle-jam/#wprm-recipe-51653-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/04/img_9591.jpg"
    },
    {
      "text": "Add guar gum to the jam and mix thoroughly. Continue mixing for about 1–2 minutes or until thickened.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-blackberry-chipotle-jam/#wprm-recipe-51653-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/04/img_9600.jpg"
    },
    {
      "text": "Using a spoon, push the jam through a colander and into a jar to remove the seeds. Discard the seeds, once finished.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-blackberry-chipotle-jam/#wprm-recipe-51653-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/04/img_9607.jpg"
    },
    {
      "text": "Enjoy the jam! Spread it on just about anything to add a delicious new dimension of flavor.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-blackberry-chipotle-jam/#wprm-recipe-51653-step-0-6",
      "imageSource": null
    }
  ],
