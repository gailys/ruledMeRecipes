  "ingredients": [
    "12 whole fresh garlic bulbs",
    "1/2 cup olive oil"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 400F. Apply pressure to the garlic to peel off the outer skins. Cut about 1/2\" off the heads of garlic, so that the cloves are showing.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/oven-roasted-garlic/#wprm-recipe-51261-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/08/img_9549.jpg"
    },
    {
      "text": "Discard the remaining garlic skins and add the garlic heads to an ovenproof dish lined with foil.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/oven-roasted-garlic/#wprm-recipe-51261-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/08/img_9560.jpg"
    },
    {
      "text": "Drizzle olive oil evenly over the garlic heads.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/oven-roasted-garlic/#wprm-recipe-51261-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/08/img_9568.jpg"
    },
    {
      "text": "Tightly wrap the garlic in the foil.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/oven-roasted-garlic/#wprm-recipe-51261-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/08/img_9570.jpg"
    },
    {
      "text": "Place in the oven and roast for 35 minutes or until light gold, checking on them every 10 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/oven-roasted-garlic/#wprm-recipe-51261-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/08/img_9578.jpg"
    },
    {
      "text": "Remove from the oven and let cool. Once cooled enough to handle, peel or slice the excess skin to remove the whole cloves.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/oven-roasted-garlic/#wprm-recipe-51261-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/08/img_9581.jpg"
    },
    {
      "text": "Store in a mason jar and refrigerate for later use.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/oven-roasted-garlic/#wprm-recipe-51261-step-0-6",
      "imageSource": null
    }
  ],
