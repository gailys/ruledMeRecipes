  "ingredients": [
    "1 cup mayonnaise",
    "1/2 cup sour cream",
    "1/4 cup heavy whipping cream",
    "2 tablespoon dried parsley",
    "1/2 teaspoon dried dill",
    "1/2 teaspoon garlic powder",
    "1/2 teaspoon onion powder",
    "1/4 teaspoon basil",
    "1/4 teaspoon black pepper"
  ],
  "instructions": [
    {
      "text": "Put all ingredients in the emulsion blender container.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-approved-ranch-dressing/#wprm-recipe-50505-step-0-0",
