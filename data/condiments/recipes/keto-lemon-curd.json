    },
    {
      "text": "Whisk together so the xylitol dissolves",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-lemon-curd/#wprm-recipe-54599-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/03/Keto-Lemon-Curd-4.jpg"
    },
    {
      "text": "Add in the egg yolks.",
