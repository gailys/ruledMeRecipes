  "ingredients": [
    "28 ounce canned whole tomatoes (San Marzano)",
    "1 cup vegetable stock",
    "1/4 cup olive oil",
    "8 teaspoon fresh garlic (slivered crosswise)",
    "1 teaspoon kosher salt (to taste)",
    "crushed red pepper flakes (to taste)",
    "1/2 teaspoon dried oregano",
    "2 tablespoon fresh basil (chopped)"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all of the ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pizza-sauce/#wprm-recipe-54503-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/12/Marinara-Sauce-1.jpg"
    },
    {
      "text": "Slice the fresh garlic cloves crosswise in slivers.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pizza-sauce/#wprm-recipe-54503-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/12/Marinara-Sauce-2.jpg"
    },
    {
      "text": "Pour the canned whole tomatoes into a bowl. Smash the tomatoes with your hands to create bits.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pizza-sauce/#wprm-recipe-54503-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/12/Marinara-Sauce-3.jpg"
    },
    {
      "text": "Add olive oil to a frying pan over medium heat. Then add in the silvered garlic. Stir this around for a minute or so.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pizza-sauce/#wprm-recipe-54503-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/12/Marinara-Sauce-4.jpg"
    },
    {
      "text": "Add in the crushed tomatoes to the pan along with kosher salt, crushed red pepper flakes, dried oregano, and basil. Turn the temperature down to low and let simmer for 15 minutes, stirring occasionally. Once you see a yellow oil on the surface, the marinara sauce is done.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pizza-sauce/#wprm-recipe-54503-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/12/Marinara-Sauce-5.jpg"
    },
    {
      "text": "Serve and enjoy.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pizza-sauce/#wprm-recipe-54503-step-0-5",
      "imageSource": null
    }
