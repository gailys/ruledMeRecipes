  "ingredients": [
    "2 large egg yolk (room temperature)",
    "1 tablespoon ruled.me roasted garlic",
    "2 teaspoon lemon juice",
    "1 teaspoon dijon mustard",
    "salt and pepper (to taste)",
    "1/2 cup olive oil",
    "1/4 cup sour cream",
    "1/4 teaspoon chipotle seasoning"
  ],
  "instructions": [
    {
      "text": "Allow the eggs to come to room temperature on the counter, or place them in warm water for about 1–2 minutes. Once done, remove and dry them off.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/roasted-garlic-chipotle-aioli/#wprm-recipe-51269-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/08/img_0569.jpg"
    },
    {
      "text": "In a food processor, add the egg yolks, roasted garlic, lemon juice, Dijon mustard, and salt and pepper.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/roasted-garlic-chipotle-aioli/#wprm-recipe-51269-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/08/img_0579.jpg"
    },
    {
      "text": "Process until smooth and creamy.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/roasted-garlic-chipotle-aioli/#wprm-recipe-51269-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/08/img_0583.jpg"
    },
    {
      "text": "Turn the food processor back on and slowly drizzle in the oil, allowing the mixture to emulsify.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/roasted-garlic-chipotle-aioli/#wprm-recipe-51269-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/08/img_0588.jpg"
    },
    {
      "text": "Once thoroughly combined, add the sour cream and chipotle seasoning. Process until smooth and well combined.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/roasted-garlic-chipotle-aioli/#wprm-recipe-51269-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/08/img_0599.jpg"
    },
    {
      "text": "Serve with crackers or dolloped on top of food!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/roasted-garlic-chipotle-aioli/#wprm-recipe-51269-step-0-5",
      "imageSource": null
    }
