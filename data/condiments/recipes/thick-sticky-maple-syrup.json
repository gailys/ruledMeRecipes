  "ingredients": [
    "2 1/4 teaspoon coconut oil",
    "1 tablespoon butter",
    "1/4 teaspoon xanthan gum",
    "1/4 cup erythritol",
    "1/4 teaspoon ground cinnamon (optional)",
    "3/4 cup water (filtered)",
    "1/2 teaspoon vanilla extract",
    "2 teaspoon maple extract"
  ],
  "instructions": [
    {
      "text": "In a microwave-safe container, mix together the coconut oil, butter, and xanthan gum.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/thick-sticky-maple-syrup/#wprm-recipe-50869-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/02/IMG_23801.jpg"
    },
    {
      "text": "Microwave the oil and butter together for 40–50 seconds, until melted and hot.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/thick-sticky-maple-syrup/#wprm-recipe-50869-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/02/IMG_23811.jpg"
    },
    {
      "text": "Use a spice grinder to powder the erythritol. Let powder settle a little before removing lid. If using cinnamon, add it in now.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/thick-sticky-maple-syrup/#wprm-recipe-50869-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/02/P21354401.jpg"
    },
    {
      "text": "Add the water and powdered erythritol to the butter and oil mixture.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/thick-sticky-maple-syrup/#wprm-recipe-50869-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/02/IMG_23861.jpg"
    },
    {
      "text": "Add in the vanilla and maple extracts. The strength of maple extracts may vary, so adjust the amount to taste.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/thick-sticky-maple-syrup/#wprm-recipe-50869-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/02/IMG_23881.jpg"
    },
    {
      "text": "Mix everything together until well combined.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/thick-sticky-maple-syrup/#wprm-recipe-50869-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/02/IMG_23901.jpg"
    },
    {
      "text": "Microwave the mixture for 40–60 seconds and stir. Let cool before using.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/thick-sticky-maple-syrup/#wprm-recipe-50869-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/02/IMG_23961.jpg"
    }
  ],
