  "ingredients": [
    "6 slice deli-sliced black forest ham",
    "6 slice cheddar cheese",
    "4 medium egg",
    "1 tablespoon fresh chives",
    "1 tablespoon butter",
    "salt and pepper (to taste)"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all of the ingredients. Preheat oven to 400F.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-baked-ham-and-cheese-rollups/#wprm-recipe-54315-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/05/Keto-Baked-Ham-and-Cheese-Rollups-1.jpg"
    },
    {
      "text": "In a bowl, whisk the eggs and fresh chives.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-baked-ham-and-cheese-rollups/#wprm-recipe-54315-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/05/Keto-Baked-Ham-and-Cheese-Rollups-2.jpg"
    },
    {
      "text": "In a frying pan over medium heat, add the butter and the whisked eggs. Scramble the eggs for about 3 - 6 minutes or until cooked to your liking.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-baked-ham-and-cheese-rollups/#wprm-recipe-54315-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/05/Keto-Baked-Ham-and-Cheese-Rollups-3.jpg"
    },
    {
      "text": "On a cutting board, lay out the ham slices. Top with sliced cheddar cheese.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-baked-ham-and-cheese-rollups/#wprm-recipe-54315-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/05/Keto-Baked-Ham-and-Cheese-Rollups-4.jpg"
    },
    {
      "text": "Then top with the scrambled eggs. Carefully roll the ham slices with the cheese and eggs in the middle.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-baked-ham-and-cheese-rollups/#wprm-recipe-54315-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/05/Keto-Baked-Ham-and-Cheese-Rollups-5.jpg"
    },
    {
      "text": "Lay the rollups with the flaps on the bottom into a baking sheet.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-baked-ham-and-cheese-rollups/#wprm-recipe-54315-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/05/Keto-Baked-Ham-and-Cheese-Rollups-6.jpg"
    },
    {
      "text": "Bake in the oven for 10 minutes or until the cheese starts to melt.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-baked-ham-and-cheese-rollups/#wprm-recipe-54315-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/05/Keto-Baked-Ham-and-Cheese-Rollups-7.jpg"
    },
    {
      "text": "Garnish with extra chives. Serve and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-baked-ham-and-cheese-rollups/#wprm-recipe-54315-step-0-7",
