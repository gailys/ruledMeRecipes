  "ingredients": [
    "4 large egg",
    "1/4 cup erythritol",
    "1/2 teaspoon vanilla extract",
    "1/2 cup coconut flour",
    "1/4 cup butter (melted)",
    "1 teaspoon baking powder",
    "1/2 teaspoon salt",
    "1/4 teaspoon ground cinnamon",
    "1/3 cup water",
    "1/2 cup frozen blueberries"
  ],
  "instructions": [
    {
      "text": "Preheat your oven to 325F. Grease a mini muffin tin well, as the batter is very sticky.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-blueberry-pancake-bites/#wprm-recipe-53020-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/05/blueberry-pancake-bites-01.jpg"
    },
    {
      "text": "Use a blender to puree the eggs, sweetener, and vanilla extract.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-blueberry-pancake-bites/#wprm-recipe-53020-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/05/blueberry-pancake-bites-03.jpg"
    },
    {
      "text": "Add the coconut flour, butter, baking powder, salt, and cinnamon. Blend until smooth, then let the batter sit for a few minutes to thicken. Blend in the additional portion of water, about 1/3 at a time until the batter is thin enough to scoop easily but not thin enough to pour.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-blueberry-pancake-bites/#wprm-recipe-53020-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/05/blueberry-pancake-bites-05.jpg"
    },
    {
      "text": "Put the batter into the muffin tin. Top with a few blueberries per bite and press the berries down into the batter.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-blueberry-pancake-bites/#wprm-recipe-53020-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/05/blueberry-pancake-bites-07.jpg"
    },
    {
      "text": "Bake for 25 minutes or until the batter fully cooks. Serve with sugar-free pancake syrup.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-blueberry-pancake-bites/#wprm-recipe-53020-step-0-4",
      "imageSource": null
    }
  ],
