  "ingredients": [
    "1 1/2 cup unsweetened almond milk",
    "2 tablespoon mct oil",
    "3/4 teaspoon turmeric powder",
    "2 teaspoon fresh ginger (peeled)",
    "1/4 teaspoon ground cinnamon (plus more for topping)",
    "1/4 teaspoon vanilla extract",
    "2 teaspoon erythritol",
    "sea salt (pinch, to taste)",
    "2 whole ice cubes"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all the ingredients.",
