  "ingredients": [
    "4 ounce bacon",
    "1 tablespoon butter (melted)",
    "1 tablespoon powdered peanut butter (such as PBfit)",
    "4 ounce breakfast sausage",
    "2 ounce pepper jack cheese",
    "2 large egg",
    "salt and pepper (to taste)"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 400F. Place the bacon on a cookie sheet with a wire rack and bake for 20–25 minutes or until crisp.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-breakfast-burger/#wprm-recipe-51785-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/07/img_6499.jpg"
    },
    {
      "text": "Mix the butter and PBfit in a small container to rehydrate the powdered peanut butter into a paste. Set aside.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-breakfast-burger/#wprm-recipe-51785-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/07/img_6510.jpg"
    },
    {
      "text": "Form the sausage patties and cook them in a pan over medium-high heat. Flip once the bottom sides are browned.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-breakfast-burger/#wprm-recipe-51785-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/07/img_6512.jpg"
    },
    {
      "text": "Grate the cheese and have it ready.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-breakfast-burger/#wprm-recipe-51785-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/07/img_6515.jpg"
    },
    {
      "text": "Once the other side of the sausage patty is browned, add the cheese and cover the pan until melted.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-breakfast-burger/#wprm-recipe-51785-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/07/img_6522.jpg"
    },
    {
      "text": "Remove the sausage patties and set aside. Fry an egg over easy in the same pan. Season to taste.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-breakfast-burger/#wprm-recipe-51785-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/07/img_6530.jpg"
    },
    {
      "text": "Assemble the sausage patties with egg, bacon, and peanut butter on top. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-breakfast-burger/#wprm-recipe-51785-step-0-6",
      "imageSource": null
    }
  ],
