  "ingredients": [
    "1/4 cup roasted almonds",
    "2/3 cup almond flour",
    "2 tablespoon erythritol",
    "1 teaspoon ground cinnamon",
    "1/2 teaspoon salt",
    "1/4 teaspoon ground nutmeg",
    "1/4 cup peanut butter",
    "2 tablespoon coconut oil",
    "1 tablespoon butter",
    "6 large egg",
    "1 teaspoon vanilla extract",
    "10 drop liquid stevia",
    "1/4 cup heavy whipping cream"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 350F. Add the almonds to a food processor.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-french-toast-muffins/#wprm-recipe-50841-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/02/P2115280.jpg"
    },
    {
      "text": "Process the nuts into small pieces, leaving a few large chunks for texture.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-french-toast-muffins/#wprm-recipe-50841-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/02/P2115281.jpg"
    },
    {
      "text": "Place the crushed almonds in a pan over medium-high heat and allow them to toast. Make sure to keep an eye on them and stir as needed.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-french-toast-muffins/#wprm-recipe-50841-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/02/P2115283.jpg"
    },
    {
      "text": "While the nuts are toasting, combine the almond flour, erythritol, cinnamon, salt, and nutmeg in a large mixing bowl.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-french-toast-muffins/#wprm-recipe-50841-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/02/P2115273.jpg"
    },
    {
      "text": "In a ramekin or microwave-safe container, add the peanut butter, coconut oil, and butter. Microwave for 30–40 seconds or until completely melted.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-french-toast-muffins/#wprm-recipe-50841-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/02/P2115275.jpg"
    },
    {
      "text": "Add the eggs, vanilla, liquid stevia, and peanut butter mixture to the dry ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-french-toast-muffins/#wprm-recipe-50841-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/02/P2115278.jpg"
    },
    {
      "text": "Mix the batter well before adding the heavy cream. Mix well again — the batter should have a liquid consistency.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-french-toast-muffins/#wprm-recipe-50841-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/02/P2115279.jpg"
    },
    {
      "text": "Evenly pour the batter into a non-stick or greased muffin pan. Spread the toasted almonds out evenly on top.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-french-toast-muffins/#wprm-recipe-50841-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/02/P2115289.jpg"
    },
    {
      "text": "Bake for 20–25 minutes. Remove from the oven and let cool for 5 minutes. Remove the muffins from the cupcake tray and cool for an additional 10–15 minutes on a wire rack.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-french-toast-muffins/#wprm-recipe-50841-step-0-8",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/02/P2115291.jpg"
    },
    {
      "text": "Top with whipped cream.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-french-toast-muffins/#wprm-recipe-50841-step-0-9",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/02/P2115309.jpg"
    }
  ],
