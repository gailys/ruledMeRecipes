  "ingredients": [
    "3 large egg",
    "2 tablespoon butter",
    "1 ounce cheddar cheese (shredded)",
    "1/4 medium red onion (diced)",
    "80 gram cremini mushrooms (sliced)",
    "salt and pepper (to taste)"
  ],
  "instructions": [
    {
      "text": "Prep ingredients: shred the cheese, slice the mushrooms and chop the onion.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-mushroom-omelet/#wprm-recipe-53517-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/09/Keto-Mushroom-Omelette-1.jpg"
    },
    {
      "text": "In a bowl, crack the eggs and add a little salt and pepper to taste. Whisk with a fork until it is all mixed together and slightly frothy.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-mushroom-omelet/#wprm-recipe-53517-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/09/Keto-Mushroom-Omelette-2.jpg"
    },
    {
      "text": "Melt the butter in a frying pan. Add the chopped red onion and sliced mushrooms to the pan. Season to taste, then cook until the mushrooms are tender, stirring occasionally. Pour in the egg mixture on top, making sure it gets between the onions and mushrooms.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-mushroom-omelet/#wprm-recipe-53517-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/09/Keto-Mushroom-Omelette-3.jpg"
    },
    {
      "text": "When the omelet is starting to get done around the sides and on the bottom but still raw on top, sprinkle the cheddar cheese over the top.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-mushroom-omelet/#wprm-recipe-53517-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/09/Keto-Mushroom-Omelette-4.jpg"
    },
    {
      "text": "With a spatula, get under the omelette carefully and fold it in half.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-mushroom-omelet/#wprm-recipe-53517-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/09/Keto-Mushroom-Omelette-5.jpg"
    },
    {
      "text": "When the omelet is golden brown on the bottom, remove from the pan and serve hot.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-mushroom-omelet/#wprm-recipe-53517-step-0-5",
      "imageSource": null
    }
  ],
