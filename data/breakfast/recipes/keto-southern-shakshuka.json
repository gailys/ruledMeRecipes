  "ingredients": [
    "1/4 cup olive oil",
    "3 cup collard greens (chopped)",
    "1 medium yellow onion (diced)",
    "1 medium jalapeno pepper (minced)",
    "1/2 medium green bell pepper (diced)",
    "4 teaspoon fresh garlic (minced)",
    "1 tablespoon paprika",
    "1/2 teaspoon crushed red pepper flakes",
    "salt and pepper (to taste)",
    "28 ounce crushed tomatoes",
    "6 large egg",
    "4 ounce goat cheese"
  ],
  "instructions": [
    {
      "text": "Preheat your oven to 425F, and preheat an oven-safe skillet over medium-high heat.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-southern-shakshuka/#wprm-recipe-53195-step-0-0",
