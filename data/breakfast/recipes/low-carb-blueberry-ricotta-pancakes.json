  "ingredients": [
    "3 large egg",
    "3/4 cup ricotta cheese",
    "1 teaspoon vanilla extract",
    "1/4 cup unsweetened almond milk",
    "1 cup almond flour",
    "1/2 cup flaxseed meal",
    "1/4 teaspoon salt",
    "1 teaspoon baking powder",
    "7 drop liquid stevia",
    "1/4 cup blueberries"
  ],
  "instructions": [
    {
      "text": "Preheat a skillet over medium heat. Blend together the eggs, ricotta, vanilla extract, and unsweetened almond milk.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-blueberry-ricotta-pancakes/#wprm-recipe-52043-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/01/Blueberry-Ricotta-Pancakes-Step-2.jpg"
    },
    {
      "text": "In a separate bowl, mix together the almond flour, golden flaxseed meal, salt, baking powder, and stevia.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-blueberry-ricotta-pancakes/#wprm-recipe-52043-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/01/Blueberry-Ricotta-Pancakes-Step-3.jpg"
    },
    {
      "text": "Slowly incorporate the dry ingredients into the wet mixture, blending until smooth batter forms.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-blueberry-ricotta-pancakes/#wprm-recipe-52043-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/01/Blueberry-Ricotta-Pancakes-Step-4.jpg"
    },
    {
      "text": "You'll want to add about 2–3 blueberries per pancake, but this depends on their size; feel free to halve them if needed.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-blueberry-ricotta-pancakes/#wprm-recipe-52043-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/01/Blueberry-Ricotta-Pancakes-Step-5.jpg"
    },
    {
      "text": "Add butter to the preheated skillet and wait for it to melt.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-blueberry-ricotta-pancakes/#wprm-recipe-52043-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/01/Blueberry-Ricotta-Pancakes-Step-6.jpg"
    },
    {
      "text": "Pour the pancake batter into the skillet, add the blueberries, and flip once lightly browned on the outside. Once finished on the other side, repeat with the remaining batter.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-blueberry-ricotta-pancakes/#wprm-recipe-52043-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/01/Blueberry-Ricotta-Pancakes-Step-7.jpg"
    },
    {
      "text": "Serve with sugar-free syrup or additional berries.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-blueberry-ricotta-pancakes/#wprm-recipe-52043-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/01/Blueberry-Ricotta-Pancakes-620x900.jpg"
    }
