  "ingredients": [
    "1/2 cup cream cheese",
    "1/2 cup butter",
    "1/2 cup allulose",
    "4 large egg",
    "1 1/2 cup almond flour",
    "1/2 cup coconut flour",
    "2 teaspoon baking powder",
    "1/4 cup unsweetened almond milk",
    "1 tablespoon banana extract",
    "1 teaspoon ground cinnamon",
    "1 cup pecans"
  ],
  "instructions": [
    {
      "text": "Gather and prep all of your ingredients. Pre-heat oven to 350F.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-banana-bread/#wprm-recipe-57964-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2025/06/Keto-Banana-Bread-1.jpg"
    },
    {
      "text": "Using a mixer, combine the cream cheese, butter, and allulose then mix until smooth and glossy.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-banana-bread/#wprm-recipe-57964-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2025/06/Keto-Banana-Bread-2.jpg"
    },
    {
      "text": "Add in the eggs, almond flour, coconut flour, baking powder, almond milk, cinnamon, and banana extract. Mix again until well combined and no lumps are formed.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-banana-bread/#wprm-recipe-57964-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2025/06/Keto-Banana-Bread-3.jpg"
    },
    {
      "text": "Fold in the pecans gently until well distributed in the batter.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-banana-bread/#wprm-recipe-57964-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2025/06/Keto-Banana-Bread-4.jpg"
    },
    {
      "text": "Pour the batter into a lined or greased pan or muffin tins, then bake until the center is just firm and edges are a deep golden brown. If you are using a larger container like a loaf pan, bake for 55-65 minutes. If using muffin tins, bake for 25-28 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-banana-bread/#wprm-recipe-57964-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2025/06/Keto-Banana-Bread-5.jpg"
    },
    {
      "text": "Allow to cool for 15 minutes, then remove from the pan and cool completely on a wire rack.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-banana-bread/#wprm-recipe-57964-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2025/06/Keto-Banana-Bread-6.jpg"
    },
    {
      "text": "Slice and serve as desired. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-banana-bread/#wprm-recipe-57964-step-0-6",
      "imageSource": null
    }
  ],
