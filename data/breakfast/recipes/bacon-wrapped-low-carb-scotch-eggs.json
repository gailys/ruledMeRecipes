  "description": "This makes a total of 2 servings of Low-Carb Bacon-Wrapped Scotch Eggs. Each serving comes out to be 491 calories, 43.5g fats, 2.7g net carbs, and 20.3g protein.",
  "servings": 2,
  "yield": [
    "2",
    "2 servings"
  ],
  "prepTime": "PT10M",
  "cookTime": "PT15M",
  "totalTime": "PT25M",
  "totalMinutes": 25,
