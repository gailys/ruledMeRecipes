  "description": "This makes a total of 6 servings of Bacon, Red Pepper, and Mozzarella Frittata. Each serving comes out to be 420 calories, 34.3g fats, 3.2g net carbs, and 23.1g protein.",
  "servings": 6,
  "yield": [
    "6",
    "6 servings"
  ],
  "prepTime": "PT10M",
  "cookTime": "PT20M",
  "totalTime": "PT30M",
