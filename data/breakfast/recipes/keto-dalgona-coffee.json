  "ingredients": [
    "1 tablespoon instant coffee",
    "1 tablespoon allulose",
    "1 tablespoon water (hot)",
    "1/4 cup ice cubes",
    "1/2 cup unsweetened almond milk",
    "2 tablespoon heavy cream"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all of the ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-dalgona-coffee/#wprm-recipe-54661-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/05/Keto-Dalgona-Coffee-1.jpg"
    },
    {
      "text": "In a bowl, combine the allulose and instant coffee. Then, pour in the hot water.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-dalgona-coffee/#wprm-recipe-54661-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/05/Keto-Dalgona-Coffee-2-1.jpg"
    },
    {
      "text": "Mix for a minute on low to combine. Up the speed to high and mix for an additional five minutes. The mixture will become light brown in color.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-dalgona-coffee/#wprm-recipe-54661-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/05/Keto-Dalgona-Coffee-3.jpg"
    },
    {
      "text": "In a glass, add the ice cubes then pour the almond milk and heavy cream in, leaving room for the coffee mixture.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-dalgona-coffee/#wprm-recipe-54661-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/05/Keto-Dalgona-Coffee-4.jpg"
    },
    {
      "text": "Using a spoon, place the mixture on top of the almond milk in the glass.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-dalgona-coffee/#wprm-recipe-54661-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/05/Keto-Dalgona-Coffee-5.jpg"
    },
    {
      "text": "Stir the coffee so it's all combined well. Serve immediately and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-dalgona-coffee/#wprm-recipe-54661-step-0-5",
