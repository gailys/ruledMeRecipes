  "ingredients": [
    "2 cup almond flour",
    "1 1/2 cup cheddar cheese",
    "2 large egg",
    "1/2 cup heavy whipping cream",
    "3 tablespoon butter (diced)",
    "1/2 teaspoon garlic powder",
    "1/2 teaspoon onion powder",
    "salt and pepper (to taste)",
    "3 ounce mixed greens",
    "4 large egg",
    "4 slice cooked bacon"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all of the ingredients. Preheat oven to 375F.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-biscuit-breakfast-sandwiches/#wprm-recipe-60280-step-0-0",
      "imageSource": null
    },
    {
      "text": "Combine all of the ingredients together for the biscuits. Stir to combine well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-biscuit-breakfast-sandwiches/#wprm-recipe-60280-step-0-1",
      "imageSource": null
    },
    {
      "text": "Form the biscuit dough into small balls with your fingers. Place on a baking sheet evenly spaced apart. Let bake in the oven for about 20 minutes or until they are golden brown in color.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-biscuit-breakfast-sandwiches/#wprm-recipe-60280-step-0-2",
      "imageSource": null
    },
    {
      "text": "Once the biscuits are cooked and cooled, slice them in half.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-biscuit-breakfast-sandwiches/#wprm-recipe-60280-step-0-3",
      "imageSource": null
    },
    {
      "text": "Make the sandwiches by adding the mixed greens, egg, and cooked bacon. Top with the other half of the biscuit.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-biscuit-breakfast-sandwiches/#wprm-recipe-60280-step-0-4",
      "imageSource": null
    },
    {
      "text": "Serve and enjoy!",
