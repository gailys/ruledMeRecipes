  "ingredients": [
    "1 cup almonds",
    "1/2 cup unsweetened shredded coconut",
    "1 cup pecans",
    "1/3 cup pumpkin seeds",
    "1/3 cup sunflower seeds",
    "6 tablespoon erythritol",
    "1/2 cup golden flaxseed meal",
    "1/2 teaspoon ground cinnamon",
    "1/2 teaspoon salt",
    "1 large egg white",
    "1/4 cup butter (melted)",
    "1 teaspoon vanilla extract"
  ],
  "instructions": [
    {
      "text": "Pre-heat oven to 325F. Prepare ingredients by measuring them out.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-granola-cereal/#wprm-recipe-53405-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/06/keto-granola-cereal-step-1.jpg"
    },
    {
      "text": "Line a baking sheet with parchment paper and set aside.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-granola-cereal/#wprm-recipe-53405-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/06/keto-granola-cereal-step-2.jpg"
    },
    {
      "text": "Add the almonds and shredded coconut to a food processor and pulse until the almonds are broken up into smaller pieces.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-granola-cereal/#wprm-recipe-53405-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/06/keto-granola-cereal-step-3.jpg"
    },
    {
      "text": "Add the pecans and pulse again until the pecans are broken up.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-granola-cereal/#wprm-recipe-53405-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/06/keto-granola-cereal-step-4.jpg"
    },
    {
      "text": "Add the pumpkin seeds, sunflower seeds, erythritol, golden flaxseed meal, cinnamon, and salt and pulse again until mixed together. Try not to overprocess here as you still want to have small pieces of nuts and seeds throughout.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-granola-cereal/#wprm-recipe-53405-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/06/keto-granola-cereal-step-5.jpg"
    },
    {
      "text": "Lastly, add the egg white, melted butter, and vanilla extract.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-granola-cereal/#wprm-recipe-53405-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/06/keto-granola-cereal-step-6.jpg"
    },
    {
      "text": "Pulse a few more times, and if needed use a spoon to scoop the bottom of the mixture to the top so that everything is incorporated well. Repeat pulsing and scraping the mixture to the top until everything is mixed and coated evenly.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-granola-cereal/#wprm-recipe-53405-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/06/keto-granola-cereal-step-7.jpg"
    },
    {
      "text": "Transfer the granola cereal mixture to a baking sheet and spread it into an even layer.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-granola-cereal/#wprm-recipe-53405-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/06/keto-granola-cereal-step-8.jpg"
    },
    {
      "text": "Bake for 15-18 minutes or until lightly browned.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-granola-cereal/#wprm-recipe-53405-step-0-8",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/06/keto-granola-cereal-step-9.jpg"
    },
    {
      "text": "Let cool and break apart into pieces. The granola will be soft when it comes out of the oven but will get crispier as it cools.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-granola-cereal/#wprm-recipe-53405-step-0-9",
      "imageSource": null
    }
  ],
