  "ingredients": [
    "2 large egg",
    "1 tablespoon heavy whipping cream",
    "salt and pepper",
    "1 ounce cheddar cheese (shredded)",
    "1 tablespoon butter",
    "1/4 medium yellow onion (finely chopped)",
    "1/4 medium green bell pepper (finely chopped)",
    "2 ounce deli-sliced black forest ham (diced)"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all the ingredients. In a bowl, whisk together the eggs and heavy whipping cream until fluffy.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-denver-omelet/#wprm-recipe-54479-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/10/Keto-Denver-Omelet-1.jpg"
    },
    {
      "text": "Season with salt and pepper and add in half of the shredded cheddar cheese.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-denver-omelet/#wprm-recipe-54479-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/10/Keto-Denver-Omelet-2.jpg"
    },
    {
      "text": "In a frying pan over medium heat, melt the butter. Add the diced ham, onion, and pepper. Let cook for 1 - 2 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-denver-omelet/#wprm-recipe-54479-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/10/Keto-Denver-Omelet-3.jpg"
    },
    {
      "text": "Add the cheesy egg mixture into the frying pan. Let cook until it is almost firm.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-denver-omelet/#wprm-recipe-54479-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/10/Keto-Denver-Omelet-4.jpg"
    },
    {
      "text": "Lower the heat to low and add the rest of the cheese in.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-denver-omelet/#wprm-recipe-54479-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/10/Keto-Denver-Omelet-5.jpg"
    },
    {
      "text": "Fold the omelet in half.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-denver-omelet/#wprm-recipe-54479-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/10/Keto-Denver-Omelet-6.jpg"
    },
    {
      "text": "Serve and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-denver-omelet/#wprm-recipe-54479-step-0-6",
      "imageSource": null
