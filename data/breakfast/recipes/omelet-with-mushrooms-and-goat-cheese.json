  "ingredients": [
    "3 large egg",
    "2 teaspoon heavy whipping cream",
    "3 ounce cremini mushrooms (sliced)",
    "1 teaspoon olive oil",
    "2 ounce goat cheese",
    "all-purpose seasoning (to taste)",
    "2 tablespoon green onion (chopped)"
  ],
  "instructions": [
    {
      "text": "Heat up the olive oil in a frying pan over medium heat. Cook the mushrooms until they become soft.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/omelet-with-mushrooms-and-goat-cheese/#wprm-recipe-52810-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/12/omelet-w-mushrooms-n-goat-cheese-02.jpg"
    },
    {
      "text": "Whisk the eggs, heavy whipping cream, and seasoning together in a separate bowl. Crumble in the 1/2 of the goat cheese.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/omelet-with-mushrooms-and-goat-cheese/#wprm-recipe-52810-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/12/omelet-w-mushrooms-n-goat-cheese-03.jpg"
    },
    {
      "text": "Pour the egg mixture into the frying pan with the mushrooms. Crumble the remaining goat cheese over the top.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/omelet-with-mushrooms-and-goat-cheese/#wprm-recipe-52810-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/12/omelet-w-mushrooms-n-goat-cheese-04.jpg"
    },
    {
      "text": "Cook for a few minutes until the egg starts to set, and the cheese begins to melt. Fold over then serve on a plate, garnish with green onions if you'd like.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/omelet-with-mushrooms-and-goat-cheese/#wprm-recipe-52810-step-0-3",
