  },
  "ingredients": [
    "6 ounce cooked bacon (chopped)",
    "8 large egg",
    "1/2 cup half-and-half",
    "1/2 cup cheddar cheese (grated)",
    "2 teaspoon dried parsley",
    "1/2 teaspoon black pepper",
    "1/4 teaspoon salt",
    "1 tablespoon butter"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 375F. Gather ingredients. (The bacon should already be cooked and chopped!)",
      "group": "",
      "sourceUrl": "https://www.ruled.me/hunger-buster-low-carb-bacon-frittata/#wprm-recipe-50381-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/11/hunger-buster-low-carb-bacon-frittata-step-01.jpg"
    },
    {
      "text": "In a large bowl, mix the eggs and half n’ half. Mix well until eggs are almost scrambled. You still want to have streaks of egg whites.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/hunger-buster-low-carb-bacon-frittata/#wprm-recipe-50381-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/11/hunger-buster-low-carb-bacon-frittata-step-02.jpg"
    },
    {
      "text": "Fold in the bacon, cheese, dried parsley, pepper, and salt.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/hunger-buster-low-carb-bacon-frittata/#wprm-recipe-50381-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/11/hunger-buster-low-carb-bacon-frittata-step-03.jpg"
    },
    {
      "text": "Grease the muffin tin with the butter. Alternatively, you can use paper liners. Pour in the mixture, filling each “cup” about 3/4 of the way.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/hunger-buster-low-carb-bacon-frittata/#wprm-recipe-50381-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/11/hunger-buster-low-carb-bacon-frittata-step-04.jpg"
    },
    {
      "text": "Stick them in the oven for about 15-18 minutes, or until they are puffy and turning a little bit golden on the edges.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/hunger-buster-low-carb-bacon-frittata/#wprm-recipe-50381-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/11/hunger-buster-low-carb-bacon-frittata-step-05.jpg"
    },
    {
      "text": "Remove from the oven and let cool for 1 minute. Remove frittatas from the muffin tray and eat up!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/hunger-buster-low-carb-bacon-frittata/#wprm-recipe-50381-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/11/hunger-buster-low-carb-bacon-frittata-step-06.jpg"
    }
  ],
