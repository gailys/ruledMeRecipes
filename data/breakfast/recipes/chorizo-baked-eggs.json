  "ingredients": [
    "2 ounce chorizo sausage",
    "2 tablespoon butter",
    "5 large egg",
    "salt and pepper (to taste)",
    "2/3 cup pepper jack cheese (shredded)",
    "1 medium avocado (small dice)",
    "2 tablespoon sour cream",
    "2 tablespoon fresh cilantro (chopped)"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 400F. Place a pan over medium heat, then remove the casing from the chorizo. Add the chorizo to the skillet and fry, stirring to break it up, and cook for 7-10 minutes or until thoroughly cooked. Drain well and set aside.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chorizo-baked-eggs/#wprm-recipe-52762-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/10/baked-chorizo-eggs-01.jpg"
    },
    {
      "text": "Place a cast iron skillet over medium heat and add the butter. Let it melt, then remove the pan from the heat and place on top of a towel or oven mitt. Alternatively, melt butter in a microwave and pour into the skillet. Make sure the inside of the pan is evenly coated with butter.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chorizo-baked-eggs/#wprm-recipe-52762-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/10/baked-chorizo-eggs-02.jpg"
    },
    {
      "text": "Crack eggs open directly into the pan. Sprinkle with salt and pepper.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chorizo-baked-eggs/#wprm-recipe-52762-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/10/baked-chorizo-eggs-03.jpg"
    },
    {
      "text": "Sprinkle the chorizo evenly over the eggs.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chorizo-baked-eggs/#wprm-recipe-52762-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/10/baked-chorizo-eggs-04.jpg"
    },
    {
      "text": "Spread the cheese out over the top.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chorizo-baked-eggs/#wprm-recipe-52762-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/10/baked-chorizo-eggs-05.jpg"
    },
    {
      "text": "Bake for 15-20 minutes, or until cheese is bubbling. If you like runnier yolks in your eggs, bake them for less time.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chorizo-baked-eggs/#wprm-recipe-52762-step-0-5",
      "imageSource": null
    },
    {
      "text": "Serve warm with the avocado, sour cream, and garnished with cilantro, if desired.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chorizo-baked-eggs/#wprm-recipe-52762-step-0-6",
      "imageSource": null
    }
  ],
