  "ingredients": [
    "3 cup water",
    "3/4 cup hemp seeds",
    "1/4 cup lemon juice",
    "drop liquid stevia (to Taste)",
    "2 teaspoon glucomannan powder"
  ],
  "instructions": [
    {
      "text": "Boil the water, then set aside. Combine 1/3 of the boiled water with the hemp seeds in a blender. Puree until the seeds are smooth and completely free of lumps.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/vegan-keto-hemp-seed-yogurt/#wprm-recipe-60028-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/03/vegan-keto-hemp-seed-yogurt-step-01.jpg"
    },
    {
      "text": "With the blender still running, add in the glucomannan powder and the remaining hot water. Process for another 15-30 seconds. The mixture will have begun to thicken.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/vegan-keto-hemp-seed-yogurt/#wprm-recipe-60028-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/03/vegan-keto-hemp-seed-yogurt-step-02.jpg"
    },
    {
      "text": "Add in the lemon juice and stevia and blend for a few seconds to mix together.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/vegan-keto-hemp-seed-yogurt/#wprm-recipe-60028-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/03/vegan-keto-hemp-seed-yogurt-step-03.jpg"
    },
    {
      "text": "Pour into a clean container, seal and refrigerate for at least 2-3 hours, allowing the yogurt to set. Top with a little shredded coconut or your favorite fruit and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/vegan-keto-hemp-seed-yogurt/#wprm-recipe-60028-step-0-3",
