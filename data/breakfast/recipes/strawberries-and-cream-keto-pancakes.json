  "ingredients": [
    "2 large egg",
    "4 tablespoon almond flour",
    "1 tablespoon stevia/erythritol blend",
    "1 teaspoon vanilla extract",
    "1/2 teaspoon baking powder",
    "1/4 teaspoon ground cinnamon",
    "4 tablespoon heavy whipping cream",
    "2 medium strawberries"
  ],
  "instructions": [
    {
      "text": "Whisk all of the pancake batter ingredients together in a mixing bowl. Let the mixture rest for 5 minutes to thicken.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/strawberries-and-cream-keto-pancakes/#wprm-recipe-58488-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/09/strawberries-and-cream-keto-pancakes-step-01.jpg"
    },
    {
      "text": "Lightly spray a frying pan with oil. Heat until it's almost smoking, as this will help seal the pan and prevent sticking. Once hot, lower the heat, then wait about 30 seconds. Spoon the batter making pancakes about 3 inches in diameter.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/strawberries-and-cream-keto-pancakes/#wprm-recipe-58488-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/09/strawberries-and-cream-keto-pancakes-step-02.jpg"
    },
    {
      "text": "Once bubbles start to appear, flip the cakes and cook until golden brown and done in the center.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/strawberries-and-cream-keto-pancakes/#wprm-recipe-58488-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/09/strawberries-and-cream-keto-pancakes-step-03.jpg"
    },
    {
      "text": "Whip the heavy cream in a bowl until soft peaks form.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/strawberries-and-cream-keto-pancakes/#wprm-recipe-58488-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/09/strawberries-and-cream-keto-pancakes-step-04.jpg"
    },
    {
      "text": "Serve with whipped cream and fresh strawberries. Optionally serve with sugar-free maple syrup.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/strawberries-and-cream-keto-pancakes/#wprm-recipe-58488-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/09/strawberries-and-cream-keto-pancakes-step-05.jpg"
    }
