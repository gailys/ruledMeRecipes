  "ingredients": [
    "4 large egg",
    "1 cup shredded mozzarella",
    "2 ounce cream cheese (room temperature)",
    "1 teaspoon garlic powder",
    "salt and pepper",
    "4 tablespoon low-carb tomato sauce",
    "1 cup shredded mozzarella",
    "1 ounce pepperoni (sliced)"
  ],
  "instructions": [
    {
      "text": "Gather and prep all ingredients. Shred mozzarella cheese and slice pepperoni if needed. Pre-heat oven to 400F.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-pepperoni-pizza-omelet/#wprm-recipe-54757-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/08/Pepperoni-Pizza-Omelet-1.jpg"
    },
    {
      "text": "Make the crust by cracking 2 eggs into a bowl and whisking to combine.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-pepperoni-pizza-omelet/#wprm-recipe-54757-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/08/Pepperoni-Pizza-Omelet-2.jpg"
    },
    {
      "text": "Add the remaining crust ingredients (mozzarella, cream cheese, garlic powder, and salt and pepper to taste). Mix together well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-pepperoni-pizza-omelet/#wprm-recipe-54757-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/08/Pepperoni-Pizza-Omelet-3.jpg"
    },
    {
      "text": "Line an oven-proof dish (big enough to fit the crust mixture) with parchment paper. You can crumble the parchment paper before lining the dish to help keep it in place. Pour in the mixture and spread with a spatula to distribute evenly. Bake in the oven for 13-15 minutes or until crust is golden brown on the top.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-pepperoni-pizza-omelet/#wprm-recipe-54757-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/08/Pepperoni-Pizza-Omelet-4.jpg"
    },
    {
      "text": "Spread tomato sauce over the crust, leaving about 1/2 inch of space around the edges.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-pepperoni-pizza-omelet/#wprm-recipe-54757-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/08/Pepperoni-Pizza-Omelet-5.jpg"
    },
    {
      "text": "Sprinkle the mozzarella over the top and lay the pepperoni all over. Place back into the oven and bake for an additional 8-10 minutes. Optionally, broil the pizza for 2-3 minutes to make the cheese extra bubbly and a little bit crispy.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-pepperoni-pizza-omelet/#wprm-recipe-54757-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/08/Pepperoni-Pizza-Omelet-6.jpg"
    },
    {
      "text": "Let cool for a few minutes before slicing and serving. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-pepperoni-pizza-omelet/#wprm-recipe-54757-step-0-6",
      "imageSource": null
    }
  ],
