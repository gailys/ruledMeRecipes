  ],
  "instructions": [
    {
      "text": "Gather and prep all ingredients. If your sausage is cased, cut the case open with a knife and scoop out the meat.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/3-ingredient-chroizo-egg-bell-pepper-rings/#wprm-recipe-54841-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/08/3-Ingredient-Chroizo-Egg-Bell-Pepper-Rings-1.jpg"
    },
    {
      "text": "Slice the pepper into 1/4 - 1/3\" thick rings.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/3-ingredient-chroizo-egg-bell-pepper-rings/#wprm-recipe-54841-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/08/3-Ingredient-Chroizo-Egg-Bell-Pepper-Rings-2.jpg"
    },
    {
      "text": "In a pan over medium-high heat, cook the chorizo until browned and slightly crispy. About 5 minutes. Remove from the pan, leaving any leftover grease.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/3-ingredient-chroizo-egg-bell-pepper-rings/#wprm-recipe-54841-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/08/3-Ingredient-Chroizo-Egg-Bell-Pepper-Rings-3.jpg"
    },
    {
      "text": "Reduce pan heat to medium to medium-low. Place the pepper rings into the pan, then crack eggs into the rings.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/3-ingredient-chroizo-egg-bell-pepper-rings/#wprm-recipe-54841-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/08/3-Ingredient-Chroizo-Egg-Bell-Pepper-Rings-4.jpg"
    },
    {
      "text": "Season eggs with salt and pepper to taste. Spoon the crispy chorizo over the top. Optionally garnish with some fresh chopped cilantro and a squeeze of lime juice.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/3-ingredient-chroizo-egg-bell-pepper-rings/#wprm-recipe-54841-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/08/3-Ingredient-Chroizo-Egg-Bell-Pepper-Rings-5.jpg"
    },
    {
      "text": "Serve hot and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/3-ingredient-chroizo-egg-bell-pepper-rings/#wprm-recipe-54841-step-0-5",
      "imageSource": null
