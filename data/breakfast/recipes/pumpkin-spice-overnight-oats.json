  "ingredients": [
    "1/3 cup canned coconut milk",
    "1/3 cup brewed coffee",
    "1/2 cup hemp hearts",
    "2 tablespoon pumpkin puree",
    "1 tablespoon chia seeds",
    "1 tablespoon mct oil",
    "2 teaspoon powdered erythritol",
    "3/4 teaspoon pumpkin pie spice",
    "1/2 teaspoon vanilla extract",
    "sea salt (to taste)",
    "2 tablespoon pecans (chopped )",
    "1/4 teaspoon ground cinnamon",
    "2 tablespoon unsweetened carton coconut milk (as needed, to thin out)"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all the ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/pumpkin-spice-overnight-oats/#wprm-recipe-53573-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/11/Pumpkin-Spice-Overnight-Oats-1.jpg"
    },
    {
      "text": "Add all the ingredients (except for the chopped pecans, cinnamon, and coconut or almond milk) to a container with a lid. Stir together until combined, then cover the container with a lid and let sit in the refrigerator overnight, or at least 8 hours.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/pumpkin-spice-overnight-oats/#wprm-recipe-53573-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/11/Pumpkin-Spice-Overnight-Oats-2.jpg"
    },
    {
      "text": "The next morning, mix in coconut or almond milk (from the carton) until desired consistency is reached.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/pumpkin-spice-overnight-oats/#wprm-recipe-53573-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/11/Pumpkin-Spice-Overnight-Oats-3.png"
    },
    {
      "text": "Top off with chopped pecans and a dash of cinnamon. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/pumpkin-spice-overnight-oats/#wprm-recipe-53573-step-0-3",
