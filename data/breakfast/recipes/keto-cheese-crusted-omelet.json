  "ingredients": [
    "6 large egg",
    "2 tablespoon butter",
    "1 1/2 cup cheddar cheese (shredded)",
    "salt and pepper (to taste)"
  ],
  "instructions": [
    {
      "text": "Gather and prep all ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheese-crusted-omelet/#wprm-recipe-54761-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/08/Keto-Cheese-crusted-Omelet-1.jpg"
    },
    {
      "text": "Add eggs into a bowl and whisk until smooth and slightly frothy. Season with salt and pepper to taste.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheese-crusted-omelet/#wprm-recipe-54761-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/08/Keto-Cheese-crusted-Omelet-2.jpg"
    },
    {
      "text": "Add in half (1/2) of the cheddar cheese and fold through the eggs.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheese-crusted-omelet/#wprm-recipe-54761-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/08/Keto-Cheese-crusted-Omelet-3.jpg"
    },
    {
      "text": "Melt butter in a pan over medium heat. Once hot, add in the egg mixture and let set for a few minutes. Do not mix the egg during this stage.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheese-crusted-omelet/#wprm-recipe-54761-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/08/Keto-Cheese-crusted-Omelet-5.jpg"
    },
    {
      "text": "Lower the heat and continue to cook the egg mixture. Once the omelet is starting to slightly set on the top, add in the remaining cheddar cheese and fold over.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheese-crusted-omelet/#wprm-recipe-54761-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/08/Keto-Cheese-crusted-Omelet-6.jpg"
    },
    {
      "text": "Serve immediately and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheese-crusted-omelet/#wprm-recipe-54761-step-0-5",
      "imageSource": null
    }
  ],
