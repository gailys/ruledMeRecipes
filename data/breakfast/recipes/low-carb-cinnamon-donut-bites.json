  "ingredients": [
    "1 cup almond flour",
    "1 1/4 teaspoon baking powder",
    "1 teaspoon ground cinnamon",
    "1/2 cup butter (melted)",
    "2 tablespoon unsweetened almond milk",
    "1/4 cup pea protein",
    "1 teaspoon xanthan gum",
    "1/2 teaspoon salt",
    "2 tablespoon sour cream",
    "1/4 cup butter (melted)",
    "1/3 cup erythritol",
    "2 teaspoon ground cinnamon",
    "3 tablespoon powdered erythritol"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all of the ingredients. Preheat oven to 325F.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-cinnamon-donut-bites/#wprm-recipe-54375-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/07/Low-Carb-Cinnamon-Donut-Bites-1.jpg"
    },
    {
      "text": "In a mixing bowl, stir together all of the ingredients for the donut holes. The dough should be a bit sticky to form into balls.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-cinnamon-donut-bites/#wprm-recipe-54375-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/07/Low-Carb-Cinnamon-Donut-Bites-2.jpg"
    },
    {
      "text": "Line a baking sheet with parchment paper and roll the balls with clean hands into small balls. Line the parchment paper with them evenly spaced apart.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-cinnamon-donut-bites/#wprm-recipe-54375-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/07/Low-Carb-Cinnamon-Donut-Bites-3.jpg"
    },
    {
      "text": "Bake in the oven for 6 minutes. In the meantime, combine the ingredients in a bowl for the cinnamon sugar coating.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-cinnamon-donut-bites/#wprm-recipe-54375-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/07/Low-Carb-Cinnamon-Donut-Bites-4.jpg"
    },
    {
      "text": "When the donut holes are room temp, roll them in the cinnamon sugar coating evenly.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-cinnamon-donut-bites/#wprm-recipe-54375-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/07/Low-Carb-Cinnamon-Donut-Bites-5.jpg"
    },
    {
      "text": "Serve and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-cinnamon-donut-bites/#wprm-recipe-54375-step-0-5",
      "imageSource": null
    }
  ],
