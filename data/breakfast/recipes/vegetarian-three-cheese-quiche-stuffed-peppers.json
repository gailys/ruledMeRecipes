  "ingredients": [
    "2 medium red bell pepper",
    "1/2 cup ricotta cheese",
    "1/2 cup mozzarella cheese (shredded)",
    "1/2 cup grated parmesan cheese",
    "4 large egg",
    "1 teaspoon garlic powder",
    "1/4 teaspoon dried parsley",
    "1/4 cup baby spinach",
    "2 tablespoon parmesan cheese"
  ],
  "instructions": [
    {
      "text": "Heat oven to 375F. Prepare the peppers by slicing them each into equal halves. Remove the seeds.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/vegetarian-three-cheese-quiche-stuffed-peppers/#wprm-recipe-52405-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/11/quiche-stuffed-bell-peppers-01.jpg"
    },
    {
      "text": "In a small food processor blend the three cheeses, eggs, garlic powder, and parsley. My food processor is smaller than I would like, so I did this in two batches, half and half, and then combined both fillings.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/vegetarian-three-cheese-quiche-stuffed-peppers/#wprm-recipe-52405-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/11/quiche-stuffed-bell-peppers-02.jpg"
    },
    {
      "text": "Pour the cheese mixture into each pepper, filling just below the rim. Place a few baby spinach leaves on top and stir with a fork, pushing them under the egg. Cover with foil and bake for 35-45 minutes or until the egg is set.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/vegetarian-three-cheese-quiche-stuffed-peppers/#wprm-recipe-52405-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/11/quiche-stuffed-bell-peppers-04.jpg"
    },
    {
      "text": "Sprinkle with Parmesan cheese and broil for 3-5 minutes or until the tops begin to brown.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/vegetarian-three-cheese-quiche-stuffed-peppers/#wprm-recipe-52405-step-0-3",
      "imageSource": null
