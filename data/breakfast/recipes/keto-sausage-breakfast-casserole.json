  "ingredients": [
    "16 ounce pork sausage",
    "2 cup green cabbage (shredded)",
    "2 cup zucchini (diced)",
    "1/2 cup onion (diced)",
    "3 large egg",
    "1/2 cup mayonnaise",
    "2 teaspoon yellow mustard",
    "1 teaspoon dried sage",
    "1/4 teaspoon cayenne pepper",
    "1 1/2 cup cheddar cheese (shredded)"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 375F. Brown the sausage in a large skillet over medium heat until almost cooked through.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-sausage-breakfast-casserole/#wprm-recipe-51959-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/11/keto-sausage-breakfast-casserole-step-01.jpg"
    },
    {
      "text": "Add the cabbage, zucchini, and onion, cooking until the vegetables are tender and the sausage is fully cooked. Pour the mixture into a greased casserole dish.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-sausage-breakfast-casserole/#wprm-recipe-51959-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/11/keto-sausage-breakfast-casserole-step-02.jpg"
    },
    {
      "text": "In a mixing bowl, whisk the eggs, mayonnaise, mustard, sage, and cayenne pepper until smooth.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-sausage-breakfast-casserole/#wprm-recipe-51959-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/11/keto-sausage-breakfast-casserole-step-03.jpg"
    },
    {
      "text": "Add two-thirds of the shredded cheese to the egg mixture and stir.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-sausage-breakfast-casserole/#wprm-recipe-51959-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/11/keto-sausage-breakfast-casserole-step-04.jpg"
    },
    {
      "text": "Pour this mixture over the sausage and vegetables in the casserole dish.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-sausage-breakfast-casserole/#wprm-recipe-51959-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/11/keto-sausage-breakfast-casserole-step-05.jpg"
    },
    {
      "text": "Top the casserole with the remaining shredded cheese. Bake for 30 minutes, or until the casserole is bubbling around the edges and the cheese is melted and beginning to brown.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-sausage-breakfast-casserole/#wprm-recipe-51959-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/11/keto-sausage-breakfast-casserole-step-06.jpg"
    },
    {
      "text": "Remove from the oven and serve hot.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-sausage-breakfast-casserole/#wprm-recipe-51959-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/11/keto-sausage-breakfast-casserole-step-07.jpg"
    }
  ],
