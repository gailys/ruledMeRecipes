    },
    {
      "text": "Chop the red onion and mince the garlic.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-bacon-egg-brussel-plate/#wprm-recipe-54013-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/11/Bacon-Egg-Brussel-Plate-2.jpg"
    },
    {
      "text": "Chop the brussel sprouts in half.",
