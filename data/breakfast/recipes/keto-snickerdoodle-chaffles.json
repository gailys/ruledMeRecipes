  "ingredients": [
    "1 large egg",
    "1/2 cup shredded mozzarella",
    "1/4 cup almond flour",
    "1/8 teaspoon baking powder",
    "3 tablespoon erythritol",
    "1 1/2 tablespoon unsalted butter (melted)",
    "1 teaspoon ground cinnamon",
    "2 tablespoon powdered erythritol"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all of the ingredients. Preheat a waffle iron.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-snickerdoodle-chaffles/#wprm-recipe-54403-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/07/Keto-Snickerdoodle-Chaffles-1.jpg"
    },
    {
      "text": "In a small food processor, add in the egg, mozzarella, almond flour, and baking powder. Blend until smooth.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-snickerdoodle-chaffles/#wprm-recipe-54403-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/07/Keto-Snickerdoodle-Chaffles-2.jpg"
    },
    {
      "text": "Add in the erythritol, then blend until smooth.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-snickerdoodle-chaffles/#wprm-recipe-54403-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/07/Keto-Snickerdoodle-Chaffles-3.jpg"
    },
    {
      "text": "Place some of the mixture onto the preheated waffle iron. Close the waffle iron and cook the waffles based on the instructions provided by the machine. Or until it cooks in between 3-5 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-snickerdoodle-chaffles/#wprm-recipe-54403-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/07/Keto-Snickerdoodle-Chaffles-4.jpg"
    },
    {
      "text": "Let the chaffles cool down a bit before removing from the iron.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-snickerdoodle-chaffles/#wprm-recipe-54403-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/07/Keto-Snickerdoodle-Chaffles-5.jpg"
    },
    {
      "text": "Brush them with melted butter on both sides.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-snickerdoodle-chaffles/#wprm-recipe-54403-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/07/Keto-Snickerdoodle-Chaffles-6.jpg"
    },
    {
      "text": "Season the chaffles with a mixture of cinnamon and erythritol on both sides.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-snickerdoodle-chaffles/#wprm-recipe-54403-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/07/Keto-Snickerdoodle-Chaffles-7.jpg"
    },
    {
      "text": "Serve and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-snickerdoodle-chaffles/#wprm-recipe-54403-step-0-7",
      "imageSource": null
    }
  ],
