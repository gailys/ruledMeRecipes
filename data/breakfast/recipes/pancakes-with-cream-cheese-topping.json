  "ingredients": [
    "8 ounce cream cheese",
    "2 tablespoon olive oil",
    "2 tablespoon pesto",
    "1/2 medium red onion (sliced thin)",
    "salt and pepper (to taste)",
    "5 large egg",
    "9 ounce cottage cheese",
    "1 tablespoon psyllium husk powder",
    "1 teaspoon fresh garlic (minced)",
    "salt (to taste)",
    "2 tablespoon butter (for frying)"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all the ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/pancakes-with-cream-cheese-topping/#wprm-recipe-53561-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/11/Pancakes-with-Cream-Cheese-1.jpg"
    },
    {
      "text": "In a bowl, make the cream cheese topping by mixing cream cheese, pesto, and half of the olive oil together. Stir until well combined and set aside.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/pancakes-with-cream-cheese-topping/#wprm-recipe-53561-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/11/Pancakes-with-Cream-Cheese-2.jpg"
    },
    {
      "text": "Make the pancake batter next. In a bowl, add the eggs, cottage cheese, psyllium husk powder, minced garlic, and salt to taste. Mix until the consistency is smooth then let it sit for about 10 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/pancakes-with-cream-cheese-topping/#wprm-recipe-53561-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/11/Pancakes-with-Cream-Cheese-3.jpg"
    },
    {
      "text": "In a frying pan, melt the butter on medium heat. Spoon the pancake batter into the pan, forming small circles about 2-3\" in diameter. Fry the pancakes on both sides until golden brown in color.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/pancakes-with-cream-cheese-topping/#wprm-recipe-53561-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/11/Pancakes-with-Cream-Cheese-4.jpg"
    },
    {
      "text": "Plate the pancakes and top with cream cheese topping, sliced onion, and remaining olive oil. Season additionally with salt and pepper if desired. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/pancakes-with-cream-cheese-topping/#wprm-recipe-53561-step-0-4",
      "imageSource": null
    }
  ],
