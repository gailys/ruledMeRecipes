  "ingredients": [
    "2 tablespoon butter",
    "2 cup cauliflower rice",
    "1/4 cup hemp hearts",
    "4 ounce cremini mushrooms",
    "1/4 teaspoon garlic powder",
    "salt and pepper (to taste)",
    "1/4 cup heavy cream",
    "1 cup unsweetened almond milk",
    "2 ounce cheddar cheese (shredded)"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all the ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-breakfast-grits/#wprm-recipe-53529-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/09/Breakfast-Grits-1.jpg"
    },
    {
      "text": "Place 2 pans over medium heat on the stove. Place half of the butter in each pan.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-breakfast-grits/#wprm-recipe-53529-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/09/Breakfast-Grits-2.jpg"
    },
    {
      "text": "Add the cauliflower rice and hemp hearts to one pan and saute for 2-3 minutes. In the other pan, saute the mushrooms for 2-3 minutes, or until cooked but still firm. Season mushrooms with salt and pepper, and set aside.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-breakfast-grits/#wprm-recipe-53529-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/09/Breakfast-Grits-3.jpg"
    },
    {
      "text": "Add in the garlic powder, salt and pepper, heavy cream, and almond milk to the cauliflower rice. Stir well. Turn the stove down medium-low, simmering until the mixture is thick. Add a small amount more almond milk if needed to prevent burning.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-breakfast-grits/#wprm-recipe-53529-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/09/Breakfast-Grits-4.jpg"
    },
    {
      "text": "Turn the stove off and stir in half the shredded cheese.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-breakfast-grits/#wprm-recipe-53529-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/09/Breakfast-Grits-5.jpg"
    },
    {
      "text": "Top with the sautéed mushrooms and the rest of the shredded cheddar cheese.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-breakfast-grits/#wprm-recipe-53529-step-0-5",
      "imageSource": null
    }
  ],
