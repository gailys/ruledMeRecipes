  "ingredients": [
    "1/2 cup full-fat plain greek yogurt",
    "1/4 cup heavy cream",
    "1/4 cup unsweetened almond milk",
    "1 ounce vegan vanilla protein powder (or unflavored protein powder with some vanilla extract)",
    "1 tablespoon almond butter",
    "1/2 ounce raspberries",
    "2 tablespoon pecans (crumbled)"
  ],
  "instructions": [
    {
      "text": "Gather and prep all ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/loaded-keto-breakfast-parfait/#wprm-recipe-54969-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/04/Loaded-Keto-Breakfast-Parfait-1.jpg"
    },
    {
      "text": "In a bowl, combine the Greek yogurt, almond milk and protein powder. Use a fork or a whisk to get all lumps out and continue mixing until smooth.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/loaded-keto-breakfast-parfait/#wprm-recipe-54969-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/04/Loaded-Keto-Breakfast-Parfait-2.jpg"
    },
    {
      "text": "Add in the heavy cream and continue to mix until incorporated.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/loaded-keto-breakfast-parfait/#wprm-recipe-54969-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/04/Loaded-Keto-Breakfast-Parfait-4.jpg"
    },
    {
      "text": "If using a separate bowl or container for serving, place the yogurt mixture into that container. Dollop the almond butter over the top and spread as best as you can.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/loaded-keto-breakfast-parfait/#wprm-recipe-54969-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/04/Loaded-Keto-Breakfast-Parfait-5.jpg"
    },
    {
      "text": "Add the raspberries and sprinkle the pecans over the top.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/loaded-keto-breakfast-parfait/#wprm-recipe-54969-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/04/Loaded-Keto-Breakfast-Parfait-6.jpg"
    },
    {
      "text": "Refrigerate until you want to serve and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/loaded-keto-breakfast-parfait/#wprm-recipe-54969-step-0-5",
      "imageSource": null
    }
