  "ingredients": [
    "10 large egg",
    "120 gram heavy whipping cream",
    "100 gram water",
    "1 1/2 cup ham (diced)",
    "3/4 cup green onion (sliced)",
    "234 gram canned diced tomatoes (drained)",
    "1 1/2 cup cheddar cheese (grated)",
    "1/2 teaspoon salt",
    "1/2 teaspoon black pepper",
    "1/2 teaspoon onion powder",
    "1/2 teaspoon garlic powder"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 450F.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/western-style-egg-scramble/#wprm-recipe-58333-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/10/western-style-egg-scramble-step-01.jpg"
    },
    {
      "text": "Whisk the eggs, heavy cream, water, and all the spices together in a bowl.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/western-style-egg-scramble/#wprm-recipe-58333-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/10/western-style-egg-scramble-step-02.jpg"
    },
    {
      "text": "Coat a large cookie sheet with non-stick spray. Pour the egg mixture onto the sheet pan, then carefully place in the oven.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/western-style-egg-scramble/#wprm-recipe-58333-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/10/western-style-egg-scramble-step-03.jpg"
    },
    {
      "text": "When eggs are almost fully cooked, remove from oven and add the ham, tomatoes, and cheese on top. Return the pan back to the oven.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/western-style-egg-scramble/#wprm-recipe-58333-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/10/western-style-egg-scramble-step-04.jpg"
    },
    {
      "text": "Cook until the cheese has melted, then remove and let it cool for about 5 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/western-style-egg-scramble/#wprm-recipe-58333-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/10/western-style-egg-scramble-step-05.jpg"
    },
    {
      "text": "Break up the eggs to turn it into a proper scramble. Sprinkle green onion on top, then divide up into individual portions. Freeze or serve.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/western-style-egg-scramble/#wprm-recipe-58333-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/10/western-style-egg-scramble-step-06.jpg"
    }
  ],
