  "ingredients": [
    "3 large egg",
    "2 tablespoon heavy cream",
    "salt (to taste)",
    "1 teaspoon ghee",
    "1 tablespoon butter",
    "2 slice prosciutto",
    "1 teaspoon fresh dill"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all of the ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-prosciutto-scrambled-eggs/#wprm-recipe-54279-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/04/Keto-Proscuitto-Scrambled-Eggs-1.jpg"
    },
    {
      "text": "In a bowl, crack the eggs and discard the shells. Add in the heavy cream and salt. Whisk until well combined.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-prosciutto-scrambled-eggs/#wprm-recipe-54279-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/04/Keto-Proscuitto-Scrambled-Eggs-2.jpg"
    },
    {
      "text": "In a frying pan over medium heat, add in the ghee and butter. Then add in the egg mixture.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-prosciutto-scrambled-eggs/#wprm-recipe-54279-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/04/Keto-Proscuitto-Scrambled-Eggs-3.jpg"
    },
    {
      "text": "Let sit in pan until the bottom appears to be cooked. Then scramble the eggs up by moving them around in the pan with a spatula.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-prosciutto-scrambled-eggs/#wprm-recipe-54279-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/04/Keto-Proscuitto-Scrambled-Eggs-4.jpg"
    },
    {
      "text": "On a plate, lay the prosciutto down then lay the scrambled eggs on top. Fold the prosciutto over the scrambled eggs.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-prosciutto-scrambled-eggs/#wprm-recipe-54279-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/04/Keto-Proscuitto-Scrambled-Eggs-5.jpg"
    },
    {
      "text": "Garnish with fresh dill. Serve and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-prosciutto-scrambled-eggs/#wprm-recipe-54279-step-0-5",
      "imageSource": null
    }
