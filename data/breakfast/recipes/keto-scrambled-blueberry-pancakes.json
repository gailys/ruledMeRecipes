  "ingredients": [
    "3 large egg",
    "1/3 cup unsweetened almond milk",
    "1/4 cup almond flour",
    "1 tablespoon coconut flour",
    "1 teaspoon baking powder",
    "salt (to taste)",
    "1 tablespoon butter (for frying)",
    "1 ounce blueberries"
  ],
  "instructions": [
    {
      "text": "Gather and prep all ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-scrambled-blueberry-pancakes/#wprm-recipe-54709-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/08/Keto-Scrambled-Blueberry-Pancakes1.jpg"
    },
    {
      "text": "In a bowl, add all ingredients except for the butter and blueberries.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-scrambled-blueberry-pancakes/#wprm-recipe-54709-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/08/Keto-Scrambled-Blueberry-Pancakes2.jpg"
    },
    {
      "text": "Mix the ingredients together well, until smooth and most lumps are gone.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-scrambled-blueberry-pancakes/#wprm-recipe-54709-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/08/Keto-Scrambled-Blueberry-Pancakes3.jpg"
    },
    {
      "text": "Heat a pan over medium heat. Once hot, grease pan with butter as needed. Add batter into the pan, ignoring the size and shape of the pancake.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-scrambled-blueberry-pancakes/#wprm-recipe-54709-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/08/Keto-Scrambled-Blueberry-Pancakes4.jpg"
    },
    {
      "text": "Using a rubber spatula, stir and fold the dough slowly as it cooks, similar to cooking scrambled eggs.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-scrambled-blueberry-pancakes/#wprm-recipe-54709-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/08/Keto-Scrambled-Blueberry-Pancakes5.jpg"
    },
    {
      "text": "Once the batter is cooked through, sprinkle blueberries over the top and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-scrambled-blueberry-pancakes/#wprm-recipe-54709-step-0-5",
      "imageSource": null
