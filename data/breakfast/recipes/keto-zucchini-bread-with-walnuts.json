  "ingredients": [
    "3 large egg",
    "1/2 cup olive oil",
    "1 teaspoon vanilla extract",
    "2 1/2 cup almond flour",
    "1 1/2 cup erythritol",
    "1/2 teaspoon salt",
    "1 1/2 teaspoon baking powder",
    "1/2 teaspoon ground nutmeg",
    "1 teaspoon ground cinnamon",
    "1/4 teaspoon ground ginger",
    "1 cup zucchini (grated)",
    "1/2 cup walnuts (chopped)"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 350F. Whisk together the eggs, oil, and vanilla extract. Set aside.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-zucchini-bread-with-walnuts/#wprm-recipe-52055-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/01/Step-1.jpg"
    },
    {
      "text": "In a separate bowl, mix together the almond flour, erythritol, salt, baking powder, nutmeg, cinnamon, and ginger. Set aside.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-zucchini-bread-with-walnuts/#wprm-recipe-52055-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/01/Step-2.jpg"
    },
    {
      "text": "Using a cheesecloth or paper towel, squeeze the excess water out of the zucchini.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-zucchini-bread-with-walnuts/#wprm-recipe-52055-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/01/Step-3.jpg"
    },
    {
      "text": "Whisk the zucchini into the bowl with the eggs.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-zucchini-bread-with-walnuts/#wprm-recipe-52055-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/01/Step-4.jpg"
    },
    {
      "text": "Using a hand mixer, slowly add the dry ingredients to the egg mixture until thoroughly combined.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-zucchini-bread-with-walnuts/#wprm-recipe-52055-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/01/Step-5.jpg"
    },
    {
      "text": "Spoon the mixture into a greased loaf pan.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-zucchini-bread-with-walnuts/#wprm-recipe-52055-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/01/Step-6.jpg"
    },
    {
      "text": "Sprinkle the chopped walnuts on top. Press them into the batter using a spatula.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-zucchini-bread-with-walnuts/#wprm-recipe-52055-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/01/Step-7.jpg"
    },
    {
      "text": "Bake for 60–70 minutes, or until the walnuts on top are browned and toasted.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-zucchini-bread-with-walnuts/#wprm-recipe-52055-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/01/Zucchini-Bread-with-Walnut-Crust-620x900.jpg"
    }
  ],
