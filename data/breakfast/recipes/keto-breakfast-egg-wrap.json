  "instructions": [
    {
      "text": "Measure out and prepare all the ingredients. Cook the chicken sausages in a frying pan, then cover with aluminum foil to keep warm.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-breakfast-egg-wrap/#wprm-recipe-54191-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/03/Keto-Breakfast-Egg-Wrap-1.jpg"
    },
    {
      "text": "In a large bowl, crack the eggs. Season with salt and pepper.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-breakfast-egg-wrap/#wprm-recipe-54191-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/03/Keto-Breakfast-Egg-Wrap-2.jpg"
    },
    {
      "text": "Beat the eggs with a whisk.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-breakfast-egg-wrap/#wprm-recipe-54191-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/03/Keto-Breakfast-Egg-Wrap-3.jpg"
    },
    {
      "text": "In a nonstick frying pan over medium heat, add the butter then add the whisked eggs. Let cook for 2 - 3 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-breakfast-egg-wrap/#wprm-recipe-54191-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/03/Keto-Breakfast-Egg-Wrap-4.jpg"
    },
    {
      "text": "Then flip over carefully and let the other side cook for another 1 - 2 minutes. Slide the egg wrap off the frying pan and onto a plate.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-breakfast-egg-wrap/#wprm-recipe-54191-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/03/Keto-Breakfast-Egg-Wrap-5.jpg"
    },
    {
      "text": "Mash up the avocado and spread across the egg wrap. Then spread the cream cheese on top of that. Top with the diced jalapenos.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-breakfast-egg-wrap/#wprm-recipe-54191-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/03/Keto-Breakfast-Egg-Wrap-7.jpg"
    },
    {
      "text": "Unwrap the chicken sausages.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-breakfast-egg-wrap/#wprm-recipe-54191-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/03/Keto-Breakfast-Egg-Wrap-6.jpg"
    },
    {
      "text": "Place the chicken sausage on top of the avocado avocado and cream cheese.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-breakfast-egg-wrap/#wprm-recipe-54191-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/03/Keto-Breakfast-Egg-Wrap-8.jpg"
    },
    {
      "text": "Roll up the egg wrap by folding in the sides then folding it around the sausage.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-breakfast-egg-wrap/#wprm-recipe-54191-step-0-8",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/03/Keto-Breakfast-Egg-Wrap-9.jpg"
    },
    {
      "text": "Serve and enjoy!",
      "group": "",
