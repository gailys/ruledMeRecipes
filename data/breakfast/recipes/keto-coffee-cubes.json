  ],
  "instructions": [
    {
      "text": "Grab a microwave-safe container (preferably a small one; I used a plastic cup) and toss in the baking chocolate.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-coffee-cubes/#wprm-recipe-50335-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/10/keto-coffee-cubes-01.jpg"
    },
    {
      "text": "Add the coconut oil and peanut butter. I used Peter Pan peanut butter because it was all I could find, but my favorite brand is Skippy's Natural Creamy Peanut Butter.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-coffee-cubes/#wprm-recipe-50335-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/10/keto-coffee-cubes-04.jpg"
    },
    {
      "text": "Add the sweetener and microwave for 60 seconds. Then stir it up into a nice liquid consistency. Freeze for future use.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-coffee-cubes/#wprm-recipe-50335-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/10/keto-coffee-cubes-05.jpg"
    },
    {
      "text": "When ready to use, just plop the cube into the bottom of a cup and pour the coffee straight over the top.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-coffee-cubes/#wprm-recipe-50335-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/10/keto-coffee-cubes-06.jpg"
    }
