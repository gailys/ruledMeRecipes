  "ingredients": [
    "1/2 medium yellow onion",
    "12 large egg",
    "1/4 cup heavy whipping cream",
    "1 cup ricotta cheese",
    "1/4 teaspoon salt",
    "1/2 tablespoon garlic and herb seasoning",
    "9 ounce frozen spinach (water squeezed out)",
    "16 ounce ham (diced)"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 350F. Dice the onion.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/ham-ricotta-spinach-casserole/#wprm-recipe-52083-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/02/Step-1.jpg"
    },
    {
      "text": "Blend one-third of the eggs with the heavy whipping cream, ricotta cheese, and onion until smooth. Set aside.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/ham-ricotta-spinach-casserole/#wprm-recipe-52083-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/02/Step-2.jpg"
    },
    {
      "text": "In a separate bowl, whisk together the remaining eggs.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/ham-ricotta-spinach-casserole/#wprm-recipe-52083-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/02/Step-3.jpg"
    },
    {
      "text": "Add the blended mixture to the eggs and whisk together. This blended mixture will help keep the eggs together, almost like a crust.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/ham-ricotta-spinach-casserole/#wprm-recipe-52083-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/02/Step-4.jpg"
    },
    {
      "text": "Stir in the salt and garlic and herb seasoning until fully incorporated.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/ham-ricotta-spinach-casserole/#wprm-recipe-52083-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/02/Step-5.jpg"
    },
    {
      "text": "Gently stir in the spinach and diced ham.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/ham-ricotta-spinach-casserole/#wprm-recipe-52083-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/02/Step-6.jpg"
    },
    {
      "text": "Pour the mixture into a greased baking or casserole dish.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/ham-ricotta-spinach-casserole/#wprm-recipe-52083-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/02/Step-7.jpg"
    },
    {
      "text": "Bake for 30–35 minutes, or until the top looks fully cooked. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/ham-ricotta-spinach-casserole/#wprm-recipe-52083-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/02/Ham-Ricotta-and-Spinach-Breakfast-Casserole-620x900.jpg"
    }
  ],
