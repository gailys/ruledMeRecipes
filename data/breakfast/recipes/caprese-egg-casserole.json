  "ingredients": [
    "1 tablespoon olive oil",
    "2 cup cherry tomatoes",
    "8 large egg",
    "13 gram fresh basil",
    "4 ounce mozzarella pearls",
    "salt and pepper (to taste)"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 350F. Chop the cherry tomatoes into halves or quarters. Fry up in a skillet with the olive oil until the tomatoes have softened somewhat.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/caprese-egg-casserole/#wprm-recipe-52583-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/05/caprese-egg-casserole-02.jpg"
    },
    {
      "text": "Set the cooked tomatoes and the liquid from the pan aside, so everything can cool.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/caprese-egg-casserole/#wprm-recipe-52583-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/05/caprese-egg-casserole-03.jpg"
    },
    {
      "text": "Add the eggs to a mixing bowl.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/caprese-egg-casserole/#wprm-recipe-52583-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/05/caprese-egg-casserole-01.jpg"
    },
    {
      "text": "Chop up the fresh basil, then add to the eggs. Season with salt and pepper.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/caprese-egg-casserole/#wprm-recipe-52583-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/05/caprese-egg-casserole-05.jpg"
    },
    {
      "text": "Whisk the eggs together until the yolks and whites are well combined.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/caprese-egg-casserole/#wprm-recipe-52583-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/05/caprese-egg-casserole-06.jpg"
    },
    {
      "text": "Pour the eggs into a greased casserole dish. Add the cooked tomatoes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/caprese-egg-casserole/#wprm-recipe-52583-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/05/caprese-egg-casserole-07.jpg"
    },
    {
      "text": "Add the fresh mozzarella balls, distributing evenly.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/caprese-egg-casserole/#wprm-recipe-52583-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/05/caprese-egg-casserole-09.jpg"
    },
    {
      "text": "Bake for 25-30 minutes, or until the eggs are cooked throughout, making sure they have completely set in the middle of the dish.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/caprese-egg-casserole/#wprm-recipe-52583-step-0-7",
      "imageSource": null
    }
  ],
