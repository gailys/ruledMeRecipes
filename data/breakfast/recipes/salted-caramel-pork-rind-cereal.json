  "ingredients": [
    "1 ounce pork rinds",
    "2 tablespoon butter",
    "2 tablespoon heavy whipping cream",
    "1 tablespoon erythritol",
    "1 cup unsweetened carton coconut milk (or other low-carb milk)",
    "1/4 teaspoon ground cinnamon"
  ],
  "instructions": [
    {
      "text": "Measure out the pork rinds.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/salted-caramel-pork-rind-cereal/#wprm-recipe-50873-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/02/IMG_1528.jpg"
    },
    {
      "text": "Break them up into smaller pieces to resemble cereal.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/salted-caramel-pork-rind-cereal/#wprm-recipe-50873-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/02/IMG_1534.jpg"
    },
    {
      "text": "Heat the butter in a pan over medium heat. In a ramekin, measure out the heavy cream and erythritol.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/salted-caramel-pork-rind-cereal/#wprm-recipe-50873-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/02/IMG_1535.jpg"
    },
    {
      "text": "Continue to let the butter cook until browned; it should start to bubble a little bit. This will not only add a different flavor profile to the caramel, but it will also give it that characteristic color.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/salted-caramel-pork-rind-cereal/#wprm-recipe-50873-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/02/IMG_1542.jpg"
    },
    {
      "text": "Once browned, remove the pan from the heat and add in the heavy cream and erythritol... Keep stirring and return the pan to the heat.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/salted-caramel-pork-rind-cereal/#wprm-recipe-50873-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/02/IMG_1552.jpg"
    },
    {
      "text": "Continue stirring until the mixture takes on a caramel-like consistency.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/salted-caramel-pork-rind-cereal/#wprm-recipe-50873-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/02/IMG_1562.jpg"
    },
    {
      "text": "Add in the pork rinds, thoroughly coating them in the caramel sauce.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/salted-caramel-pork-rind-cereal/#wprm-recipe-50873-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/02/IMG_1566.jpg"
    },
    {
      "text": "Transfer the caramel-coated pork rinds to a plate.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/salted-caramel-pork-rind-cereal/#wprm-recipe-50873-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/02/IMG_1586.jpg"
    },
    {
      "text": "Place in the fridge for 20–40 minutes to allow the caramel to harden.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/salted-caramel-pork-rind-cereal/#wprm-recipe-50873-step-0-8",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/02/IMG_1591.jpg"
    },
    {
      "text": "Remove from the fridge once hardened.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/salted-caramel-pork-rind-cereal/#wprm-recipe-50873-step-0-9",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/02/IMG_1596.jpg"
    },
    {
      "text": "Pour the coconut milk over the cereal. Sprinkle with cinnamon and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/salted-caramel-pork-rind-cereal/#wprm-recipe-50873-step-0-10",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/02/porkrindcereal2.jpg"
    }
  ],
