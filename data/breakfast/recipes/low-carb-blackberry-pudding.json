  "ingredients": [
    "5 large egg yolk",
    "1/4 cup coconut flour",
    "1/4 teaspoon baking powder",
    "2 tablespoon coconut oil",
    "2 tablespoon butter",
    "2 tablespoon erythritol",
    "10 drop liquid stevia",
    "2 tablespoon heavy whipping cream",
    "2 teaspoon lemon juice",
    "2 teaspoon lemon zest",
    "1/4 cup blackberries"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 350F. Separate the egg yolks from the whites and set them aside.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-blackberry-pudding/#wprm-recipe-51193-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/07/IMG_6572.jpg"
    },
    {
      "text": "Measure out the coconut flour and baking powder. Set aside.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-blackberry-pudding/#wprm-recipe-51193-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/07/IMG_6577.jpg"
    },
    {
      "text": "Measure out the coconut oil and butter. Set aside.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-blackberry-pudding/#wprm-recipe-51193-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/07/IMG_6581.jpg"
    },
    {
      "text": "Whisk the egg yolks until pale in color. Add the erythritol and liquid stevia and whisk again to combine.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-blackberry-pudding/#wprm-recipe-51193-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/07/IMG_6585.jpg"
    },
    {
      "text": "Add the heavy cream, lemon juice, and lemon zest, then add the coconut and butter. Mix everything until the consistency is smooth and without any lumps.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-blackberry-pudding/#wprm-recipe-51193-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/07/IMG_6591.jpg"
    },
    {
      "text": "Sift the dry ingredients into the wet ingredients and mix well on a slow speed.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-blackberry-pudding/#wprm-recipe-51193-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/07/IMG_6597.jpg"
    },
    {
      "text": "Measure the batter out into ramekins and lightly crush the blackberries. Evenly distribute the blackberries by pushing them into the top of the batter.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-blackberry-pudding/#wprm-recipe-51193-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/07/IMG_6603.jpg"
    },
    {
      "text": "Bake for 20–25 minutes. Remove and let cool for about 5 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-blackberry-pudding/#wprm-recipe-51193-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/07/IMG_6606.jpg"
    },
    {
      "text": "Serve and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-blackberry-pudding/#wprm-recipe-51193-step-0-8",
      "imageSource": null
    }
  ],
