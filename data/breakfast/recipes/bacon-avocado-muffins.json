  "ingredients": [
    "5 large egg",
    "1/2 cup almond flour",
    "1/4 cup flaxseed meal",
    "1 1/2 tablespoon psyllium husk powder",
    "1 teaspoon ground coriander",
    "1 teaspoon dried chives",
    "1/4 teaspoon crushed red pepper flakes",
    "1 teaspoon fresh garlic (minced)",
    "salt and pepper (to taste)",
    "1 1/2 cup unsweetened carton coconut milk",
    "1 1/2 tablespoon lemon juice",
    "5 ounce bacon",
    "2 tablespoon butter",
    "45 gram green onion",
    "4 1/2 ounce colby jack cheese",
    "1 teaspoon baking powder",
    "2 medium avocado"
  ],
  "instructions": [
    {
      "text": "In a mixing bowl, combine the eggs, almond flour, flaxseed meal, psyllium husk, spices, coconut milk, and lemon juice. Set aside.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/bacon-avocado-muffins/#wprm-recipe-51475-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/11/img_8700.jpg"
    },
    {
      "text": "Fry the bacon until crisp in a pan over medium-low heat. Add the butter to the pan once the bacon is almost done cooking.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/bacon-avocado-muffins/#wprm-recipe-51475-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/11/img_8708.jpg"
    },
    {
      "text": "Chop the green onions and grate the cheese. Add the green onions, cheese, and baking powder to the mixing bowl. Crumble the bacon and add the crumbled bacon and melted butter to the batter.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/bacon-avocado-muffins/#wprm-recipe-51475-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/11/img_8711.jpg"
    },
    {
      "text": "Preheat oven to 350F. Slice the avocados in half, removing the pit and cubing them while still in the peel. Scoop out the cubed avocado and gently fold it into the mixture.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/bacon-avocado-muffins/#wprm-recipe-51475-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/11/img_8715.jpg"
    },
    {
      "text": "Pour the batter into a greased cupcake tray and bake for 24–26 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/bacon-avocado-muffins/#wprm-recipe-51475-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/11/img_8723.jpg"
    },
    {
      "text": "Store in the fridge and enjoy cold!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/bacon-avocado-muffins/#wprm-recipe-51475-step-0-5",
      "imageSource": null
    }
  ],
