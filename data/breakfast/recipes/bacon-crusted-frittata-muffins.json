  "ingredients": [
    "18 ounce bacon",
    "7 large egg",
    "4 tablespoon heavy whipping cream",
    "1/2 teaspoon black pepper",
    "1/2 teaspoon onion powder",
    "1/2 teaspoon celery salt",
    "1/2 teaspoon cayenne pepper",
    "1 cup cheddar cheese (shredded)"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 375F. Cut the bacon slices in half and shape them around the outsides and bottom of each cupcake mold, making sure not to leave any gaps.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/bacon-crusted-frittata-muffins/#wprm-recipe-50573-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/12/step1frittatamuffin.jpg"
    },
    {
      "text": "Bake for 15 minutes to precook the bacon baskets. Meanwhile, whisk together the eggs, heavy cream, and seasonings. Feel free to add any extra fresh herbs you'd like here!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/bacon-crusted-frittata-muffins/#wprm-recipe-50573-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/12/step2frittatamuffins.jpg"
    },
    {
      "text": "Place some shredded cheddar cheese at the bottom of each bacon basket. Pour the egg mixture into the cups, trying your best not to let any egg leak out. Bake for an additional 12–15 minutes or until beginning to brown on top.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/bacon-crusted-frittata-muffins/#wprm-recipe-50573-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/12/step3frittatamuffin.jpg"
    },
    {
      "text": "Remove from the oven and let cool. Store them for later, or serve and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/bacon-crusted-frittata-muffins/#wprm-recipe-50573-step-0-3",
      "imageSource": null
    }
  ],
