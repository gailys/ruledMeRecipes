  "ingredients": [
    "16 ounce cauliflower",
    "3 large egg",
    "1/2 medium onion",
    "1 teaspoon salt",
    "black pepper (to taste)",
    "8 tablespoon butter (to fry)"
  ],
  "instructions": [
    {
      "text": "Grate the cauliflower and onion into small pieces using either a grater or a food processor.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cauliflower-hash-browns-5-ingredient/#wprm-recipe-53341-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/05/cauliflower-hash-browns-02.jpg"
    },
    {
      "text": "Add the cauliflower and onion to a bowl, then add the eggs and seasoning. Mix together well and set aside for 5-10 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cauliflower-hash-browns-5-ingredient/#wprm-recipe-53341-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/05/cauliflower-hash-browns-03.jpg"
    },
    {
      "text": "Melt enough butter to thoroughly cover the bottom of the pan.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cauliflower-hash-browns-5-ingredient/#wprm-recipe-53341-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/05/cauliflower-hash-browns-04.jpg"
    },
    {
      "text": "Add scoops of the cauliflower mixture into the butter and fry for 4-5 minutes on each side. Be careful not to flip before the sides are crispy as they can break apart. Add additional butter to the pan as needed to help fry the hash browns.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cauliflower-hash-browns-5-ingredient/#wprm-recipe-53341-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/05/cauliflower-hash-browns-05.jpg"
    },
    {
      "text": "If cooking in batches, you can keep the finished cauliflower hash browns in foil to help keep them warm. Once finished, serve the hash browns with the butter from the pan.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cauliflower-hash-browns-5-ingredient/#wprm-recipe-53341-step-0-4",
      "imageSource": null
    }
