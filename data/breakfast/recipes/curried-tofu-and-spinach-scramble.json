  "ingredients": [
    "2 tablespoon olive oil",
    "1/2 medium onion (diced)",
    "3 teaspoon fresh garlic (minced)",
    "12 ounce extra firm tofu",
    "1 teaspoon curry powder",
    "1/2 teaspoon turmeric powder",
    "1/2 teaspoon cumin",
    "salt and pepper (to taste)",
    "2 large fresh tomatoes (diced)",
    "250 gram spinach"
  ],
  "instructions": [
    {
      "text": "Saute the garlic and onion in olive oil. Cook until the onion softens.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/curried-tofu-and-spinach-scramble/#wprm-recipe-59678-step-0-0",
