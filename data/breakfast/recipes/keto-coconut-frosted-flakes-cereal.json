  "ingredients": [
    "4 cup unsweetened toasted coconut flakes",
    "2 large egg white",
    "3 1/2 ounce powdered erythritol",
    "1 teaspoon vanilla extract"
  ],
  "instructions": [
    {
      "text": "Gather ingredients. Preheat oven to 300F. Line a large cookie sheet with parchment paper.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-coconut-frosted-flakes-cereal/#wprm-recipe-58522-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/06/keto-coconut-frosted-flakes-cereal-step-01.jpg"
    },
    {
      "text": "Whisk the egg whites, vanilla, and erythritol together.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-coconut-frosted-flakes-cereal/#wprm-recipe-58522-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/06/keto-coconut-frosted-flakes-cereal-step-02.jpg"
    },
    {
      "text": "Add the egg white mixture to the coconut flakes. Mix very well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-coconut-frosted-flakes-cereal/#wprm-recipe-58522-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/06/keto-coconut-frosted-flakes-cereal-step-03.jpg"
    },
    {
      "text": "Spread the coconut flakes out on the baking sheet. Cook for 15 minutes, then stir.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-coconut-frosted-flakes-cereal/#wprm-recipe-58522-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/06/keto-coconut-frosted-flakes-cereal-step-04.jpg"
    },
    {
      "text": "Cook for another 10-20 minutes. Stir again, then turn the oven off. Leave the coconut flakes in the oven for an additional 10-15 minutes to fully dry.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-coconut-frosted-flakes-cereal/#wprm-recipe-58522-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/06/keto-coconut-frosted-flakes-cereal-step-05.jpg"
    },
    {
      "text": "Remove from the oven and allow to cool before serving.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-coconut-frosted-flakes-cereal/#wprm-recipe-58522-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/06/keto-coconut-frosted-flakes-cereal-step-06.jpg"
    }
