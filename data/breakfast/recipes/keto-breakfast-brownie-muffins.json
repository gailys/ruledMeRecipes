  "ingredients": [
    "1 cup flaxseed meal",
    "1/4 cup unsweetened dark cocoa powder",
    "1 tablespoon ground cinnamon",
    "1/2 tablespoon baking powder",
    "1/2 teaspoon salt",
    "1 large egg",
    "2 tablespoon coconut oil",
    "1/4 cup sugar-free caramel syrup (such as Torani)",
    "1/2 cup pumpkin puree",
    "1 teaspoon vanilla extract",
    "1 teaspoon apple cider vinegar",
    "1/4 cup slivered almonds"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 350F. Add the dry ingredients to a large mixing bowl and stir to combine.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-breakfast-brownie-muffins/#wprm-recipe-51859-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/12/01Mix-dry-ingredients.jpg"
    },
    {
      "text": "In a separate bowl, whisk together the wet ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-breakfast-brownie-muffins/#wprm-recipe-51859-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/12/02Mix-wet-ingredients.jpg"
    },
    {
      "text": "Pour the wet ingredients into the dry ingredients and mix well to combine.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-breakfast-brownie-muffins/#wprm-recipe-51859-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/12/03Mix-well.jpg"
    },
    {
      "text": "Line a muffin tin with paper liners and spoon in the batter. Sprinkle the slivered almonds on top and press them in gently to help them stick.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-breakfast-brownie-muffins/#wprm-recipe-51859-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/12/04Spoon-batter.jpg"
    },
    {
      "text": "Bake for about 15 minutes. The muffins rise and set on top. Enjoy — these taste good both warm and cold!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-breakfast-brownie-muffins/#wprm-recipe-51859-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/12/Muffins3.jpg"
