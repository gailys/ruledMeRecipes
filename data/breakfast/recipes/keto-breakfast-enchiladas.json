  "ingredients": [
    "6 large egg",
    "1/4 cup heavy cream",
    "1/2 teaspoon garlic powder",
    "1/2 teaspoon chili powder",
    "salt and pepper (to taste)",
    "8 ounce breakfast sausage",
    "3/4 cup red enchilada sauce",
    "1 1/2 cup cheddar cheese (shredded)"
  ],
  "instructions": [
    {
      "text": "Preheat a small skillet over medium heat. You’ll also want to preheat your oven to 400 degrees Fahrenheit.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-breakfast-enchiladas/#wprm-recipe-53211-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/11/keto-enchiladas-01.jpg"
    },
    {
      "text": "Add the eggs, heavy whipping cream, salt, garlic powder, chili powder, and black pepper to a bowl. Whisk together then grease the skillet with coconut oil.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-breakfast-enchiladas/#wprm-recipe-53211-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/11/keto-enchiladas-02.jpg"
    },
    {
      "text": "Pour 1/4 cup portions of the batter into the pan, then cover with a lid. Cook for 3-5 minutes or until cooked through. Repeat this step with the remaining batter to create the rest of the tortillas.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-breakfast-enchiladas/#wprm-recipe-53211-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/11/keto-enchiladas-03.jpg"
    },
    {
      "text": "Cook the ground sausage well then set aside.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-breakfast-enchiladas/#wprm-recipe-53211-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/11/keto-enchiladas-04.jpg"
    },
    {
      "text": "Add portions of the sausage and cheese to each tortilla. Roll them up and place them into a casserole dish.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-breakfast-enchiladas/#wprm-recipe-53211-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/11/keto-enchiladas-05.jpg"
    },
    {
      "text": "Pour the enchilada sauce on top, making sure to cover all the egg.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-breakfast-enchiladas/#wprm-recipe-53211-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/11/keto-enchiladas-06.jpg"
    },
    {
      "text": "Top with extra cheese then bake for 15 minutes or until melted and bubbly.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-breakfast-enchiladas/#wprm-recipe-53211-step-0-6",
      "imageSource": null
    }
  ],
