  "ingredients": [
    "2 large egg (seperated)",
    "1/2 cup egg white (or egg substitute*)",
    "1/2 cup buttermilk",
    "1 teaspoon vanilla extract",
    "1/4 cup coconut flour",
    "1 tablespoon low-carb protein powder (like isopure)",
    "1 teaspoon baking powder",
    "1/4 teaspoon ground cinnamon",
    "1 tablespoon stevia/erythritol blend",
    "cooking spray"
  ],
  "instructions": [
    {
      "text": "Beat the egg whites (from the whole eggs) with a pinch of salt until they have soft peaks. For the lazy (me), use a hand mixer with whisk attachment.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/fluffy-buttermilk-pancakes/#wprm-recipe-50323-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/10/Fluffy_Buttermilk_Pancakes-1.jpg"
    },
    {
      "text": "Mix the buttermilk, egg yolks, liquid egg whites, and vanilla extract in a bowl (make sure it is mixed well).",
      "group": "",
      "sourceUrl": "https://www.ruled.me/fluffy-buttermilk-pancakes/#wprm-recipe-50323-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/10/Fluffy_Buttermilk_Pancakes-2.jpg"
    },
    {
      "text": "In a separate bowl, whisk the coconut flour, protein powder, baking powder, and cinnamon. Add the dry ingredients to the wet and mix until combined!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/fluffy-buttermilk-pancakes/#wprm-recipe-50323-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/10/Fluffy_Buttermilk_Pancakes-5.jpg"
    },
    {
      "text": "Fold the whipped egg whites into the batter; make sure not to deflate the whites!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/fluffy-buttermilk-pancakes/#wprm-recipe-50323-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/10/Fluffy_Buttermilk_Pancakes-6.jpg"
    },
    {
      "text": "Preheat a nonstick skillet over medium-low heat. For each pancake, lightly grease the pan with butter. Then pour 1/4 cup of batter into the skillet, moving it slightly to distribute batter.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/fluffy-buttermilk-pancakes/#wprm-recipe-50323-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/10/Fluffy_Buttermilk_Pancakes-7.jpg"
    },
    {
      "text": "Cook until bubbles are visible on top, then flip the pancake over and cook until the other side is golden brown.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/fluffy-buttermilk-pancakes/#wprm-recipe-50323-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/10/Fluffy_Buttermilk_Pancakes-8.jpg"
    }
  ],
