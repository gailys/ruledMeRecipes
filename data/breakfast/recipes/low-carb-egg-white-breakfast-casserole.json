  "ingredients": [
    "16 ounce ground turkey",
    "1 medium red bell pepper (sliced)",
    "1 medium red onion (sliced)",
    "12 large egg white",
    "4 ounce cream cheese",
    "1 teaspoon garlic powder",
    "1 teaspoon onion powder",
    "salt and pepper (to taste)",
    "4 ounce shredded mozzarella"
  ],
  "instructions": [
    {
      "text": "Gather and prep all of your ingredients. Pre-heat oven to 350F.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-egg-white-breakfast-casserole/#wprm-recipe-57947-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2025/06/Egg-White-Breakfast-Casserole-1.jpg"
    },
    {
      "text": "At the bottom of a baking dish, press the sausage mixture into the bottom of the dish and then spread pepper and onion across the top.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-egg-white-breakfast-casserole/#wprm-recipe-57947-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2025/06/Egg-White-Breakfast-Casserole-2.jpg"
    },
    {
      "text": "Blend or whisk the egg whites, cream cheese, onion powder, garlic powder, and salt and pepper to taste.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-egg-white-breakfast-casserole/#wprm-recipe-57947-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2025/06/Egg-White-Breakfast-Casserole-3.jpg"
    },
    {
      "text": "Pour the egg white mixture over the top of the meat and vegetables.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-egg-white-breakfast-casserole/#wprm-recipe-57947-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2025/06/Egg-White-Breakfast-Casserole-4.jpg"
    },
    {
      "text": "Sprinkle the cheese over the top, then bake for 25-30 minutes or until golden brown around the edges and eggs are solidified.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-egg-white-breakfast-casserole/#wprm-recipe-57947-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2025/06/Egg-White-Breakfast-Casserole-5.jpg"
    },
    {
      "text": "Slice, serve, and enjoy! Optionally garnish with some chopped parsley if desired.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-egg-white-breakfast-casserole/#wprm-recipe-57947-step-0-5",
      "imageSource": null
