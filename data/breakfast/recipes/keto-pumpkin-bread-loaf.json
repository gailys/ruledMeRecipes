  "ingredients": [
    "1 1/2 cup almond flour",
    "1/4 cup psyllium husk powder",
    "1/4 cup stevia/erythritol blend (such as Swerve)",
    "1 1/2 teaspoon pumpkin pie spice",
    "2 teaspoon baking powder",
    "1/2 teaspoon kosher salt",
    "1/2 cup pumpkin puree",
    "1/2 cup unsweetened carton coconut milk",
    "3 large egg white"
  ],
  "instructions": [
    {
      "text": "Measure out the dry ingredients into a sifter.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pumpkin-bread-loaf/#wprm-recipe-51447-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/10/img_8123.jpg"
    },
    {
      "text": "Sift the ingredients into a large bowl. Preheat the oven to 350F. Fill a baking dish with about a cup of water and place it on the bottom rack of the oven.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pumpkin-bread-loaf/#wprm-recipe-51447-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/10/img_8128.jpg"
    },
    {
      "text": "Add the pumpkin puree and coconut milk and mix to form a sturdy dough.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pumpkin-bread-loaf/#wprm-recipe-51447-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/10/img_8133.jpg"
    },
    {
      "text": "Whip the egg whites in a separate bowl. If needed, add some cream of tartar to the egg whites to help keep them stable.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pumpkin-bread-loaf/#wprm-recipe-51447-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/10/img_8152.jpg"
    },
    {
      "text": "Aggressively fold one-third of the egg whites into the dough to get it to absorb some of the moisture. Then, add the rest of the egg whites and gently fold them into the dough.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pumpkin-bread-loaf/#wprm-recipe-51447-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/10/img_8159.jpg"
    },
    {
      "text": "Grease a standard loaf pan. Spread the dough into the pan.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pumpkin-bread-loaf/#wprm-recipe-51447-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/10/img_8162.jpg"
    },
    {
      "text": "Bake for 75 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pumpkin-bread-loaf/#wprm-recipe-51447-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/10/img_8172.jpg"
    },
    {
      "text": "Remove from the oven and let cool.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pumpkin-bread-loaf/#wprm-recipe-51447-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/10/img_8180.jpg"
    },
    {
      "text": "Slice and serve!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pumpkin-bread-loaf/#wprm-recipe-51447-step-0-8",
      "imageSource": null
    }
  ],
