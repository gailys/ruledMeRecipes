  "ingredients": [
    "2 tablespoon butter",
    "1/2 medium onion (diced)",
    "10 medium portobello mushrooms (sliced)",
    "8 ounce chorizo sausage",
    "1/3 cup heavy cream",
    "1 cup pepper jack cheese",
    "6 large egg",
    "1 tablespoon sriracha",
    "1/3 cup cheddar cheese (shredded)"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all of the ingredients. Preheat oven to 400F.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/baked-eggs-and-chorizo-pepperjack-cheese/#wprm-recipe-60252-step-0-0",
      "imageSource": null
    },
    {
      "text": "In a frying pan over medium heat, melt the butter and add the diced onion. Let cook for 30 seconds - 1 minute. Then add in the sliced mushrooms.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/baked-eggs-and-chorizo-pepperjack-cheese/#wprm-recipe-60252-step-0-1",
      "imageSource": null
    },
    {
      "text": "Add in the chorizo sausage. Stir and let cook until it gets crumbly. Once the chorizo is cooked, remove from heat.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/baked-eggs-and-chorizo-pepperjack-cheese/#wprm-recipe-60252-step-0-2",
      "imageSource": null
    },
    {
      "text": "Stir in the heavy cream and add in the pepper jack cheese. Create wells in the skillet and then crack the eggs into those wells.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/baked-eggs-and-chorizo-pepperjack-cheese/#wprm-recipe-60252-step-0-3",
      "imageSource": null
    },
    {
      "text": "Top with the sriracha sauce then the add the shredded cheese. Place in the oven for 15 minutes or until the eggs are done.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/baked-eggs-and-chorizo-pepperjack-cheese/#wprm-recipe-60252-step-0-4",
      "imageSource": null
    },
    {
      "text": "Serve hot and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/baked-eggs-and-chorizo-pepperjack-cheese/#wprm-recipe-60252-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/05/baked-eggs-and-chorizo-pepperjack-cheese-step-01.jpeg"
    }
  ],
