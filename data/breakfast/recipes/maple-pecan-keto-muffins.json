  "ingredients": [
    "3/4 cup pecans",
    "2 large egg",
    "1/2 cup coconut oil",
    "2 teaspoon maple extract",
    "1 teaspoon vanilla extract",
    "1/2 teaspoon apple cider vinegar",
    "1/4 teaspoon liquid stevia",
    "1 cup almond flour",
    "1/2 cup flaxseed meal",
    "1/4 cup erythritol",
    "1/2 teaspoon baking soda"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 325F. Add the pecans to a food processor and process them until roughly chopped.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/maple-pecan-keto-muffins/#wprm-recipe-50953-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_5570.jpg"
    },
    {
      "text": "In a large mixing bowl, add the eggs, coconut oil, maple extract, vanilla, apple cider vinegar, and liquid stevia. Mix well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/maple-pecan-keto-muffins/#wprm-recipe-50953-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_5572.jpg"
    },
    {
      "text": "In a separate bowl, add about two-thirds of the chopped pecans, almond flour, flaxseed meal, erythritol, and baking soda. Mix well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/maple-pecan-keto-muffins/#wprm-recipe-50953-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_5576.jpg"
    },
    {
      "text": "Pour the wet ingredients into the dry ingredients. Note: The wet ingredients will be lumpy if the eggs are cold rather than room temperature. If the batter is wet and chunky, it's from the solidified bits of coconut oil — no need to worry about this.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/maple-pecan-keto-muffins/#wprm-recipe-50953-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_5591.jpg"
    },
    {
      "text": "Mix the ingredients to form a batter.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/maple-pecan-keto-muffins/#wprm-recipe-50953-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_5594.jpg"
    },
    {
      "text": "Distribute the batter evenly in a lined cupcake tray.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/maple-pecan-keto-muffins/#wprm-recipe-50953-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_5607.jpg"
    },
    {
      "text": "Sprinkle the remaining chopped pecans on top of the muffins.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/maple-pecan-keto-muffins/#wprm-recipe-50953-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_5614.jpg"
    },
    {
      "text": "Bake for 25–30 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/maple-pecan-keto-muffins/#wprm-recipe-50953-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_5620.jpg"
    },
    {
      "text": "Remove and let cool for 5–10 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/maple-pecan-keto-muffins/#wprm-recipe-50953-step-0-8",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_5625.jpg"
    },
    {
      "text": "Serve warm! These also keep very well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/maple-pecan-keto-muffins/#wprm-recipe-50953-step-0-9",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/MaplePecanBig2.jpg"
    }
  ],
