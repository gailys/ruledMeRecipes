  "ingredients": [
    "1 cup almond flour",
    "1/2 cup unflavored low-carb protein powder",
    "3 tablespoon allulose",
    "1 teaspoon baking powder",
    "1/2 teaspoon xanthan gum",
    "1 cup cottage cheese",
    "3 large egg",
    "2 teaspoon lemon zest",
    "1 teaspoon vanilla extract",
    "2 tablespoon lemon juice",
    "2 tablespoon butter (for greasing pan)"
  ],
  "instructions": [
    {
      "text": "Gather and prep all of your ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cottage-cheese-pancakes/#wprm-recipe-58011-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2025/07/Cottage-Cheese-Pancakes-1.jpg"
    },
    {
      "text": "In a bowl, whisk together almond flour, protein powder, allulose, baking powder, and xanthan gum. Break up any clumps.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cottage-cheese-pancakes/#wprm-recipe-58011-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2025/07/Cottage-Cheese-Pancakes-2.jpg"
    },
    {
      "text": "In a blender, combine the cottage cheese, eggs, and vanilla extract. Once smooth, add in the lemon zest and blend again.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cottage-cheese-pancakes/#wprm-recipe-58011-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2025/07/Cottage-Cheese-Pancakes-3.jpg"
    },
    {
      "text": "Slowly add lemon juice into the batter until just scoopable. Pre-heat pan or griddle over medium heat and brush with oil or butter. Once hot, create pancakes about 4 inches in diameter. Cook until edges are set and bubbles are forming on the top. About 2-4 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cottage-cheese-pancakes/#wprm-recipe-58011-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2025/07/Cottage-Cheese-Pancakes-5.jpg"
    },
    {
      "text": "Flip and continue to cook until bottom is golden brown, about 2 more minutes. Repeat the process with remaining batter, adding more oil or butter to pan as needed.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cottage-cheese-pancakes/#wprm-recipe-58011-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2025/07/Cottage-Cheese-Pancakes-6.jpg"
    },
    {
      "text": "Serve warm with additional lemon and optionally topped with powdered allulose. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cottage-cheese-pancakes/#wprm-recipe-58011-step-0-5",
      "imageSource": null
    }
  ],
