  "ingredients": [
    "2 tablespoon olive oil",
    "3 medium egg",
    "3/4 cup swiss cheese (shredded)",
    "salt and pepper (to taste)",
    "3 tablespoon mayonnaise",
    "2 teaspoon tomato paste",
    "1 teaspoon dijon mustard",
    "3/4 teaspoon onion powder",
    "1/2 teaspoon hot sauce",
    "4 ounce pastrami (deli sliced)",
    "2 slice swiss cheese",
    "1/2 cup sauerkraut"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all the ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-reuben-chaffle/#wprm-recipe-54099-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/01/Keto-Reuben-Chaffles-1.jpg"
    },
    {
      "text": "Using olive oil, grease a waffle maker.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-reuben-chaffle/#wprm-recipe-54099-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/01/Keto-Reuben-Chaffles-2.jpg"
    },
    {
      "text": "Grab a baking sheet and lay a wire rack over the baking sheet.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-reuben-chaffle/#wprm-recipe-54099-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/01/Keto-Reuben-Chaffles-3.jpg"
    },
    {
      "text": "In a bowl, mix together the eggs and Swiss cheese.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-reuben-chaffle/#wprm-recipe-54099-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/01/Keto-Reuben-Chaffles-4.jpg"
    },
    {
      "text": "In another bowl mix together the mayonnaise, tomato paste, dijon mustard, onion powder, hot sauce, and salt and pepper. Set this dressing aside.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-reuben-chaffle/#wprm-recipe-54099-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/01/Keto-Reuben-Chaffles-5.jpg"
    },
    {
      "text": "Pour the chaffle mix into the waffle maker. Bake using the instructions and timer on the waffle maker or until golden brown.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-reuben-chaffle/#wprm-recipe-54099-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/01/Keto-Reuben-Chaffles-6.jpg"
    },
    {
      "text": "Transfer to the cooling rack and let cool for 3-5 minutes. Cut the chaffles. Preheat oven to 350F.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-reuben-chaffle/#wprm-recipe-54099-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/01/Keto-Reuben-Chaffles-7.jpg"
    },
    {
      "text": "Lay the pastrami slices and the Swiss cheese slices on half of the chaffles. Top with the other half of the chaffle.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-reuben-chaffle/#wprm-recipe-54099-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/01/Keto-Reuben-Chaffles-8.jpg"
    },
    {
      "text": "Let bake in the oven for 3-5 minutes or until the cheese starts to melt.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-reuben-chaffle/#wprm-recipe-54099-step-0-8",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/01/Keto-Reuben-Chaffles-9.jpg"
    },
    {
      "text": "Top the chaffles with the dressing and saukerkraut. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-reuben-chaffle/#wprm-recipe-54099-step-0-9",
      "imageSource": null
    }
  ],
