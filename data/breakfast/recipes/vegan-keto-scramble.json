  "ingredients": [
    "14 ounce extra firm tofu",
    "3 tablespoon avocado oil",
    "2 tablespoon yellow onion (diced)",
    "1 1/2 tablespoon nutritional yeast",
    "1/2 teaspoon garlic powder",
    "1/2 teaspoon turmeric powder",
    "salt (to taste)",
    "1 cup baby spinach",
    "3 medium cherry tomatoes (diced)",
    "3 ounce vegan cheese substitute (grated or diced)"
  ],
  "instructions": [
    {
      "text": "Wrap your block of tofu in a few layers of paper towel, or a clean cloth towel, and gently squeeze some of the water out. Set aside.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/vegan-keto-scramble/#wprm-recipe-52710-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/09/vegan-keto-scrambled-eggs-01.jpg"
    },
    {
      "text": "In a skillet on medium heat, sauté the chopped onion in 1/3 of the avocado oil until the onion is soft and translucent.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/vegan-keto-scramble/#wprm-recipe-52710-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/09/vegan-keto-scrambled-eggs-03.jpg"
    },
    {
      "text": "Place the block of tofu in the skillet and crumble using a potato masher or fork until it’s the consistency of scrambled egg.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/vegan-keto-scramble/#wprm-recipe-52710-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/09/vegan-keto-scrambled-eggs-04.jpg"
    },
    {
      "text": "Drizzle with the rest of the oil and sprinkle with the dry seasonings, then gently stir to coat.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/vegan-keto-scramble/#wprm-recipe-52710-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/09/vegan-keto-scrambled-eggs-05.jpg"
    },
    {
      "text": "Cook the tofu over medium heat, stirring and folding occasionally until most of the liquid has evaporated.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/vegan-keto-scramble/#wprm-recipe-52710-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/09/vegan-keto-scrambled-eggs-06.jpg"
    },
    {
      "text": "Fold in the baby spinach, diced tomato and cheese and cook for an additional minute or until the spinach wilts and the cheese is melted.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/vegan-keto-scramble/#wprm-recipe-52710-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/09/vegan-keto-scrambled-eggs-07.jpg"
    },
    {
      "text": "Serve hot and store leftovers in the refrigerator for up to three days!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/vegan-keto-scramble/#wprm-recipe-52710-step-0-6",
      "imageSource": null
    }
  ],
