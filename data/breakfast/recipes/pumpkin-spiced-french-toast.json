  "ingredients": [
    "4 slices pumpkin bread (recipe here)",
    "1 large egg",
    "2 tablespoons cream",
    "½ teaspoon vanilla extract",
    "1/8 teaspoon orange extract",
    "¼ teaspoon pumpkin pie spice (recipe here)",
    "2 tablespoons butter"
  ],
  "instructions": [
    {
      "text": "Let the bread dry out overnight in open air after you have sliced it.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/pumpkin-spiced-french-toast/#wprm-recipe-51443-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/10/img_8297.jpg"
    },
    {
      "text": "Mix together egg, extracts, and pumpkin pie spice. Let the bread soak on both sides in the mixture.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/pumpkin-spiced-french-toast/#wprm-recipe-51443-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/10/img_8300.jpg"
    },
    {
      "text": "Heat butter in pan until almost browned, then add bread slices. Flip when browned and continue to cook until browned on both sides.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/pumpkin-spiced-french-toast/#wprm-recipe-51443-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/10/img_8316.jpg"
    },
    {
      "text": "Serve with keto maple syrup (recipe here) and some extra powdered swerve.",
