  "instructions": [
    {
      "text": "Gather and prep all of your ingredients. Pre-heat oven to 400F.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/any-time-keto-breakfast-casserole/#wprm-recipe-56770-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/06/Any-time-Keto-Breakfast-Casserole-1.jpg"
    },
    {
      "text": "Place the onion and sausage into a baking tray and drizzle the olive oil over everything (making sure to grease the tray). Bake for 15 minutes, turning the sausages half way through.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/any-time-keto-breakfast-casserole/#wprm-recipe-56770-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/06/Any-time-Keto-Breakfast-Casserole-2.jpg"
    },
    {
      "text": "Remove the sausages from the baking tray, then place the cabbage, mushrooms, spinach, tomatoes, and parsley into it. Season with salt and pepper to taste.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/any-time-keto-breakfast-casserole/#wprm-recipe-56770-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/06/Any-time-Keto-Breakfast-Casserole-3.jpg"
    },
    {
      "text": "Place the sausages back on the top, then return to the oven for 20 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/any-time-keto-breakfast-casserole/#wprm-recipe-56770-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/06/Any-time-Keto-Breakfast-Casserole-4.jpg"
    },
    {
      "text": "Remove from the oven to let cool for a few minutes. Garnish with parsley.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/any-time-keto-breakfast-casserole/#wprm-recipe-56770-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/06/Any-time-Keto-Breakfast-Casserole-5.jpg"
    },
    {
      "text": "Serve immediately and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/any-time-keto-breakfast-casserole/#wprm-recipe-56770-step-0-5",
