  ],
  "instructions": [
    {
      "text": "Crack the eggs open into a mixing bowl. Season with salt and pepper then whisk together. Stir in the basil.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-caprese-omelet/#wprm-recipe-58766-step-0-0",
