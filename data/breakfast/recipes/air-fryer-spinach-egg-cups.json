  "ingredients": [
    "4 ounce frozen spinach (thawed with excess water squeezed out)",
    "1 ounce feta cheese (crumbled)",
    "2 large egg",
    "2 teaspoon olive oil",
    "salt and pepper (to taste)"
  ],
  "instructions": [
    {
      "text": "Gather and prep all of your ingredients. If your spinach is frozen, you can thaw in the microwave and squeeze excess water out.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/air-fryer-spinach-egg-cups/#wprm-recipe-56964-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/06/Air-Fryer-Spinach-Egg-Cups-1.jpg"
    },
    {
      "text": "Scramble eggs in a bowl (or just use the cup/ramekin you plan to cook it in).",
      "group": "",
      "sourceUrl": "https://www.ruled.me/air-fryer-spinach-egg-cups/#wprm-recipe-56964-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/06/Air-Fryer-Spinach-Egg-Cups-2.jpg"
    },
    {
      "text": "Add the olive oil and spinach to a ramekin or cup, then season with salt and pepper. Pour the egg over the spinach and lightly stir.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/air-fryer-spinach-egg-cups/#wprm-recipe-56964-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/06/Air-Fryer-Spinach-Egg-Cups-3.jpg"
    },
    {
      "text": "Top the egg cup with crumbled feta cheese.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/air-fryer-spinach-egg-cups/#wprm-recipe-56964-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/06/Air-Fryer-Spinach-Egg-Cups-4.jpg"
    },
    {
      "text": "Place into the air fryer and cook at 400F for 7-9 minutes depending on the doneness you prefer.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/air-fryer-spinach-egg-cups/#wprm-recipe-56964-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/06/Air-Fryer-Spinach-Egg-Cups-5.jpg"
    },
    {
      "text": "Allow to cool for a minute or two, then serve and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/air-fryer-spinach-egg-cups/#wprm-recipe-56964-step-0-5",
      "imageSource": null
    }
