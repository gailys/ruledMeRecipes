  "ingredients": [
    "3 ounce cream cheese",
    "3 large egg",
    "1 tablespoon coconut flour",
    "1 teaspoon psyllium husk powder",
    "1 teaspoon baking powder",
    "salt and pepper (to taste)",
    "1 ounce cheddar cheese",
    "1 medium jalapeno pepper"
  ],
  "instructions": [
    {
      "text": "Using an immersion blender, combine all ingredients except for the cheese and jalapeño.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/jalapeno-cheddar-waffles/#wprm-recipe-51733-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/06/img_7715.jpg"
    },
    {
      "text": "Once the ingredients are thoroughly combined, add the cheese and jalapeño.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/jalapeno-cheddar-waffles/#wprm-recipe-51733-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/06/img_7721.jpg"
    },
    {
      "text": "Use the immersion blender again to make sure that all of the ingredients are mixed well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/jalapeno-cheddar-waffles/#wprm-recipe-51733-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/06/img_7723.jpg"
    },
    {
      "text": "Heat up the waffle iron and pour the batter to cook — mine took about 5–6 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/jalapeno-cheddar-waffles/#wprm-recipe-51733-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/06/img_7728.jpg"
    },
    {
