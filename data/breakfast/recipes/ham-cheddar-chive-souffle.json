  "ingredients": [
    "6 ounce cooked ham",
    "1/2 medium onion",
    "1 1/2 teaspoon fresh garlic",
    "1 cup cheddar cheese",
    "2 tablespoon fresh chives",
    "3 tablespoon olive oil",
    "6 large egg",
    "1/2 cup heavy whipping cream",
    "1/2 teaspoon salt",
    "1/4 teaspoon black pepper",
    "1 tablespoon butter (to grease ramekins)"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 400F. Grease the ramekins with the butter. Prep all of the ingredients. Cube the ham steak, dice the onion, mince the garlic, grate the cheese, and chop the fresh chives.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/ham-cheddar-chive-souffle/#wprm-recipe-51277-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/08/img_09841.jpg"
    },
    {
      "text": "Heat up the olive oil in a pan. Once hot, add onions and sauté until soft.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/ham-cheddar-chive-souffle/#wprm-recipe-51277-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/08/img_0992.jpg"
    },
    {
      "text": "Once soft, add the garlic and sauté until lightly browned.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/ham-cheddar-chive-souffle/#wprm-recipe-51277-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/08/img_1000.jpg"
    },
    {
      "text": "In a bowl, mix the eggs, heavy cream, chopped chives, salt, and pepper.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/ham-cheddar-chive-souffle/#wprm-recipe-51277-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/08/img_1002.jpg"
    },
    {
      "text": "Add all of the other ingredients, including the onion and garlic from the pan. Mix well. Pour the batter into the greased ramekins.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/ham-cheddar-chive-souffle/#wprm-recipe-51277-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/08/img_1008.jpg"
    },
    {
      "text": "Bake for 20 minutes or until puffed and lightly browned on the top. Let cool slightly before serving.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/ham-cheddar-chive-souffle/#wprm-recipe-51277-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/08/img_1019.jpg"
    },
    {
      "text": "Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/ham-cheddar-chive-souffle/#wprm-recipe-51277-step-0-6",
