  "ingredients": [
    "3 medium green onion",
    "14 ounce can hearts of palm",
    "2 tablespoon italian seasoning",
    "1/2 cup parmesan cheese",
    "1/4 cup mayonnaise",
    "1 large egg",
    "1 large egg yolk",
    "1/4 cup parmesan cheese"
  ],
  "instructions": [
    {
      "text": "Gather all ingredients. Heat oven to 350F and prepare a small baking dish with nonstick spray.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cheesy-hearts-palm-dip/#wprm-recipe-52349-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/09/hearts-of-palm-dip-00.jpg"
    },
    {
      "text": "Chop the bulbs of your green onion and drain your hearts of palm. It is not necessary to cut the palm before adding it to your food processor but it can help if you have an older or less powerful model.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cheesy-hearts-palm-dip/#wprm-recipe-52349-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/09/hearts-of-palm-dip-01.jpg"
    },
    {
      "text": "Combine hearts of palm, onion, seasoning, Parmesan cheese, and mayo in the food processor. Pulse until the mixture is chopped well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cheesy-hearts-palm-dip/#wprm-recipe-52349-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/09/hearts-of-palm-dip-02.jpg"
    },
    {
      "text": "Add the egg and additional egg yolk to the processor. Pulse three to four times to combine.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cheesy-hearts-palm-dip/#wprm-recipe-52349-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/09/hearts-of-palm-dip-03.jpg"
    },
    {
      "text": "Pour the dip into the prepared baking dish and cook for 15 – 20 minutes or until the mixture begins to puff up slightly. Stir and top with more Parmesan cheese.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cheesy-hearts-palm-dip/#wprm-recipe-52349-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/09/hearts-of-palm-dip-04.jpg"
    },
    {
      "text": "Broil until the topping is melted and begins to brown. Serve hot with veggies or keto crackers!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cheesy-hearts-palm-dip/#wprm-recipe-52349-step-0-5",
      "imageSource": null
    }
  ],
