  "ingredients": [
    "4 large dill pickle",
    "4 tablespoon mayonnaise",
    "1 1/2 teaspoon yellow mustard",
    "2 ounce deli sliced turkey",
    "2 ounce italian dry salami",
    "1 medium fresh tomatoes (sliced)",
    "2 ounce iceberg lettuce",
    "2 ounce cheddar cheese",
    "1/4 medium red onion (sliced)",
    "salt and pepper (to taste)"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all the ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pickle-sandwiches/#wprm-recipe-53577-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/11/Pickle-Sandwiches-1.jpg"
    },
    {
      "text": "Cut each pickle in half, lengthwise. Scoop out the seeds of the pickle and then some so it makes a little boat where you can easily put the mayonnaise and mustard without it squeezing out the sides of the sandwich.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pickle-sandwiches/#wprm-recipe-53577-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/11/Pickle-Sandwiches-2.jpg"
    },
    {
      "text": "In a bowl, mix the mayonnaise and mustard together. Put this on one side of the pickle, where you scooped the seeds out from.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pickle-sandwiches/#wprm-recipe-53577-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/11/Pickle-Sandwiches-3.jpg"
    },
    {
      "text": "Place the turkey, salami, tomato slices, lettuce leaves, cheese, and onion on top of the sauce. Season with salt and pepper to taste.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pickle-sandwiches/#wprm-recipe-53577-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/11/Pickle-Sandwiches-4.jpg"
    },
    {
      "text": "Place the other half of the pickle on top. Secure it down with a toothpick, and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pickle-sandwiches/#wprm-recipe-53577-step-0-4",
      "imageSource": null
    }
