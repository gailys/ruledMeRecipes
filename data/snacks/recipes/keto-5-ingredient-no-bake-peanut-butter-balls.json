  "instructions": [
    {
      "text": "Gather and prep all ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-5-ingredient-no-bake-peanut-butter-balls/#wprm-recipe-55024-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/05/Keto-No-Bake-Peanut-Butter-Energy-Balls-1.jpg"
    },
    {
      "text": "Add the peanut butter, protein powder, allulose, and vanilla extract to a food processor.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-5-ingredient-no-bake-peanut-butter-balls/#wprm-recipe-55024-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/05/Keto-No-Bake-Peanut-Butter-Energy-Balls-2.jpg"
    },
    {
      "text": "Blend the mixture until smooth and any lumps removed, scraping down the sides as needed. The mixture should be dense and able to form balls with. If the mixture is too thick, you can add a bit of unsweetened almond milk to help thin it out.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-5-ingredient-no-bake-peanut-butter-balls/#wprm-recipe-55024-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/05/Keto-No-Bake-Peanut-Butter-Energy-Balls-3.jpg"
    },
    {
      "text": "Place the mixture into the freezer for 10-15 minutes to make firm and less sticky. Then, use a spoon to scoop out the mixture and form into ~1 inch balls.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-5-ingredient-no-bake-peanut-butter-balls/#wprm-recipe-55024-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/05/Keto-No-Bake-Peanut-Butter-Energy-Balls-4.jpg"
    },
    {
      "text": "Roll the balls into the chopped peanuts, evenly coating the outside. You may need to press the peanuts into the balls but you can re-shape as needed.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-5-ingredient-no-bake-peanut-butter-balls/#wprm-recipe-55024-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/05/Keto-No-Bake-Peanut-Butter-Energy-Balls-5.jpg"
    },
    {
      "text": "Enjoy immediately, or store in an air-tight container in the refrigerator for up to 2 weeks.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-5-ingredient-no-bake-peanut-butter-balls/#wprm-recipe-55024-step-0-5",
