  "ingredients": [
    "4 tablespoon chia seeds",
    "1/2 cup water",
    "1 cup unsweetened shredded coconut",
    "1 tablespoon coconut oil",
    "1 tablespoon powdered stevia/erythritol blend",
    "1/4 teaspoon vanilla extract",
    "1/2 cup pecans"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all the ingredients. Preheat the oven to 350F.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-coconut-pecan-chia-bars/#wprm-recipe-53521-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/10/Coconut-Chia-Bars-1.jpg"
    },
    {
      "text": "In a bowl combine the chia seeds and water and let it sit until it becomes thick, about 15 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-coconut-pecan-chia-bars/#wprm-recipe-53521-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/10/Coconut-Chia-Bars-2.jpg"
    },
    {
      "text": "In another bowl, mix together the soaked chia seeds, unsweetened shredded coconut, coconut oil, sweetener, and vanilla extract. Stir until combined well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-coconut-pecan-chia-bars/#wprm-recipe-53521-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/10/Coconut-Chia-Bars-3.jpg"
    },
    {
      "text": "Gently stir in the pecans.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-coconut-pecan-chia-bars/#wprm-recipe-53521-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/10/Coconut-Chia-Bars-4.jpg"
    },
    {
      "text": "Line a pan with parchment paper.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-coconut-pecan-chia-bars/#wprm-recipe-53521-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/10/Coconut-Chia-Bars-5.png"
    },
    {
      "text": "Pour the mixture into the parchment-lined baking pan, and spread evenly. It should be about 3/4\" thick.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-coconut-pecan-chia-bars/#wprm-recipe-53521-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/10/Coconut-Chia-Bars-6.jpg"
    },
    {
      "text": "Put in the oven for 40-45 minutes or until the edges become golden brown.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-coconut-pecan-chia-bars/#wprm-recipe-53521-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/10/Coconut-Chia-Bars-7.jpg"
    },
    {
      "text": "Let cool in the pan before slicing and serving.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-coconut-pecan-chia-bars/#wprm-recipe-53521-step-0-7",
      "imageSource": null
    }
  ],
