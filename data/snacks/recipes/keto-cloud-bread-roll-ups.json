  ],
  "instructions": [
    {
      "text": "Measure out and prepare all the ingredients. Preheat oven to 350F.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cloud-bread-roll-ups/#wprm-recipe-54053-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/12/Keto-Cloud-Bread-Roll-Ups-1.jpg"
    },
    {
      "text": "In a bowl, beat the egg whites until they get really fluffy.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cloud-bread-roll-ups/#wprm-recipe-54053-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/12/Keto-Cloud-Bread-Roll-Ups-2.jpg"
    },
    {
      "text": "In a separate bowl, add the egg yolks and cream cheese. Mix together well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cloud-bread-roll-ups/#wprm-recipe-54053-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/12/Keto-Cloud-Bread-Roll-Ups-3.jpg"
    },
    {
      "text": "Carefully add the egg yolk and cream cheese mixture into the egg whites. Fold them into each other gently.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cloud-bread-roll-ups/#wprm-recipe-54053-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/12/Keto-Cloud-Bread-Roll-Ups-4.jpg"
    },
    {
      "text": "Line a baking sheet with parchment paper. Spread out the mixture into an even rectangular.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cloud-bread-roll-ups/#wprm-recipe-54053-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/12/Keto-Cloud-Bread-Roll-Ups-5.jpg"
    },
    {
      "text": "Bake in the oven for about 15 minutes or until golden brown in color.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cloud-bread-roll-ups/#wprm-recipe-54053-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/12/Keto-Cloud-Bread-Roll-Ups-6.jpg"
    },
    {
      "text": "Place the cheddar cheese and the salami evenly on the egg base and roll it up immediately after coming out of the oven.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cloud-bread-roll-ups/#wprm-recipe-54053-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/12/Keto-Cloud-Bread-Roll-Ups-7.jpg"
    },
    {
      "text": "Cut it into even slices. Serve and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cloud-bread-roll-ups/#wprm-recipe-54053-step-0-7",
      "imageSource": null
    }
  ],
