  "ingredients": [
    "2 ounce bacon",
    "5 large hard-boiled egg",
    "1/4 cup mayonnaise",
    "1 teaspoon dijon mustard",
    "1/4 teaspoon cayenne pepper",
    "1/2 teaspoon dried rosemary"
  ],
  "instructions": [
    {
      "text": "Cut the bacon into thin slices and place in a pan on medium heat.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/spiced-bacon-deviled-eggs/#wprm-recipe-50589-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/12/spiced_bacon_deviled_eggs-1a.jpg"
    },
    {
      "text": "Let the bacon cook over medium heat until nice and extra crispy.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/spiced-bacon-deviled-eggs/#wprm-recipe-50589-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/12/spiced_bacon_deviled_eggs-1b.jpg"
    },
    {
      "text": "Remove the bacon, leaving as much of the drippings in the pan as possible. Rest the bacon on paper towels to allow it to cool off and get even crispier.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/spiced-bacon-deviled-eggs/#wprm-recipe-50589-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/12/spiced_bacon_deviled_eggs-1e.jpg"
    },
    {
      "text": "Slice the hardboiled eggs in half.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/spiced-bacon-deviled-eggs/#wprm-recipe-50589-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/12/spiced_bacon_deviled_eggs-2.jpg"
    },
    {
      "text": "Scoop out the yolks, taking care not to break the egg whites.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/spiced-bacon-deviled-eggs/#wprm-recipe-50589-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/12/spiced_bacon_deviled_eggs-3.jpg"
    },
    {
      "text": "Place the yolks in a bowl.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/spiced-bacon-deviled-eggs/#wprm-recipe-50589-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/12/spiced_bacon_deviled_eggs-4.jpg"
    },
    {
      "text": "Add in the mayonnaise, Dijon mustard, cayenne pepper, bacon fat, and half of the rosemary, reserving the rest for garnish.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/spiced-bacon-deviled-eggs/#wprm-recipe-50589-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/12/spiced_bacon_deviled_eggs-5.jpg"
    },
    {
      "text": "Add several small pieces of bacon to the bottom of the empty egg whites.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/spiced-bacon-deviled-eggs/#wprm-recipe-50589-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/12/spiced_bacon_deviled_eggs-7.jpg"
    },
    {
      "text": "Mix all of filling ingredients together in the bowl. Add the mixture to a Ziploc bag and cut off a corner to use it as a piping tool.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/spiced-bacon-deviled-eggs/#wprm-recipe-50589-step-0-8",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/12/spiced_bacon_deviled_eggs-8.jpg"
    },
    {
      "text": "Pipe the mixture on the top of the eggs. Garnish with the rosemary and any remaining bacon. Serve and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/spiced-bacon-deviled-eggs/#wprm-recipe-50589-step-0-9",
      "imageSource": null
    }
  ],
