  "ingredients": [
    "3/4 cup almond flour",
    "1 teaspoon baking powder",
    "2 cup mozzarella cheese (shredded)",
    "230 gram brie cheese",
    "1/4 cup cremini mushrooms (chopped and sauteed)",
    "2 slice cooked bacon (Chopped)",
    "1 tablespoon butter (melted)"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 350F. In a bowl, mix the almond flour and baking powder.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/baked-brie-with-a-keto-crust/#wprm-recipe-52607-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/05/keto-baked-brie-01.jpg"
    },
    {
      "text": "In a separate microwavable bowl, melt the mozzarella cheese.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/baked-brie-with-a-keto-crust/#wprm-recipe-52607-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/05/keto-baked-brie-02.jpg"
    },
    {
      "text": "Mix the mozzarella and almond flour until it has the consistency of a dough.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/baked-brie-with-a-keto-crust/#wprm-recipe-52607-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/05/keto-baked-brie-04.jpg"
    },
    {
      "text": "Quickly place the dough between two pieces of parchment paper and roll it into a circle using a rolling pin.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/baked-brie-with-a-keto-crust/#wprm-recipe-52607-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/05/keto-baked-brie-06.jpg"
    },
    {
      "text": "Remove top parchment and place the brie cheese in the center of the dough.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/baked-brie-with-a-keto-crust/#wprm-recipe-52607-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/05/keto-baked-brie-07.jpg"
    },
    {
      "text": "Top the brie with the mushrooms and bacon. Using a knife, make an angular cut in the dough from the brie to the outside. Make similar cuts around the entire brick of cheese.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/baked-brie-with-a-keto-crust/#wprm-recipe-52607-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/05/keto-baked-brie-09.jpg"
    },
    {
      "text": "Take an individual piece of dough and bring it up onto the top of the brie/mushrooms/bacon. Continue wrapping the brie with the pieces of dough until fully covered.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/baked-brie-with-a-keto-crust/#wprm-recipe-52607-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/05/keto-baked-brie-10.jpg"
    },
    {
      "text": "Once the entire brick of brie is covered, transfer parchment paper with brie to baking sheet and brush melted butter over the entire dough.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/baked-brie-with-a-keto-crust/#wprm-recipe-52607-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/05/keto-baked-brie-11.jpg"
    },
    {
      "text": "Bake for 30 minutes or until the dough has become a nice golden brown.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/baked-brie-with-a-keto-crust/#wprm-recipe-52607-step-0-8",
      "imageSource": null
    }
  ],
