  "ingredients": [
    "1 1/4 cup almond flour",
    "1/4 teaspoon black pepper",
    "1/2 teaspoon salt",
    "1/2 teaspoon baking powder",
    "1/4 teaspoon dried basil",
    "1/8 teaspoon cayenne pepper",
    "1 teaspoon fresh garlic (pressed)",
    "2 tablespoon pesto",
    "3 tablespoon butter"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 325F. Line a cookie sheet with parchment paper. In a medium bowl, combine the almond flour, pepper, salt, and baking powder. Whisk until smooth.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/pesto-keto-crackers/#wprm-recipe-52003-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/12/keto_pesto_crackers_01.jpg"
    },
    {
      "text": "Add in the basil, cayenne, and garlic, stirring until evenly combined.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/pesto-keto-crackers/#wprm-recipe-52003-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/12/keto_pesto_crackers_02.jpg"
    },
    {
      "text": "Next, add in the pesto and whisk until the dough forms into coarse crumbs.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/pesto-keto-crackers/#wprm-recipe-52003-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/12/keto_pesto_crackers_03.jpg"
    },
    {
      "text": "Cut the butter into the cracker mixture with a fork and combine until the dough forms into a ball.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/pesto-keto-crackers/#wprm-recipe-52003-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/12/keto_pesto_crackers_06.jpg"
    },
    {
      "text": "Transfer the dough onto the prepared cookie sheet and spread it out thinly, until it's about 1 1/2-mm thick. Try and make the thickness consistent throughout to help the crackers bake evenly.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/pesto-keto-crackers/#wprm-recipe-52003-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/12/keto_pesto_crackers_07.jpg"
    },
    {
      "text": "Bake for 14–17 minutes or until light golden brown in color.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/pesto-keto-crackers/#wprm-recipe-52003-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/12/keto_pesto_crackers_08.jpg"
    },
    {
      "text": "Remove from the oven once finished baking.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/pesto-keto-crackers/#wprm-recipe-52003-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/12/keto_pesto_crackers_09.jpg"
    },
    {
      "text": "Cut the crackers, serve, and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/pesto-keto-crackers/#wprm-recipe-52003-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/12/keto_pesto_crackers_pin.jpg"
    }
  ],
