    "fatGrams": 17
  },
  "ingredients": [
    "6 large egg",
    "1 1/4 cup water",
    "1/2 cup soy sauce (or coconut aminos)",
    "1/4 cup unseasoned rice vinegar",
    "1 teaspoon liquid stevia",
    "2 teaspoon fresh garlic (grated)",
    "4 ounce cream cheese (softened)",
    "1 tablespoon fresh chives (chopped)",
    "salt and pepper (to taste)"
  ],
  "instructions": [
    {
      "text": "Place the eggs in a pot and cover with water. Bring to a boil and cover the pot with a lid. Reduce the heat to the very low and let cook for 7 minutes. Pour out the water and peel the eggs under cold running water. Set the eggs aside.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/soy-sauce-marinated-deviled-eggs/#wprm-recipe-52143-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/03/IMG_1012.jpg"
    },
    {
      "text": "In a large bowl, mix together four-fifths of the water with the soy sauce, rice wine vinegar, stevia, and garlic.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/soy-sauce-marinated-deviled-eggs/#wprm-recipe-52143-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/03/IMG_1021.jpg"
    },
    {
      "text": "Place the eggs in the bowl and cover with a few paper towels. Allow the paper towels to soak up the marinade so that the eggs are weighted down into the mixture while also being marinated on the tops.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/soy-sauce-marinated-deviled-eggs/#wprm-recipe-52143-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/03/IMG_1033.jpg"
    },
    {
      "text": "Let the eggs marinate in the fridge for 2 hours, periodically rotating them to ensure they are evenly coated.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/soy-sauce-marinated-deviled-eggs/#wprm-recipe-52143-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/03/IMG_1054.jpg"
    },
    {
      "text": "Pat the eggs dry and cut them in half. Remove the yolks, reserving them for the next step, and set the whites aside.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/soy-sauce-marinated-deviled-eggs/#wprm-recipe-52143-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/03/IMG_1039.jpg"
    },
    {
      "text": "Use a hand mixer to whip the softened cream cheese with the remaining water, adding just a spoonful at the time (sometimes less is needed). Mix in the egg yolks, chopped chives, and salt and pepper.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/soy-sauce-marinated-deviled-eggs/#wprm-recipe-52143-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/03/IMG_1040.jpg"
    },
    {
      "text": "Spoon or pipe the whipped egg yolks back into the egg whites. Serve and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/soy-sauce-marinated-deviled-eggs/#wprm-recipe-52143-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/03/IMG_1056.jpg"
    }
  ],
