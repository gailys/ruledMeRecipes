  "ingredients": [
    "12 ounce pork sausage",
    "1/2 teaspoon cumin",
    "1/2 teaspoon onion powder",
    "salt and pepper (to taste)",
    "2 ounce smoked cheddar cheese (cut into 1-inch cubes)",
    "12 ounce bacon"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 350F. Lay the sausage out on a cookie sheet lined with parchment paper. Try to mold the sausage into patties to help with the preparation.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-bacon-burger-bombs/#wprm-recipe-52241-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/06/bacon-burger-bombs-step-1.jpg"
    },
    {
      "text": "Dust the sausage with cumin, onion powder, salt, and pepper to taste.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-bacon-burger-bombs/#wprm-recipe-52241-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/06/bacon-burger-bombs-step-2.jpg"
    },
    {
      "text": "Place a cube of cheese in the middle of each sausage round.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-bacon-burger-bombs/#wprm-recipe-52241-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/06/bacon-burger-bombs-step-3.jpg"
    },
    {
      "text": "Form the meat into balls to seal off the cheese, rolling them to make them nice and smooth.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-bacon-burger-bombs/#wprm-recipe-52241-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/06/bacon-burger-bombs-step-4.jpg"
    },
    {
      "text": "Wrap the bacon around the sausage balls. Place in the oven and bake for 1 hour.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-bacon-burger-bombs/#wprm-recipe-52241-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/06/bacon-burger-bombs-step-5.jpg"
    },
    {
      "text": "Serve with low-carb burger condiments of choice. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-bacon-burger-bombs/#wprm-recipe-52241-step-0-5",
