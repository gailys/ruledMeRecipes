  "ingredients": [
    "12 ounce bacon",
    "8 ounce cream cheese (softened)",
    "1 cup mayonnaise",
    "1 cup sour cream",
    "1 1/2 cup cheddar cheese (shredded)",
    "1 medium fresh tomatoes",
    "2 tablespoon fresh chives (chopped)"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 375F. Use a skillet to fry up the bacon slices, then set aside on a paper towel to drain.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-blt-style-dip/#wprm-recipe-52563-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/04/blt-dip-02.jpg"
    },
    {
      "text": "In a mixing bowl, combine the softened cream cheese, mayonnaise, and sour cream, blending well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-blt-style-dip/#wprm-recipe-52563-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/04/blt-dip-03.jpg"
    },
    {
      "text": "Add the crumbled bacon and most of the shredded cheddar cheese, reserving a small amount for topping the dip.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-blt-style-dip/#wprm-recipe-52563-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/04/blt-dip-04.jpg"
    },
    {
      "text": "Dice up the tomato and set a little bit aside, then mix the rest into the dip.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-blt-style-dip/#wprm-recipe-52563-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/04/blt-dip-05.jpg"
    },
    {
      "text": "Spread the dip out into a baking pan or small casserole dish. Evenly distribute the reserved shredded cheese and tomato, then sprinkle the chives on top.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-blt-style-dip/#wprm-recipe-52563-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/04/blt-dip-06.jpg"
    },
    {
      "text": "Bake for 20 minutes, or until hot and bubbly.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-blt-style-dip/#wprm-recipe-52563-step-0-5",
      "imageSource": null
    }
  ],
