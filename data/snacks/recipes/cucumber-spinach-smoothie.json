  "ingredients": [
    "90 gram spinach",
    "7 large ice cubes",
    "1 cup unsweetened carton coconut milk",
    "12 drop liquid stevia",
    "1/4 teaspoon xanthan gum",
    "1 tablespoon mct oil",
    "2 1/2 ounce cucumber"
  ],
  "instructions": [
    {
      "text": "Grab the spinach and toss it in a blender. Add in the ice cubes, coconut milk (from a carton), liquid stevia, xanthan gum, and MCT oil. Peel and cube the cucumber, adding it in as well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cucumber-spinach-smoothie/#wprm-recipe-51355-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/09/img_2097.jpg"
    },
    {
      "text": "Blend for 1–2 minutes or until the ingredients are well combined. There may still be little bits of spinach floating around, but these really can't be detected in the texture.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cucumber-spinach-smoothie/#wprm-recipe-51355-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/09/img_2101.jpg"
    },
    {
      "text": "Pour into a nice big glass and savor the refreshingly sweet taste!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cucumber-spinach-smoothie/#wprm-recipe-51355-step-0-2",
