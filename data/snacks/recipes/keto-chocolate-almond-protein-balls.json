  "ingredients": [
    "6 tablespoon almond butter",
    "1 teaspoon coconut oil (melted)",
    "1 tablespoon vanilla extract",
    "1 tablespoon allulose (or your preferred sweetener)",
    "3 tablespoon almond flour",
    "1 ounce vegan vanilla protein powder (or unflavored protein powder + vanilla extract + sweetener to taste)",
    "1/4 cup low-carb dark chocolate chips"
  ],
  "instructions": [
    {
      "text": "Gather and prep all ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chocolate-almond-protein-balls/#wprm-recipe-55020-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/05/Keto-Chocolate-Almond-Protein-Balls-1.jpg"
    },
    {
      "text": "In a bowl, add the dry ingredients: protein powder, almond flour, and allulose. Mix well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chocolate-almond-protein-balls/#wprm-recipe-55020-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/05/Keto-Chocolate-Almond-Protein-Balls-2.jpg"
    },
    {
      "text": "In a separate bowl, add the wet ingredients: almond butter, melted coconut oil, vanilla extract. Mix well to combine. Then mix the wet ingredients into the dry, stirring to well to combine.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chocolate-almond-protein-balls/#wprm-recipe-55020-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/05/Keto-Chocolate-Almond-Protein-Balls-3.jpg"
    },
    {
      "text": "Add the chocolate chips into the mix and knead by hand until it forms a smooth consistency like cookie dough. Scoop out dough and roll by hand to form into balls. Note: If the mixture is too dry, you can add some unsweetened almond milk or more melted coconut oil to help. If the mixture is too wet, you can slowly add more protein powder to help the consistency.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chocolate-almond-protein-balls/#wprm-recipe-55020-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/05/Keto-Chocolate-Almond-Protein-Balls-4.jpg"
    },
    {
      "text": "Place the protein balls in the freezer for 10-15 minutes, or until firm. Enjoy immediately or store in the refrigerator in an air-tight container for up to 2 weeks.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chocolate-almond-protein-balls/#wprm-recipe-55020-step-0-4",
      "imageSource": null
    }
  ],
