  "instructions": [
    {
      "text": "Measure out the coconut oil, heavy cream, and cream cheese.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/coconut-orange-creamsicle-fat-bombs/#wprm-recipe-51701-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/05/img_4664.jpg"
    },
    {
      "text": "Use an immersion blender to blend all of these ingredients. If necessary, microwave for 30–60 seconds to make the ingredients easier to combine.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/coconut-orange-creamsicle-fat-bombs/#wprm-recipe-51701-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/05/img_4670.jpg"
    },
    {
      "text": "Add the Orange Vanilla Mio and liquid stevia into the mixture and stir everything together with a spoon.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/coconut-orange-creamsicle-fat-bombs/#wprm-recipe-51701-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/05/img_4672.jpg"
    },
    {
      "text": "Spread the mixture into silicone molds and freeze for 2–3 hours.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/coconut-orange-creamsicle-fat-bombs/#wprm-recipe-51701-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/05/img_4682.jpg"
    },
    {
      "text": "Once hardened, remove from the silicone tray and store in the freezer. Enjoy!",
