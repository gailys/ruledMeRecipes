  "ingredients": [
    "2 large portobello mushrooms",
    "1/2 cup parmesan cheese (shredded)",
    "1/2 teaspoon garlic powder",
    "1/2 teaspoon smoked paprika",
    "1/4 teaspoon cayenne pepper",
    "salt and pepper (to taste)",
    "1 large egg (beaten)",
    "3 ounce bacon",
    "1/4 cup cheddar cheese (shredded)",
    "1 tablespoon dried chives"
  ],
  "instructions": [
    {
      "text": "Heat oven to 425F and line a baking sheet with foil and/or non stick spray. Slice the mushroom caps into ¼ in thick strips and cut the ends off at an angle to imitate a “French fry” cut.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/smothered-portobello-mushroom-fries/#wprm-recipe-52659-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/07/smothered-portobello-fries07.jpg"
    },
    {
      "text": "In a small food processor, blend Parmesan cheese and seasonings until the mixture is well combined. Transfer the mixture to a shallow bowl or dish.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/smothered-portobello-mushroom-fries/#wprm-recipe-52659-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/07/smothered-portobello-fries08.jpg"
    },
    {
      "text": "Beat the egg in a small bowl. Dip the mushroom fries in the egg to coat.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/smothered-portobello-mushroom-fries/#wprm-recipe-52659-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/07/smothered-portobello-fries09.jpg"
    },
    {
      "text": "Carefully roll the mushroom in the Parmesan mixture.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/smothered-portobello-mushroom-fries/#wprm-recipe-52659-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/07/smothered-portobello-fries10.jpg"
    },
    {
      "text": "Place the mushroom fries on the prepared baking sheet and roast for about 10 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/smothered-portobello-mushroom-fries/#wprm-recipe-52659-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/07/smothered-portobello-fries11.jpg"
    },
    {
      "text": "While the fries are baking, add bacon strips to a pan and fry over medium heat until crisp. Remove the bacon from the pan and allow to cool before “crumbling” or dicing with a knife.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/smothered-portobello-mushroom-fries/#wprm-recipe-52659-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/07/smothered-portobello-fries12.jpg"
    },
    {
      "text": "Remove the fries from oven and cover with shredded cheese and crumbled bacon.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/smothered-portobello-mushroom-fries/#wprm-recipe-52659-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/07/smothered-portobello-fries13.jpg"
    },
    {
      "text": "Bake for an additional 5 minutes or until cheese is melted. Top with dried chives and serve.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/smothered-portobello-mushroom-fries/#wprm-recipe-52659-step-0-7",
      "imageSource": null
    }
  ],
