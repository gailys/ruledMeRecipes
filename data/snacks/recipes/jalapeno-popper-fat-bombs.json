  "ingredients": [
    "3 ounce bacon",
    "1 medium jalapeno pepper",
    "3 ounce cream cheese (softened)",
    "1/2 teaspoon dried parsley",
    "1/4 teaspoon onion powder",
    "1/4 teaspoon garlic powder",
    "salt and pepper (to taste)"
  ],
  "instructions": [
    {
      "text": "Fry the bacon in a pan until crisp.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/jalapeno-popper-fat-bombs/#wprm-recipe-51595-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/02/img_5603.jpg"
    },
    {
      "text": "Remove from the pan, reserving the grease for later use. Wait until the bacon is cooled and crisp.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/jalapeno-popper-fat-bombs/#wprm-recipe-51595-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/02/img_5606.jpg"
    },
    {
      "text": "Deseed the jalapeño pepper (keep the seeds for added spice) and dice into small pieces.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/jalapeno-popper-fat-bombs/#wprm-recipe-51595-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/02/img_5607.jpg"
    },
    {
      "text": "Combine the cream cheese, diced jalapeño, and spices. Season with salt and pepper to taste.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/jalapeno-popper-fat-bombs/#wprm-recipe-51595-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/02/img_5612.jpg"
    },
    {
      "text": "Add the reserved bacon fat and mix to form a solid mixture.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/jalapeno-popper-fat-bombs/#wprm-recipe-51595-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/02/img_5615.jpg"
    },
    {
      "text": "Crumble the bacon onto a plate. Roll the cream cheese mixture into balls and then roll the balls in the bacon bits to coat them. Serve and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/jalapeno-popper-fat-bombs/#wprm-recipe-51595-step-0-5",
