  "ingredients": [
    "1/2 cup swiss cheese (shredded)",
    "1/2 cup cheddar cheese (shredded)",
    "1/8 cup cooked bacon (crumbled)"
  ],
  "instructions": [
    {
      "text": "Preheat your oven to 300F. Line a baking sheet with parchment paper.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheesy-bacon-nacho-chips/#wprm-recipe-53147-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/09/keto-cheese-bacon-nachos-01.jpg"
    },
    {
      "text": "Spread the Swiss cheese out on the parchment. Sprinkle the bacon on top of the Swiss, then add the cheddar cheese as the final layer.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheesy-bacon-nacho-chips/#wprm-recipe-53147-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/09/keto-cheese-bacon-nachos-02.jpg"
    },
    {
      "text": "Straighten up the edges so that the cheese forms a square.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheesy-bacon-nacho-chips/#wprm-recipe-53147-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/09/keto-cheese-bacon-nachos-04.jpg"
    },
    {
      "text": "Bake in the oven for 10 minutes or until the cheese has melted together and starts to brown. Remove from the oven and allow to cool.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheesy-bacon-nacho-chips/#wprm-recipe-53147-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/09/keto-cheese-bacon-nachos-05.jpg"
    },
    {
      "text": "Cut the cheese into strips, and then down into triangles.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheesy-bacon-nacho-chips/#wprm-recipe-53147-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/09/keto-cheese-bacon-nachos-06.jpg"
    },
    {
      "text": "Line another baking sheet with parchment paper, then arrange the cheese triangles on top. Broil for another minute or two to make the chips crunchy.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheesy-bacon-nacho-chips/#wprm-recipe-53147-step-0-5",
      "imageSource": null
    }
  ],
