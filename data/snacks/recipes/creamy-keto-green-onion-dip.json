  ],
  "instructions": [
    {
      "text": "Wash and chop the green onion, removing any wilted or discolored pieces of the green stem.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-keto-green-onion-dip/#wprm-recipe-53227-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/01/green-onion-dip-01.jpg"
    },
    {
      "text": "In a large bowl, mix the cream cheese, sour cream, mayonnaise, and crushed garlic and half of the onion until the mixture is smooth and there are no visible lumps.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-keto-green-onion-dip/#wprm-recipe-53227-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/01/green-onion-dip-02.jpg"
    },
    {
      "text": "Once smooth, add the rest of the onion to the dip and fold in gently.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-keto-green-onion-dip/#wprm-recipe-53227-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/01/green-onion-dip-03.jpg"
    },
    {
      "text": "Season with salt and pepper and serve with crudité! For a stronger onion flavor, refrigerate for 1 hour before serving.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-keto-green-onion-dip/#wprm-recipe-53227-step-0-3",
