  "ingredients": [
    "3 large egg white",
    "1/8 teaspoon cream of tartar",
    "2 tablespoon unflavored low-carb protein powder",
    "1 cup parmesan cheese (grated)",
    "2 tablespoon fresh chives (diced)"
  ],
  "instructions": [
    {
      "text": "Gather and prep all of your ingredients. Pre-heat oven to 340F.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-puffed-cheese-snacks/#wprm-recipe-56803-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/06/Keto-Puffed-Cheese-Snacks-1.jpg"
    },
    {
      "text": "Separate the egg yolks from the whites and add the whites to a bowl. Save the yolks for a different recipe or discard. Add in the cream of tartar.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-puffed-cheese-snacks/#wprm-recipe-56803-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/06/Keto-Puffed-Cheese-Snacks-2.jpg"
    },
    {
      "text": "Beat the egg whites until soft peaks form, then add in the protein powder. Continue beating until stiff peaks form.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-puffed-cheese-snacks/#wprm-recipe-56803-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/06/Keto-Puffed-Cheese-Snacks-3.jpg"
    },
    {
      "text": "Add in the grated parmesan and chives, then fold into the egg white mixture gently using a spatula.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-puffed-cheese-snacks/#wprm-recipe-56803-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/06/Keto-Puffed-Cheese-Snacks-5.jpg"
    },
    {
      "text": "Spoon the mixture onto a parchment paper lined baking sheet. Try to make each mound about 1 tablespoon big.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-puffed-cheese-snacks/#wprm-recipe-56803-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/06/Keto-Puffed-Cheese-Snacks-6.jpg"
    },
    {
      "text": "Place into the oven and bake for 5 minutes, then turn the temperature of the oven down to 140F. Allow to bake for an additional 40-45 minutes. Allow to cool, then serve!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-puffed-cheese-snacks/#wprm-recipe-56803-step-0-5",
      "imageSource": null
    }
