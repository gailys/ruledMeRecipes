  "ingredients": [
    "16 ounce shrimp",
    "16 ounce ground pork",
    "60 gram green onion (chopped)",
    "1 tablespoon fresh garlic (minced)",
    "1 teaspoon chinese five-spice powder",
    "1/2 teaspoon black pepper",
    "1/4 teaspoon salt",
    "1 tablespoon soy sauce (or coconut aminos)",
    "2 teaspoon fish sauce",
    "1 tablespoon sesame oil",
    "1 teaspoon unseasoned rice vinegar",
    "1 large egg",
    "2 medium red bell pepper",
    "3 medium green bell pepper"
  ],
  "instructions": [
    {
      "text": "Let's get all the prep out of the way first. Make sure that the shrimp have been drained of any excess water. Peel the shrimp and pat them dry. Cut the shrimp into thirds. We will be mixing these with the ground pork.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-bites-asian-pork-shrimp/#wprm-recipe-50557-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/12/keto-bites-asian-pork-shrimp-01.jpg"
    },
    {
      "text": "Place the ground pork in a plastic bag.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-bites-asian-pork-shrimp/#wprm-recipe-50557-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/12/keto-bites-asian-pork-shrimp-05.jpg"
    },
    {
      "text": "Add the chopped shrimp, all of the spices, green onion, soy sauce, fish sauce, sesame oil, vinegar, and egg to the plastic bag.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-bites-asian-pork-shrimp/#wprm-recipe-50557-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/12/keto-bites-asian-pork-shrimp-08.jpg"
    },
    {
      "text": "Mix the ingredients very well, making sure that the meats are completely covered by the spices and sauces. Squeeze all the air out of the bag and roll it into a log. Let sit in the fridge to marinate for 2–3 hours.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-bites-asian-pork-shrimp/#wprm-recipe-50557-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/12/keto-bites-asian-pork-shrimp-09.jpg"
    },
    {
      "text": "Preheat oven to 375F. Chop the red bell peppers into quarters. Chop the green bell peppers the same way. Spoon the marinated mixture onto the pepper quarters. Place in the oven and bake for 35 minutes. Turn the tray around and bake for an additional 5 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-bites-asian-pork-shrimp/#wprm-recipe-50557-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/12/keto-bites-asian-pork-shrimp-12.jpg"
    },
    {
      "text": "Let cool for 5 minutes and serve!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-bites-asian-pork-shrimp/#wprm-recipe-50557-step-0-5",
      "imageSource": null
    }
  ],
