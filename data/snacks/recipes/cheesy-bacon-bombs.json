  "ingredients": [
    "8 ounce mozzarella cheese (grated)",
    "1 large egg",
    "4 tablespoon butter (melted)",
    "4 tablespoon almond flour",
    "3 tablespoon psyllium husk powder",
    "1/4 teaspoon salt",
    "1/4 teaspoon black pepper",
    "1/8 teaspoon garlic powder",
    "1/8 teaspoon onion powder",
    "10 ounce bacon",
    "1 cup lard (or other oil with a high smoke point)"
  ],
  "instructions": [
    {
      "text": "Add half of the mozzarella cheese to a large mixing bowl.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cheesy-bacon-bombs/#wprm-recipe-51157-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/06/IMG_4304.jpg"
    },
    {
      "text": "Add the egg and butter and mix well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cheesy-bacon-bombs/#wprm-recipe-51157-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/06/IMG_4315.jpg"
    },
    {
      "text": "Add in the almond flour, psyllium husk, and remaining spices (salt, black pepper, garlic powder, and onion powder). Mix well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cheesy-bacon-bombs/#wprm-recipe-51157-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/06/IMG_4317.jpg"
    },
    {
      "text": "Spread the remaining cheese over half of the dough and fold the dough over lengthwise.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cheesy-bacon-bombs/#wprm-recipe-51157-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/06/IMG_4328.jpg"
    },
    {
      "text": "Fold the dough again vertically to form a square shape.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cheesy-bacon-bombs/#wprm-recipe-51157-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/06/IMG_4331.jpg"
    },
    {
      "text": "Crimp the edges and press the dough together to form a rectangle. The filling should be tightly sealed inside.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cheesy-bacon-bombs/#wprm-recipe-51157-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/06/IMG_4332.jpg"
    },
    {
      "text": "Use a knife to cut the dough into squares.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cheesy-bacon-bombs/#wprm-recipe-51157-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/06/IMG_4337.jpg"
    },
    {
      "text": "Cut each slice of bacon in half and lay a square of dough at the end of the piece of bacon.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cheesy-bacon-bombs/#wprm-recipe-51157-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/06/IMG_4342.jpg"
    },
    {
      "text": "Wrap the dough tightly in bacon until the ends are overlapping, stretching the bacon beforehand if needed.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cheesy-bacon-bombs/#wprm-recipe-51157-step-0-8",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/06/IMG_4345.jpg"
    },
    {
      "text": "Use a toothpick to secure the bacon after rolling.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cheesy-bacon-bombs/#wprm-recipe-51157-step-0-9",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/06/IMG_4346.jpg"
    },
    {
      "text": "Repeat for every piece of dough.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cheesy-bacon-bombs/#wprm-recipe-51157-step-0-10",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/06/IMG_4349.jpg"
    },
    {
      "text": "Heat the lard to 350–375F and fry the cheesy bacon bombs in small batches.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cheesy-bacon-bombs/#wprm-recipe-51157-step-0-11",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/06/IMG_4361.jpg"
    },
    {
      "text": "Once finished, let cool and drain on a paper towel.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cheesy-bacon-bombs/#wprm-recipe-51157-step-0-12",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/06/IMG_4368.jpg"
    },
    {
      "text": "Serve and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cheesy-bacon-bombs/#wprm-recipe-51157-step-0-13",
      "imageSource": null
    }
  ],
