  "ingredients": [
    "4 ounce cream cheese",
    "1/4 cup sour cream",
    "1/4 cup mayonnaise",
    "1 cup mozzarella cheese (shredded)",
    "salt and pepper (to taste)",
    "1/2 cup low-carb tomato sauce (such as Rao's)",
    "1/4 cup parmesan cheese",
    "1/2 ounce pepperoni (chopped)",
    "1 tablespoon green bell pepper (diced)",
    "4 whole black olives (sliced)",
    "1/2 teaspoon italian seasoning",
    "salt and pepper (to taste)",
    "1 tablespoon green bell pepper (diced)",
    "1 ounce cremini mushrooms (diced)",
    "1/2 teaspoon italian seasoning",
    "salt and pepper (to taste)"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 350F. Measure out the cream cheese and microwave for 20 seconds to get it to room temperature.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/personal-pan-pizza-dip/#wprm-recipe-51551-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/01/img_2860.jpg"
    },
    {
      "text": "Add the sour cream, mayonnaise, and half of the mozzarella cheese. Season with salt and pepper to taste.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/personal-pan-pizza-dip/#wprm-recipe-51551-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/01/img_2864.jpg"
    },
    {
      "text": "Divide the mixture into ramekins.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/personal-pan-pizza-dip/#wprm-recipe-51551-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/01/img_2868.jpg"
    },
    {
      "text": "Spoon tomato sauce over each ramekin and spread it out evenly.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/personal-pan-pizza-dip/#wprm-recipe-51551-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/01/img_2872.jpg"
    },
    {
      "text": "Combine the parmesan with the remaining mozzarella. Sprinkle this mixture evenly over the sauce and add toppings of choice.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/personal-pan-pizza-dip/#wprm-recipe-51551-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/01/img_2877.jpg"
    },
    {
      "text": "Bake for 18–20 minutes or until the cheese is bubbling. Remove from the oven and let cool for a few minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/personal-pan-pizza-dip/#wprm-recipe-51551-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/01/img_2882.jpg"
    },
    {
      "text": "Serve and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/personal-pan-pizza-dip/#wprm-recipe-51551-step-0-6",
      "imageSource": null
    }
  ],
