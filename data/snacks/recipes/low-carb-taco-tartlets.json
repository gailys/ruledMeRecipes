    "servingSize": "1 serving"
  },
  "nutritionPerServing": {
    "calories": 235,
    "netCarbsGrams": 2.6,
    "proteinGrams": 10,
    "fatGrams": 20
  },
  "ingredients": [
    "1 cup almond flour",
    "3 tablespoon coconut flour",
    "1 teaspoon xanthan gum",
    "1/4 teaspoon salt",
    "1 teaspoon dried oregano",
    "1/4 teaspoon cayenne pepper",
    "1/4 teaspoon paprika",
    "5 tablespoon butter (chilled)",
    "2 tablespoon ice water",
    "80 gram cremini mushrooms",
    "45 gram green onion",
    "1 tablespoon olive oil",
    "2 teaspoon fresh garlic (minced)",
    "400 gram ground beef",
    "1 teaspoon worcestershire sauce",
    "1 teaspoon cumin",
    "1 teaspoon salt",
    "1/2 teaspoon black pepper",
    "1/4 teaspoon ground cinnamon",
    "2 tablespoon tomato paste",
    "2 teaspoon yellow mustard",
    "1/3 cup mozzarella cheese (grated)"
  ],
  "instructions": [
    {
      "text": "Mix together the almond flour, coconut flour, xanthan gum, and salt to make the pastry base.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-taco-tartlets/#wprm-recipe-50921-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/MTT1.jpg"
    },
    {
      "text": "Add in the spices.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-taco-tartlets/#wprm-recipe-50921-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/MTT2.jpg"
    },
    {
      "text": "Add the dry ingredients to a food processor. Cut the cold butter into small cubes and add these to the food processor as well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-taco-tartlets/#wprm-recipe-50921-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/MTT3.jpg"
    },
    {
      "text": "Pulse the mixture, slowly adding in the ice-cold water, until a crumbly but solid dough begins to form.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-taco-tartlets/#wprm-recipe-50921-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/MTT4.jpg"
    },
    {
      "text": "Wrap the dough in plastic wrap and freeze for 10 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-taco-tartlets/#wprm-recipe-50921-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/MTT5.jpg"
    },
    {
      "text": "Remove the dough from the freezer and place on a Silpat.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-taco-tartlets/#wprm-recipe-50921-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/MTT6.jpg"
    },
    {
      "text": "Add a second Silpat on top of the dough.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-taco-tartlets/#wprm-recipe-50921-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/MTT7.jpg"
    },
    {
      "text": "Use a rolling pin to roll the dough out into a square shape.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-taco-tartlets/#wprm-recipe-50921-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/MTT8.jpg"
    },
    {
      "text": "Use a cup or cookie cutter to cut circles into the dough. Repeat with the rest of the dough.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-taco-tartlets/#wprm-recipe-50921-step-0-8",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/MTT9.jpg"
    },
    {
      "text": "Place the circular pastries into a whoopie pan. (These are also sold as muffin top pans.) Set aside.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-taco-tartlets/#wprm-recipe-50921-step-0-9",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/MTT10.jpg"
    },
    {
      "text": "Preheat oven to 325F. Prep the vegetables by slicing the mushrooms and green onions.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-taco-tartlets/#wprm-recipe-50921-step-0-10",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_4157.jpg"
    },
    {
      "text": "Heat up the olive oil in a pan over high heat.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-taco-tartlets/#wprm-recipe-50921-step-0-11",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_4158.jpg"
    },
    {
      "text": "Sauté the garlic and green onions until cooked.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-taco-tartlets/#wprm-recipe-50921-step-0-12",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_4162.jpg"
    },
    {
      "text": "Add the ground beef to the pan, searing it, and then add in the Worcestershire sauce, cumin, salt, pepper, and cinnamon.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-taco-tartlets/#wprm-recipe-50921-step-0-13",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_4166.jpg"
    },
    {
      "text": "Once cooked through, stir in the sliced mushrooms.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-taco-tartlets/#wprm-recipe-50921-step-0-14",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_4168.jpg"
    },
    {
      "text": "Once the mushrooms are slightly cooked, add the tomato paste and mustard, mixing this in as well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-taco-tartlets/#wprm-recipe-50921-step-0-15",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_4193.jpg"
    },
    {
      "text": "Spoon the beef mixture evenly into the pastries. Top with the shredded mozzarella.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-taco-tartlets/#wprm-recipe-50921-step-0-16",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_4201.jpg"
    },
    {
      "text": "Bake for 20–25 minutes and then broil the tops for 3–5 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-taco-tartlets/#wprm-recipe-50921-step-0-17",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_4204.jpg"
    },
    {
      "text": "Let cool completely and serve!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-taco-tartlets/#wprm-recipe-50921-step-0-18",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/TacoTartlet21.jpg"
    }
  ],
