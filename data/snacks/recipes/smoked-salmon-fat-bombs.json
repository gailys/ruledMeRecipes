  ],
  "instructions": [
    {
      "text": "Gather and prep all ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/smoked-salmon-fat-bombs/#wprm-recipe-54973-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/03/Smoked-Salmon-Fat-Bombs-1.jpg"
    },
    {
      "text": "Chop smoked salmon into fine pieces. It doesn't have to be perfect - just do the best you can.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/smoked-salmon-fat-bombs/#wprm-recipe-54973-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/03/Smoked-Salmon-Fat-Bombs-2.jpg"
    },
    {
      "text": "Mix together the smoked salmon, goats cheese, butter, and lemon juice.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/smoked-salmon-fat-bombs/#wprm-recipe-54973-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/03/Smoked-Salmon-Fat-Bombs-3.jpg"
    },
    {
      "text": "Season with black pepper to taste. Line a container (that can be sealed) with parchment paper.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/smoked-salmon-fat-bombs/#wprm-recipe-54973-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/03/Smoked-Salmon-Fat-Bombs-4.jpg"
    },
    {
      "text": "Scoop the mixture and form into ~1 inch balls. Place the balls into the parchment-lined container. Set in the fridge overnight (or at minimum a few hours) for the mixture to firm up.",
