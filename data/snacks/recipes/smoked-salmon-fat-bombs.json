      "sourceUrl": "https://www.ruled.me/smoked-salmon-fat-bombs/#wprm-recipe-54973-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/03/Smoked-Salmon-Fat-Bombs-5.jpg"
