  },
  "ingredients": [
    "1/2 cup butter",
    "1/2 cup coconut oil",
    "1/2 cup sour cream",
    "1/2 cup cream cheese",
    "2 tablespoon erythritol",
    "25 drop liquid stevia",
    "2 tablespoon unsweetened dark cocoa powder",
    "1 teaspoon vanilla extract",
    "24 gram strawberries"
  ],
  "instructions": [
    {
      "text": "In a bowl, combine the butter, coconut oil, sour cream, cream cheese, erythritol, and liquid stevia.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/neapolitan-fat-bombs/#wprm-recipe-51729-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/06/img_9611.jpg"
    },
    {
      "text": "Using an immersion blender, combine the ingredients into a smooth mixture.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/neapolitan-fat-bombs/#wprm-recipe-51729-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/06/img_9617.jpg"
    },
    {
      "text": "Divide the mixture into 3 different bowls. Add the cocoa powder to one bowl, vanilla extract to another bowl, and strawberries to the last bowl.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/neapolitan-fat-bombs/#wprm-recipe-51729-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/06/img_9622.jpg"
    },
    {
      "text": "Use the immersion blender to combine the separate flavors until liquified. Add the chocolate mixture to a container with a pouring spout.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/neapolitan-fat-bombs/#wprm-recipe-51729-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/06/img_9626.jpg"
    },
    {
      "text": "Pour the chocolate mixture into the fat bomb molds and freeze for 30 minutes. Repeat with the vanilla mixture, pouring it over the chocolate and freezing for another 30 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/neapolitan-fat-bombs/#wprm-recipe-51729-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/06/img_9634.jpg"
    },
    {
      "text": "Repeat the process with the strawberry mixture, then freeze again for at least 1 hour.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/neapolitan-fat-bombs/#wprm-recipe-51729-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/06/img_9740.jpg"
    },
    {
      "text": "Once completely frozen, remove from the molds, and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/neapolitan-fat-bombs/#wprm-recipe-51729-step-0-6",
      "imageSource": null
    }
  ],
