  "description": "This makes a total of 4 servings of Crispy & Delicious Kale Chips. Each serving comes out to be 73 calories, 7g fats, 1.7g net carbs, and 0.9g protein.",
  "servings": 4,
  "yield": [
    "4",
    "4 servings"
  ],
  "prepTime": "PT5M",
  "cookTime": "PT15M",
  "totalTime": "PT20M",
  "totalMinutes": 20,
  "nutrition": {
    "@type": "NutritionInformation",
