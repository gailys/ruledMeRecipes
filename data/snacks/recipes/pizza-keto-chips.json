  },
  "ingredients": [
    "6 ounce pepperoni (sliced)",
    "5 1/4 ounce mozzarella cheese (shredded)"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 400F.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/pizza-keto-chips/#wprm-recipe-50339-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/10/cookiesheet.jpg"
    },
    {
      "text": "On a non-stick baking sheet, arrange the pepperoni in overlapping batches of four.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/pizza-keto-chips/#wprm-recipe-50339-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/10/placingpepperonis.jpg"
    },
    {
      "text": "Bake for about 5 minutes or until semi-crispy and the fat is oozing out of them. If they move out of place, just arrange them back together.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/pizza-keto-chips/#wprm-recipe-50339-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/10/pepperonibaked.jpg"
    },
    {
      "text": "Sprinkle cheese on top. Bake for another 3 minutes or until the cheese is melted and a little crisp.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/pizza-keto-chips/#wprm-recipe-50339-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/10/addedcheese.jpg"
    },
    {
      "text": "Place the chips onto paper towels to soak up any excess grease. Let sit for 3–4 minutes to cool off and crisp up even more.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/pizza-keto-chips/#wprm-recipe-50339-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/10/drainonpapertowels.jpg"
    },
    {
      "text": "Serve and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/pizza-keto-chips/#wprm-recipe-50339-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/10/IMG_1356.jpg"
    }
  ],
