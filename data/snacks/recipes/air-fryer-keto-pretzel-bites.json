  },
  "ingredients": [
    "4 tablespoon coconut flour",
    "1 teaspoon baking powder",
    "1/2 teaspoon garlic powder",
    "1/4 teaspoon xanthan gum",
    "6 ounce shredded mozzarella",
    "1 large egg",
    "1 tablespoon coconut flour",
    "1 tablespoon butter",
    "kosher salt (to taste)",
    "2 tablespoon mayonnaise",
    "2 tablespoon whole grain mustard"
  ],
  "instructions": [
    {
      "text": "Gather and prep all of your ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/air-fryer-keto-pretzel-bites/#wprm-recipe-58030-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2025/07/Keto-Pretzel-Bites-1.jpg"
    },
    {
      "text": "In a bowl, whisk together coconut flour, baking powder, garlic powder, and xanthan gum.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/air-fryer-keto-pretzel-bites/#wprm-recipe-58030-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2025/07/Keto-Pretzel-Bites-2.jpg"
    },
    {
      "text": "Place mozzarella into a microwave-safe bowl and microwave for 30-40 seconds at a time until completely melted and easy to stir.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/air-fryer-keto-pretzel-bites/#wprm-recipe-58030-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2025/07/Keto-Pretzel-Bites-3.jpg"
    },
    {
      "text": "Add the flour mixture into the mozzarella, then add the egg. Stir well using a spatula or fork, working everything together until a solid dough forms.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/air-fryer-keto-pretzel-bites/#wprm-recipe-58030-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2025/07/Keto-Pretzel-Bites-4.jpg"
    },
    {
      "text": "Once the cheese dough is cool enough to work with your hands, dust work surface with coconut flour and knead with your hands until dough comes together completely.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/air-fryer-keto-pretzel-bites/#wprm-recipe-58030-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2025/07/Keto-Pretzel-Bites-6.jpg"
    },
    {
      "text": "Divide the dough into equal portions, then roll into a log. Cut the logs into bite-size pieces. Brush with melted butter and set aside.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/air-fryer-keto-pretzel-bites/#wprm-recipe-58030-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2025/07/Keto-Pretzel-Bites-7.jpg"
    },
    {
      "text": "Place pretzel bites into rack of air fryer and sprinkle with coarse salt to taste. Lightly press salt into the dough if needed. Air fry at 350F for 5-7 minutes or until puffed and golden brown.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/air-fryer-keto-pretzel-bites/#wprm-recipe-58030-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2025/07/Keto-Pretzel-Bites-8.jpg"
    },
    {
      "text": "Mix together the mayonnaise and mustard for the dipping sauce, then serve while hot. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/air-fryer-keto-pretzel-bites/#wprm-recipe-58030-step-0-7",
      "imageSource": null
    }
  ],
