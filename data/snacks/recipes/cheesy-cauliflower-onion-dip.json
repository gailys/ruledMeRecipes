  "ingredients": [
    "16 ounce cauliflower",
    "1/2 cup onion (diced)",
    "1 1/2 cup chicken broth",
    "1/2 teaspoon cumin",
    "1/2 teaspoon chili powder",
    "1/2 teaspoon garlic powder",
    "1/2 teaspoon black pepper",
    "1/2 teaspoon salt",
    "3/4 cup cream cheese",
    "1/4 cup mayonnaise"
  ],
  "instructions": [
    {
      "text": "Simmer the cauliflower and diced onion in chicken broth until soft and tender.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cheesy-cauliflower-onion-dip/#wprm-recipe-52063-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/01/Cheesy-Cauliflower-Onion-Dip-1.jpg"
    },
    {
      "text": "Stir in the cumin, chili powder, garlic powder, pepper, and salt.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cheesy-cauliflower-onion-dip/#wprm-recipe-52063-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/01/Cheesy-Cauliflower-Onion-Dip-2.jpg"
    },
    {
      "text": "Cut the cream cheese into chunks, whisking them into the cauliflower until melted and no longer chunky.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cheesy-cauliflower-onion-dip/#wprm-recipe-52063-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/01/Cheesy-Cauliflower-Onion-Dip-3.jpg"
    },
    {
      "text": "Use an immersion or regular blender to blend the liquid until completely smooth.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cheesy-cauliflower-onion-dip/#wprm-recipe-52063-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/01/Cheesy-Cauliflower-Onion-Dip-4.jpg"
    },
    {
      "text": "Carefully whisk in the mayonnaise.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cheesy-cauliflower-onion-dip/#wprm-recipe-52063-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/01/Cheesy-Cauliflower-Onion-Dip-5.jpg"
    },
    {
      "text": "Chill in the fridge for 2–3 hours before serving.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cheesy-cauliflower-onion-dip/#wprm-recipe-52063-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/01/Cheesy-Cauliflower-Onion-Dip-Final-620x900.jpg"
    }
  ],
