  "ingredients": [
    "16 ounce ground hot italian sausage",
    "15 ounce canned tomatoes with habanero (like ro*tel)",
    "1/4 cup green onion (sliced)",
    "8 ounce cream cheese",
    "16 ounce sour cream",
    "8 ounce pepper jack cheese (diced)"
  ],
  "instructions": [
    {
      "text": "Using a saucepan, cook the hot Italian sausage on medium until lightly browned.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/spicy-sausage-cheese-dip/#wprm-recipe-52111-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/03/Step-1.jpg"
    },
    {
      "text": "Stir in the can of Ro*Tel and cook for a few minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/spicy-sausage-cheese-dip/#wprm-recipe-52111-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/03/Step-2.jpg"
    },
    {
      "text": "Mix in the green onions and turn off the heat when the Italian sausage has fully browned.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/spicy-sausage-cheese-dip/#wprm-recipe-52111-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/03/Step-3.jpg"
    },
    {
      "text": "Set a slow cooker on high then layer the bottom of the stoneware with the diced pepper jack cheese, and cream cheese cut into chunks.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/spicy-sausage-cheese-dip/#wprm-recipe-52111-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/03/Step-4.jpg"
    },
    {
      "text": "Pour the Italian sausage on top of the cheese.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/spicy-sausage-cheese-dip/#wprm-recipe-52111-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/03/Step-5.jpg"
    },
    {
      "text": "Then, spread the sour cream on top of the Italian sausage.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/spicy-sausage-cheese-dip/#wprm-recipe-52111-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/03/Step-6.jpg"
    },
    {
      "text": "After about an hour, stir the dip until the cheese is completely incorporated. Then allow to continue cooking. Cook for about two hours total, on high, until the dip is completely done.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/spicy-sausage-cheese-dip/#wprm-recipe-52111-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/03/Spicy-Sausage-Cheese-Dip-620900.jpg"
    }
  ],
