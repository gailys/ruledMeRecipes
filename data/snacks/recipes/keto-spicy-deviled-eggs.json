  "nutritionPerServing": {
    "calories": 609,
    "netCarbsGrams": 3.2,
    "proteinGrams": 20,
    "fatGrams": 56.4
  },
  "ingredients": [
    "6 large egg",
    "1 tablespoon sriracha",
    "1/2 cup mayonnaise",
    "salt and pepper (to taste)",
    "1/2 tablespoon poppy seeds"
  ],
  "instructions": [
    {
      "text": "Place the eggs in a pot and add enough water to just cover the eggs. Bring the water to a boil over medium-high heat without the lid.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-spicy-deviled-eggs/#wprm-recipe-53223-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/01/spicy-deviled-eggs-02.jpg"
    },
    {
      "text": "Let the eggs simmer for about 7-8 minutes, then quickly cool the eggs in an ice-water bath.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-spicy-deviled-eggs/#wprm-recipe-53223-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/01/spicy-deviled-eggs-03.jpg"
    },
    {
      "text": "Remove the egg shells. Cut the eggs in half and scoop out the yolk portion, placing them in a separate bowl.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-spicy-deviled-eggs/#wprm-recipe-53223-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/01/spicy-deviled-eggs-04.jpg"
    },
    {
      "text": "Mix the egg yolks, sriracha, mayonnaise, and salt and pepper together until smooth.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-spicy-deviled-eggs/#wprm-recipe-53223-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/01/spicy-deviled-eggs-06.jpg"
    },
    {
      "text": "Scoop or pipe the yolk mixture back into the hollows of the egg whites.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-spicy-deviled-eggs/#wprm-recipe-53223-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/01/spicy-deviled-eggs-07.jpg"
    },
    {
      "text": "Garnish with poppy seeds and serve. Optionally you can put them into the refrigerator to get a firmer texture.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-spicy-deviled-eggs/#wprm-recipe-53223-step-0-5",
      "imageSource": null
    }
  ],
