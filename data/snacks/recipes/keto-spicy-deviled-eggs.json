  "description": "This makes a total of 2 servings of Spicy Keto Deviled Eggs. Each serving comes out to be 609 calories, 56.4g fats, 3.2g net carbs, and 20g protein.",
  "servings": 2,
  "yield": [
    "2",
    "2 servings"
  ],
  "prepTime": "PT10M",
  "cookTime": "PT20M",
  "totalTime": "PT30M",
  "totalMinutes": 30,
  "nutrition": {
    "@type": "NutritionInformation",
