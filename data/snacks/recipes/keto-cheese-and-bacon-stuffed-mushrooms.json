  "ingredients": [
    "4 slice bacon",
    "3 ounce frozen spinach (thawed and drained)",
    "1 teaspoon fresh garlic (minced)",
    "4 ounce cream cheese",
    "1 large egg",
    "2 tablespoon coconut flour",
    "1 cup mozzarella cheese (shredded)",
    "salt and pepper (to taste)",
    "16 medium cremini mushrooms (washed and dried)"
  ],
  "instructions": [
    {
      "text": "Preheat your oven to 350F. Use a skillet to cook the bacon until it’s crisp, then set aside to cool. Transfer the bacon fat to a large mixing bowl.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheese-and-bacon-stuffed-mushrooms/#wprm-recipe-53179-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/10/low-carb-stuffed-mushrooms-01.jpg"
    },
    {
      "text": "Crumble the bacon. Add 3/4 of the bacon, the spinach, garlic, cream cheese, egg, coconut flour, and mozzarella cheese to the mixing bowl. Season with salt and pepper then mix well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheese-and-bacon-stuffed-mushrooms/#wprm-recipe-53179-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/10/low-carb-stuffed-mushrooms-03.jpg"
    },
    {
      "text": "Remove the stems from the mushrooms. Stuff each mushroom cap with the filling then place into a small casserole dish.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheese-and-bacon-stuffed-mushrooms/#wprm-recipe-53179-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/10/low-carb-stuffed-mushrooms-04.jpg"
    },
    {
      "text": "Top the mushrooms with the remaining bacon.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheese-and-bacon-stuffed-mushrooms/#wprm-recipe-53179-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/10/low-carb-stuffed-mushrooms-05.jpg"
    },
    {
      "text": "Bake at 350F for 20 minutes or until the filling starts bubbling and has browned.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheese-and-bacon-stuffed-mushrooms/#wprm-recipe-53179-step-0-4",
