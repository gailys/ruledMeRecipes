  "ingredients": [
    "1/2 cup almond flour",
    "1/2 cup flaxseed meal",
    "1 teaspoon baking powder",
    "1/2 teaspoon salt",
    "1/4 teaspoon black pepper",
    "2 large egg",
    "1/4 cup sour cream",
    "16 ounce ground beef",
    "salt and pepper (to taste)",
    "1/2 teaspoon onion powder",
    "1/2 teaspoon garlic powder",
    "2 tablespoon tomato paste",
    "1/2 cup cheddar cheese (shredded)",
    "1 ounce dill pickle",
    "2 tablespoon low-carb ketchup",
    "2 tablespoon yellow mustard"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 350F. Place the ground beef in a hot pan. Season with salt and pepper.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheeseburger-muffins/#wprm-recipe-51571-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/01/img_2929.jpg"
    },
    {
      "text": "Cook until browned on the bottom, and then add in the onion powder, garlic powder, and tomato paste. Mix together and turn off the heat. The ground beef should be rare.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheeseburger-muffins/#wprm-recipe-51571-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/01/img_2936.jpg"
    },
    {
      "text": "Mix together the dry ingredients for the muffins.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheeseburger-muffins/#wprm-recipe-51571-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/01/img_2924.jpg"
    },
    {
      "text": "Add the wet ingredients to the muffin mixture and mix well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheeseburger-muffins/#wprm-recipe-51571-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/01/img_2940.jpg"
    },
    {
      "text": "Evenly divide the muffin mixture into silicone muffin cups. Use a spoon to make a small indentation in the muffins for the ground beef. Fill each muffin with the ground beef mixture.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheeseburger-muffins/#wprm-recipe-51571-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/01/img_2945.jpg"
    },
    {
      "text": "Bake for 15–20 minutes or until slightly browned on the outside.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheeseburger-muffins/#wprm-recipe-51571-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/01/img_2955.jpg"
    },
    {
      "text": "Remove from the oven and top with cheese. Broil for an additional 1–3 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheeseburger-muffins/#wprm-recipe-51571-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/01/img_2961.jpg"
    },
    {
      "text": "Let cool for 5–10 minutes and remove from the silicone muffin cups.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheeseburger-muffins/#wprm-recipe-51571-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/01/img_2970.jpg"
    },
    {
      "text": "Top with pickles, ketchup, and mustard. Serve and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheeseburger-muffins/#wprm-recipe-51571-step-0-8",
      "imageSource": null
    }
  ],
