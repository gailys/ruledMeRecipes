  "instructions": [
    {
      "text": "Measure out and prepare all of the ingredients. Preheat oven to 350F.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-sausage-balls/#wprm-recipe-54255-step-0-0",
