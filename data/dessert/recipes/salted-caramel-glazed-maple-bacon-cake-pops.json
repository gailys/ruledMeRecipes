  "featuredImage": "images/bdd7eb29d80b65635eb29fee.avif",
  "rawRecipe": {
    "@type": "Recipe",
    "name": "Maple Bacon Cake Pops with Salted Caramel Glaze",
    "author": {
      "@type": "Person",
      "name": "Craig Clarke",
      "url": "https://www.ruled.me/about-us/#craig-clarke"
    },
    "description": "This makes a total of 36 servings of Maple Bacon Cake Pops with Salted Caramel Glaze. Each serving comes out to be 69 calories, 6.1g fats, 0.6g net carbs, and 2.2g protein.",
    "datePublished": "2014-05-23T15:05:59+00:00",
    "image": [
      "https://www.ruled.me/wp-content/uploads/2014/05/BaconPops1.jpg"
    ],
    "recipeYield": [
      "36",
      "36 servings"
    ],
    "prepTime": "PT30M",
    "cookTime": "PT60M",
    "totalTime": "PT90M",
    "recipeIngredient": [
      "6 ounce bacon",
      "5 large egg (separated)",
      "1/4 cup low-carb maple syrup",
      "1/4 cup erythritol",
      "1/4 teaspoon liquid stevia",
      "1/2 teaspoon vanilla extract",
      "1 cup almond flour",
      "2 tablespoon psyllium husk powder",
      "2 tablespoon butter",
      "1 teaspoon baking powder",
      "1/2 teaspoon cream of tartar",
      "5 tablespoon butter",
      "5 tablespoon heavy whipping cream",
      "2 1/2 tablespoon sugar-free salted caramel syrup (such as Torani)"
    ],
    "recipeInstructions": [
      {
        "@type": "HowToStep",
        "text": "Slice the bacon into small, bite-sized chunks. Hint: Freeze the bacon for 30 minutes beforehand or use scissors to make this step easier.",
        "name": "Slice the bacon into small, bite-sized chunks. Hint: Freeze the bacon for 30 minutes beforehand or use scissors to make this step easier.",
        "url": "https://www.ruled.me/salted-caramel-glazed-maple-bacon-cake-pops/#wprm-recipe-51121-step-0-0",
        "image": "https://www.ruled.me/wp-content/uploads/2014/05/IMG_4039.jpg"
      },
      {
        "@type": "HowToStep",
        "text": "Heat a pan over medium-high heat and cook the bacon until crisp.",
        "name": "Heat a pan over medium-high heat and cook the bacon until crisp.",
        "url": "https://www.ruled.me/salted-caramel-glazed-maple-bacon-cake-pops/#wprm-recipe-51121-step-0-1",
        "image": "https://www.ruled.me/wp-content/uploads/2014/05/IMG_4043.jpg"
      },
      {
        "@type": "HowToStep",
        "text": "Remove from the pan and drain on paper towels. Save the excess bacon grease for sautéing vegetables or other meats.",
        "name": "Remove from the pan and drain on paper towels. Save the excess bacon grease for sautéing vegetables or other meats.",
        "url": "https://www.ruled.me/salted-caramel-glazed-maple-bacon-cake-pops/#wprm-recipe-51121-step-0-2",
        "image": "https://www.ruled.me/wp-content/uploads/2014/05/IMG_4046.jpg"
      },
      {
        "@type": "HowToStep",
        "text": "Preheat oven to 325F. In two separate bowls, separate the egg yolks from the egg whites.",
        "name": "Preheat oven to 325F. In two separate bowls, separate the egg yolks from the egg whites.",
        "url": "https://www.ruled.me/salted-caramel-glazed-maple-bacon-cake-pops/#wprm-recipe-51121-step-0-3",
        "image": "https://www.ruled.me/wp-content/uploads/2014/05/IMG_4051.jpg"
      },
      {
        "@type": "HowToStep",
        "text": "To the bowl with the egg yolks, add the Ruled.Me Maple Syrup, erythritol, liquid stevia, and vanilla extract.",
        "name": "To the bowl with the egg yolks, add the Ruled.Me Maple Syrup, erythritol, liquid stevia, and vanilla extract.",
        "url": "https://www.ruled.me/salted-caramel-glazed-maple-bacon-cake-pops/#wprm-recipe-51121-step-0-4",
        "image": "https://www.ruled.me/wp-content/uploads/2014/05/IMG_4055.jpg"
      },
      {
        "@type": "HowToStep",
        "text": "Combine using a hand mixer for about 2 minutes. The egg yolks should become lighter in color.",
        "name": "Combine using a hand mixer for about 2 minutes. The egg yolks should become lighter in color.",
        "url": "https://www.ruled.me/salted-caramel-glazed-maple-bacon-cake-pops/#wprm-recipe-51121-step-0-5",
        "image": "https://www.ruled.me/wp-content/uploads/2014/05/IMG_4057.jpg"
      },
      {
        "@type": "HowToStep",
        "text": "Add the almond flour, psyllium husk powder, butter, and baking powder.",
        "name": "Add the almond flour, psyllium husk powder, butter, and baking powder.",
        "url": "https://www.ruled.me/salted-caramel-glazed-maple-bacon-cake-pops/#wprm-recipe-51121-step-0-6",
        "image": "https://www.ruled.me/wp-content/uploads/2014/05/IMG_4060.jpg"
      },
      {
        "@type": "HowToStep",
        "text": "Mix until a thick batter forms.",
        "name": "Mix until a thick batter forms.",
        "url": "https://www.ruled.me/salted-caramel-glazed-maple-bacon-cake-pops/#wprm-recipe-51121-step-0-7",
        "image": "https://www.ruled.me/wp-content/uploads/2014/05/IMG_4067.jpg"
      },
      {
        "@type": "HowToStep",
        "text": "Wash the whisk attachments thoroughly to remove any traces of fat and dry thoroughly.",
        "name": "Wash the whisk attachments thoroughly to remove any traces of fat and dry thoroughly.",
        "url": "https://www.ruled.me/salted-caramel-glazed-maple-bacon-cake-pops/#wprm-recipe-51121-step-0-8",
        "image": "https://www.ruled.me/wp-content/uploads/2014/05/IMG_4077.jpg"
      },
      {
        "@type": "HowToStep",
        "text": "Add the cream of tartar to the egg whites.",
        "name": "Add the cream of tartar to the egg whites.",
        "url": "https://www.ruled.me/salted-caramel-glazed-maple-bacon-cake-pops/#wprm-recipe-51121-step-0-9",
        "image": "https://www.ruled.me/wp-content/uploads/2014/05/IMG_4083.jpg"
      },
      {
        "@type": "HowToStep",
        "text": "Using the hand mixer, whisk the egg whites until stiff peaks form.",
        "name": "Using the hand mixer, whisk the egg whites until stiff peaks form.",
        "url": "https://www.ruled.me/salted-caramel-glazed-maple-bacon-cake-pops/#wprm-recipe-51121-step-0-10",
        "image": "https://www.ruled.me/wp-content/uploads/2014/05/IMG_4087.jpg"
      },
      {
        "@type": "HowToStep",
        "text": "Add two-thirds of the crisped bacon to the cake pop batter.",
        "name": "Add two-thirds of the crisped bacon to the cake pop batter.",
        "url": "https://www.ruled.me/salted-caramel-glazed-maple-bacon-cake-pops/#wprm-recipe-51121-step-0-11",
        "image": "https://www.ruled.me/wp-content/uploads/2014/05/IMG_4095.jpg"
      },
      {
        "@type": "HowToStep",
        "text": "Add about one-third of the egg whites into the batter and mix vigorously.",
        "name": "Add about one-third of the egg whites into the batter and mix vigorously.",
        "url": "https://www.ruled.me/salted-caramel-glazed-maple-bacon-cake-pops/#wprm-recipe-51121-step-0-12",
        "image": "https://www.ruled.me/wp-content/uploads/2014/05/IMG_4102.jpg"
      },
      {
        "@type": "HowToStep",
        "text": "Add the rest of the egg whites and gently fold them in to the batter. The end result should be a light, airy batter.",
        "name": "Add the rest of the egg whites and gently fold them in to the batter. The end result should be a light, airy batter.",
        "url": "https://www.ruled.me/salted-caramel-glazed-maple-bacon-cake-pops/#wprm-recipe-51121-step-0-13",
        "image": "https://www.ruled.me/wp-content/uploads/2014/05/IMG_4108.jpg"
      },
      {
        "@type": "HowToStep",
        "text": "Spoon the mixture into a greased cake pop pan (I use one from Nordic Ware), filling with enough batter that rises above the mold. Place the lid on top and bake for 20–25 minutes.",
        "name": "Spoon the mixture into a greased cake pop pan (I use one from Nordic Ware), filling with enough batter that rises above the mold. Place the lid on top and bake for 20–25 minutes.",
        "url": "https://www.ruled.me/salted-caramel-glazed-maple-bacon-cake-pops/#wprm-recipe-51121-step-0-14",
        "image": "https://www.ruled.me/wp-content/uploads/2014/05/IMG_4121.jpg"
      },
      {
        "@type": "HowToStep",
        "text": "Once finished, remove the cake pops and let cool. Continue using the mold to make cake pops, or use the remaining batter to make cupcakes (use the same cook time).",
        "name": "Once finished, remove the cake pops and let cool. Continue using the mold to make cake pops, or use the remaining batter to make cupcakes (use the same cook time).",
        "url": "https://www.ruled.me/salted-caramel-glazed-maple-bacon-cake-pops/#wprm-recipe-51121-step-0-15",
        "image": "https://www.ruled.me/wp-content/uploads/2014/05/IMG_4134.jpg"
      },
      {
        "@type": "HowToStep",
        "text": "While the cake pops are cooling, prepare the sauce. Add the butter to the pan over medium-low heat and melt until browned and no longer bubbling.",
        "name": "While the cake pops are cooling, prepare the sauce. Add the butter to the pan over medium-low heat and melt until browned and no longer bubbling.",
        "url": "https://www.ruled.me/salted-caramel-glazed-maple-bacon-cake-pops/#wprm-recipe-51121-step-0-16",
        "image": "https://www.ruled.me/wp-content/uploads/2014/05/IMG_4151.jpg"
      },
      {
        "@type": "HowToStep",
        "text": "Add the heavy cream and Torani Salted Caramel syrup to the pan. The cream should begin to bubble right away.",
        "name": "Add the heavy cream and Torani Salted Caramel syrup to the pan. The cream should begin to bubble right away.",
        "url": "https://www.ruled.me/salted-caramel-glazed-maple-bacon-cake-pops/#wprm-recipe-51121-step-0-17",
        "image": "https://www.ruled.me/wp-content/uploads/2014/05/IMG_4161.jpg"
      },
      {
        "@type": "HowToStep",
        "text": "Mix everything together and continue to cook to allow the sauce to reduce. The mixture is ready once it's thick enough that it takes a while to come back together after being separated with a spoon.",
        "name": "Mix everything together and continue to cook to allow the sauce to reduce. The mixture is ready once it's thick enough that it takes a while to come back together after being separated with a spoon.",
        "url": "https://www.ruled.me/salted-caramel-glazed-maple-bacon-cake-pops/#wprm-recipe-51121-step-0-18",
        "image": "https://www.ruled.me/wp-content/uploads/2014/05/IMG_4166.jpg"
      },
      {
        "@type": "HowToStep",
        "text": "Poke the lollipop sticks into the cake pops and dip each one in the caramel sauce.",
        "name": "Poke the lollipop sticks into the cake pops and dip each one in the caramel sauce.",
        "url": "https://www.ruled.me/salted-caramel-glazed-maple-bacon-cake-pops/#wprm-recipe-51121-step-0-19",
        "image": "https://www.ruled.me/wp-content/uploads/2014/05/IMG_4171.jpg"
      },
      {
        "@type": "HowToStep",
        "text": "Arrange the cake pops by sticking them into an egg carton and sprinkling over a few small pieces of bacon. Refrigerate for 20–40 minutes (or longer if needed).",
        "name": "Arrange the cake pops by sticking them into an egg carton and sprinkling over a few small pieces of bacon. Refrigerate for 20–40 minutes (or longer if needed).",
        "url": "https://www.ruled.me/salted-caramel-glazed-maple-bacon-cake-pops/#wprm-recipe-51121-step-0-20",
        "image": "https://www.ruled.me/wp-content/uploads/2014/05/IMG_4184.jpg"
      },
      {
        "@type": "HowToStep",
        "text": "Enjoy!",
        "name": "Enjoy!",
        "url": "https://www.ruled.me/salted-caramel-glazed-maple-bacon-cake-pops/#wprm-recipe-51121-step-0-21"
      }
    ],
