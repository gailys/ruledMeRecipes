  "language": "en",
  "description": "This makes a total of 36 servings of Maple Bacon Cake Pops with Salted Caramel Glaze. Each serving comes out to be 69 calories, 6.1g fats, 0.6g net carbs, and 2.2g protein.",
  "servings": 36,
  "yield": [
    "36",
    "36 servings"
  ],
  "prepTime": "PT30M",
  "cookTime": "PT60M",
  "totalTime": "PT90M",
  "totalMinutes": 90,
  "nutrition": {
    "@type": "NutritionInformation",
