  "ingredients": [
    "2 1/2 cup almond flour",
    "1/2 teaspoon salt",
    "1/2 teaspoon baking soda",
    "1/2 cup erythritol",
    "1/2 cup butter",
    "1 tablespoon vanilla extract",
    "1/2 cup low-carb dark chocolate chips",
    "2 large egg",
    "1/4 cup walnuts (chopped)"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 350F. In a large bowl, combine the almond flour, salt, baking soda, and erythritol.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-chocolate-chip-cookies/#wprm-recipe-50355-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/10/chocolate_chip_cookies-2.jpg"
    },
    {
      "text": "In a separate bowl, melt the butter and mix in the vanilla, dark chocolate chips, eggs, and walnuts. Mix the wet ingredients into the dry ingredients to form a cohesive cookie dough.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-chocolate-chip-cookies/#wprm-recipe-50355-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/10/chocolate_chip_cookies-7.jpg"
    },
    {
      "text": "Place spoonfuls of the dough on a parchment-lined baking sheet, flattening or shaping them as needed.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-chocolate-chip-cookies/#wprm-recipe-50355-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/10/chocolate_chip_cookies-9.jpg"
    },
    {
      "text": "Bake for 8–10 minutes, or until the edges have turned golden brown. Keep an eye on these, as they can burn quite quickly. Cool on a cooling rack for 10–15 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-chocolate-chip-cookies/#wprm-recipe-50355-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/10/chocolate_chip_cookies-14.jpg"
    },
    {
      "text": "Serve and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-chocolate-chip-cookies/#wprm-recipe-50355-step-0-4",
      "imageSource": null
    }
  ],
