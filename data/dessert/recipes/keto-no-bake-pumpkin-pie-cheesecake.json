  "ingredients": [
    "3/4 cup almond flour",
    "1/2 cup flaxseed meal",
    "1 teaspoon pumpkin pie spice",
    "1/4 cup butter",
    "25 drop liquid stevia",
    "4 ounce cream cheese (softened)",
    "1/3 cup pumpkin puree",
    "1/4 cup heavy whipping cream",
    "3 tablespoon butter",
    "2 tablespoon sour cream",
    "1/4 teaspoon pumpkin pie spice",
    "25 drop liquid stevia"
  ],
  "instructions": [
    {
      "text": "Combine the dry ingredients for the crust and mix together well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-no-bake-pumpkin-pie-cheesecake/#wprm-recipe-51827-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/10/IMG_4564.jpg"
    },
    {
      "text": "Add the butter and liquid stevia to the dry ingredients and combine to form a dough.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-no-bake-pumpkin-pie-cheesecake/#wprm-recipe-51827-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/10/IMG_4569.jpg"
    },
    {
      "text": "Roll the dough into small spheres, placing one in each of the mini tart pans.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-no-bake-pumpkin-pie-cheesecake/#wprm-recipe-51827-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/10/IMG_4575.jpg"
    },
    {
      "text": "Press the dough flat, making sure it reaches up the sides of the tart pans.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-no-bake-pumpkin-pie-cheesecake/#wprm-recipe-51827-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/10/IMG_4579.jpg"
    },
    {
      "text": "Combine all of the filling ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-no-bake-pumpkin-pie-cheesecake/#wprm-recipe-51827-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/10/IMG_4582.jpg"
    },
    {
      "text": "Use an immersion blender to blend well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-no-bake-pumpkin-pie-cheesecake/#wprm-recipe-51827-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/10/IMG_4586.jpg"
    },
    {
      "text": "Once smooth, spread the filling ingredients into the crust and place in the refrigerator for at least 4 hours.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-no-bake-pumpkin-pie-cheesecake/#wprm-recipe-51827-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/10/IMG_4589.jpg"
    },
    {
      "text": "Take out of the refrigerator, slice, and top with extra whipped cream if desired.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-no-bake-pumpkin-pie-cheesecake/#wprm-recipe-51827-step-0-7",
      "imageSource": null
