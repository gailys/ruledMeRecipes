  "ingredients": [
    "2 ounce unsweetened baking chocolate",
    "3 tablespoon butter",
    "2 tablespoon powdered erythritol",
    "2 tablespoon butter (softened)",
    "1/2 cup erythritol",
    "2 large egg",
    "1/4 cup unsweetened almond milk",
    "1 teaspoon vanilla extract",
    "1 cup almond flour",
    "1 tablespoon psyllium husk powder",
    "1 tablespoon baking powder",
    "1/3 cup walnuts",
    "1 tablespoon erythritol",
    "1/2 tablespoon butter",
    "salt (to Taste)",
    "1 tablespoon unsweetened shredded coconut (optional garnish)"
  ],
  "instructions": [
    {
      "text": "Heat oven to 350F and prepare a welled donut pan with non-stick cooking spray. Cream the softened butter and sweetener together until they are evenly mixed.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/toffee-nut-cake-donuts/#wprm-recipe-52623-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/06/toffee-nut-cake-donuts-01.jpg"
    },
    {
      "text": "Add the eggs and beat with a hand mixer or whisk until the eggs are light and frothy.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/toffee-nut-cake-donuts/#wprm-recipe-52623-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/06/toffee-nut-cake-donuts-02-1.jpg"
    },
    {
      "text": "Pour in almond milk and vanilla and beat again just to make sure all of the ingredients are mixed well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/toffee-nut-cake-donuts/#wprm-recipe-52623-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/06/toffee-nut-cake-donuts-03.jpg"
    },
    {
      "text": "Using a sifter or mesh colander, add half of the dry ingredients to the wet and mix well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/toffee-nut-cake-donuts/#wprm-recipe-52623-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/06/toffee-nut-cake-donuts-04.jpg"
    },
    {
      "text": "Finish by sifting in the remaining dry ingredients and stir until a batter forms.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/toffee-nut-cake-donuts/#wprm-recipe-52623-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/06/toffee-nut-cake-donuts-05.jpg"
    },
    {
      "text": "Pour batter into prepared donut pan and bake for 20 minutes or until the donuts begin to brown. Cool completely before removing from pan.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/toffee-nut-cake-donuts/#wprm-recipe-52623-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/06/toffee-nut-cake-donuts-06.jpg"
    },
    {
      "text": "Melt unsweetened chocolate and butter in a microwave safe dish. Mix in powdered sweetener and set aside until the donuts are ready for dipping.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/toffee-nut-cake-donuts/#wprm-recipe-52623-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/06/toffee-nut-cake-donuts-07.jpg"
    },
    {
      "text": "Heat nuts, sweetener, and butter in a small microwave safe dish for 45 seconds at a time, stirring frequently until the nuts begin to caramelize.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/toffee-nut-cake-donuts/#wprm-recipe-52623-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/06/toffee-nut-cake-donuts-08.jpg"
    },
    {
      "text": "Spread nuts on parchment paper and sprinkle with salt. Chop if you prefer them smaller.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/toffee-nut-cake-donuts/#wprm-recipe-52623-step-0-8",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/06/toffee-nut-cake-donuts-09.jpg"
    },
    {
      "text": "Dip the donuts in the liquid chocolate or drizzle over the top.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/toffee-nut-cake-donuts/#wprm-recipe-52623-step-0-9",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/06/toffee-nut-cake-donuts-10.jpg"
    },
    {
      "text": "Top with toffee nuts and optional shredded coconut. Store in an air tight container.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/toffee-nut-cake-donuts/#wprm-recipe-52623-step-0-10",
      "imageSource": null
    }
  ],
