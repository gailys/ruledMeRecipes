  "ingredients": [
    "2 1/3 cup almond flour",
    "1 teaspoon baking powder",
    "1/2 teaspoon sea salt",
    "1/2 teaspoon xanthan gum",
    "3/4 cup stevia/erythritol blend",
    "2 tablespoon lemon zest",
    "2 tablespoon butter (melted)",
    "3 large egg",
    "3/4 cup unsweetened almond milk",
    "1 tablespoon vanilla extract",
    "2 teaspoon lemon extract",
    "16 ounce cream cheese (softened)",
    "2 tablespoon butter",
    "1/3 cup stevia/erythritol blend",
    "3/4 cup frozen raspberries",
    "3 tablespoon heavy whipping cream",
    "1 teaspoon lemon juice",
    "1 teaspoon vanilla extract"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 350F and line a cupcake pan with papers.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/lemon-cupcakes-raspberry-frosting/#wprm-recipe-52333-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/09/lemon-cupcakes-n-raspberry-frosting-01.jpg"
    },
    {
      "text": "In a large bowl, whisk together almond flour, baking powder, salt, xanthan gum, sweetener, and zest until combined.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/lemon-cupcakes-raspberry-frosting/#wprm-recipe-52333-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/09/lemon-cupcakes-n-raspberry-frosting-02.jpg"
    },
    {
      "text": "Whisk melted butter into the dry ingredients. The mixture should form into coarse crumbs.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/lemon-cupcakes-raspberry-frosting/#wprm-recipe-52333-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/09/lemon-cupcakes-n-raspberry-frosting-03.jpg"
    },
    {
      "text": "Add eggs and stir until incorporated. The batter will begin to stick together.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/lemon-cupcakes-raspberry-frosting/#wprm-recipe-52333-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/09/lemon-cupcakes-n-raspberry-frosting-04.jpg"
    },
    {
      "text": "Add almond milk, vanilla, and lemon extract and whisk until the batter is smooth.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/lemon-cupcakes-raspberry-frosting/#wprm-recipe-52333-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/09/lemon-cupcakes-n-raspberry-frosting-05.jpg"
    },
    {
      "text": "Carefully fill the prepared cupcake papers until they are about ¾ full—about 2 heaping tablespoons for each cupcake.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/lemon-cupcakes-raspberry-frosting/#wprm-recipe-52333-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/09/lemon-cupcakes-n-raspberry-frosting-06.jpg"
    },
    {
      "text": "Place cupcakes in preheated oven and bake for 29-32 minutes or until the cupcake bounces back when pressed.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/lemon-cupcakes-raspberry-frosting/#wprm-recipe-52333-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/09/lemon-cupcakes-n-raspberry-frosting-07.jpg"
    },
    {
      "text": "Let cupcakes cool on a rack until they reach room temperature before frosting.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/lemon-cupcakes-raspberry-frosting/#wprm-recipe-52333-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/09/lemon-cupcakes-n-raspberry-frosting-08.jpg"
    },
    {
      "text": "In a large bowl, whip together cream cheese and butter using an electric mixer.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/lemon-cupcakes-raspberry-frosting/#wprm-recipe-52333-step-0-8",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/09/lemon-cupcakes-n-raspberry-frosting-09.jpg"
    },
    {
      "text": "Blend in sweetener and frozen raspberries until combined.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/lemon-cupcakes-raspberry-frosting/#wprm-recipe-52333-step-0-9",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/09/lemon-cupcakes-n-raspberry-frosting-10.jpg"
    },
    {
      "text": "Add whipping cream, lemon juice, and vanilla and blend until smooth.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/lemon-cupcakes-raspberry-frosting/#wprm-recipe-52333-step-0-10",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/09/lemon-cupcakes-n-raspberry-frosting-11.jpg"
    },
    {
      "text": "Using a piping bag, frost cupcakes as desired.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/lemon-cupcakes-raspberry-frosting/#wprm-recipe-52333-step-0-11",
      "imageSource": null
    }
  ],
