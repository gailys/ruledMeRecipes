  "ingredients": [
    "2 cup almond flour",
    "1 cup erythritol",
    "2 teaspoon ground ginger",
    "1/2 teaspoon ground cinnamon",
    "1/4 teaspoon ground nutmeg",
    "1/4 teaspoon ground cloves",
    "1/4 teaspoon salt",
    "1/4 cup butter (unsalted)",
    "1 large egg",
    "1 teaspoon vanilla extract"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 350F. Combine the dry ingredients in a large mixing bowl.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-gingersnap-cookies/#wprm-recipe-51987-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/11/Gingersnap-Cookies-2.jpg"
    },
    {
      "text": "In a small bowl, stir together the melted unsalted butter, egg, and vanilla extract until well combined.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-gingersnap-cookies/#wprm-recipe-51987-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/11/Gingersnap-Cookies-3.jpg"
    },
    {
      "text": "Add the wet ingredients to the dry ingredients. Blend with a hand mixer until combined. The cookie batter should be slightly stiff and crumbly.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-gingersnap-cookies/#wprm-recipe-51987-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/11/Gingersnap-Cookies-4.jpg"
    },
    {
      "text": "Use a tablespoon to measure out even spoonfuls. Flatten the top of each cookie with a spatula.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-gingersnap-cookies/#wprm-recipe-51987-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/11/Gingersnap-Cookies-5.jpg"
    },
    {
      "text": "Bake for 10–12 minutes, until lightly browned on top.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-gingersnap-cookies/#wprm-recipe-51987-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/12/Gingersnap-Cookies-620x900-3.jpg"
    }
