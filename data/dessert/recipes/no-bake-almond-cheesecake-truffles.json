  "category": "dessert",
  "language": "en",
  "description": "This makes a total of 5 servings of No Bake Almond Cheesecake Truffles. Each serving comes out to be 397 calories, 38.1g fats, 4.4g net carbs, and 8.8g protein.",
  "servings": 5,
  "yield": [
    "5",
    "5 servings"
  ],
  "prepTime": "PT30M",
  "cookTime": "PT0M",
  "totalTime": "PT30M",
  "totalMinutes": 30,
  "nutrition": {
    "@type": "NutritionInformation",
    "calories": "397 kcal",
    "fatContent": "38.1 g",
