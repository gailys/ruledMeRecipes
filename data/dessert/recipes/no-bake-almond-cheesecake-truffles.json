    "calories": 397,
    "netCarbsGrams": 4.4,
    "proteinGrams": 8.8,
    "fatGrams": 38.1
  },
  "ingredients": [
    "1/4 cup cream cheese",
    "1/2 cup almond flour",
    "2 tablespoon unsweetened shredded coconut",
    "3 teaspoon stevia/erythritol blend",
    "1/8 teaspoon vanilla extract",
    "1/8 teaspoon almond extract",
    "8 tablespoon butter (room temp)",
    "4 tablespoon stevia/erythritol blend",
    "5 large egg white",
    "salt (dash)",
    "1/8 cup almonds",
    "1 teaspoon coconut oil",
    "1/4 cup low-carb dark chocolate chips",
    "2 tablespoon unsweetened shredded coconut",
    "2 tablespoon almonds (chopped )"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all of the ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/no-bake-almond-cheesecake-truffles/#wprm-recipe-60288-step-0-0",
      "imageSource": null
    },
    {
      "text": "Combine all of the ingredients for the truffles in a bowl sans almonds. Stir to combine well. Place this in the freezer for 5 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/no-bake-almond-cheesecake-truffles/#wprm-recipe-60288-step-0-1",
      "imageSource": null
    },
    {
      "text": "Remove from freezer and roll into small balls. Put an almond in each of the balls.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/no-bake-almond-cheesecake-truffles/#wprm-recipe-60288-step-0-2",
      "imageSource": null
    },
    {
      "text": "Place back in the freezer for about 10 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/no-bake-almond-cheesecake-truffles/#wprm-recipe-60288-step-0-3",
      "imageSource": null
    },
    {
      "text": "Meanwhile, place the coconut oil and chocolate chips in a microwave safe bowl. Heat in the microwave in 30 second increments, stirring every 30 seconds until completely melted.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/no-bake-almond-cheesecake-truffles/#wprm-recipe-60288-step-0-4",
      "imageSource": null
    },
    {
      "text": "On a plate, add the shredded coconut and chopped almonds.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/no-bake-almond-cheesecake-truffles/#wprm-recipe-60288-step-0-5",
      "imageSource": null
    },
    {
      "text": "Remove the balls from the freezer and dip into the melted chocolate. Then coat them with the coconut and chopped almonds.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/no-bake-almond-cheesecake-truffles/#wprm-recipe-60288-step-0-6",
      "imageSource": null
    },
    {
      "text": "Once the truffles are done, place them on a baking sheet with parchment paper.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/no-bake-almond-cheesecake-truffles/#wprm-recipe-60288-step-0-7",
      "imageSource": null
    },
    {
      "text": "Place in the freezer for about 10 minutes or until the chocolate is set.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/no-bake-almond-cheesecake-truffles/#wprm-recipe-60288-step-0-8",
      "imageSource": null
    },
    {
      "text": "Store in the refrigerator. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/no-bake-almond-cheesecake-truffles/#wprm-recipe-60288-step-0-9",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/05/no-bake-almond-cheesecake-truffles-step-01.jpeg"
    }
  ],
