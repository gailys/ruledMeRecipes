  },
  "ingredients": [
    "1 cup macadamia nuts",
    "3/4 cup cashews",
    "1 teaspoon vanilla extract",
    "1/4 teaspoon ground cinnamon",
    "1/4 teaspoon ground ginger",
    "1/8 teaspoon ground nutmeg",
    "1/8 teaspoon ground cloves",
    "salt (to taste)",
    "2 tablespoon butter",
    "2 tablespoon stevia/erythritol blend (such as Swerve, powdered)",
    "2 tablespoon heavy whipping cream"
  ],
  "instructions": [
    {
      "text": "Measure out the raw macadamias and cashews.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-cookie-butter/#wprm-recipe-51411-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/09/img_6503.jpg"
    },
    {
      "text": "Pulse the nuts in a food processor until beginning to turn crumbly.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-cookie-butter/#wprm-recipe-51411-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/09/img_6507.jpg"
    },
    {
      "text": "Add in the vanilla, spices, and a pinch of salt, and continue to process until smooth.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-cookie-butter/#wprm-recipe-51411-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/09/img_6523.jpg"
    },
    {
      "text": "In a pan, combine the butter and powdered sweetener. Let the mixture cook down until slightly browned. Once browned, add the heavy cream and remove from the heat. Stir together well to form a thick syrup.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-cookie-butter/#wprm-recipe-51411-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/09/img_6545.jpg"
    },
    {
      "text": "Slowly pour the syrup into the food processor while it's running.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-cookie-butter/#wprm-recipe-51411-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/09/img_6570.jpg"
    },
    {
      "text": "Remove the cookie butter from the food processor and enjoy or store in a mason jar for later use.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-cookie-butter/#wprm-recipe-51411-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/09/img_6579.jpg"
    }
  ],
