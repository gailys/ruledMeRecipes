    "1/4 teaspoon baking powder",
    "1/2 teaspoon pumpkin pie spice"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all of the ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pumpkin-mug-cake/#wprm-recipe-54619-step-0-0",
