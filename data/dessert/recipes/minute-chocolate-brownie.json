    "fatGrams": 11
  },
  "ingredients": [
    "1 large egg",
    "1 tablespoon heavy whipping cream",
    "2 tablespoon unsweetened almond milk",
    "5 drop liquid stevia",
    "33 gram low-carb chocolate protein powder (such as Isopure)"
  ],
  "instructions": [
    {
      "text": "Crack the egg into a small mug.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/minute-chocolate-brownie/#wprm-recipe-50441-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/11/FindingtheRightSizeMug.jpg"
    },
    {
      "text": "Add the heavy cream, almond milk, and stevia. Mix together well, until the mixture is solid in color.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/minute-chocolate-brownie/#wprm-recipe-50441-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/11/AddSteviaCreamAlmondMilk.jpg"
    },
    {
      "text": "Add half of the protein powder, stir, and then add the other half.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/minute-chocolate-brownie/#wprm-recipe-50441-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/11/ProteinPowderScoop.jpg"
    },
    {
      "text": "Mix well to combine. Don't worry if there are still a few little lumps; they tend to dissolve while cooking in the microwave.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/minute-chocolate-brownie/#wprm-recipe-50441-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/11/AddProteinPowder.jpg"
    },
    {
      "text": "Microwave for 45–60 seconds on regular power.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/minute-chocolate-brownie/#wprm-recipe-50441-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/11/MinuteBrownieMixedTogether.jpg"
    },
    {
      "text": "Keep an eye on the mug as it cooks, stopping the microwave when the mixture begins to rise.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/minute-chocolate-brownie/#wprm-recipe-50441-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/11/MicrowavingKetoBrownie.jpg"
    },
    {
      "text": "Mix the brownie up to let the liquid soak into the semi-dry brownie portion. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/minute-chocolate-brownie/#wprm-recipe-50441-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/11/FinishedMicrowavingKetoBrownie.jpg"
    }
  ],
