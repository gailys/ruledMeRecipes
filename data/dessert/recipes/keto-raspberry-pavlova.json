  "ingredients": [
    "4 large egg white",
    "1/2 cup erythritol",
    "1 teaspoon vanilla extract",
    "1 teaspoon lemon juice",
    "2 teaspoon xanthan gum",
    "1 cup raspberries",
    "2 teaspoon fresh mint (leaves)",
    "1 cup frozen berries",
    "1 cup heavy whipping cream"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 300F. Separate the eggs carefully and beat the egg whites until foamy. There shouldn't be any egg yolk in the bowl!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-raspberry-pavlova/#wprm-recipe-51921-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/07/1Beat-eggs.jpg"
    },
    {
      "text": "Slowly add the erythritol, beating the mixture until stiff peaks form. Once stiff, add the vanilla, lemon juice, and xanthan gum, gently folding them in using a silicone spatula.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-raspberry-pavlova/#wprm-recipe-51921-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/07/2Until-stiff-peak-form.jpg"
    },
    {
      "text": "Line a baking sheet with parchment paper. Trace a bowl or cup as many times as needed to use as a guide for where to spoon the mixture.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-raspberry-pavlova/#wprm-recipe-51921-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/07/3Draw-guides.jpg"
    },
    {
      "text": "Spoon the pavlova batter into each circle. Use a spoon to create a well in each pavlova for the filling.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-raspberry-pavlova/#wprm-recipe-51921-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/07/4Form-pavlova-shapes.jpg"
    },
    {
      "text": "Bake for 1 hour, or until the pavlovas are a crisp, golden brown. Remove from the oven and let cool.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-raspberry-pavlova/#wprm-recipe-51921-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/07/5Baked.jpg"
    },
    {
      "text": "While the pavlovas are cooling, prepare the creamy filling. Add the frozen berries to a blender or food processor.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-raspberry-pavlova/#wprm-recipe-51921-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/07/6Frozen-berries.jpg"
    },
    {
      "text": "Blend with a cup of heavy cream for about 3 minutes, or until the mixture is thick enough to spoon.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-raspberry-pavlova/#wprm-recipe-51921-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/07/7Blend-with-cream.jpg"
    },
    {
      "text": "Spoon the frozen berry mixture into each pavlova.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-raspberry-pavlova/#wprm-recipe-51921-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/07/8Spoon-filling.jpg"
    },
    {
      "text": "Garnish with the fresh raspberries and mint before serving. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-raspberry-pavlova/#wprm-recipe-51921-step-0-8",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/07/RaspberryPavlovaLong.jpg"
    }
  ],
