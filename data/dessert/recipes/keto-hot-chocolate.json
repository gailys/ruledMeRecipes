  ],
  "instructions": [
    {
      "text": "Measure out and prepare all of the ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-hot-chocolate/#wprm-recipe-54669-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/07/keto-hot-chocolate-1.jpg"
    },
    {
      "text": "In a saucepan, add the cocoa powder and allulose. Whisk until combined well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-hot-chocolate/#wprm-recipe-54669-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/07/keto-hot-chocolate-2.jpg"
    },
    {
      "text": "Add in the heavy cream a little bit at a time. Whisk to combine well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-hot-chocolate/#wprm-recipe-54669-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/07/keto-hot-chocolate-3.jpg"
    },
    {
      "text": "Add in the almond milk slowly over medium heat. Whisk constantly until everything is combined well. Heat until the mixture is hot.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-hot-chocolate/#wprm-recipe-54669-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/07/keto-hot-chocolate-4.jpg"
    },
    {
      "text": "Remove from heat and add in the vanilla extract.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-hot-chocolate/#wprm-recipe-54669-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/07/keto-hot-chocolate-5.jpg"
    },
    {
      "text": "Pour into glasses. Serve and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-hot-chocolate/#wprm-recipe-54669-step-0-5",
      "imageSource": null
    }
