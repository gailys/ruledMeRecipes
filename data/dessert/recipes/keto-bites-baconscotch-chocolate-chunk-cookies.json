  "description": "This makes a total of 24 servings of Baconscotch Chocolate Chunk Cookies. Each serving comes out to be 107 calories, 9.7g fats, 1.2g net carbs, and 2.4g protein.",
  "servings": 24,
  "yield": [
    "24",
    "24 servings"
  ],
  "prepTime": "PT15M",
  "cookTime": "PT35M",
  "totalTime": "PT50M",
  "totalMinutes": 50,
  "nutrition": {
    "@type": "NutritionInformation",
    "calories": "107 kcal",
    "fatContent": "9.7 g",
    "proteinContent": "2.4 g",
    "carbohydrateContent": "1.2 g",
    "servingSize": "1 serving"
  },
