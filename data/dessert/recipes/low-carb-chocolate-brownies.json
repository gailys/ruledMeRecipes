  "ingredients": [
    "1/3 cup erythritol",
    "1/4 cup coconut oil",
    "1/4 cup low-carb maple syrup",
    "2 large egg",
    "2 tablespoon sugar-free salted caramel syrup (such as Torani)",
    "2 cup almond flour",
    "1/2 cup unsweetened dark cocoa powder",
    "1 tablespoon psyllium husk powder",
    "1 teaspoon baking powder",
    "1/2 teaspoon salt"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 350F. Add erythritol, coconut oil, maple syrup, eggs, and Torani Salted Caramel syrup to a bowl.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-chocolate-brownies/#wprm-recipe-51305-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/08/img_3223.jpg"
    },
    {
      "text": "In a separate bowl, combine almond flour, unsweetened cocoa powder, psyllium husk powder, baking powder, and salt. Mix together well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-chocolate-brownies/#wprm-recipe-51305-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/08/img_3225.jpg"
    },
    {
      "text": "Beat the wet ingredients together using a hand mixer until a consistent mixture is formed. Slowly pour the wet ingredients into the dry ingredients while mixing.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-chocolate-brownies/#wprm-recipe-51305-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/08/img_3239.jpg"
    },
    {
      "text": "Press the batter into a non-stick baking pan, then smooth out the top. Don't worry too much if there are any bits of solidified coconut oil on top; these will melt as the brownies bake.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-chocolate-brownies/#wprm-recipe-51305-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/08/img_3243.jpg"
    },
    {
      "text": "Bake for 20 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-chocolate-brownies/#wprm-recipe-51305-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/08/img_3248.jpg"
    },
    {
      "text": "Remove from the oven. If you'd like, you can sprinkle some sf chocolate chips on top to melt. (Be sure to add them to your macros.) Let cool, then remove from the pan.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-chocolate-brownies/#wprm-recipe-51305-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/08/img_3256.jpg"
    },
    {
      "text": "Slice and serve.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-chocolate-brownies/#wprm-recipe-51305-step-0-6",
      "imageSource": null
    }
  ],
