  "ingredients": [
    "1 cup almond flour",
    "1/2 teaspoon baking powder",
    "1/4 teaspoon salt",
    "1/3 cup erythritol",
    "1/3 cup unsweetened shredded coconut",
    "3 tablespoon coconut flour",
    "1/4 cup unsweetened dark cocoa powder",
    "2 large egg (room temperature)",
    "1/4 cup coconut oil",
    "1 teaspoon vanilla extract"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 350F. In a large mixing bowl, combine the almond flour, baking powder, salt, erythritol, and unsweetened shredded coconut.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chocolate-coconut-macaroon-cookies/#wprm-recipe-51639-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/03/img_6756.jpg"
    },
    {
      "text": "Add the coconut flour and cocoa powder and continue to mix until well combined.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chocolate-coconut-macaroon-cookies/#wprm-recipe-51639-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/03/img_6759.jpg"
    },
    {
      "text": "Add the wet ingredients and mix together again.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chocolate-coconut-macaroon-cookies/#wprm-recipe-51639-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/03/img_6761.jpg"
    },
    {
      "text": "Once the dough becomes too hard to stir, knead it into a ball by hand.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chocolate-coconut-macaroon-cookies/#wprm-recipe-51639-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/03/img_6764.jpg"
    },
    {
      "text": "Shape the dough into small balls and place on a baking sheet lined with parchment paper or Silpat. Place in the oven and bake for 15–20 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chocolate-coconut-macaroon-cookies/#wprm-recipe-51639-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/03/img_6773.jpg"
    },
    {
      "text": "Sprinkle a little bit of extra unsweetened coconut on top and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chocolate-coconut-macaroon-cookies/#wprm-recipe-51639-step-0-5",
      "imageSource": null
    }
