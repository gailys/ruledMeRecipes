  ],
  "instructions": [
    {
      "text": "Preheat oven to 400F. Break up scones into pieces with your hands. Microwave coconut milk until warm and pour milk over scones.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cinnamon-orange-souffle/#wprm-recipe-51033-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/04/IMG_92332.jpg"
    },
    {
      "text": "Separate eggs and beat egg whites until stiff peaks form. Beat egg yolks, butter, and allspice together.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cinnamon-orange-souffle/#wprm-recipe-51033-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/04/IMG_9245.jpg"
    },
    {
      "text": "Add egg yolk mixture to the scones and milk, then stir until everything is combined.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cinnamon-orange-souffle/#wprm-recipe-51033-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/04/IMG_9252.jpg"
    },
    {
      "text": "Carefully fold egg whites into mixture, then distribute batter among ramekins.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cinnamon-orange-souffle/#wprm-recipe-51033-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/04/IMG_9257.jpg"
    },
    {
      "text": "Bake for 40-50 minutes, let cool, and remove from ramekins.",
      "group": "",
