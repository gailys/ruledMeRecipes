  "ingredients": [
    "1 1/2 cup almonds",
    "3 tablespoon coconut oil",
    "2 tablespoon allulose",
    "1 1/2 cup almonds (blanched)",
    "1 cup canned coconut milk",
    "1/3 cup coconut oil",
    "6 tablespoon allulose",
    "2 teaspoon almond extract",
    "salt (to taste)"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all o f the ingredients. Cut and line a springform pan with parchment paper.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-almond-cake/#wprm-recipe-54701-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/07/Keto-Almond-Cake-1.jpg"
    },
    {
      "text": "In a food processor, add the almonds, coconut oil, and allulose. Pulse to combine well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-almond-cake/#wprm-recipe-54701-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/07/Keto-Almond-Cake-2.jpg"
    },
    {
      "text": "In the parchment paper lined springform pan, press the crust mixture into the pan evenly.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-almond-cake/#wprm-recipe-54701-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/07/Keto-Almond-Cake-3.jpg"
    },
    {
      "text": "Boil water and soak the almonds in the hot, boiling water for 2 hours. Drain, rinse, and pat dry.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-almond-cake/#wprm-recipe-54701-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/07/Keto-Almond-Cake-4.jpg"
    },
    {
      "text": "In a food processor, blend the almonds until smooth.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-almond-cake/#wprm-recipe-54701-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/07/Keto-Almond-Cake-5.jpg"
    },
    {
      "text": "Add in the canned coconut milk, coconut oil, allulose, almond extract, and salt. Mix to combine well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-almond-cake/#wprm-recipe-54701-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/07/Keto-Almond-Cake-6.jpg"
    },
    {
      "text": "Pour the smoothed mixture on top of the crust in the springform pan. Refrigerate for at least 3 hours or until the cake is firm.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-almond-cake/#wprm-recipe-54701-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/07/Keto-Almond-Cake-7.jpg"
    },
    {
      "text": "Serve and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-almond-cake/#wprm-recipe-54701-step-0-7",
      "imageSource": null
    }
  ],
