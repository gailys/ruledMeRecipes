  "ingredients": [
    "1 large egg",
    "2 tablespoon almond flour",
    "1 tablespoon erythritol",
    "7 drop liquid stevia",
    "2 tablespoon butter (room temperature)",
    "1/2 teaspoon baking powder",
    "2 tablespoon almond flour",
    "1/4 teaspoon ground cinnamon",
    "1/4 teaspoon ground ginger",
    "1/4 teaspoon ground cloves",
    "1/4 teaspoon cardamom",
    "1/4 teaspoon vanilla extract"
  ],
  "instructions": [
    {
      "text": "Get a mug ready! Of course, I chose this fitting holiday mug to show off my love for chai!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chai-spice-keto-mug-cake/#wprm-recipe-50929-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_4303.jpg"
    },
    {
      "text": "Mix together the egg, almond flour, erythritol, and stevia.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chai-spice-keto-mug-cake/#wprm-recipe-50929-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_4309.jpg"
    },
    {
      "text": "Add the butter and baking powder and mix again.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chai-spice-keto-mug-cake/#wprm-recipe-50929-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_4326.jpg"
    },
    {
      "text": "Add the spices and flavorings — almond flour, cinnamon, ginger, cloves, cardamom, and vanilla extract. Mix until fully combined.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chai-spice-keto-mug-cake/#wprm-recipe-50929-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_4338.jpg"
    },
    {
      "text": "Microwave on high (power level 10) for 70 seconds.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chai-spice-keto-mug-cake/#wprm-recipe-50929-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_4391.jpg"
    },
    {
      "text": "Turn the mug upside down and lightly tap it against a plate. The cake should slide out in one piece.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chai-spice-keto-mug-cake/#wprm-recipe-50929-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/chaispice.jpg"
    }
  ],
