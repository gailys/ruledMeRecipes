  "ingredients": [
    "2 tablespoon coconut flour",
    "2 tablespoon unsweetened cocoa powder",
    "2 tablespoon powdered stevia/erythritol blend",
    "1/4 teaspoon baking powder",
    "2 large egg",
    "2 tablespoon butter (melted)",
    "2 tablespoon unsweetened almond milk"
  ],
  "instructions": [
    {
      "text": "In a bowl mix together the coconut flour, unsweetened cocoa powder, confectioners sweetener, and baking powder.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/coconut-flour-chocolate-keto-mug-cake/#wprm-recipe-52786-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/11/coconut-flour-chocolate-keto-mug-cake-01.jpg"
    },
    {
      "text": "Add the eggs, melted butter, and almond milk to the dry ingredients. Mix well to combine.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/coconut-flour-chocolate-keto-mug-cake/#wprm-recipe-52786-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/11/coconut-flour-chocolate-keto-mug-cake-02.jpg"
    },
    {
      "text": "Add the cake batter to a greased coffee mug. You'll need one that holds at least 12 ounces.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/coconut-flour-chocolate-keto-mug-cake/#wprm-recipe-52786-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/11/coconut-flour-chocolate-keto-mug-cake-03.jpg"
    },
    {
      "text": "Cook the mug in the microwave for about 2 minutes, but start checking at 1 minute. Cooking time may vary with your microwave. Usually, I know it's done when the cake starts puffing up over the top of the mug and will pull away easily from the sides of the mug.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/coconut-flour-chocolate-keto-mug-cake/#wprm-recipe-52786-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/11/coconut-flour-chocolate-keto-mug-cake-05.jpg"
    },
    {
      "text": "Remove the finished cake from the mug and slice in half to serve.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/coconut-flour-chocolate-keto-mug-cake/#wprm-recipe-52786-step-0-4",
      "imageSource": null
