  "ingredients": [
    "2 cup heavy whipping cream",
    "1 cup unsweetened carton coconut milk",
    "4 large egg",
    "1 tablespoon vanilla extract",
    "2 teaspoon ground cinnamon",
    "1 teaspoon ground allspice",
    "4 tablespoon stevia/erythritol blend (such as Swerve)",
    "7 1/2 ounce clear rum"
  ],
  "instructions": [
    {
      "text": "Assemble the ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-keto-eggnog/#wprm-recipe-50481-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/12/creamy-delicious-keto-friendly-eggnog-step-01.jpg"
    },
    {
      "text": "Add the heavy cream and coconut milk to a mixing bowl.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-keto-eggnog/#wprm-recipe-50481-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/12/creamy-delicious-keto-friendly-eggnog-step-02.jpg"
    },
    {
      "text": "Separate the egg whites and yolks of 3/4 of the eggs into two different bowls, reserving one-quarter of the whole eggs for later.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-keto-eggnog/#wprm-recipe-50481-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/12/creamy-delicious-keto-friendly-eggnog-step-03.jpg"
    },
    {
      "text": "Whip the egg whites until soft peaks form. Whisk the egg yolks until creamy.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-keto-eggnog/#wprm-recipe-50481-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/12/creamy-delicious-keto-friendly-eggnog-step-04.jpg"
    },
    {
      "text": "Mix the egg whites into the cream and coconut milk mixture.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-keto-eggnog/#wprm-recipe-50481-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/12/creamy-delicious-keto-friendly-eggnog-step-05.jpg"
    },
    {
      "text": "Add the vanilla to the mixture.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-keto-eggnog/#wprm-recipe-50481-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/12/creamy-delicious-keto-friendly-eggnog-step-06.jpg"
    },
    {
      "text": "Add the spices and sweetener to the mixture. Mix the ingredients together well, ensuring that there are no lumps in the mixture.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-keto-eggnog/#wprm-recipe-50481-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/12/creamy-delicious-keto-friendly-eggnog-step-07.jpg"
    },
    {
      "text": "Whisk the remaining egg until consistent throughout (no whites showing). Mix this into the eggnog.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-keto-eggnog/#wprm-recipe-50481-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/12/creamy-delicious-keto-friendly-eggnog-step-08.jpg"
    },
    {
      "text": "Now for the rum! Pour it into the eggnog and mix well. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-keto-eggnog/#wprm-recipe-50481-step-0-8",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/12/creamy-delicious-keto-friendly-eggnog-step-09.jpg"
    }
