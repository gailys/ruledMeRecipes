  "ingredients": [
    "1/2 cup toasted pecans",
    "2 cup unsweetened carton coconut milk",
    "1/2 cup cottage cheese",
    "1/2 cup pumpkin puree",
    "1/3 cup erythritol",
    "3 large egg yolk",
    "2 tablespoon butter (salted)",
    "1 teaspoon pumpkin pie spice",
    "1 teaspoon maple extract",
    "1/2 teaspoon xanthan gum",
    "20 drop liquid stevia"
  ],
  "instructions": [
    {
      "text": "Chop the toasted pecans and add them to a pan with butter over gentle heat. If using raw pecans, place them in a pan and toast over low heat for about 7–10 minutes first.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/pumpkin-pecan-pie-ice-cream/#wprm-recipe-51835-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/11/IMG_6903.jpg"
    },
    {
      "text": "Place the remaining ingredients in a container with room for an immersion blender.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/pumpkin-pecan-pie-ice-cream/#wprm-recipe-51835-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/11/IMG_6881.jpg"
    },
    {
      "text": "Blend the ingredients together into a smooth mixture.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/pumpkin-pecan-pie-ice-cream/#wprm-recipe-51835-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/11/IMG_6890.jpg"
    },
    {
      "text": "Pour the mixture into an ice cream machine.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/pumpkin-pecan-pie-ice-cream/#wprm-recipe-51835-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/11/IMG_6894.jpg"
    },
    {
      "text": "Once the butter is browned and the pecans have soaked up some of the butter, add this mixture to the ice cream machine.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/pumpkin-pecan-pie-ice-cream/#wprm-recipe-51835-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/11/IMG_6909.jpg"
    },
    {
      "text": "Follow the manufacturer's instructions to churn the ice cream. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/pumpkin-pecan-pie-ice-cream/#wprm-recipe-51835-step-0-5",
