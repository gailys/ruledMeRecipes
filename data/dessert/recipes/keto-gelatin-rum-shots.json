  ],
  "instructions": [
    {
      "text": "Heat up half of the water in a mixing bowl, until the water is quite is hot. Pour in the unflavored gelatin and mix well. Stir in the remaining water and allow to cool slightly, but not enough for the gelatin to begin firming up.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-gelatin-rum-shots/#wprm-recipe-52169-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/04/keto-gelatin-rum-shots-step-01.jpg"
    },
    {
      "text": "Mix in the coconut extract and powdered erythritol. Taste the mixture, adding more erythritol as needed.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-gelatin-rum-shots/#wprm-recipe-52169-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/04/keto-gelatin-rum-shots-step-02.jpg"
    },
    {
      "text": "Stir in the rum.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-gelatin-rum-shots/#wprm-recipe-52169-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/04/keto-gelatin-rum-shots-step-03.jpg"
    },
    {
      "text": "Pour the liquid into the plastic cups. Place in the fridge for about an hour to firm up.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-gelatin-rum-shots/#wprm-recipe-52169-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/04/keto-gelatin-rum-shots-step-04.jpg"
    },
    {
      "text": "Serve and enjoy!",
      "group": "",
