  "ingredients": [
    "1 cup erythritol",
    "6 tablespoon butter (unsalted, melted)",
    "3 large egg",
    "2 teaspoon vanilla extract",
    "1 1/2 cup almond flour",
    "1 tablespoon ground cinnamon",
    "1/4 teaspoon salt",
    "1 teaspoon baking powder",
    "2 tablespoon butter (unsalted)",
    "1/4 cup heavy whipping cream",
    "2 tablespoon erythritol",
    "1 cup pecans (chopped)"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 350F. In a large mixing bowl, combine the erythritol and melted butter.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cinnamon-blondie-pecan-bars/#wprm-recipe-52099-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/02/Step-1-1.jpg"
    },
    {
      "text": "Add the eggs and vanilla extract and blend until smooth. Set aside.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cinnamon-blondie-pecan-bars/#wprm-recipe-52099-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/02/Step-2-1.jpg"
    },
    {
      "text": "In a separate bowl, combine the almond flour, cinnamon, salt, and baking powder.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cinnamon-blondie-pecan-bars/#wprm-recipe-52099-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/02/Step-3-1.jpg"
    },
    {
      "text": "Add the dry ingredients to the wet ingredients, using a hand blender to mix until smooth.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cinnamon-blondie-pecan-bars/#wprm-recipe-52099-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/02/Step-5-1.jpg"
    },
    {
      "text": "Lightly grease a baking pan and spread the batter evenly inside.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cinnamon-blondie-pecan-bars/#wprm-recipe-52099-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/02/Step-6-1.jpg"
    },
    {
      "text": "In a small frying pan, melt the butter for the pecan glaze. Cook until slightly browned.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cinnamon-blondie-pecan-bars/#wprm-recipe-52099-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/02/Step-7-1.jpg"
    },
    {
      "text": "Next, whisk in the heavy whipping cream and erythritol until the mixture begins to thicken.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cinnamon-blondie-pecan-bars/#wprm-recipe-52099-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/02/Step-8.jpg"
    },
    {
      "text": "Once bubbling, add the chopped pecans and mix for 3–5 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cinnamon-blondie-pecan-bars/#wprm-recipe-52099-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/02/Step-9.jpg"
    },
    {
      "text": "Layer the pecans on top of the cinnamon blondie batter.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cinnamon-blondie-pecan-bars/#wprm-recipe-52099-step-0-8",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/02/Step-10.jpg"
    },
    {
      "text": "Bake for 20–25 minutes or until the top of the pecans look like they are dry.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cinnamon-blondie-pecan-bars/#wprm-recipe-52099-step-0-9",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/02/Cinnamon-Blondie-Pecan-Bars-620x900.jpg"
    }
  ],
