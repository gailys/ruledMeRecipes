  "ingredients": [
    "1 cup unsweetened carton coconut milk",
    "1/3 cup heavy whipping cream",
    "1 teaspoon vanilla extract",
    "4 large egg",
    "1/3 cup erythritol",
    "1 teaspoon liquid stevia",
    "1/3 cup macadamia nut butter"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 325F. In a medium-sized mixing bowl, add the coconut milk, vanilla extract, and heavy cream.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/macadamia-coconut-keto-custard/#wprm-recipe-50721-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/01/macadamia-coconut-keto-custard-01.jpg"
    },
    {
      "text": "Add the eggs and begin to lightly whisk together. Do this gently to avoid aerating the eggs. Add the sweeteners and macadamia nut butter.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/macadamia-coconut-keto-custard/#wprm-recipe-50721-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/01/macadamia-coconut-keto-custard-02.jpg"
    },
    {
      "text": "Continue stirring until everything is combined evenly. Fill a small baking pan with about an inch of water. Place ramekins in the baking pan, ensuring sure that they are submerged in about 1 inch of water. Fill the ramekins with the custard mixture.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/macadamia-coconut-keto-custard/#wprm-recipe-50721-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/01/macadamia-coconut-keto-custard-04.jpg"
    },
    {
      "text": "Place in the oven and bake for about 40 minutes, or until a knife comes out clean. Once done, let cool for about 25 minutes while sitting in the water. Remove the ramekins from the water and allow to dry. Serve and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/macadamia-coconut-keto-custard/#wprm-recipe-50721-step-0-3",
      "imageSource": null
    }
  ],
