  "ingredients": [
    "5 tablespoon butter",
    "1/4 cup pecans (crushed)",
    "1/4 cup heavy whipping cream",
    "25 drop liquid stevia",
    "1 1/2 cup unsweetened carton coconut milk",
    "1/4 teaspoon xanthan gum"
  ],
  "instructions": [
    {
      "text": "Add the butter to a pan over low heat, stirring until melted and beginning to take on a deep amber color.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/brown-butter-pecan-keto-ice-cream/#wprm-recipe-51765-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/07/img_7636.jpg"
    },
    {
      "text": "Put the pecans in a plastic bag and crush (you can use a rolling pin for this).",
      "group": "",
      "sourceUrl": "https://www.ruled.me/brown-butter-pecan-keto-ice-cream/#wprm-recipe-51765-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/07/img_7642.jpg"
    },
    {
      "text": "Once the butter is browned, add in the heavy cream, stevia, and pecans. Stir together well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/brown-butter-pecan-keto-ice-cream/#wprm-recipe-51765-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/07/img_7648.jpg"
    },
    {
      "text": "Add the coconut milk, butter mixture, and xanthan gum to a container. Whisk everything together well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/brown-butter-pecan-keto-ice-cream/#wprm-recipe-51765-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/07/img_7656.jpg"
    },
    {
      "text": "Add the mixture to your ice cream machine and follow the manufacturer's instructions.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/brown-butter-pecan-keto-ice-cream/#wprm-recipe-51765-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/07/img_7659.jpg"
    },
    {
      "text": "Serve and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/brown-butter-pecan-keto-ice-cream/#wprm-recipe-51765-step-0-5",
      "imageSource": null
