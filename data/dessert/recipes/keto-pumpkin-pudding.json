  "ingredients": [
    "1/3 cup stevia/erythritol blend (such as Swerve)",
    "1 teaspoon xanthan gum",
    "1/2 teaspoon pumpkin pie spice",
    "salt (to taste)",
    "1/4 cup pumpkin puree",
    "3 large egg yolk",
    "1 teaspoon vanilla extract",
    "1 1/2 cup heavy whipping cream",
    "1 cup heavy whipping cream",
    "3 tablespoon stevia/erythritol blend (such as Swerve)",
    "1/2 teaspoon vanilla extract"
  ],
  "instructions": [
    {
      "text": "In a medium saucepan, whisk together the sweetener, xanthan gum, pumpkin spice, and salt until smooth.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pumpkin-pudding/#wprm-recipe-52015-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/12/DSC_5219.jpg"
    },
    {
      "text": "Add the pumpkin puree, egg yolks, and vanilla extract to the dry ingredients. Stir until thoroughly combined. Gradually add in the heavy whipping cream, whisking between each addition. Once all the cream has been added, turn on the heat to medium.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pumpkin-pudding/#wprm-recipe-52015-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/12/DSC_5224.jpg"
    },
    {
      "text": "Heat the pudding mixture, whisking constantly until the mixture thickens (about 4–7 minutes). Once thickened, remove from the heat and transfer to a bowl. Place the bowl in the fridge, removing to stir every 10 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pumpkin-pudding/#wprm-recipe-52015-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/12/DSC_5239.jpg"
    },
    {
      "text": "Meanwhile, in a medium bowl, whip cream with an electric mixer until stiff peaks form.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pumpkin-pudding/#wprm-recipe-52015-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/12/DSC_5253.jpg"
    },
    {
      "text": "Add the sweetener and vanilla extract and mix until just combined.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pumpkin-pudding/#wprm-recipe-52015-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/12/DSC_5260.jpg"
    },
    {
      "text": "Once the base mixture has cooled to room temperature, gently fold the whipped cream mixture into the pudding base until fully incorporated.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pumpkin-pudding/#wprm-recipe-52015-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/12/DSC_5267.jpg"
    },
    {
      "text": "Transfer the pudding into small serving cups, cover, and place in the fridge for at least 1–2 hours before serving.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pumpkin-pudding/#wprm-recipe-52015-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/12/pumpkinpudding.jpg"
    }
  ],
