  "ingredients": [
    "2 cup almond flour",
    "1 teaspoon baking powder",
    "1 cup allulose",
    "2 large egg",
    "1/2 cup butter (softened)",
    "1 tablespoon vanilla extract",
    "1/2 cup low-carb dark chocolate chips"
  ],
  "instructions": [
    {
      "text": "Gather and prep all ingredients. Pre-heat oven to 350F.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/easy-keto-blondies/#wprm-recipe-54909-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/09/Easy-Keto-Blondies-1.jpg"
    },
    {
      "text": "In a bowl, combine the almond flour and baking powder.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/easy-keto-blondies/#wprm-recipe-54909-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/09/Easy-Keto-Blondies-2.jpg"
    },
    {
      "text": "In a separate bowl, whisk together the allulose, eggs, butter, and vanilla extract until thick and light in color.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/easy-keto-blondies/#wprm-recipe-54909-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/09/Easy-Keto-Blondies-3.jpg"
    },
    {
      "text": "Add the wet ingredients into the dry, then mix until well combined and a batter forms.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/easy-keto-blondies/#wprm-recipe-54909-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/09/Easy-Keto-Blondies-4.jpg"
    },
    {
      "text": "Fold in the chocolate chips.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/easy-keto-blondies/#wprm-recipe-54909-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/09/Easy-Keto-Blondies-5.jpg"
    },
    {
      "text": "In a parchment-lined baking pan, add the dough and spread to distribute evenly.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/easy-keto-blondies/#wprm-recipe-54909-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/09/Easy-Keto-Blondies-6.jpg"
    },
    {
      "text": "Bake for 20-25 minutes or until a toothpick comes out clean. Once finished, remove from oven and let cool. Enjoy! NOTE: If blondies are golden brown at 20 minutes and not cooked through, you may need to cover the top with foil to stop from burning.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/easy-keto-blondies/#wprm-recipe-54909-step-0-6",
      "imageSource": null
    }
