  "ingredients": [
    "2 large egg",
    "1 medium avocado",
    "4 tablespoon butter (melted)",
    "4 tablespoon almond butter",
    "1/2 teaspoon baking soda",
    "1/4 teaspoon salt",
    "1/2 cup stevia/erythritol blend",
    "1/3 cup cocoa powder",
    "1 teaspoon vanilla extract"
  ],
  "instructions": [
    {
      "text": "Pre-heat oven to 350F. Prepare ingredients as needed.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-avocado-brownies/#wprm-recipe-53409-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/06/Flourless-avocado-brownies-1.jpg"
    },
    {
      "text": "Line a loaf pan with parchment paper and set aside.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-avocado-brownies/#wprm-recipe-53409-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/06/Flourless-avocado-brownies-3.jpg"
    },
    {
      "text": "In a food processor, combine all of the ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-avocado-brownies/#wprm-recipe-53409-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/06/Flourless-avocado-brownies-7.jpg"
    },
    {
      "text": "Pulse together until smooth, for about 30-45 seconds in total. Try not to overmix as the final product will become cakey if you do.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-avocado-brownies/#wprm-recipe-53409-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/06/Flourless-avocado-brownies-8.jpg"
    },
    {
      "text": "Transfer the batter to the loaf pan and bake for 25 minutes or until the edges begin to separate from the side.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-avocado-brownies/#wprm-recipe-53409-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/06/Flourless-avocado-brownies-10.jpg"
    },
    {
      "text": "Remove from the oven and let cool for 10-15 minutes. Slice into squares and store leftovers in an airtight container in the fridge for up to a week.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-avocado-brownies/#wprm-recipe-53409-step-0-5",
      "imageSource": null
    }
  ],
