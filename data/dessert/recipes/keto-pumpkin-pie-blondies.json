  "ingredients": [
    "1/2 cup butter (softened)",
    "1/2 cup erythritol",
    "1 large egg",
    "1 teaspoon ground cinnamon",
    "15 drop liquid stevia",
    "1/2 cup pumpkin puree",
    "1/8 teaspoon pumpkin pie spice",
    "1 teaspoon maple extract",
    "1/4 cup almond flour",
    "2 tablespoon coconut flour",
    "1 ounce pecans (chopped)"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 350F. Beat the softened butter and erythritol using an electric hand mixer.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pumpkin-pie-blondies/#wprm-recipe-51839-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/11/01Cream-butter-and-eryth.jpg"
    },
    {
      "text": "Add the egg and beat again until thoroughly combined.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pumpkin-pie-blondies/#wprm-recipe-51839-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/11/02Add-egg.jpg"
    },
    {
      "text": "Add the cinnamon and stevia for extra flavor and sweetness.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pumpkin-pie-blondies/#wprm-recipe-51839-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/11/03Add-cinnamon-and-stevia.jpg"
    },
    {
      "text": "Add the pumpkin puree, pumpkin pie spice, and maple extract.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pumpkin-pie-blondies/#wprm-recipe-51839-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/11/04Add-pumpkin-and-extracts.jpg"
    },
    {
      "text": "Finally, add in the almond flour and coconut flour, mixing until well combined.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pumpkin-pie-blondies/#wprm-recipe-51839-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/11/05Add-flours.jpg"
    },
    {
      "text": "Spray a brownie pan with coconut oil and pour in the blondie batter, spreading it into an even layer.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pumpkin-pie-blondies/#wprm-recipe-51839-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/11/06Spread-into-pan.jpg"
    },
    {
      "text": "Chop the pecans and sprinkle them on top of the blondies.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pumpkin-pie-blondies/#wprm-recipe-51839-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/11/07Sprinkle-pecans.jpg"
    },
    {
      "text": "Bake for 20–25 minutes. The top should be set and golden. A toothpick inserted into the middle should come out clean.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pumpkin-pie-blondies/#wprm-recipe-51839-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/11/08Bake-until-set.jpg"
    },
    {
      "text": "Serve and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pumpkin-pie-blondies/#wprm-recipe-51839-step-0-8",
      "imageSource": null
    }
  ],
