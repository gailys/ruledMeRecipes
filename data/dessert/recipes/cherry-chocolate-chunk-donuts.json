  "ingredients": [
    "salt (to taste)",
    "3/4 cup almond flour",
    "1/4 cup flaxseed meal",
    "3 tablespoon stevia/erythritol blend",
    "1 teaspoon baking powder",
    "2 large egg",
    "1 teaspoon vanilla extract",
    "2 1/2 tablespoon coconut oil",
    "3 tablespoon unsweetened carton coconut milk",
    "50 gram low-carb dark chocolate (such as ChocoPerfection)",
    "2 teaspoon berry extract",
    "15 drop red food coloring"
  ],
  "instructions": [
    {
      "text": "Mix all of the dry ingredients together.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cherry-chocolate-chunk-donuts/#wprm-recipe-51579-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/02/img_5045.jpg"
    },
    {
      "text": "Add the eggs, vanilla extract, coconut oil, and coconut milk to the batter.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cherry-chocolate-chunk-donuts/#wprm-recipe-51579-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/02/img_5052.jpg"
    },
    {
      "text": "Stir the batter well until clumps are gone. Chop the chocolate bar into chunks and fold into the batter.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cherry-chocolate-chunk-donuts/#wprm-recipe-51579-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/02/img_5055.jpg"
    },
    {
      "text": "Depending on if you want flavored or colored batter, add your optional berry extract and food coloring. Mix together well until all of the dough is uniform.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cherry-chocolate-chunk-donuts/#wprm-recipe-51579-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/02/img_5059.jpg"
    },
    {
      "text": "Plug your donut maker in and grease if needed. I use the BabyCakes Donut Maker. Put the batter into a Ziploc bag and cut the end off so that you can pipe the dough.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cherry-chocolate-chunk-donuts/#wprm-recipe-51579-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/02/img_5061.jpg"
    },
    {
      "text": "Once hot, pipe the batter into the donut maker, filling each well. Close the donut maker and wait about 4-5 minutes before flipping.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cherry-chocolate-chunk-donuts/#wprm-recipe-51579-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/02/img_5068.jpg"
    },
    {
      "text": "Flip each donut using the tool that came with the donut maker. Then, cook for another 2-3 minutes. Repeat the process with the other 6 donuts and set aside to cool.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cherry-chocolate-chunk-donuts/#wprm-recipe-51579-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/02/img_5072.jpg"
    },
    {
      "text": "Serve and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cherry-chocolate-chunk-donuts/#wprm-recipe-51579-step-0-7",
      "imageSource": null
    }
  ],
