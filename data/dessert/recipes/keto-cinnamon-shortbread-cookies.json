  "ingredients": [
    "1 cup almond flour",
    "3 tablespoon erythritol",
    "1/2 teaspoon baking soda",
    "1/4 teaspoon sea salt",
    "1 teaspoon vanilla extract",
    "1/4 cup butter (diced)",
    "2 teaspoon erythritol",
    "1 1/4 teaspoon ground cinnamon",
    "1 tablespoon powdered erythritol (for garnish)"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all the ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cinnamon-shortbread-cookies/#wprm-recipe-53721-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/03/Keto-Cinnamon-Shortbread-1.jpg"
    },
    {
      "text": "In a food processor, combine the almond flour, erythritol, baking soda, and sea salt. Pulse until combined well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cinnamon-shortbread-cookies/#wprm-recipe-53721-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/03/Keto-Cinnamon-Shortbread-2.jpg"
    },
    {
      "text": "Add the vanilla extract and butter to the food processor. Pulse until a thick dough starts to form.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cinnamon-shortbread-cookies/#wprm-recipe-53721-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/03/Keto-Cinnamon-Shortbread-3.jpg"
    },
    {
      "text": "On a piece of parchment paper, spread out dough into a rectangle.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cinnamon-shortbread-cookies/#wprm-recipe-53721-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/03/Keto-Cinnamon-Shortbread-4.jpg"
    },
    {
      "text": "Cover the dough with another piece of parchment paper. With a rolling pin, roll out the dough until the dough is about 3/8\" thick.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cinnamon-shortbread-cookies/#wprm-recipe-53721-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/03/Keto-Cinnamon-Shortbread-5.jpg"
    },
    {
      "text": "Put the dough in the refrigerator for about 30 minutes. It should get stiff but still be able to roll without crumbling.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cinnamon-shortbread-cookies/#wprm-recipe-53721-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/03/Keto-Cinnamon-Shortbread-6.jpg"
    },
    {
      "text": "In a bowl, combine the erythritol and cinnamon. Stir until combined well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cinnamon-shortbread-cookies/#wprm-recipe-53721-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/03/Keto-Cinnamon-Shortbread-7.jpg"
    },
    {
      "text": "Sprinkle this blend on the chilled cookie dough.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cinnamon-shortbread-cookies/#wprm-recipe-53721-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/03/Keto-Cinnamon-Shortbread-8.jpg"
    },
    {
      "text": "Using the parchment paper, gently lift up the cookie dough and roll it. Wrap the cookie dough with parchment paper and chill in the refrigerator for about an hour or until firm.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cinnamon-shortbread-cookies/#wprm-recipe-53721-step-0-8",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/03/Keto-Cinnamon-Shortbread-9.png"
    },
    {
      "text": "Take out and slice the dough. Preheat oven to 375F.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cinnamon-shortbread-cookies/#wprm-recipe-53721-step-0-9",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/03/Keto-Cinnamon-Shortbread-10.jpg"
    },
    {
      "text": "Line a baking sheet with parchment paper and spread out the cookies evenly.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cinnamon-shortbread-cookies/#wprm-recipe-53721-step-0-10",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/03/Keto-Cinnamon-Shortbread-11.jpg"
    },
    {
      "text": "Bake cookies for 9-10 minutes or until golden brown.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cinnamon-shortbread-cookies/#wprm-recipe-53721-step-0-11",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/03/Keto-Cinnamon-Shortbread-12.jpg"
    },
    {
      "text": "Let the cookies cool on the baking sheet for 5 minutes before taking off.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cinnamon-shortbread-cookies/#wprm-recipe-53721-step-0-12",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/03/Keto-Cinnamon-Shortbread-13.jpg"
    },
    {
      "text": "Sprinkle with powdered erythritol. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cinnamon-shortbread-cookies/#wprm-recipe-53721-step-0-13",
      "imageSource": null
    }
  ],
