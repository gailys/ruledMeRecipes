  "ingredients": [
    "3/4 cup pumpkin puree",
    "1/4 cup unsweetened sunflower seed butter",
    "1 large egg (room temperature)",
    "1/2 cup erythritol",
    "1/4 cup coconut flour (sifted)",
    "2 tablespoon flaxseed meal",
    "1 teaspoon ground cinnamon",
    "1/2 teaspoon ground nutmeg",
    "1/2 teaspoon baking soda",
    "1/2 teaspoon baking powder",
    "1/4 teaspoon salt",
    "3 tablespoon cream cheese (optional)"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 350F. Lightly grease a mini muffin pan. In a mixing bowl, combine the pumpkin, sunflower seed butter, and egg. Stir until smooth.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/mini-pumpkin-spice-muffins/#wprm-recipe-51945-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/10/mini-pumpkin-spice-muffins-step-01.jpg"
    },
    {
      "text": "Add all of the dry ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/mini-pumpkin-spice-muffins/#wprm-recipe-51945-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/10/mini-pumpkin-spice-muffins-step-02.jpg"
    },
    {
      "text": "Mix well to combine.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/mini-pumpkin-spice-muffins/#wprm-recipe-51945-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/10/mini-pumpkin-spice-muffins-step-03.jpg"
    },
    {
      "text": "Using a measuring spoon, scoop batter into the prepared pan. Bake for 15 minutes, then remove the pan from the oven and let cool completely.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/mini-pumpkin-spice-muffins/#wprm-recipe-51945-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/10/mini-pumpkin-spice-muffins-step-04.jpg"
    },
    {
      "text": "Carefully remove the muffins from the pan and transfer to a serving tray. Optional: Top the muffins with cream cheese.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/mini-pumpkin-spice-muffins/#wprm-recipe-51945-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/10/mini-pumpkin-spice-muffins-step-05.jpg"
    },
    {
      "text": "Enjoy!",
