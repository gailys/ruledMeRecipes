  "ingredients": [
    "5 large egg (separated)",
    "1 cup almond flour",
    "2 tablespoon coconut flour",
    "1 teaspoon baking powder",
    "2 tablespoon butter (salted)",
    "1/4 cup cream cheese (softened)",
    "1/4 cup erythritol",
    "1/4 teaspoon liquid stevia",
    "2 teaspoon blueberry extract",
    "2 teaspoon lime zest",
    "2 tablespoon lime juice",
    "1/4 cup blueberries"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 325F. Separate the egg yolks and whites into two mixing bowls.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/blueberry-lime-july-4th-cake/#wprm-recipe-51197-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/07/blueberry-lime-july-4th-cake-step-01.jpg"
    },
    {
      "text": "In a separate bowl, mix together the almond flour, coconut flour, and baking powder.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/blueberry-lime-july-4th-cake/#wprm-recipe-51197-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/07/blueberry-lime-july-4th-cake-step-02.jpg"
    },
    {
      "text": "Using a hand mixer, beat the egg yolks until pale in color.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/blueberry-lime-july-4th-cake/#wprm-recipe-51197-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/07/blueberry-lime-july-4th-cake-step-03.jpg"
    },
    {
      "text": "Add in the erythritol, liquid stevia, blueberry extract, butter, and cream cheese. Beat until smooth.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/blueberry-lime-july-4th-cake/#wprm-recipe-51197-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/07/blueberry-lime-july-4th-cake-step-04.jpg"
    },
    {
      "text": "Add lime zest and two-thirds of the lime juice to the egg yolk mixture, and mix until well incorporated.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/blueberry-lime-july-4th-cake/#wprm-recipe-51197-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/07/blueberry-lime-july-4th-cake-step-05.jpg"
    },
    {
      "text": "Sift the dry ingredients into the wet ingredients and mix well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/blueberry-lime-july-4th-cake/#wprm-recipe-51197-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/07/blueberry-lime-july-4th-cake-step-06.jpg"
    },
    {
      "text": "With clean and dry beaters, beat the egg whites with the remaining lime juice until stiff peaks form. Then, gently fold the whites into the batter.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/blueberry-lime-july-4th-cake/#wprm-recipe-51197-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/07/blueberry-lime-july-4th-cake-step-07.jpg"
    },
    {
      "text": "Pour the batter into loaf or cake pans and top with the blueberries. I used these awesome Threshold disposable cake pans from Target.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/blueberry-lime-july-4th-cake/#wprm-recipe-51197-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/07/blueberry-lime-july-4th-cake-step-08.jpg"
    },
    {
      "text": "Bake for 35–40 minutes or until a toothpick comes out clean. Let cool.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/blueberry-lime-july-4th-cake/#wprm-recipe-51197-step-0-8",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/07/blueberry-lime-july-4th-cake-step-09.jpg"
    },
    {
      "text": "Serve and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/blueberry-lime-july-4th-cake/#wprm-recipe-51197-step-0-9",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/07/blueberry-lime-july-4th-cake-step-10.jpg"
    }
  ],
