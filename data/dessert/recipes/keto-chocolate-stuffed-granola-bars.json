  "ingredients": [
    "1 cup sunflower seeds",
    "1/4 cup hemp seeds",
    "1 cup unsweetened toasted coconut flakes",
    "4 tablespoon low-carb brown sugar replacement",
    "1 tablespoon coconut oil",
    "13 1/2 ounce canned coconut milk (refrigerated + liquid thrown out)",
    "1/2 cup almond butter",
    "4 ounce unsweetened baking chocolate",
    "1/2 cup low-carb brown sugar replacement"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all of the ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chocolate-stuffed-granola-bars/#wprm-recipe-54243-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/03/Keto-Chocolate-Stuffed-Granola-Bars-1.jpg"
    },
    {
      "text": "Line a baking sheet with parchment paper.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chocolate-stuffed-granola-bars/#wprm-recipe-54243-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/03/Keto-Chocolate-Stuffed-Granola-Bars-2.jpg"
    },
    {
      "text": "Add the sunflower seeds, coconut flakes, sweetener, and hemp seeds in a food processor. Pulse until it is a fine powder. Add in the coconut oil and pulse again.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chocolate-stuffed-granola-bars/#wprm-recipe-54243-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/03/Keto-Chocolate-Stuffed-Granola-Bars-3.jpg"
    },
    {
      "text": "Transfer to a glass bowl and put in the microwave for 3 minutes total, taking it out every 30 seconds to stir.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chocolate-stuffed-granola-bars/#wprm-recipe-54243-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/03/Keto-Chocolate-Stuffed-Granola-Bars-4.jpg"
    },
    {
      "text": "Split the mixture in half. Pour half into the baking sheet and push down firmly to form. Set the other half aside for now.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chocolate-stuffed-granola-bars/#wprm-recipe-54243-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/03/Keto-Chocolate-Stuffed-Granola-Bars-5.jpg"
    },
    {
      "text": "In a saucepan over medium heat, add in the solids from the canned coconut milk and brown sugar replacement.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chocolate-stuffed-granola-bars/#wprm-recipe-54243-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/03/Keto-Chocolate-Stuffed-Granola-Bars-6.jpg"
    },
    {
      "text": "Let simmer for 5 minutes then remove from heat.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chocolate-stuffed-granola-bars/#wprm-recipe-54243-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/03/Keto-Chocolate-Stuffed-Granola-Bars-7.jpg"
    },
    {
      "text": "Whisk in the chocolate. Once melted, add back to the heat. Add in the almond butter and whisk until smooth.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chocolate-stuffed-granola-bars/#wprm-recipe-54243-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/03/Keto-Chocolate-Stuffed-Granola-Bars-8.jpg"
    },
    {
      "text": "Pour the chocolate mixture on top of the granola mixture in the baking pan. Then, layer it with the other half of the granola. Let set in the freezer for 60 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chocolate-stuffed-granola-bars/#wprm-recipe-54243-step-0-8",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/03/Keto-Chocolate-Stuffed-Granola-Bars-9.jpg"
    },
    {
      "text": "Cut, serve, and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chocolate-stuffed-granola-bars/#wprm-recipe-54243-step-0-9",
      "imageSource": null
    }
  ],
