  "ingredients": [
    "1 cup almond flour",
    "1/2 cup vital wheat gluten",
    "3/4 cup allulose",
    "1/2 cup butter (room temperature)",
    "2 large egg",
    "1 1/2 teaspoon baking powder",
    "1 teaspoon vanilla extract",
    "2 ounce low-carb dark chocolate",
    "1 teaspoon kosher salt (as needed)"
  ],
  "instructions": [
