  "ingredients": [
    "1 1/2 cup unsweetened carton coconut milk",
    "2 tablespoon heavy whipping cream",
    "1/2 teaspoon ground cinnamon",
    "1 teaspoon instant coffee",
    "2 tablespoon unsweetened dark cocoa powder",
    "1/2 teaspoon vanilla extract",
    "1 tablespoon stevia/erythritol blend (such as Swerve)"
  ],
  "instructions": [
    {
      "text": "Gather all of the ingredients together.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-keto-hot-cocoa/#wprm-recipe-50537-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/12/creamy-keto-hot-cocoa-01.jpg"
    },
    {
      "text": "Pour coconut milk and heavy cream into a saucepan over medium heat.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-keto-hot-cocoa/#wprm-recipe-50537-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/12/creamy-keto-hot-cocoa-03.jpg"
    },
    {
      "text": "Measure out the cinnamon and instant coffee. Once the milk mixture is steaming, add in the cinnamon and coffee and stir to combine. Add the cocoa powder.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-keto-hot-cocoa/#wprm-recipe-50537-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/12/creamy-keto-hot-cocoa-04.jpg"
    },
    {
      "text": "Add the vanilla and sweetener and stir everything together, taking care to break up any lumps. Turn the heat up to high, stirring constantly, and wait until the liquid comes to a rolling boil.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-keto-hot-cocoa/#wprm-recipe-50537-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/12/creamy-keto-hot-cocoa-05.jpg"
    },
    {
      "text": "Once boiling, turn the heat to low and continue stirring. Once the hot chocolate has cooled down, it should have a shiny, rich consistency. It's finished!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-keto-hot-cocoa/#wprm-recipe-50537-step-0-4",
      "imageSource": null
    },
    {
      "text": "Pour into mugs and serve!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-keto-hot-cocoa/#wprm-recipe-50537-step-0-5",
      "imageSource": null
    }
