  "instructions": [
    {
      "text": "Measure out and prepare all the ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-coconut-white-chocolate-chip-cookies/#wprm-recipe-54195-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/03/Keto-Coconut-White-Chocolate-Chip-Cookies-1.jpg"
    },
    {
      "text": "Line a baking sheet with parchment paper. Preheat oven to 350F.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-coconut-white-chocolate-chip-cookies/#wprm-recipe-54195-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/03/Keto-Coconut-White-Chocolate-Chip-Cookies-2.jpg"
    },
    {
      "text": "Spread the unsweetened coconut flakes onto the parchment lined baking sheet. Bake in the oven for 5 minutes or until slightly brown. Set aside to cool.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-coconut-white-chocolate-chip-cookies/#wprm-recipe-54195-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/03/Keto-Coconut-White-Chocolate-Chip-Cookies-3.jpg"
    },
    {
      "text": "In a stand mixer, mix together the softened butter and sugar until it is fluffy. Add in the egg and vanilla extract and mix to combine well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-coconut-white-chocolate-chip-cookies/#wprm-recipe-54195-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/03/Keto-Coconut-White-Chocolate-Chip-Cookies-4.jpg"
    },
    {
      "text": "In a bowl, whisk together the almond flour, coconut flour, psyllum husk powder, xanthan gum, salt, and baking powder. Mix to combine well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-coconut-white-chocolate-chip-cookies/#wprm-recipe-54195-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/03/Keto-Coconut-White-Chocolate-Chip-Cookies-6.jpg"
    },
    {
      "text": "Add the flour mixture into the butter, sugar, and egg mixture. Mix together to combine well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-coconut-white-chocolate-chip-cookies/#wprm-recipe-54195-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/03/Keto-Coconut-White-Chocolate-Chip-Cookies-5.jpg"
    },
    {
      "text": "Stir in the toasted coconut and the white chocolate chips.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-coconut-white-chocolate-chip-cookies/#wprm-recipe-54195-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/03/Keto-Coconut-White-Chocolate-Chip-Cookies-7.jpg"
    },
    {
      "text": "Roll the dough into balls and place on parchment lined baking sheet. Leave enough room between the cookies for them to expand in the oven.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-coconut-white-chocolate-chip-cookies/#wprm-recipe-54195-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/03/Keto-Coconut-White-Chocolate-Chip-Cookies-9.jpg"
    },
    {
      "text": "With a spatula, flatten the cookie dough balls. Bake in the oven for 10 - 12 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-coconut-white-chocolate-chip-cookies/#wprm-recipe-54195-step-0-8",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/03/Keto-Coconut-White-Chocolate-Chip-Cookies-10.jpg"
    },
    {
      "text": "Serve and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-coconut-white-chocolate-chip-cookies/#wprm-recipe-54195-step-0-9",
