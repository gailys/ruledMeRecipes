  "instructions": [
    {
      "text": "Preheat oven to 350F and lightly grease a baking pan. Whisk the dry ingredients for the bar layer together in a mixing bowl.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/gingerbread-pumpkin-cheesecake-bars/#wprm-recipe-51929-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/10/gingerbread-pumpkin-cheesecake-bars-step-01.jpg"
    },
    {
      "text": "Add the coconut oil, eggs, and vanilla to the mixing bowl and combine. The bar mixture should be stiff and crumbly.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/gingerbread-pumpkin-cheesecake-bars/#wprm-recipe-51929-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/10/gingerbread-pumpkin-cheesecake-bars-step-02.jpg"
    },
    {
      "text": "Press the dough into the prepared pan, reserving a portion for topping. Press down firmly and ensure that the base layer is even. Set aside.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/gingerbread-pumpkin-cheesecake-bars/#wprm-recipe-51929-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/10/gingerbread-pumpkin-cheesecake-bars-step-03.jpg"
    },
    {
      "text": "Combine all of the cheesecake layer ingredients and stir until smooth.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/gingerbread-pumpkin-cheesecake-bars/#wprm-recipe-51929-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/10/gingerbread-pumpkin-cheesecake-bars-step-04.jpg"
    },
    {
      "text": "Spread the cheesecake mixture evenly over the base layer. Top with the reserved crumb mixture. Bake for 25–30 minutes, until the cheesecake layer puffs slightly and begins to turn light brown at the edges. Do not overbake.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/gingerbread-pumpkin-cheesecake-bars/#wprm-recipe-51929-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/10/gingerbread-pumpkin-cheesecake-bars-step-05.jpg"
    },
    {
      "text": "Remove the bars from the oven and let cool in the pan for 1 hour at room temperature.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/gingerbread-pumpkin-cheesecake-bars/#wprm-recipe-51929-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/10/gingerbread-pumpkin-cheesecake-bars-step-06.jpg"
    },
    {
      "text": "Chill for 2 hours in the refrigerator before slicing.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/gingerbread-pumpkin-cheesecake-bars/#wprm-recipe-51929-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/10/gingerbread-pumpkin-cheesecake-bars-step-07.jpg"
    }
  ],
