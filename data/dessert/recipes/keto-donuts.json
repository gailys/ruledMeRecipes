  "ingredients": [
    "3 large egg",
    "1/2 cup stevia/erythritol blend",
    "1 teaspoon vanilla extract",
    "2 tablespoon butter (melted)",
    "1/2 cup almond flour",
    "1/4 teaspoon salt",
    "1/4 teaspoon baking powder",
    "1/4 teaspoon ground cinnamon",
    "2 tablespoon cocoa powder",
    "31 gram low-carb chocolate protein powder (vegetarian)",
    "2 tablespoon heavy cream"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 350F. Whip egg whites until they have stiff peaks (this is the most important part and will ensure you get a great fluffy consistency).",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-donuts/#wprm-recipe-50319-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/10/keto-donuts-04.jpg"
    },
    {
      "text": "Combine the egg yolks, sweetener, vanilla, and butter in a separate bowl, then whisk until well mixed.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-donuts/#wprm-recipe-50319-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/10/keto-donuts-01.jpg"
    },
    {
      "text": "Combine almond meal, salt, baking powder, cinnamon, and cocoa powder in a third mixing bowl.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-donuts/#wprm-recipe-50319-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/10/keto-donuts-03.jpg"
    },
    {
      "text": "Gently (really gently) fold the wet ingredients into the whipped egg whites.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-donuts/#wprm-recipe-50319-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/10/keto-donuts-06.jpg"
    },
    {
      "text": "Slowly add the bowl of mixed dry ingredients to the wet mixture while continuing to mix.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-donuts/#wprm-recipe-50319-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/10/keto-donuts-07.jpg"
    },
    {
      "text": "Fill the donut pan ¾ of the way full on each mold.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-donuts/#wprm-recipe-50319-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/10/keto-donuts-09.jpg"
    },
    {
      "text": "Bake for 15 minutes, or until a toothpick comes out clean. In a separate bowl, combine casein powder and heavy cream until it is thick and forms the icing.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-donuts/#wprm-recipe-50319-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/10/keto-donuts-14.jpg"
    },
    {
      "text": "Pour the icing over the donuts when they have cooled down a bit.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-donuts/#wprm-recipe-50319-step-0-7",
      "imageSource": null
    }
  ],
