  "ingredients": [
    "2 large egg",
    "1/2 cup mayonnaise",
    "1 tablespoon vanilla extract",
    "1 3/4 cup almond flour",
    "1/2 cup erythritol",
    "1/4 teaspoon salt",
    "2 teaspoon baking powder",
    "4 ounce cream cheese (softened)",
    "1/4 cup erythritol (powdered)",
    "3 tablespoon heavy whipping cream",
    "1/2 teaspoon vanilla extract"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 350F. Combine the eggs, mayonnaise, and vanilla extract in a medium-sized bowl.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-vanilla-bean-cupcakes/#wprm-recipe-52075-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/01/Step-1-1.jpg"
    },
    {
      "text": "The batter should be really smooth, so use a hand mixer if needed. Set the bowl aside once done mixing.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-vanilla-bean-cupcakes/#wprm-recipe-52075-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/01/Step-3-1.jpg"
    },
    {
      "text": "In a separate bowl, combine the almond flour, erythritol, salt, and baking powder.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-vanilla-bean-cupcakes/#wprm-recipe-52075-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/01/Step-4-1.jpg"
    },
    {
      "text": "Slowly add the batter to the dry ingredients, whisking until smooth.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-vanilla-bean-cupcakes/#wprm-recipe-52075-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/01/Step-5-1.jpg"
    },
    {
      "text": "The mixture might seem a little dry, but this is normal.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-vanilla-bean-cupcakes/#wprm-recipe-52075-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/01/Step-6-1.jpg"
    },
    {
      "text": "Spoon out the desired number of servings into a greased cupcake tray.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-vanilla-bean-cupcakes/#wprm-recipe-52075-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/01/Step-7-1.jpg"
    },
    {
      "text": "Bake for 20–25 minutes or until lightly browned on top. Mix together the frosting ingredients while baking and frost the cupcakes after they have cooled. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-vanilla-bean-cupcakes/#wprm-recipe-52075-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/01/Vanilla-Bean-Cupcakes-620x900.jpg"
    }
  ],
