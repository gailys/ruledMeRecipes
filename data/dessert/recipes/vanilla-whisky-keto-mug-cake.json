  "ingredients": [
    "1 large egg",
    "2 tablespoon almond flour",
    "1 tablespoon erythritol",
    "7 drop liquid stevia",
    "2 tablespoon butter",
    "1/2 teaspoon baking powder",
    "1 tablespoon scotch",
    "1 tablespoon almond flour",
    "2 teaspoon coconut flour",
    "1/2 teaspoon vanilla extract"
  ],
  "instructions": [
    {
      "text": "Get a mug ready! Add the egg, almond flour, erythritol, and stevia. Mix until combined.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/vanilla-whisky-keto-mug-cake/#wprm-recipe-50957-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_4301.jpg"
    },
    {
      "text": "Add the butter and baking powder to the mug and mix until well combined.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/vanilla-whisky-keto-mug-cake/#wprm-recipe-50957-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_4324.jpg"
    },
    {
      "text": "Now, time to add the flavors! Add a shot of whiskey or scotch. Next, add almond flour, coconut flour, and vanilla extract. Mix to combine.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/vanilla-whisky-keto-mug-cake/#wprm-recipe-50957-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_4332.jpg"
    },
    {
      "text": "Microwave on high (power level 10) for 85 seconds.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/vanilla-whisky-keto-mug-cake/#wprm-recipe-50957-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_4364.jpg"
    },
    {
      "text": "Turn the mug upside down and lightly tap it against a plate. The cake should slide out in one piece.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/vanilla-whisky-keto-mug-cake/#wprm-recipe-50957-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/WhiskyVanillaBig.jpg"
    }
  ],
