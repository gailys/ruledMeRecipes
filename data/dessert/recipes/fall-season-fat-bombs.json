  "ingredients": [
    "2 tablespoon peanut butter",
    "1 tablespoon coconut oil",
    "1 tablespoon heavy whipping cream",
    "5 drop liquid sucralose (to taste)",
    "1 teaspoon unsweetened dark cocoa powder",
    "1/4 teaspoon ground allspice"
  ],
  "instructions": [
    {
      "text": "Place the peanut butter into cups or molds.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/fall-season-fat-bombs/#wprm-recipe-50437-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/11/fall-season-fat-bombs-step-01.jpg"
    },
    {
      "text": "Add the coconut oil.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/fall-season-fat-bombs/#wprm-recipe-50437-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/11/fall-season-fat-bombs-step-02.jpg"
    },
    {
      "text": "Pour in the heavy cream and liquid sweetener.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/fall-season-fat-bombs/#wprm-recipe-50437-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/11/fall-season-fat-bombs-step-03.jpg"
    },
    {
      "text": "Measure out the cocoa powder and allspice and add them to the mix.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/fall-season-fat-bombs/#wprm-recipe-50437-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/11/fall-season-fat-bombs-step-04.jpg"
    },
    {
      "text": "Stir well to combine. Clean up the sides a bit to help the fat bombs pop out more easily once frozen.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/fall-season-fat-bombs/#wprm-recipe-50437-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/11/fall-season-fat-bombs-step-05.jpg"
    },
    {
      "text": "Stick in the freezer for about 2 hours, pop them out, and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/fall-season-fat-bombs/#wprm-recipe-50437-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/11/fall-season-fat-bombs-step-06.jpg"
    }
