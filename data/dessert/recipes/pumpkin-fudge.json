  "ingredients": [
    "1 3/4 cup coconut butter",
    "1 cup pumpkin puree",
    "1/4 teaspoon ground nutmeg",
    "1 teaspoon ground cinnamon",
    "1 tablespoon coconut oil"
  ],
  "instructions": [
    {
      "text": "Line a square baking pan with aluminum foil and set aside.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/pumpkin-fudge/#wprm-recipe-51975-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/11/pumpkin-fudge-step-01-1.jpg"
    },
    {
      "text": "Spoon the coconut butter into a saucepan, warming it over low heat until melted. Stir and remove from the heat.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/pumpkin-fudge/#wprm-recipe-51975-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/11/pumpkin-fudge-step-02-1.jpg"
    },
    {
      "text": "Add the pumpkin, nutmeg, and cinnamon. Stir to combine into a thick, almost grainy mixture.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/pumpkin-fudge/#wprm-recipe-51975-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/11/pumpkin-fudge-step-03.jpg"
    },
    {
      "text": "Add the coconut oil and stir vigorously to combine the ingredients and distribute the oil evenly.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/pumpkin-fudge/#wprm-recipe-51975-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/11/pumpkin-fudge-step-04-1.jpg"
    },
    {
      "text": "Spoon the mixture into the prepared pan and spread it out evenly with the back of a spoon.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/pumpkin-fudge/#wprm-recipe-51975-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/11/pumpkin-fudge-step-05-1.jpg"
    },
    {
      "text": "Place a piece of wax paper on top of the fudge and press the mixture evenly into the pan.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/pumpkin-fudge/#wprm-recipe-51975-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/11/pumpkin-fudge-step-06-1.jpg"
    },
    {
      "text": "Remove the wax paper and discard. Place the fudge in the refrigerator for 1–2 hours, until cooled and firm.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/pumpkin-fudge/#wprm-recipe-51975-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/11/pumpkin-fudge-step-07-1.jpg"
    },
    {
      "text": "Remove the fudge from the refrigerator and carefully lift out the foil along with the fudge. Peel the foil back from the edges of the fudge. Use a sharp knife to cut the large brick of fudge into equal squares.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/pumpkin-fudge/#wprm-recipe-51975-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/11/pumpkin-fudge-step-08-1.jpg"
    },
    {
      "text": "Keep in the fridge in a sealed container for up to 1 week.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/pumpkin-fudge/#wprm-recipe-51975-step-0-8",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/11/pumpkin-fudge-step-09-1.jpg"
    }
  ],
