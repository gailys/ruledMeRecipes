  "ingredients": [
    "1 1/4 cup almond flour",
    "1/4 cup butter (chilled)",
    "1/4 cup stevia/erythritol blend",
    "15 drop liquid stevia",
    "1/2 teaspoon xanthan gum",
    "1/2 cup stevia/erythritol blend",
    "1 teaspoon water",
    "1/2 cup heavy whipping cream",
    "1/2 cup peanut butter",
    "1 teaspoon vanilla extract",
    "6 tablespoon butter",
    "2 1/2 ounce low-carb dark chocolate",
    "2 tablespoon stevia/erythritol blend",
    "2 tablespoon unsweetened dark cocoa powder",
    "15 drop liquid stevia",
    "1/2 teaspoon vanilla extract"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 350F. Combine the almond flour, butter, granulated sweetener, liquid stevia, and xanthan gum in a food processor. Pulse until fine and crumbly.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-snickers-bar/#wprm-recipe-50359-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/10/Mock-Snickers-Bar-1.jpg"
    },
    {
      "text": "Press the mixture evenly into a non-stick baking pan and bake for 15 minutes or until golden. Once done, remove from the oven and let cool.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-snickers-bar/#wprm-recipe-50359-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/10/Mock-Snickers-Bar-2.jpg"
    },
    {
      "text": "Meanwhile, make the peanut butter caramel filling. Combine the sweetener with water in a small saucepan over medium-high heat, stirring frequently until the sweetener is dissolved and the mixture is bubbling (about 5 minutes). Remove from heat and stir in the heavy cream; the mixture should be bubbling. Return to the heat and let boil for 1 minute. Add the peanut butter and vanilla extract and stir until smooth.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-snickers-bar/#wprm-recipe-50359-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/10/Mock-Snickers-Bar-3.jpg"
    },
    {
      "text": "Pour the filling over the cooled shortbread crust and spread it out evenly. Let cool completely.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-snickers-bar/#wprm-recipe-50359-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/10/Mock-Snickers-Bar-4.jpg"
    },
    {
      "text": "To create the chocolate topping, melt the butter, chocolate, and sweetener in a small saucepan over low heat, stirring occasionally until the mixture is smooth and glossy. Add the cocoa powder and whisk until smooth. Next, add the liquid stevia and vanilla extract and whisk again.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-snickers-bar/#wprm-recipe-50359-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/10/Mock-Snickers-Bar-6.jpg"
    },
    {
      "text": "Pour the chocolate topping over the cooled peanut butter filling.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-snickers-bar/#wprm-recipe-50359-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/10/Mock-Snickers-Bar-7.jpg"
    },
    {
      "text": "Let sit at room temperature for at least 1 hour before cutting. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-snickers-bar/#wprm-recipe-50359-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/10/Mock-Snickers-Bar-8.jpg"
    }
  ],
