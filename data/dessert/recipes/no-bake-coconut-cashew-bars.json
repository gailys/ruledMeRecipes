  "ingredients": [
    "1/4 cup butter (melted)",
    "1 cup almond flour",
    "1 teaspoon ground cinnamon",
    "salt (to taste)",
    "1/4 cup low-carb maple syrup",
    "1/4 cup unsweetened shredded coconut",
    "1/2 cup cashews (raw or roasted)"
  ],
  "instructions": [
    {
      "text": "Combine the melted butter and almond flour in a large bowl and mix well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/no-bake-coconut-cashew-bars/#wprm-recipe-51887-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/01/01Combine-almond-and-butter.jpg"
    },
    {
      "text": "Add the cinnamon, salt, and sugar-free maple syrup. Mix well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/no-bake-coconut-cashew-bars/#wprm-recipe-51887-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/01/02Add-in-maple-and-cinnamon.jpg"
    },
    {
      "text": "Next, add the shredded coconut and mix again.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/no-bake-coconut-cashew-bars/#wprm-recipe-51887-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/01/03Add-shredded-coconut.jpg"
    },
    {
      "text": "Roughly chop the cashews and add them to the dough. Mix very well to combine everything evenly.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/no-bake-coconut-cashew-bars/#wprm-recipe-51887-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/01/04Add-cashews.jpg"
    },
    {
      "text": "Line a baking dish with parchment paper and spread the dough out in an even layer. Add some extra shredded coconut and cinnamon on top for a prettier presentation.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/no-bake-coconut-cashew-bars/#wprm-recipe-51887-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/01/05Spread-evenly.jpg"
    },
    {
      "text": "Place in the refrigerator and chill for at least 2 hours, but preferably overnight. Once chilled, slice into bars.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/no-bake-coconut-cashew-bars/#wprm-recipe-51887-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/01/06Chill-and-slice.jpg"
    },
    {
      "text": "Serve and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/no-bake-coconut-cashew-bars/#wprm-recipe-51887-step-0-6",
      "imageSource": null
    }
  ],
