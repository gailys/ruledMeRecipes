  "ingredients": [
    "1 cup unsweetened carton coconut milk",
    "1/4 cup sour cream",
    "1/4 cup heavy whipping cream",
    "2 tablespoon vodka (optional)",
    "2 teaspoon butterscotch extract",
    "2 tablespoon erythritol",
    "25 drop liquid stevia",
    "1 teaspoon sea salt",
    "1/2 teaspoon xanthan gum",
    "3 tablespoon butter (browned)"
  ],
  "instructions": [
    {
      "text": "Add the coconut milk, sour cream, heavy cream, vodka, butterscotch extract, sweetener, liquid stevia, salt, and xanthan gum to a container. Use an immersion blender to blend everything together.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/butterscotch-sea-salt-ice-cream/#wprm-recipe-51773-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/07/img_8430.jpg"
    },
    {
      "text": "In a pan over low heat, brown the butter until it is a dark amber color.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/butterscotch-sea-salt-ice-cream/#wprm-recipe-51773-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/07/img_8436.jpg"
    },
    {
      "text": "Add the butter to the ice cream base and use the immersion blender to blend everything together.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/butterscotch-sea-salt-ice-cream/#wprm-recipe-51773-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/07/img_8439.jpg"
    },
    {
      "text": "Add the ice cream base to an ice cream machine and churn according to the manufacturer's instructions.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/butterscotch-sea-salt-ice-cream/#wprm-recipe-51773-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/07/img_8443.jpg"
    },
    {
      "text": "Scoop and enjoy!",
