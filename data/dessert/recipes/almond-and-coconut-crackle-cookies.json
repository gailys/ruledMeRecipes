  "ingredients": [
    "2 large egg white",
    "8 tablespoon allulose",
    "1 cup almonds (sliced)",
    "1/4 cup unsweetened toasted coconut flakes"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 325F. Line baking sheets with parchment paper or a silicone mat.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/almond-and-coconut-crackle-cookies/#wprm-recipe-52862-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/01/almond-coconut-crackle-cookies-01.jpg"
    },
    {
      "text": "Combine egg whites and allulose in a mixing bowl.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/almond-and-coconut-crackle-cookies/#wprm-recipe-52862-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/01/almond-coconut-crackle-cookies-02.jpg"
    },
    {
      "text": "Whisk egg whites and sweetener in the mixing bowl until mixture is thick, but not foamy.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/almond-and-coconut-crackle-cookies/#wprm-recipe-52862-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/01/almond-coconut-crackle-cookies-04.jpg"
    },
    {
      "text": "Stir in sliced almonds and unsweetened coconut flakes. Whip ingredients until mixture is an evenly distributed cookie batter.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/almond-and-coconut-crackle-cookies/#wprm-recipe-52862-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/01/almond-coconut-crackle-cookies-05.jpg"
    },
    {
      "text": "Spoon or scoop cookie batter into mounds on the baking sheet.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/almond-and-coconut-crackle-cookies/#wprm-recipe-52862-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/01/almond-coconut-crackle-cookies-06.jpg"
    },
    {
      "text": "Space cookie batter mounds evenly and generously on the baking sheet. Flatten the top of the mounds with the spoon, fork, or scoop.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/almond-and-coconut-crackle-cookies/#wprm-recipe-52862-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/01/almond-coconut-crackle-cookies-07.jpg"
    },
    {
      "text": "Bake cookies for 10 minutes. Rotate the baking sheet in the oven.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/almond-and-coconut-crackle-cookies/#wprm-recipe-52862-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/01/almond-coconut-crackle-cookies-08.jpg"
    },
    {
      "text": "Bake cookies for another 8-10 minutes, until they are toasted and crisp. Remove baking sheet from oven and cool.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/almond-and-coconut-crackle-cookies/#wprm-recipe-52862-step-0-7",
      "imageSource": null
    }
  ],
