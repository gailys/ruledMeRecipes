  "ingredients": [
    "13 ounce bacon",
    "2 tablespoon erythritol",
    "1 tablespoon maple extract",
    "4 tablespoon unsweetened dark cocoa powder",
    "2 tablespoon erythritol",
    "15 drop liquid stevia",
    "1/4 cup roasted pecans (chopped)"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 400F. Place bacon slices onto a foil-lined baking sheet.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chocolate-covered-maple-pecan-bacon/#wprm-recipe-50981-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_5685.jpg"
    },
    {
      "text": "Sprinkle half of the erythritol and maple extract over one side of the bacon and rub it in.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chocolate-covered-maple-pecan-bacon/#wprm-recipe-50981-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_5689.jpg"
    },
    {
      "text": "Flip the bacon slices and apply the remaining erythritol and maple extract.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chocolate-covered-maple-pecan-bacon/#wprm-recipe-50981-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_5696.jpg"
    },
    {
      "text": "Bake for 40–50 minutes or until crisp.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chocolate-covered-maple-pecan-bacon/#wprm-recipe-50981-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_5700.jpg"
    },
    {
      "text": "Once bacon is done, set aside for 5 minutes to cool.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chocolate-covered-maple-pecan-bacon/#wprm-recipe-50981-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_5701.jpg"
    },
    {
      "text": "Tilt the baking sheet and drain the bacon fat into a bowl.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chocolate-covered-maple-pecan-bacon/#wprm-recipe-50981-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_5708.jpg"
    },
    {
      "text": "Add the cocoa powder, erythritol, and liquid stevia to the bacon fat and mix well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chocolate-covered-maple-pecan-bacon/#wprm-recipe-50981-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_5724.jpg"
    },
    {
      "text": "Transfer this chocolate mixture to a container large enough to dip the bacon. Dip each slice into the chocolate and transfer to a sheet of parchment paper. Sprinkle over the pecans before the chocolate dries.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chocolate-covered-maple-pecan-bacon/#wprm-recipe-50981-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_5727.jpg"
    },
    {
      "text": "Place the chocolate-covered bacon in the refrigerator for at least 5 hours, preferably overnight.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chocolate-covered-maple-pecan-bacon/#wprm-recipe-50981-step-0-8",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_5735.jpg"
    },
    {
      "text": "Grab and serve!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chocolate-covered-maple-pecan-bacon/#wprm-recipe-50981-step-0-9",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/ChocolateMapleBaconBig.jpg"
    }
  ],
