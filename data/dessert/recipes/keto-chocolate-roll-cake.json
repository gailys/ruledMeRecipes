  "ingredients": [
    "1 cup almond flour",
    "1/4 cup psyllium husk powder",
    "1/4 cup unsweetened dark cocoa powder",
    "1/4 cup erythritol",
    "1 teaspoon baking powder",
    "4 tablespoon butter (melted)",
    "1/4 cup sour cream",
    "1 teaspoon vanilla extract",
    "3 large egg",
    "1/4 cup unsweetened carton coconut milk",
    "8 ounce cream cheese",
    "8 tablespoon butter",
    "1/4 cup sour cream",
    "1/4 cup erythritol",
    "1/4 teaspoon liquid stevia",
    "1 teaspoon vanilla extract"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 350F. Add the dry ingredients to a bowl and stir to combine.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chocolate-roll-cake/#wprm-recipe-51331-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/08/img_3862.jpg"
    },
    {
      "text": "Melt the butter in the microwave. Add the sour cream, melted butter, vanilla, and eggs to the dry ingredient mix. Use a hand mixer to combine.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chocolate-roll-cake/#wprm-recipe-51331-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/08/img_3867.jpg"
    },
    {
      "text": "Add a small amount of coconut milk to the batter to make the dough more workable and spreadable.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chocolate-roll-cake/#wprm-recipe-51331-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/08/img_3874.jpg"
    },
    {
      "text": "Spread the batter over a Silpat lined baking sheet — it should cover the area of an entire cookie sheet.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chocolate-roll-cake/#wprm-recipe-51331-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/08/img_3880.jpg"
    },
    {
      "text": "Bake for 12–15 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chocolate-roll-cake/#wprm-recipe-51331-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/08/img_3890.jpg"
    },
    {
      "text": "Remove and let cool slightly while making the cream cheese filling.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chocolate-roll-cake/#wprm-recipe-51331-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/08/img_3894.jpg"
    },
    {
      "text": "In a bowl, combine the cream cheese, butter, sour cream, erythritol, liquid stevia, and vanilla. Use a hand mixer to cream the ingredients together well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chocolate-roll-cake/#wprm-recipe-51331-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/08/img_3904.jpg"
    },
    {
      "text": "Plop the cream cheese filling on top of the cake and spread evenly with a spoon.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chocolate-roll-cake/#wprm-recipe-51331-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/08/img_3915.jpg"
    },
    {
      "text": "Gently roll up the cake. Use a knife to scrape off any excess filling and leave a clean seam on the edge of the roll. Slice, serve, and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chocolate-roll-cake/#wprm-recipe-51331-step-0-8",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/08/img_3925.jpg"
    }
  ],
