  "ingredients": [
    "1 tablespoon egg white",
    "1 tablespoon almond butter",
    "1 teaspoon unsweetened dark cocoa powder",
    "1/8 teaspoon vanilla extract",
    "3 drop liquid stevia",
    "1/8 teaspoon baking soda",
    "salt (to taste, see note)"
  ],
  "instructions": [
    {
      "text": "Find a microwave-safe cup or container.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-microwave-brownie/#wprm-recipe-50343-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/10/microwave_brownies-7-e1483306516559.jpg"
    },
    {
      "text": "In a small bowl, add the egg whites and beat until nicely aerated and frothy.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-microwave-brownie/#wprm-recipe-50343-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/10/microwave_brownies-9.jpg"
    },
    {
      "text": "Place all of the ingredients in the cup and mix them together well with a fork.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-microwave-brownie/#wprm-recipe-50343-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/10/microwave_brownies-2.jpg"
    },
    {
      "text": "Stick the cup in the microwave for around 40 seconds (microwave times may vary). Shave 10 seconds off the microwave time for a more molten consistency.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-microwave-brownie/#wprm-recipe-50343-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/10/microwave_brownies-4.jpg"
    },
    {
      "text": "Remove from the microwave and serve.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-microwave-brownie/#wprm-recipe-50343-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/10/microwave_brownies-5-e1483306437131.jpg"
    }
  ],
