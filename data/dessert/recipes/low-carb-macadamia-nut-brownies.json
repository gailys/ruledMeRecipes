  "ingredients": [
    "5 tablespoon butter (salted, room temperature)",
    "1/4 cup coconut oil",
    "3/4 cup erythritol",
    "2 large egg (room temperature)",
    "1 teaspoon vanilla extract",
    "3 tablespoon unsweetened dark cocoa powder",
    "1 teaspoon instant coffee",
    "1 1/2 teaspoon baking powder",
    "3/4 cup almond flour",
    "3/4 cup macadamia nuts"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 350F. Make sure the eggs and butter have come to room temperature. Add the butter, coconut oil, and erythritol to a mixing bowl.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-macadamia-nut-brownies/#wprm-recipe-50661-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/12/macadamia_nut_brownies-1.jpg"
    },
    {
      "text": "Beat the fats and sweetener together to create a creamy consistency.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-macadamia-nut-brownies/#wprm-recipe-50661-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/12/macadamia_nut_brownies-2.jpg"
    },
    {
      "text": "Add the eggs and vanilla extract to the creamed butter.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-macadamia-nut-brownies/#wprm-recipe-50661-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/12/macadamia_nut_brownies-3.jpg"
    },
    {
      "text": "Mix together well into a creamy consistency.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-macadamia-nut-brownies/#wprm-recipe-50661-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/12/macadamia_nut_brownies-4.jpg"
    },
    {
      "text": "Add the cocoa powder and instant coffee to the mixture. Mix the cocoa powder and coffee in well, until the mixture is a dark brown. Add the baking powder.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-macadamia-nut-brownies/#wprm-recipe-50661-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/12/macadamia_nut_brownies-5.jpg"
    },
    {
      "text": "Cream everything together and then add the almond flour.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-macadamia-nut-brownies/#wprm-recipe-50661-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/12/macadamia_nut_brownies-6.jpg"
    },
    {
      "text": "Mix thoroughly. The batter should be light brown and fluffy. Add two-thirds of the macadamia nuts.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-macadamia-nut-brownies/#wprm-recipe-50661-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/12/macadamia_nut_brownies-7.jpg"
    },
    {
      "text": "Fold in the macadamia nuts, making sure they are evenly distributed throughout the batter.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-macadamia-nut-brownies/#wprm-recipe-50661-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/12/macadamia_nut_brownies-8.jpg"
    },
    {
      "text": "Spread the batter evenly into a non-stick brownie pan. Top with the rest of the macadamia nuts, pressing them into the batter until mostly submerged and just slightly peeking out on top.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-macadamia-nut-brownies/#wprm-recipe-50661-step-0-8",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/12/macadamia_nut_brownies-9.jpg"
    },
    {
      "text": "Place in the oven for 25 minutes, or until a toothpick comes out clean. The edges will be slightly brown, almost burned.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-macadamia-nut-brownies/#wprm-recipe-50661-step-0-9",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/12/macadamia_nut_brownies-11.jpg"
    },
    {
      "text": "Let cool for at least 15 minutes before slicing. Serve and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-macadamia-nut-brownies/#wprm-recipe-50661-step-0-10",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/12/macadamia_nut_brownies-17.jpg"
    }
  ],
