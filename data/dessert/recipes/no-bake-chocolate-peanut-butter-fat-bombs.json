  "ingredients": [
    "1/4 cup unsweetened dark cocoa powder",
    "4 tablespoon powdered peanut butter (such as PBfit)",
    "6 tablespoon hemp seeds",
    "1/2 cup coconut oil",
    "2 tablespoon heavy whipping cream",
    "1 teaspoon vanilla extract",
    "28 drop liquid stevia",
    "1/4 cup unsweetened shredded coconut"
  ],
  "instructions": [
    {
      "text": "Mix the cocoa powder, powdered peanut butter, and hemp seeds together with the coconut oil. This may take a bit of work, but it will eventually form a paste.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/no-bake-chocolate-peanut-butter-fat-bombs/#wprm-recipe-51635-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/04/img_9171.jpg"
    },
    {
      "text": "Add in the heavy cream, vanilla, and liquid stevia. Mix again until everything is combined and slightly creamy.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/no-bake-chocolate-peanut-butter-fat-bombs/#wprm-recipe-51635-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/04/img_9185.jpg"
    },
    {
      "text": "Measure the unsweetened shredded coconut out onto a plate.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/no-bake-chocolate-peanut-butter-fat-bombs/#wprm-recipe-51635-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/04/img_9190.jpg"
    },
    {
      "text": "Roll the mixture out into balls and then roll them in the unsweetened shredded coconut. Place on a baking tray lined with parchment paper. Freeze for about 20 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/no-bake-chocolate-peanut-butter-fat-bombs/#wprm-recipe-51635-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/04/img_9194.jpg"
    },
    {
      "text": "Remove from the freezer and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/no-bake-chocolate-peanut-butter-fat-bombs/#wprm-recipe-51635-step-0-4",
