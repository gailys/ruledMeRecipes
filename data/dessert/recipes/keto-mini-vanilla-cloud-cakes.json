  "ingredients": [
    "6 tablespoon cream cheese (softened)",
    "2 teaspoon vanilla extract",
    "1/4 cup stevia/erythritol blend (such as Swerve)",
    "6 large egg (separated)",
    "1/2 teaspoon cream of tartar",
    "16 ounce cream cheese (softened)",
    "1/3 cup stevia/erythritol blend (such as Swerve)",
    "2 tablespoon butter (softened)",
    "1 tablespoon vanilla extract"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 300F. Grease a muffin tin. In a medium bowl, beat the cream cheese, vanilla extract, sweetener, and egg yolks until smooth.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-mini-vanilla-cloud-cakes/#wprm-recipe-51949-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/11/cloud-cake-02.jpg"
    },
    {
      "text": "In a separate bowl, whip the egg whites and cream of tartar with an electric mixer until stiff peaks form.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-mini-vanilla-cloud-cakes/#wprm-recipe-51949-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/11/cloud-cake-01.jpg"
    },
    {
      "text": "Next, gently fold the whipped egg whites into the yolk mixture, taking care not to deflate them.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-mini-vanilla-cloud-cakes/#wprm-recipe-51949-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/11/cloud-cake-03.jpg"
    },
    {
      "text": "Scoop the mixture into the muffin tin. Bake for 30–35 minutes or until golden brown.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-mini-vanilla-cloud-cakes/#wprm-recipe-51949-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/11/cloud-cake-04.jpg"
    },
    {
      "text": "Once done, remove the cakes and place on a cooling rack.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-mini-vanilla-cloud-cakes/#wprm-recipe-51949-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/11/cloud-cake-05.jpg"
    },
    {
      "text": "While the cakes are cooling, combine the frosting ingredients together in a medium bowl.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-mini-vanilla-cloud-cakes/#wprm-recipe-51949-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/11/cloud-cake-frosting-01.jpg"
    },
    {
      "text": "Beat with an electric mixer until smooth.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-mini-vanilla-cloud-cakes/#wprm-recipe-51949-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/11/cloud-cake-frosting-02.jpg"
    },
    {
      "text": "Transfer the frosting to a pastry bag with a wide tip.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-mini-vanilla-cloud-cakes/#wprm-recipe-51949-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/11/cloud-cake-frosting-03.jpg"
    },
    {
      "text": "Set aside three mini cake layers for each finished cake, piping frosting in between each layer. Serve and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-mini-vanilla-cloud-cakes/#wprm-recipe-51949-step-0-8",
      "imageSource": null
    }
  ],
