  "description": "This makes a total of 4 servings of Garlic Butter Braised Cabbage. Each serving comes out to be 110 calories, 8.6g fats, 5.7g net carbs, and 1.5g protein.",
  "servings": 4,
  "yield": [
    "4",
    "4 servings"
  ],
  "prepTime": "PT10M",
  "cookTime": "PT25M",
  "totalTime": "PT35M",
  "totalMinutes": 35,
  "nutrition": {
    "@type": "NutritionInformation",
