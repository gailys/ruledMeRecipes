    "fatGrams": 8.6
  },
  "ingredients": [
    "2 tablespoon butter",
    "1/4 cup onion (diced)",
    "2 teaspoon fresh garlic (minced)",
    "1 cup vegetable broth",
    "1/4 medium green cabbage (cut in 1-inch thick slices)",
    "2 tablespoon worcestershire sauce",
    "1/4 cup sour cream",
    "salt (to taste)",
    "garlic powder (to taste)"
  ],
  "instructions": [
    {
      "text": "Melt the butter in a large skillet. Be sure to use a skillet or frying pan with a lid to properly braise!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/garlic-butter-braised-cabbage/#wprm-recipe-52631-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/06/garlic-butter-braised-cabbage-01.jpg"
    },
    {
      "text": "Add chopped onion and minced garlic to the butter and sauté on medium heat until the onion is translucent and the garlic is fragrant.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/garlic-butter-braised-cabbage/#wprm-recipe-52631-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/06/garlic-butter-braised-cabbage-02.jpg"
    },
    {
      "text": "Add broth and bring to a simmer.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/garlic-butter-braised-cabbage/#wprm-recipe-52631-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/06/garlic-butter-braised-cabbage-03.jpg"
    },
    {
      "text": "Reduce heat to medium-low and add cabbage slices in an even layer. If they don’t all fit, stacking them will work, too. You may also want to cut one slice in half to make it all fit! Cover with the lid and let the cabbage cook for about 20 minutes or until very tender.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/garlic-butter-braised-cabbage/#wprm-recipe-52631-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/06/garlic-butter-braised-cabbage-04.jpg"
    },
    {
      "text": "Once tender, carefully remove the cabbage from the pan and set aside while you make the sauce.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/garlic-butter-braised-cabbage/#wprm-recipe-52631-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/06/garlic-butter-braised-cabbage-05.jpg"
    },
    {
      "text": "Add the Worcestershire sauce to the pan and bring the sauce back to a simmer. Stir in the sour cream and mix until well combined.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/garlic-butter-braised-cabbage/#wprm-recipe-52631-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/06/garlic-butter-braised-cabbage-06.jpg"
    },
    {
      "text": "Pour the cream sauce over the braised cabbage and garnish with optional salt and garlic powder. A garlic-herb blend seasoning works very well with this dish. Portion into four equal servings.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/garlic-butter-braised-cabbage/#wprm-recipe-52631-step-0-6",
      "imageSource": null
    }
  ],
