    "fatGrams": 30.4
  },
  "ingredients": [
    "2 cup mozzarella cheese (shredded ~8oz)",
    "3/4 cup almond flour",
    "1 tablespoon psyllium husk powder",
    "1 teaspoon baking powder",
    "1 large egg",
    "3 tablespoon cream cheese (softened)",
    "2 tablespoon italian seasoning",
    "1 teaspoon salt",
    "1 teaspoon black pepper",
    "1 teaspoon garlic powder",
    "1 teaspoon onion powder",
    "3 ounce cheddar cheese",
    "1/4 cup parmesan cheese",
    "3 tablespoon butter",
    "6 tablespoon stevia/erythritol blend (like swerve)",
    "2 tablespoon ground cinnamon"
  ],
  "instructions": [
    {
      "text": "Pre-heat oven to 400F. Mix together egg and cream cheese until slightly combined. Set aside.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-breadsticks/#wprm-recipe-51555-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/01/img_2696.jpg"
    },
    {
      "text": "In a bowl, combine all the dry ingredients: almond flour, psyllium husk, and baking powder.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-breadsticks/#wprm-recipe-51555-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/01/img_2698.jpg"
    },
    {
      "text": "Measure out the mozzarella cheese and microwave in 20 second intervals. Stir the cheese each time you take it out of the microwave and continue microwaving until sizzling.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-breadsticks/#wprm-recipe-51555-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/01/img_2702.jpg"
    },
    {
      "text": "Add the egg, cream cheese, and dry ingredients into the mozzarella cheese and mix together.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-breadsticks/#wprm-recipe-51555-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/01/img_2709.jpg"
    },
    {
      "text": "Using your hands, knead the dough together. Once it is combined, set on a silpat.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-breadsticks/#wprm-recipe-51555-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/01/img_2713.jpg"
    },
    {
      "text": "Press the dough flat until you have a full baking sheet worth of dough. Transfer the dough to some foil so that you can use a pizza cutter on it. Knives and sharp objects should never be used on a silpat!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-breadsticks/#wprm-recipe-51555-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/01/img_2723.jpg"
    },
    {
      "text": "Cut the dough and season per ingredients listed for each. Bake 13-15 minutes on top rack until crisp.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-breadsticks/#wprm-recipe-51555-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/01/img_2738.jpg"
    },
    {
      "text": "Serve while warm! You can serve the savory breadsticks with some marinara and the sweet breadsticks with some cream cheese buttercream.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-breadsticks/#wprm-recipe-51555-step-0-7",
      "imageSource": null
    }
  ],
