  "ingredients": [
    "8 tablespoon butter",
    "32 ounce green cabbage",
    "1 medium yellow onion",
    "2 teaspoon fresh garlic (minced)",
    "1 1/2 cup heavy whipping cream",
    "6 tablespoon ranch dressing",
    "6 ounce cream cheese",
    "salt and pepper (to taste)",
    "6 ounce cheddar cheese (shredded)"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all the ingredients. Preheat oven to 400F and grease a baking dish.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-creamy-cabbage-casserole/#wprm-recipe-53565-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/11/Low-carb-Cabbage-Casserole-1.jpg"
    },
    {
      "text": "Using a mandolin or sharp knife, shred the cabbage, onion, and mince the garlic.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-creamy-cabbage-casserole/#wprm-recipe-53565-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/11/Low-carb-Cabbage-Casserole-2.jpg"
    },
    {
      "text": "In a frying pan, melt the butter on medium to high heat. Saute the shredded cabbage, onion, and garlic for 7-10 minutes or until softened. Add the heavy whipping cream, ranch dressing, and cream cheese. Add salt and pepper to taste. Stir together and let simmer for 5-8 minutes more.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-creamy-cabbage-casserole/#wprm-recipe-53565-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/11/Low-carb-Cabbage-Casserole-3.jpg"
    },
    {
      "text": "Add the cabbage mixture to a greased baking pan. Sprinkle the shredded cheddar cheese evenly over the top. Bake for 15-20 minutes or until cheese is completely melted and golden brown in color.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-creamy-cabbage-casserole/#wprm-recipe-53565-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/11/Low-carb-Cabbage-Casserole-4.jpg"
    },
    {
      "text": "Serve hot and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-creamy-cabbage-casserole/#wprm-recipe-53565-step-0-4",
      "imageSource": null
    }
