  "ingredients": [
    "16 ounce cauliflower (riced or cut into small florets)",
    "1/2 teaspoon salt",
    "2 tablespoon butter",
    "1 cup parmesan cheese (grated)",
    "1/4 teaspoon black pepper",
    "1/2 teaspoon truffle oil",
    "1 tablespoon fresh parsley"
  ],
  "instructions": [
    {
      "text": "Bring water to a boil in the lower part of a steamer. Place the cauliflower florets in the top part and season with half of the salt, reserving the rest for later. Steam the cauliflower until tender, about 7–10 minutes if using riced cauliflower or 10–13 minutes if using small florets.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/mashed-cauliflower-with-parmesan-cheese-and-truffle-oil/#wprm-recipe-52035-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/12/DSC_6310.jpg"
    },
    {
      "text": "Transfer the steamed cauliflower to a food processor. Add the butter, parmesan, black pepper, and remaining salt. Process until smooth.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/mashed-cauliflower-with-parmesan-cheese-and-truffle-oil/#wprm-recipe-52035-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/12/DSC_6323.jpg"
    },
    {
      "text": "Add the truffle oil and parsley to the food processor. Pulse a few times to chop and mix in the parsley leaves and incorporate the truffle oil. Taste and adjust the seasonings as needed.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/mashed-cauliflower-with-parmesan-cheese-and-truffle-oil/#wprm-recipe-52035-step-0-2",
