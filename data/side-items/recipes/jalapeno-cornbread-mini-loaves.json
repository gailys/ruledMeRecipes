  "ingredients": [
    "1 1/2 cup almond flour",
    "1/2 cup flaxseed meal",
    "2 teaspoon baking powder",
    "1 teaspoon salt",
    "1/2 cup sour cream",
    "4 tablespoon butter (melted)",
    "4 large egg",
    "10 drop liquid stevia",
    "1 teaspoon sweet corn extract (such as Amoretti)",
    "2 medium jalapeno pepper (deseeded)",
    "1/2 cup sharp cheddar cheese (grated)"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 375F. Grease a mini loaf pan with cooking spray or butter. Gather the ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/jalapeno-cornbread-mini-loaves/#wprm-recipe-52321-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/09/keto-jalapeno-cornbread-01.jpg"
    },
    {
      "text": "In a large bowl, whisk together the almond flour, golden flaxseed meal, baking powder, and salt.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/jalapeno-cornbread-mini-loaves/#wprm-recipe-52321-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/09/keto-jalapeno-cornbread-02.jpg"
    },
    {
      "text": "In a separate, medium-sized bowl, whisk together the wet ingredients. Combine the wet and dry ingredients well. Fold the diced jalapeño and grated cheddar cheese into the batter.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/jalapeno-cornbread-mini-loaves/#wprm-recipe-52321-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/09/keto-jalapeno-cornbread-03.jpg"
    },
    {
      "text": "Spoon the batter evenly into the prepared loaf pan. Garnish each loaf with a sliced pepper ring, if desired.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/jalapeno-cornbread-mini-loaves/#wprm-recipe-52321-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/09/keto-jalapeno-cornbread-04.jpg"
    },
    {
      "text": "Bake for 20–22 minutes or until golden brown. Let cool in the pan for 5 minutes and remove to a wire rack to finish cooling.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/jalapeno-cornbread-mini-loaves/#wprm-recipe-52321-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/09/keto-jalapeno-cornbread-05.jpg"
    },
    {
      "text": "Serve and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/jalapeno-cornbread-mini-loaves/#wprm-recipe-52321-step-0-5",
      "imageSource": null
    }
  ],
