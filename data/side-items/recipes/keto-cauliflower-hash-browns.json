  },
  "ingredients": [
    "1 pound cauliflower",
    "3 large eggs",
    "½ medium yellow onion (finely diced)",
    "Salt and pepper (to taste)",
    "4 ounces butter"
  ],
  "instructions": [
    {
      "text": "Wash then peel the outer leaves of the cauliflower head. Cut down into a few pieces then rice with a food processor. You could also use a cheese grater if that's what you have.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cauliflower-hash-browns/#wprm-recipe-53127-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/09/cauliflower-hash-browns-04.jpg"
    },
    {
      "text": "Add the riced cauliflower, eggs, onion, salt, and pepper to a mixing bowl. Mix together well then allow to sit for 10 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cauliflower-hash-browns/#wprm-recipe-53127-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/09/cauliflower-hash-browns-05.jpg"
    },
    {
      "text": "Preheat a large skillet, the heat up the butter until it's completely melted.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cauliflower-hash-browns/#wprm-recipe-53127-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/09/cauliflower-hash-browns-01.jpg"
    },
    {
      "text": "Scoop the cauliflower batter into the frying pan, then use a spatula to flatten and shape them into hash browns. You want them to be about 3-4 inches wide.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cauliflower-hash-browns/#wprm-recipe-53127-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/09/cauliflower-hash-browns-02.jpg"
    },
    {
      "text": "Fry for at least 5 minutes on each side, or until they look golden brown. Make sure you don’t flip them too quickly, or they may crumble. Serve as desired.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cauliflower-hash-browns/#wprm-recipe-53127-step-0-4",
      "imageSource": null
    }
  ],
