  "category": "side-items",
  "language": "en",
  "description": "Make these for your family along with eggs and bacon for an American style breakfast. These hash browns are a great option for when you miss potatoes in the morning, or alongside classic brunch style breakfasts.",
  "servings": 4,
  "yield": [
    "4"
  ],
  "prepTime": "PT15M",
  "cookTime": "PT15M",
  "totalTime": "PT30M",
  "totalMinutes": 30,
