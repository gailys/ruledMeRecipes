  "ingredients": [
    "4 large portobello mushrooms",
    "2 1/2 tablespoon olive oil",
    "salt and pepper (to taste)",
    "1/2 cup marinated artichoke hearts (diced)",
    "5 cup spinach",
    "2 ounce cream cheese",
    "1/3 cup parmesan cheese (shredded, for filling)",
    "2 tablespoon flaxseed meal",
    "4 tablespoon parmesan cheese (shredded, for topping)"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 400F. Clean the portobello mushrooms, removing the stems and using a spoon to scrape the gills out from inside the caps.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/artichoke-stuffed-portobello-mushrooms/#wprm-recipe-52165-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/04/step1.jpg"
    },
    {
      "text": "Brush four-fifths of the olive oil onto the mushroom caps and sheet pan. Season with salt and pepper and bake for 10 minutes. If the mushrooms have any water in them, just dab it away with a paper towel.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/artichoke-stuffed-portobello-mushrooms/#wprm-recipe-52165-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/04/step2.jpg"
    },
    {
      "text": "Heat the remaining olive oil in a skillet over high heat. Add the artichoke hearts and spinach and let cook until the spinach leaves are mostly wilted.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/artichoke-stuffed-portobello-mushrooms/#wprm-recipe-52165-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/04/step3.jpg"
    },
    {
      "text": "Add the cream cheese to the pan, stirring until mostly melted. Add the shredded parmesan. Remove from heat and season with salt and pepper, ensuring that the filling is thoroughly mixed.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/artichoke-stuffed-portobello-mushrooms/#wprm-recipe-52165-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/04/step4.jpg"
    },
    {
      "text": "Stuff the mushroom caps with the filling.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/artichoke-stuffed-portobello-mushrooms/#wprm-recipe-52165-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/04/step5.jpg"
    },
    {
      "text": "Top each mushroom with flaxseed meal and parmesan.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/artichoke-stuffed-portobello-mushrooms/#wprm-recipe-52165-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/04/step6.jpg"
    },
    {
      "text": "Bake for an additional 5 minutes, or until the topping is melted.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/artichoke-stuffed-portobello-mushrooms/#wprm-recipe-52165-step-0-6",
      "imageSource": null
    }
  ],
