  "ingredients": [
    "1/2 medium green cabbage",
    "1/2 cup red cabbage (shredded)",
    "1 medium red bell pepper",
    "1 large egg (see note*)",
    "1 cup avocado oil (or avocado mayonnaise if not using raw egg)",
    "1/2 medium lime (juiced)",
    "1 teaspoon fresh garlic (minced)",
    "1/2 teaspoon chili powder",
    "1/2 teaspoon cumin",
    "1 teaspoon salt",
    "1 tablespoon fresh cilantro (chopped)"
  ],
  "instructions": [
    {
      "text": "Shred the cabbage or cut into thin strips. Do the same for the red cabbage, unless using pre-shredded.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/fiesta-slaw-with-avocado-lime-dressing/#wprm-recipe-52265-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/06/fiesta-slaw-avocado-mayo-01.jpg"
    },
    {
      "text": "Cut the top and bottom off the red pepper and remove the stem and seeds. Slice or julienne the strips to desired thickness.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/fiesta-slaw-with-avocado-lime-dressing/#wprm-recipe-52265-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/06/fiesta-slaw-avocado-mayo-02.jpg"
    },
    {
      "text": "Combine the vegetables in a large bowl and refrigerate while preparing the dressing.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/fiesta-slaw-with-avocado-lime-dressing/#wprm-recipe-52265-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/06/fiesta-slaw-avocado-mayo-03.jpg"
    },
    {
      "text": "Crack the egg and pour the oil into a tall, narrow jar or blender cup. Add the lime juice, garlic, chili powder, cumin, salt, and coriander, reserving some of the leaves for garnish.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/fiesta-slaw-with-avocado-lime-dressing/#wprm-recipe-52265-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/06/fiesta-slaw-avocado-mayo-04.jpg"
    },
    {
      "text": "Blend the mixture on high speed using an immersion blender. Keep the blade at the bottom of the cup, moving it back and forth gently. Once the mixture is well blended, slowly pull the base up and down until the mixture becomes creamy.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/fiesta-slaw-with-avocado-lime-dressing/#wprm-recipe-52265-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/06/fiesta-slaw-avocado-mayo-07.jpg"
    },
    {
      "text": "Pour the dressing over the salad and toss gently. Garnish with the remaining cilantro and serve.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/fiesta-slaw-with-avocado-lime-dressing/#wprm-recipe-52265-step-0-5",
      "imageSource": null
    }
  ],
