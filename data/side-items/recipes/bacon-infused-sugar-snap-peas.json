  "ingredients": [
    "3 tablespoon lard",
    "2 teaspoon fresh garlic (minced)",
    "3 cup sugar snap peas",
    "1/2 medium lemon (juiced and zested)",
    "1/2 teaspoon crushed red pepper flakes (for garnish)"
  ],
  "instructions": [
    {
      "text": "Heat the bacon fat in a pan until it reaches its smoking point.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/bacon-infused-sugar-snap-peas/#wprm-recipe-50861-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/02/bacon-infused-sugar-snap-peas-step-01.jpg"
    },
    {
      "text": "Once the smoking point is reached, add in the garlic. Reduce the heat to medium and let cook for 1–2 minutes, until the garlic is lightly browned.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/bacon-infused-sugar-snap-peas/#wprm-recipe-50861-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/02/bacon-infused-sugar-snap-peas-step-02.jpg"
    },
    {
      "text": "Add the snap peas to the pan and squeeze the lemon juice over them. Let cook for another 1–2 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/bacon-infused-sugar-snap-peas/#wprm-recipe-50861-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/02/bacon-infused-sugar-snap-peas-step-03.jpg"
    },
    {
      "text": "Remove and serve. Garnish with the red pepper flakes and lemon zest.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/bacon-infused-sugar-snap-peas/#wprm-recipe-50861-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/02/bacon-infused-sugar-snap-peas-step-04.jpg"
    }
