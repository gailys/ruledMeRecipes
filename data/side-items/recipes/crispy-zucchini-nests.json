  "ingredients": [
    "3 medium zucchini",
    "1 teaspoon garlic powder",
    "1/4 cup cheddar cheese (shredded)",
    "6 slice cooked bacon (chopped)",
    "1/4 cup onion (diced)",
    "salt and pepper (to taste)",
    "12 tablespoon sour cream"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 350F. Spiralize the zucchini using a spiral slicer. On a parchment lined baking sheet, make piles with the zucchini that equal double the amount of servings (each serving is 2 piles). Allow the zucchini to form it’s natural spiral shape.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/crispy-zucchini-nests/#wprm-recipe-52245-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/06/crispy-zucchini-nests-01.jpg"
    },
    {
      "text": "Sprinkle garlic powder over the nests.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/crispy-zucchini-nests/#wprm-recipe-52245-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/06/crispy-zucchini-nests-03.jpg"
    },
    {
      "text": "Open up the middle of the nests and place the cheese, bacon, and onions inside. Season with salt and pepper to taste.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/crispy-zucchini-nests/#wprm-recipe-52245-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/06/crispy-zucchini-nests-05.jpg"
    },
    {
      "text": "Bake for 20 minutes and then broil for an additional 5–10 minutes or until the tops of the nests have browned.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/crispy-zucchini-nests/#wprm-recipe-52245-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/06/crispy-zucchini-nests-06.jpg"
    },
    {
      "text": "Remove from the oven and serve with a dollop of sour cream on top!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/crispy-zucchini-nests/#wprm-recipe-52245-step-0-4",
      "imageSource": null
