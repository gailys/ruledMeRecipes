  "ingredients": [
    "588 gram cauliflower",
    "1/4 cup sour cream",
    "1/2 cup mayonnaise",
    "2 tablespoon white vinegar",
    "1 tablespoon yellow mustard",
    "1 teaspoon celery seed",
    "1/4 teaspoon salt",
    "4 large hard-boiled egg (reseve half of the egg yolks and chop the rest)",
    "50 gram celery (diced)",
    "1 teaspoon fresh dill",
    "30 gram green onion (thinly sliced)"
  ],
  "instructions": [
    {
      "text": "Prepare the cauliflower by cutting the head into bite-sized florets and steaming in a silicone steamer (as shown) for 3–4 minutes, or in a stovetop steamer, until the cauliflower is only slightly tender. Set aside to cool.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-keto-potato-salad/#wprm-recipe-52281-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/07/faux-keto-potato-salad-01.jpg"
    },
    {
      "text": "Make the dressing by whisking together the sour cream, mayo, vinegar, mustard, celery seed, and salt.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-keto-potato-salad/#wprm-recipe-52281-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/07/faux-keto-potato-salad-02.jpg"
    },
    {
      "text": "Mash the reserved egg yolks into the cream mixture and whisk until very smooth.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-keto-potato-salad/#wprm-recipe-52281-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/07/faux-keto-potato-salad-03.jpg"
    },
    {
      "text": "Add the cooled cauliflower, chopped hard-boiled eggs, celery, green onion, and dill. Stir to coat everything evenly.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-keto-potato-salad/#wprm-recipe-52281-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/07/faux-keto-potato-salad-06.jpg"
    },
    {
      "text": "Refrigerate for about 1 hour to allow the cauliflower to completely cool and the flavors to meld. Garnish with a bit of extra green onion and serve cold!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-keto-potato-salad/#wprm-recipe-52281-step-0-4",
