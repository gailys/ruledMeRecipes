  "ingredients": [
    "1 large cauliflower",
    "2 tablespoon heavy whipping cream",
    "2 tablespoon butter",
    "2 tablespoon sour cream",
    "1/4 teaspoon garlic powder",
    "salt and pepper (to taste)"
  ],
  "instructions": [
    {
      "text": "Add a cup of water to a saucepan, then set it over medium heat and bring it to a simmer. Separate the cauliflower into florets. Save the cores!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-mashed-potatoes/#wprm-recipe-50371-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/10/cauliflower-mashed-potatoes-1.jpg"
    },
    {
      "text": "Chop the cauliflower cores into small pieces (dice it).",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-mashed-potatoes/#wprm-recipe-50371-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/10/cauliflower-mashed-potatoes-2.jpg"
    },
    {
      "text": "Add all the cauliflower to the pot, and cover.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-mashed-potatoes/#wprm-recipe-50371-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/10/cauliflower-mashed-potatoes-3.jpg"
    },
    {
      "text": "Cook for 12-15 minutes, until cauliflower is very tender.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-mashed-potatoes/#wprm-recipe-50371-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/10/cauliflower-mashed-potatoes-4.jpg"
    },
    {
      "text": "Drain all water and add heavy cream, butter, sour cream, salt and pepper.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-mashed-potatoes/#wprm-recipe-50371-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/10/cauliflower-mashed-potatoes-6.jpg"
    },
    {
      "text": "Grab your masher and go to town on these tasty, tender morsels.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-mashed-potatoes/#wprm-recipe-50371-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/10/cauliflower-mashed-potatoes-7.jpg"
    },
    {
      "text": "Top with chives, cheese, or bacon.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-mashed-potatoes/#wprm-recipe-50371-step-0-6",
      "imageSource": null
    }
  ],
