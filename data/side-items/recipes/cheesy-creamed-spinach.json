  "ingredients": [
    "3 tablespoon butter",
    "1 1/2 cup cheddar cheese",
    "7 cup spinach",
    "1/2 teaspoon salt",
    "1/2 teaspoon black pepper",
    "1/2 teaspoon all-purpose seasoning (such as Mrs. Dash)",
    "3 tablespoon heavy whipping cream"
  ],
  "instructions": [
    {
      "text": "Melt the butter in a pan over medium-low heat.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cheesy-creamed-spinach/#wprm-recipe-50989-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/cheesy-creamed-spinach-04.jpg"
    },
    {
      "text": "Shred the cheddar cheese as the butter mets.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cheesy-creamed-spinach/#wprm-recipe-50989-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/cheesy-creamed-spinach-03.jpg"
    },
    {
      "text": "Once the butter has melted, add the spinach to the pan. Next, add the seasonings: salt, pepper, and Mrs. Dash Table Blend.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cheesy-creamed-spinach/#wprm-recipe-50989-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/cheesy-creamed-spinach-06.jpg"
    },
    {
      "text": "Allow the spinach to wilt, then add in the shredded cheddar cheese and heavy cream.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cheesy-creamed-spinach/#wprm-recipe-50989-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/cheesy-creamed-spinach-08.jpg"
    },
    {
      "text": "Mix everything well until the cheese melts down and the sauce is smooth.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cheesy-creamed-spinach/#wprm-recipe-50989-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/cheesy-creamed-spinach-09.jpg"
    },
    {
      "text": "Move the spinach to one side of the pan and turn the heat up to medium-high. Allow the sauce to reduce.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cheesy-creamed-spinach/#wprm-recipe-50989-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/cheesy-creamed-spinach-12.jpg"
    },
    {
      "text": "Once reduced, mix again and serve hot. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cheesy-creamed-spinach/#wprm-recipe-50989-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/cheesy-creamed-spinach-11.jpg"
    }
