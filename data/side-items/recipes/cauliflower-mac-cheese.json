  "ingredients": [
    "32 ounce frozen cauliflower (florets)",
    "1 cup heavy whipping cream",
    "4 ounce cream cheese (cubed)",
    "8 ounce cheddar cheese (shredded)",
    "1 teaspoon dijon mustard",
    "1 teaspoon turmeric powder",
    "1/2 teaspoon garlic powder",
    "salt and pepper (to taste)"
  ],
  "instructions": [
    {
      "text": "Cook the cauliflower florets according to the package instructions.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cauliflower-mac-cheese/#wprm-recipe-52181-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/05/macandcheese-1-of-13.jpg"
    },
    {
      "text": "Bring the cream to a simmer. Use a whisk to stir in the cream cheese and mix until smooth.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cauliflower-mac-cheese/#wprm-recipe-52181-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/05/macandcheese-2-of-13.jpg"
    },
    {
      "text": "Stir in 3/4 of the shredded cheddar cheese. Save the other 1/4 for later. Mix until the cheese melts into the sauce.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cauliflower-mac-cheese/#wprm-recipe-52181-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/05/macandcheese-3-of-13.jpg"
    },
    {
      "text": "Add the Dijon mustard, turmeric, powdered garlic, salt, and pepper. The sauce will become a smooth yellow color.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cauliflower-mac-cheese/#wprm-recipe-52181-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/05/macandcheese-6-of-13.jpg"
    },
    {
      "text": "Make sure that the cauliflower is drained well, then add it to the cheese sauce. Evenly coat the florets with sauce.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cauliflower-mac-cheese/#wprm-recipe-52181-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/05/macandcheese-8-of-13.jpg"
    },
    {
      "text": "Sprinkle on the remaining cheddar cheese, then stir until mostly melted.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cauliflower-mac-cheese/#wprm-recipe-52181-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/05/macandcheese-11-of-13.jpg"
    }
  ],
