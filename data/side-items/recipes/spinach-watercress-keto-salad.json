  "ingredients": [
    "3 cup baby spinach",
    "1 cup watercress",
    "1 medium avocado (sliced)",
    "1/8 cup lemon juice",
    "1/4 cup avocado oil",
    "1 tablespoon mediterranean seasoning",
    "1/2 cup parmesan cheese (shredded)",
    "salt and pepper (to taste)"
  ],
  "instructions": [
    {
      "text": "Prepare the greens by washing and removing the stems from the spinach and watercress. Pat dry.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/spinach-watercress-keto-salad/#wprm-recipe-52285-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/07/spinach-watercress-salad-keto-lemon-dressing-01.jpg"
    },
    {
      "text": "Combine the spinach and watercress in a large bowl or serving platter.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/spinach-watercress-keto-salad/#wprm-recipe-52285-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/07/spinach-watercress-salad-keto-lemon-dressing-02.jpg"
    },
    {
      "text": "Cut the avocado in half and remove the pit. Peel the skin off of each side.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/spinach-watercress-keto-salad/#wprm-recipe-52285-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/07/spinach-watercress-salad-keto-lemon-dressing-07.jpg"
    },
    {
      "text": "Slice the avocado in thin strips and set these aside for later.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/spinach-watercress-keto-salad/#wprm-recipe-52285-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/07/spinach-watercress-salad-keto-lemon-dressing-04.jpg"
    },
    {
      "text": "To prepare the dressing, combine the lemon juice, avocado oil, and Mediterranean seasoning. Shake well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/spinach-watercress-keto-salad/#wprm-recipe-52285-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/07/spinach-watercress-salad-keto-lemon-dressing-05.jpg"
    },
    {
      "text": "Add the shredded parmesan, avocado slices, and salt and pepper to the spinach. Drizzle with the dressing and serve.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/spinach-watercress-keto-salad/#wprm-recipe-52285-step-0-5",
      "imageSource": null
    }
