  "instructions": [
    {
      "text": "Bring water to a boil in a pan over medium-high heat. Don't fill it all the way — make sure to leave enough room to ensure that the water does NOT touch the mixing bowl placed on top. Place the chocolate in a mixing bowl.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-chocolate-ganache/#wprm-recipe-50609-step-0-0",
