    {
      "text": "Add the chopped broccoli and cauliflower, onion, crumbled bacon, and sliced almonds to a large bowl.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/broccoli-cauliflower-salad/#wprm-recipe-52369-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/11/broccoli-cauliflower-salad-04.jpg"
