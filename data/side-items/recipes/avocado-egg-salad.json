  "instructions": [
    {
      "text": "Preheat a frying pan. Cook bacon to desired crispness, then set aside to cool on paper towels. When cooled, chop the bacon into small pieces.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/avocado-egg-salad/#wprm-recipe-52822-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/12/bacon-and-egg-benedict-salad-01.jpg"
    },
    {
      "text": "Hard-boil the eggs to your own preference. Let them cool, then peel the eggs and place them in a bowl.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/avocado-egg-salad/#wprm-recipe-52822-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/12/avocado-egg-salad-01.jpg"
    },
    {
      "text": "Add in mayonnaise, lemon juice, garlic, salt, pepper, and green onions.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/avocado-egg-salad/#wprm-recipe-52822-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/12/avocado-egg-salad-03.jpg"
    },
    {
      "text": "Mash using a fork or potato masher until desired consistency.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/avocado-egg-salad/#wprm-recipe-52822-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/12/avocado-egg-salad-04.jpg"
    },
    {
      "text": "Spoon the avocado from the halves into the egg salad. Mash the avocado into the egg salad.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/avocado-egg-salad/#wprm-recipe-52822-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/12/avocado-egg-salad-05.jpg"
    },
    {
      "text": "Stir in the hot sauce and chopped bacon.",
      "group": "",
