  "ingredients": [
    "1/2 cup almond flour",
    "4 teaspoon psyllium husk powder",
    "1 teaspoon baking powder",
    "1/2 teaspoon garlic powder",
    "1/4 teaspoon salt",
    "2 large egg white",
    "1 tablespoon avocado oil",
    "1 tablespoon parmesan cheese (grated)"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 350F. Line a baking sheet with parchment paper. In a large mixing bowl, add the almond flour, psyllium husk, baking powder, garlic powder, and salt. Stir until combined.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/garlic-parmesan-keto-croutons/#wprm-recipe-52325-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/09/keto-croutons-01.jpg"
    },
    {
      "text": "Add in the egg whites and stir to combine.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/garlic-parmesan-keto-croutons/#wprm-recipe-52325-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/09/keto-croutons-02.jpg"
    },
    {
      "text": "Work the dough using a spatula or your hands until it's a thick, slightly sticky consistency.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/garlic-parmesan-keto-croutons/#wprm-recipe-52325-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/09/keto-croutons-03.jpg"
    },
    {
      "text": "Divide the dough into balls and place them on the parchment paper. They will already be drying up as you continue to work with them, so move quickly!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/garlic-parmesan-keto-croutons/#wprm-recipe-52325-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/09/keto-croutons-04.jpg"
    },
    {
      "text": "Flatten each dough ball slightly and bake for 10 minutes, or until the dough seems firm but not yet crusted on the edges.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/garlic-parmesan-keto-croutons/#wprm-recipe-52325-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/09/keto-croutons-05.jpg"
    },
    {
      "text": "Cut each portion in half horizontally and then slice into squares.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/garlic-parmesan-keto-croutons/#wprm-recipe-52325-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/09/keto-croutons-06.jpg"
    },
    {
      "text": "Drizzle the croutons with oil, sprinkle with parmesan cheese, and return to oven until the cheese has melted and browned.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/garlic-parmesan-keto-croutons/#wprm-recipe-52325-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/09/keto-croutons-07.jpg"
    },
    {
      "text": "Cool and serve over keto salads or soups!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/garlic-parmesan-keto-croutons/#wprm-recipe-52325-step-0-7",
      "imageSource": null
    }
  ],
