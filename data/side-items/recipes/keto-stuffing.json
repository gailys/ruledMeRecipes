  "ingredients": [
    "9 tablespoon almond flour (can be subbed for 3 tablespoon coconut flour)",
    "3 tablespoon butter (melted)",
    "3 large egg",
    "6 tablespoon grated parmesan cheese",
    "1 1/2 teaspoon baking powder",
    "2 tablespoon butter (melted)",
    "4 medium celery",
    "1/4 medium yellow onion (chopped)",
    "1/4 cup leek (chopped)",
    "1 teaspoon dried thyme",
    "1/2 teaspoon dried sage",
    "1/2 teaspoon dried rosemary",
    "salt and pepper (to taste)",
    "1/4 cup chicken broth",
    "1/4 cup heavy cream"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all of the ingredients. Make the keto bread following these instructions: https://www.ruled.me/90-second-keto-bread/",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-stuffing/#wprm-recipe-54507-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/11/Keto-Stuffing-1.jpg"
    },
    {
      "text": "Cube the keto bread and place onto a baking sheet.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-stuffing/#wprm-recipe-54507-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/11/Keto-Stuffing-2.jpg"
    },
    {
      "text": "Bake in the oven for about 5-10 minutes at 425F.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-stuffing/#wprm-recipe-54507-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/11/Keto-Stuffing-3.jpg"
    },
    {
      "text": "In a frying pan, sautee celery, onion, and leeks in butter over low to medium heat for a few minutes. Remove from heat.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-stuffing/#wprm-recipe-54507-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/11/Keto-Stuffing-4.jpg"
    },
    {
      "text": "Mix the cubed bread into the sauteed vegetables. Place this in a baking pan and top with thyme, sage, rosemary, salt, and pepper. Combine heavy cream and chicken broth together. Drizzle this over the top. Reduce heat to 350F and covered with aluminum foil.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-stuffing/#wprm-recipe-54507-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/11/Keto-Stuffing-5.jpg"
    },
    {
      "text": "Bake in the oven for 10 minutes, remove foil and cook for another 5 minutes. Serve and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-stuffing/#wprm-recipe-54507-step-0-5",
      "imageSource": null
    }
  ],
