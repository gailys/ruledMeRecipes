  "ingredients": [
    "1 medium cauliflower",
    "3 teaspoon fresh garlic (minced)",
    "1 tablespoon butter",
    "3/4 cup heavy whipping cream",
    "1 cup parmesan cheese (shredded)",
    "2 tablespoon cream cheese",
    "salt and pepper (to taste)"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 350F. Chop up the cauliflower into small-to-medium sized florets and place them into a casserole dish.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/garlic-parmesan-cauliflower-wings/#wprm-recipe-52615-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/06/garlic-parmesan-cauliflower-02.jpg"
    },
    {
      "text": "Mince the garlic cloves.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/garlic-parmesan-cauliflower-wings/#wprm-recipe-52615-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/06/garlic-parmesan-cauliflower-03.jpg"
    },
    {
      "text": "Melt the butter in a pan and saute the garlic in it briefly to soften and release flavor. Add a few dashes of salt and pepper.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/garlic-parmesan-cauliflower-wings/#wprm-recipe-52615-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/06/garlic-parmesan-cauliflower-04.jpg"
    },
    {
      "text": "Pour in the heavy cream and let it come to a simmer.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/garlic-parmesan-cauliflower-wings/#wprm-recipe-52615-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/06/garlic-parmesan-cauliflower-05.jpg"
    },
    {
      "text": "Whisk in a small handful of the Parmesan cheese. Once it is melted, add more.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/garlic-parmesan-cauliflower-wings/#wprm-recipe-52615-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/06/garlic-parmesan-cauliflower-06.jpg"
    },
    {
      "text": "Continue whisking in the Parmesan in small amounts until all of it is incorporated. Add in the cream cheese, stirring until it melts.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/garlic-parmesan-cauliflower-wings/#wprm-recipe-52615-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/06/garlic-parmesan-cauliflower-06-1.jpg"
    },
    {
      "text": "Pour the sauce all over the cauliflower and toss until they are all coated.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/garlic-parmesan-cauliflower-wings/#wprm-recipe-52615-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/06/garlic-parmesan-cauliflower-08.jpg"
    },
    {
      "text": "Bake for 45 minutes. This is optional, but for extra crispiness you can broil for an additional few minutes, turning once.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/garlic-parmesan-cauliflower-wings/#wprm-recipe-52615-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/06/garlic-parmesan-cauliflower-09.jpg"
    }
  ],
