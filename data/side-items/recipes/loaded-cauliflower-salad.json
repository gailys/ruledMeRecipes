  "ingredients": [
    "1 medium cauliflower",
    "4 large egg (hard boiled)",
    "1 cup mayonnaise",
    "3 slice cooked bacon (chopped)",
    "2 tablespoon apple cider vinegar",
    "1/4 cup onion (chopped)",
    "1 teaspoon fresh garlic (minced)",
    "3/4 cup green onion (chopped)",
    "1 teaspoon stevia/erythritol blend"
  ],
  "instructions": [
    {
      "text": "Chop up the cauliflower into bite-size pieces.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/loaded-cauliflower-salad/#wprm-recipe-52337-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/09/loaded-cauliflower-salad-01.jpg"
    },
    {
      "text": "In a separate bowl, place your hard boiled and peeled eggs. Add your mayonnaise to the eggs.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/loaded-cauliflower-salad/#wprm-recipe-52337-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/09/loaded-cauliflower-salad-02.jpg"
    },
    {
      "text": "Top with the rest of your ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/loaded-cauliflower-salad/#wprm-recipe-52337-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/09/loaded-cauliflower-salad-04.jpg"
    },
    {
      "text": "Mash with a fork until all your ingredients are mixed and your eggs are now crushed into small pieces.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/loaded-cauliflower-salad/#wprm-recipe-52337-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/09/loaded-cauliflower-salad-05.jpg"
    },
    {
      "text": "Dump your sauce onto the cauliflower.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/loaded-cauliflower-salad/#wprm-recipe-52337-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/09/loaded-cauliflower-salad-06.jpg"
    },
    {
      "text": "Mix thoroughly.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/loaded-cauliflower-salad/#wprm-recipe-52337-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/09/loaded-cauliflower-salad-07.jpg"
    },
    {
      "text": "Top with a little more bacon and green onions.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/loaded-cauliflower-salad/#wprm-recipe-52337-step-0-6",
      "imageSource": null
    }
  ],
