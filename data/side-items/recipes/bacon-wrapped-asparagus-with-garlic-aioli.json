  "description": "This makes a total of 3 servings of Bacon-Wrapped Asparagus with Garlic Aioli. Each serving comes out to be 507 calories, 47g fats, 5.8g net carbs, and 13.4g protein.",
  "servings": 3,
  "yield": [
    "3",
    "3 servings"
  ],
  "prepTime": "PT15M",
  "cookTime": "PT25M",
