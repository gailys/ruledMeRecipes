  "ingredients": [
    "1 medium green cabbage",
    "2 tablespoon olive oil",
    "3 tablespoon lemon juice",
    "salt and pepper (to taste)",
    "1/2 medium lemon (sliced to garnish)"
  ],
  "instructions": [
    {
      "text": "Gather ingredients and preheat oven to 450F. Use nonstick spray or olive oil to coat your roasting pan.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-roasted-lemony-cabbage/#wprm-recipe-59514-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/06/keto-roasted-lemony-cabbage-step-01.jpg"
    },
    {
      "text": "Slice the cabbage into 8 wedges, cutting through the core and the stem.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-roasted-lemony-cabbage/#wprm-recipe-59514-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/06/keto-roasted-lemony-cabbage-step-02.jpg"
    },
    {
      "text": "Whisk the olive oil and lemon juice together. Brush this all over the cabbage, then season each wedge with salt and pepper.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-roasted-lemony-cabbage/#wprm-recipe-59514-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/06/keto-roasted-lemony-cabbage-step-03.jpg"
    },
    {
      "text": "Turn the wedges over and repeat with the second side.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-roasted-lemony-cabbage/#wprm-recipe-59514-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/06/keto-roasted-lemony-cabbage-step-04.jpg"
    },
    {
      "text": "Roast the cabbage for about 15 minutes, then carefully flip the wedges over.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-roasted-lemony-cabbage/#wprm-recipe-59514-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/06/keto-roasted-lemony-cabbage-step-05.jpg"
    },
    {
      "text": "Roast the opposite side for another 15 minutes. Serve hot with the lemon wedges.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-roasted-lemony-cabbage/#wprm-recipe-59514-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/06/keto-roasted-lemony-cabbage-step-06.jpg"
    }
  ],
