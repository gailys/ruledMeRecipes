  "ingredients": [
    "16 ounce green beans (ends trimmed)",
    "1 tablespoon butter",
    "1 tablespoon olive oil",
    "2 teaspoon fresh garlic (minced)",
    "1 teaspoon salt",
    "1/2 teaspoon black pepper",
    "1 tablespoon parmesan cheese (grated)"
  ],
  "instructions": [
    {
      "text": "Bring water to a rolling boil in a large pot.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/crisp-garlic-green-beans/#wprm-recipe-50393-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/11/Garlic-Parmesan-Green-Beans-4.jpg"
    },
    {
      "text": "Add the green beans and steam for 3–4 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/crisp-garlic-green-beans/#wprm-recipe-50393-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/11/Garlic-Parmesan-Green-Beans-5.jpg"
    },
    {
      "text": "Immediately drain the green beans and add them to a bowl of ice water until completely cooled.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/crisp-garlic-green-beans/#wprm-recipe-50393-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/11/Garlic-Parmesan-Green-Beans-6.jpg"
    },
    {
      "text": "Meanwhile, melt the butter in a pan over medium heat. Once melted, add the olive oil and garlic.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/crisp-garlic-green-beans/#wprm-recipe-50393-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/11/Garlic-Parmesan-Green-Beans-8.jpg"
    },
    {
      "text": "Drain the green beans and leave to rest on paper towels.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/crisp-garlic-green-beans/#wprm-recipe-50393-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/11/Garlic-Parmesan-Green-Beans-2.jpg"
    },
    {
      "text": "Once the garlic is starting to sizzle, add the green beans to the pan and toss to coat in the oil. Season with salt and pepper and remove from the heat.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/crisp-garlic-green-beans/#wprm-recipe-50393-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/11/Garlic-Parmesan-Green-Beans-9.jpg"
    },
    {
      "text": "Sprinkle with the Parmesan and serve.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/crisp-garlic-green-beans/#wprm-recipe-50393-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/11/zgreenbeans-3.jpg"
    }
  ],
