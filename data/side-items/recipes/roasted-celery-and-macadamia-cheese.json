  "ingredients": [
    "11 ounce celery",
    "6 ounce macadamia nuts",
    "2 tablespoon lemon juice",
    "3 tablespoon nutritional yeast",
    "1/2 teaspoon garlic powder",
    "1/2 cup water",
    "2 tablespoon fresh basil",
    "salt and pepper"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 350F. Wash, trim, and cut the stalks of celery into halves. Peel as many of the strings off as you can.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/roasted-celery-and-macadamia-cheese/#wprm-recipe-52503-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/01/roasted-celery-n-macadamia-cheese-01.jpg"
    },
    {
      "text": "In a food processor blend the macadamia nuts, lemon juice, nutritional yeast, garlic powder, water, and fresh basil. Add salt and pepper to taste.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/roasted-celery-and-macadamia-cheese/#wprm-recipe-52503-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/01/roasted-celery-n-macadamia-cheese-03.jpg"
    },
    {
      "text": "Lay the celery in an oven proof dish. Season with salt and pepper.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/roasted-celery-and-macadamia-cheese/#wprm-recipe-52503-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/01/roasted-celery-n-macadamia-cheese-02.jpg"
    },
    {
      "text": "Spoon the macadamia nut cheese into the celery. Divide it up as evenly as you can.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/roasted-celery-and-macadamia-cheese/#wprm-recipe-52503-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/01/roasted-celery-n-macadamia-cheese-04.jpg"
    },
    {
      "text": "Bake for around 40 minutes. If you’d like the macadamia cheese to look more brown, then pop it under the broiler for a few minutes. It’s ready when the celery is soft and can be easily cut with a fork.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/roasted-celery-and-macadamia-cheese/#wprm-recipe-52503-step-0-4",
      "imageSource": null
    }
