  "ingredients": [
    "1 cup coconut flour (sifted)",
    "1/2 cup flaxseed meal",
    "1 teaspoon salt",
    "1 teaspoon baking powder",
    "1/2 teaspoon baking soda",
    "6 large egg (room temperature)",
    "1/2 cup water",
    "1 tablespoon apple cider vinegar"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 350F. Grease a loaf pan. Sift the coconut flour into a mixing bowl.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-bread-loaves/#wprm-recipe-52019-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/12/keto-bread-loaves-step-01.jpg"
    },
    {
      "text": "Add the remaining dry ingredients and whisk together.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-bread-loaves/#wprm-recipe-52019-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/12/keto-bread-loaves-step-02.jpg"
    },
    {
      "text": "Add in eggs, water, and vinegar.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-bread-loaves/#wprm-recipe-52019-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/12/keto-bread-loaves-step-03.jpg"
    },
    {
      "text": "Mix until the batter comes together — it will be quite thick.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-bread-loaves/#wprm-recipe-52019-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/12/keto-bread-loaves-step-04.jpg"
    },
    {
      "text": "Press batter into the loaf pan(s) and bake until cooked through, about 40 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-bread-loaves/#wprm-recipe-52019-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/12/keto-bread-loaves-step-05.jpg"
    },
    {
      "text": "Allow the bread to cool in the pan until just warm, and then remove from the pan, slice, and enjoy.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-bread-loaves/#wprm-recipe-52019-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/12/keto-bread-loaves-step-06.jpg"
    }
