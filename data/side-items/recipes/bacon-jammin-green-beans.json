  ],
  "instructions": [
    {
      "text": "Bring water to boil on the stove.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/bacon-jammin-green-beans/#wprm-recipe-50315-step-0-0",
      "imageSource": null
    },
    {
      "text": "Add your green beans and boil for 3-4 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/bacon-jammin-green-beans/#wprm-recipe-50315-step-0-1",
      "imageSource": null
    },
    {
      "text": "Drain your green beans and put them in an ice bath for 2-3 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/bacon-jammin-green-beans/#wprm-recipe-50315-step-0-2",
      "imageSource": null
    },
    {
      "text": "In a pan, bring 3 Tbsp. Bacon Jam and 1 Tbsp. Olive Oil to a sizzle.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/bacon-jammin-green-beans/#wprm-recipe-50315-step-0-3",
      "imageSource": null
    },
    {
      "text": "Drain your green beans again, dry them, and add them to the pan.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/bacon-jammin-green-beans/#wprm-recipe-50315-step-0-4",
      "imageSource": null
    },
    {
      "text": "Stir everything together, let cook for 1-2 minutes, then serve.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/bacon-jammin-green-beans/#wprm-recipe-50315-step-0-5",
      "imageSource": null
    }
