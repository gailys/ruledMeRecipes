  "ingredients": [
    "2 ounce cream cheese (softened)",
    "1/4 cup cheddar cheese (shredded)",
    "1/2 cup almond flour",
    "1 teaspoon garlic (minced)",
    "1 teaspoon dried chives",
    "1 tablespoon coconut flour",
    "1 large egg white (beaten)"
  ],
  "instructions": [
    {
      "text": "Heat oven to 350F and line a baking sheet with parchment. In a large bowl mix cream cheese and cheddar cheese.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/garlic-and-herb-breadstick-bites/#wprm-recipe-52690-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/08/garlic-n-herb-breadstick-bites-01.jpg"
    },
    {
      "text": "Stir in almond flour, minced garlic, chives, coconut flour, and egg white. The dough should be soft and not dry or crumbly.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/garlic-and-herb-breadstick-bites/#wprm-recipe-52690-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/08/garlic-n-herb-breadstick-bites-02.jpg"
    },
    {
      "text": "Add the dough to a pastry bag or large plastic bag, and cut about 1 inch from the tip.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/garlic-and-herb-breadstick-bites/#wprm-recipe-52690-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/08/garlic-n-herb-breadstick-bites-04.jpg"
    },
    {
      "text": "Pipe the dough onto a baking sheet in 3-inch strips.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/garlic-and-herb-breadstick-bites/#wprm-recipe-52690-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/08/garlic-n-herb-breadstick-bites-05.jpg"
    },
    {
      "text": "Using the tines of a fork, gently flatten each strip.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/garlic-and-herb-breadstick-bites/#wprm-recipe-52690-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/08/garlic-n-herb-breadstick-bites-06.jpg"
    },
    {
      "text": "Bake for 10-15 minutes or until golden. Serve hot or let cool completely for a crispy stick!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/garlic-and-herb-breadstick-bites/#wprm-recipe-52690-step-0-5",
      "imageSource": null
    }
  ],
