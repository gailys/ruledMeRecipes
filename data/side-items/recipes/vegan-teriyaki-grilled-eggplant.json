  "ingredients": [
    "1/4 cup sesame oil",
    "1/2 cup soy sauce",
    "2 teaspoon fresh garlic (peeled and smashed)",
    "1 tablespoon ground ginger",
    "2 tablespoon stevia/erythritol blend",
    "2 medium eggplant",
    "1 tablespoon toasted sesame seeds"
  ],
  "instructions": [
    {
      "text": "Combine sesame oil, soy sauce (or liquid aminos), garlic, ginger, and sweetener into a sauce pan and whisk together over medium heat.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/vegan-teriyaki-grilled-eggplant/#wprm-recipe-52643-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/07/vegan-grilled-terriyaki-eggplant-02.jpg"
    },
    {
      "text": "Bring the sauce to a light simmer, stirring frequently until it begins to thicken slightly. Remove from heat.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/vegan-teriyaki-grilled-eggplant/#wprm-recipe-52643-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/07/vegan-grilled-terriyaki-eggplant-03.jpg"
    },
    {
      "text": "Remove the stems from the eggplants and slice into 1/8 in slices. You will get approximately five full slices from each eggplant.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/vegan-teriyaki-grilled-eggplant/#wprm-recipe-52643-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/07/vegan-grilled-terriyaki-eggplant-05.jpg"
    },
    {
      "text": "Brush each slice of eggplant with the teriyaki sauce and place on a hot grill.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/vegan-teriyaki-grilled-eggplant/#wprm-recipe-52643-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/07/vegan-grilled-terriyaki-eggplant-06.jpg"
    },
    {
      "text": "Sear each side, brushing with more sauce as it caramelizes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/vegan-teriyaki-grilled-eggplant/#wprm-recipe-52643-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/07/vegan-grilled-terriyaki-eggplant-08.jpg"
    },
    {
      "text": "Garnish with toasted sesame seeds and serve with remaining sauce.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/vegan-teriyaki-grilled-eggplant/#wprm-recipe-52643-step-0-5",
