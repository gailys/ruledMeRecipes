  "ingredients": [
    "10 ounce frozen spinach",
    "1/4 teaspoon garlic powder",
    "1/4 teaspoon onion powder",
    "salt and pepper (to taste)",
    "3 ounce cream cheese",
    "2 tablespoon sour cream",
    "3 tablespoon parmesan cheese"
  ],
  "instructions": [
    {
      "text": "Defrost frozen spinach in the microwave until warmed through, usually about 6–7 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/easy-keto-creamed-spinach/#wprm-recipe-51725-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/06/img_5811.jpg"
    },
    {
      "text": "Heat a pan on the stove over medium-high heat. Once hot, add the spinach and let some of the water boil off. Add the seasonings and mix well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/easy-keto-creamed-spinach/#wprm-recipe-51725-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/06/img_5813.jpg"
    },
    {
      "text": "Add the cream cheese and stir together until it has melted.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/easy-keto-creamed-spinach/#wprm-recipe-51725-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/06/img_5816.jpg"
    },
    {
      "text": "Add the sour cream and mix. Turn the pan down to low.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/easy-keto-creamed-spinach/#wprm-recipe-51725-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/06/img_5818.jpg"
    },
    {
      "text": "Finally, add the parmesan cheese and stir until the creamed spinach has thickened.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/easy-keto-creamed-spinach/#wprm-recipe-51725-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/06/img_5819.jpg"
    },
    {
      "text": "Serve and enjoy! This goes great with just about anything,",
      "group": "",
      "sourceUrl": "https://www.ruled.me/easy-keto-creamed-spinach/#wprm-recipe-51725-step-0-5",
      "imageSource": null
    }
  ],
