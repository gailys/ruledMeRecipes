  "ingredients": [
    "16 ounce green beans (trimmed)",
    "2 tablespoon lemon juice",
    "1/2 teaspoon salt",
    "2 tablespoon olive oil",
    "1/3 cup almonds (sliced)",
    "4 teaspoon fresh garlic (thinly sliced)"
  ],
  "instructions": [
    {
      "text": "Steam the green beans until they are tender, but retain a slight snap.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/green-beans-with-lemon-and-almonds/#wprm-recipe-59718-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/05/green-beans-with-lemon-and-almonds-step-01.jpg"
    },
    {
      "text": "Transfer the beans to a bowl and add the lemon juice and salt. Mix together well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/green-beans-with-lemon-and-almonds/#wprm-recipe-59718-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/05/green-beans-with-lemon-and-almonds-step-02.jpg"
    },
    {
      "text": "Heat the olive oil in a frying pan, then add the almonds. Cook until they start to have some color.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/green-beans-with-lemon-and-almonds/#wprm-recipe-59718-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/05/green-beans-with-lemon-and-almonds-step-03.jpg"
    },
    {
      "text": "Mix in the garlic then cook for another 30 seconds until it changes color. Add this to the green beans.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/green-beans-with-lemon-and-almonds/#wprm-recipe-59718-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/05/green-beans-with-lemon-and-almonds-step-04.jpg"
    },
    {
      "text": "Toss well, then serve.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/green-beans-with-lemon-and-almonds/#wprm-recipe-59718-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/05/green-beans-with-lemon-and-almonds-step-05.jpg"
    }
  ],
