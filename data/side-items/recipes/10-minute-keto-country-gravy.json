  "ingredients": [
    "4 ounce breakfast sausage",
    "2 tablespoon butter",
    "1 cup heavy whipping cream",
    "1/2 teaspoon guar gum",
    "salt and pepper (to taste)"
  ],
  "instructions": [
    {
      "text": "Add sausage to a heated pan and brown all over.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/10-minute-keto-country-gravy/#wprm-recipe-51737-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/06/img_7796.jpg"
    },
    {
      "text": "Remove the sausage from the pan, reserving as much of the fat as possible. Add in the butter and let it melt.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/10-minute-keto-country-gravy/#wprm-recipe-51737-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/06/img_7801.jpg"
    },
    {
      "text": "Once completely melted, add the heavy cream to the pan. Stir it as it bubbles.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/10-minute-keto-country-gravy/#wprm-recipe-51737-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/06/img_7805.jpg"
    },
    {
      "text": "Add in the guar gum and stir vigorously while the cream is bubbling. Let the mixture thicken until it takes a moment to come back together after running a spoon through it.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/10-minute-keto-country-gravy/#wprm-recipe-51737-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/06/img_7812.jpg"
    },
    {
      "text": "Add the sausage back into the pan and stir together. Serve and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/10-minute-keto-country-gravy/#wprm-recipe-51737-step-0-4",
      "imageSource": null
    }
  ],
