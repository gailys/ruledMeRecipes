  "ingredients": [
    "16 ounce brussels sprouts",
    "1 tablespoon coconut oil",
    "1 tablespoon fresh garlic (minced)",
    "1/2 cup sour cream",
    "1/4 cup heavy whipping cream",
    "1 1/2 cup pepper jack cheese (shredded)",
    "salt and pepper (to taste)",
    "1 tablespoon sun-dried tomatoes"
  ],
  "instructions": [
    {
      "text": "Clean Brussels sprouts, slice into halves and place in a large skillet that has a tight fitting lid.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/one-pan-pepper-jack-brussels-sprouts/#wprm-recipe-52647-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/07/one-pan-pepper-jack-brussels-sprouts-01.jpg"
    },
    {
      "text": "Pour in enough water to just submerge the sprouts, then cover the skillet with the lid and bring the water to a simmer. Simmer for five to seven minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/one-pan-pepper-jack-brussels-sprouts/#wprm-recipe-52647-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/07/one-pan-pepper-jack-brussels-sprouts-02.jpg"
    },
    {
      "text": "Remove the skillet from the heat and drain the sprouts. Rinse under very cold water to stop the cooking process and set aside.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/one-pan-pepper-jack-brussels-sprouts/#wprm-recipe-52647-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/07/one-pan-pepper-jack-brussels-sprouts-03.jpg"
    },
    {
      "text": "In the same skillet, heat oil and garlic on medium low heat until fragrant.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/one-pan-pepper-jack-brussels-sprouts/#wprm-recipe-52647-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/07/one-pan-pepper-jack-brussels-sprouts-04.jpg"
    },
    {
      "text": "Add sour cream and heavy whipping cream, then increase the heat to medium. Slowly stir in pepper Jack cheese, reserving a small amount to add at the end. Season with salt and pepper to taste.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/one-pan-pepper-jack-brussels-sprouts/#wprm-recipe-52647-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/07/one-pan-pepper-jack-brussels-sprouts-05.jpg"
    },
    {
      "text": "Once the sauce thickens, add brussels sprouts and stir gently to coat.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/one-pan-pepper-jack-brussels-sprouts/#wprm-recipe-52647-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/07/one-pan-pepper-jack-brussels-sprouts-06.jpg"
    },
    {
      "text": "Bring the mixture back to a light simmer and cover with the lid. Continue to cook for three to five minutes",
      "group": "",
      "sourceUrl": "https://www.ruled.me/one-pan-pepper-jack-brussels-sprouts/#wprm-recipe-52647-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/07/one-pan-pepper-jack-brussels-sprouts-07.jpg"
    },
    {
      "text": "Top with remaining cheese and sundried tomatoes and broil, or cook with the lid on, until cheese is melted and bubbly. Serve hot!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/one-pan-pepper-jack-brussels-sprouts/#wprm-recipe-52647-step-0-7",
      "imageSource": null
    }
  ],
