  "ingredients": [
    "16 ounce green beans",
    "1/2 cup pecans (chopped)",
    "1/4 cup olive oil",
    "1/4 cup parmesan cheese (grated)",
    "2 tablespoon lemon zest",
    "2 teaspoon fresh garlic (minced)",
    "1 teaspoon crushed red pepper flakes"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 450F. Place the green beans into a large mixing bowl.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/roasted-pecan-green-beans/#wprm-recipe-50909-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_3239.jpg"
    },
    {
      "text": "Add the pecans to a food processor and process until small and crumbly, with some slightly larger pieces for contrasting texture. Add the processed pecans to the green beans.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/roasted-pecan-green-beans/#wprm-recipe-50909-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_3244.jpg"
    },
    {
      "text": "Add the olive oil, parmesan cheese, lemon zest, minced garlic, and red pepper flakes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/roasted-pecan-green-beans/#wprm-recipe-50909-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_3257.jpg"
    },
    {
      "text": "Use a fork to mix the green beans together well with the rest of the ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/roasted-pecan-green-beans/#wprm-recipe-50909-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_3261.jpg"
    },
    {
      "text": "Line a baking sheet with foil and spread the green beans out on top. Don't worry if some of them are overlapping, as this will add even more textural contrasts to the final dish!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/roasted-pecan-green-beans/#wprm-recipe-50909-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_3272.jpg"
    },
    {
      "text": "Roast for 20–25 minutes, checking on them regularly after the 20-minute mark.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/roasted-pecan-green-beans/#wprm-recipe-50909-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_3279.jpg"
    },
    {
      "text": "Let cool for 4–5 minutes and serve!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/roasted-pecan-green-beans/#wprm-recipe-50909-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/RoastedGreenBeans1.jpg"
    }
  ],
