  "ingredients": [
    "2 teaspoon garlic powder",
    "2 teaspoon salt",
    "2 teaspoon smoked paprika",
    "1 teaspoon chipotle seasoning",
    "1/2 teaspoon dried oregano",
    "1/2 teaspoon onion powder",
    "3/4 medium cauliflower",
    "3 tablespoon olive oil",
    "1/4 cup parmesan cheese (grated)",
    "1/2 medium lime",
    "2 tablespoon fresh cilantro (chopped)"
  ],
  "instructions": [
    {
      "text": "Pre-heat oven to 400 degrees Fahrenheit. Combine all the seasoning ingredients in a small bowl and mix evenly.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/roasted-cajun-cauliflower-steaks/#wprm-recipe-53251-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/02/roasted-cajun-cauliflower-steaks-01.jpg"
    },
    {
      "text": "Slice one whole head of cauliflower, starting from the center, into 1-inch “steaks”. The ends typically crumble so you can save those pieces for other recipes or toss them on the baking sheet too!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/roasted-cajun-cauliflower-steaks/#wprm-recipe-53251-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/02/roasted-cajun-cauliflower-steaks-03.jpg"
    },
    {
      "text": "Lay the steaks on a large baking sheet and brush both sides with plenty of oil.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/roasted-cajun-cauliflower-steaks/#wprm-recipe-53251-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/02/roasted-cajun-cauliflower-steaks-04.jpg"
    },
    {
      "text": "Rub each steak with the Cajun seasoning. Bake for 20 minutes, turning them half-way through.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/roasted-cajun-cauliflower-steaks/#wprm-recipe-53251-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/02/roasted-cajun-cauliflower-steaks-05.jpg"
    },
    {
      "text": "Remove the steaks from the oven and sprinkle with parmesan cheese.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/roasted-cajun-cauliflower-steaks/#wprm-recipe-53251-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/02/roasted-cajun-cauliflower-steaks-06.jpg"
    },
    {
      "text": "Return to the oven for 5 minutes to melt the cheese. Garnish with chopped cilantro and a squeeze of lime!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/roasted-cajun-cauliflower-steaks/#wprm-recipe-53251-step-0-5",
      "imageSource": null
    }
  ],
