  "ingredients": [
    "6 ounce brussels sprouts",
    "1.8 ounce onion",
    "1 teaspoon fresh garlic (minced)",
    "2 tablespoon butter",
    "1/4 teaspoon black pepper",
    "1 tablespoon soy sauce (or coconut aminos)",
    "1/2 teaspoon liquid smoke",
    "1/2 cup heavy whipping cream",
    "1 tablespoon butter",
    "1/4 teaspoon paprika",
    "1/4 teaspoon turmeric powder",
    "1/4 teaspoon black pepper",
    "1/8 teaspoon xanthan gum",
    "2 1/2 ounce cheddar cheese (shredded)",
    "1/2 ounce pork rinds",
    "3 tablespoon parmesan cheese",
    "1/2 teaspoon paprika"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 375F. Chop the stems off of the Brussels sprouts, and then chop them in half down the spine.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-au-gratin-brussels-sprouts/#wprm-recipe-51375-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/09/img_4992.jpg"
    },
    {
      "text": "Dice the onion and garlic.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-au-gratin-brussels-sprouts/#wprm-recipe-51375-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/09/img_4999.jpg"
    },
    {
      "text": "Heat a pan over high heat and add in the butter. Let it begin to brown slightly, and then add in the Brussels sprouts and season with pepper. Let cook for about 2–3 minutes, and then add the onion and garlic. Once the onions start to get soft, add in the soy sauce and liquid smoke (if using). Set aside.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-au-gratin-brussels-sprouts/#wprm-recipe-51375-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/09/img_5002.jpg"
    },
    {
      "text": "In a saucepan, combine the heavy cream and butter. Season with paprika, turmeric, pepper, and xanthan gum, whisking together to thicken it.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-au-gratin-brussels-sprouts/#wprm-recipe-51375-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/09/img_5007.jpg"
    },
    {
      "text": "Add the grated cheese and stir it in slowly.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-au-gratin-brussels-sprouts/#wprm-recipe-51375-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/09/img_5014.jpg"
    },
    {
      "text": "Once the cheese sauce is thick and creamy, add it to the Brussels sprouts and mix together well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-au-gratin-brussels-sprouts/#wprm-recipe-51375-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/09/img_5021.jpg"
    },
    {
      "text": "Pour the mixture into separate ramekins.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-au-gratin-brussels-sprouts/#wprm-recipe-51375-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/09/img_5025.jpg"
    },
    {
      "text": "Use a spice grinder or food processor to grind the pork rinds, parmesan, and paprika. Top the ramekins with this crumb mixture.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-au-gratin-brussels-sprouts/#wprm-recipe-51375-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/09/img_5013.jpg"
    },
    {
      "text": "Bake for 17–20 minutes, until the pork rind and parmesan crust has crisped up slightly.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-au-gratin-brussels-sprouts/#wprm-recipe-51375-step-0-8",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/09/img_5028.jpg"
    },
    {
      "text": "Serve warm!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-au-gratin-brussels-sprouts/#wprm-recipe-51375-step-0-9",
      "imageSource": null
    }
  ],
