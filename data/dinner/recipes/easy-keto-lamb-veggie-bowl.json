  "ingredients": [
    "16 ounce ground lamb",
    "1 tablespoon olive oil",
    "salt and pepper (to taste)",
    "6 ounce frozen spinach (thawed)",
    "8 ounce cauliflower rice",
    "1 teaspoon cumin",
    "1/2 teaspoon chili powder",
    "1/2 teaspoon ground cinnamon",
    "1 medium fresh tomatoes (diced)",
    "4 ounce feta cheese (crumbled)"
  ],
  "instructions": [
    {
      "text": "Gather and prep all of your ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/easy-keto-lamb-veggie-bowl/#wprm-recipe-57188-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/08/Easy-Keto-Lamb-Veggie-Bowl-1.jpg"
    },
    {
      "text": "If using frozen spinach, microwave spinach until just thawed and squeeze excess water out.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/easy-keto-lamb-veggie-bowl/#wprm-recipe-57188-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/08/Easy-Keto-Lamb-Veggie-Bowl-2.jpg"
    },
    {
      "text": "In a pan over medium heat, add olive oil and ground lamb. Season with salt and pepper to taste. Break the lamb up with a wooden spatula and cook until lightly browned.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/easy-keto-lamb-veggie-bowl/#wprm-recipe-57188-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/08/Easy-Keto-Lamb-Veggie-Bowl-3.jpg"
    },
    {
      "text": "Add in the spinach and stir well to combine, breaking up the spinach leaves so that they are not clumped together.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/easy-keto-lamb-veggie-bowl/#wprm-recipe-57188-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/08/Easy-Keto-Lamb-Veggie-Bowl-4.jpg"
    },
    {
      "text": "Add in the cauliflower rice and mix into the lamb. Cook until tender, stirring occasionally, about 3-4 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/easy-keto-lamb-veggie-bowl/#wprm-recipe-57188-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/08/Easy-Keto-Lamb-Veggie-Bowl-5.jpg"
    },
    {
      "text": "Add in the spices and half of the feta and tomato. Stir together and mix well and fragrant. Season with salt and pepper again if needed.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/easy-keto-lamb-veggie-bowl/#wprm-recipe-57188-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/08/Easy-Keto-Lamb-Veggie-Bowl-6.jpg"
    },
    {
      "text": "Serve while hot. Top with remaining half of feta and tomato, then enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/easy-keto-lamb-veggie-bowl/#wprm-recipe-57188-step-0-6",
      "imageSource": null
    }
  ],
