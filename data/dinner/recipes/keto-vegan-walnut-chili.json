  "ingredients": [
    "5 tablespoon avocado oil",
    "5 medium celery (diced)",
    "2 teaspoon fresh garlic (minced)",
    "1 1/2 teaspoon ground cinnamon",
    "2 teaspoon chili powder",
    "4 teaspoon cumin",
    "1 1/2 teaspoon smoked paprika",
    "2 medium green bell pepper (diced)",
    "1 medium zucchini",
    "8 ounce cremini mushrooms",
    "2 ounce chipotle peppers in adobo sauce",
    "1 1/2 tablespoon tomato paste",
    "15 ounce canned diced tomatoes",
    "4 cup vegetable broth",
    "1/2 cup unsweetened carton coconut milk",
    "20 ounce vegan meat crumbles",
    "1 cup walnuts (crushed)",
    "1 tablespoon unsweetened cocoa powder",
    "4 tablespoon fresh cilantro",
    "2 medium avocado (sliced)",
    "4 tablespoon red radish (sliced)",
    "salt and pepper (to taste)"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all the ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-vegan-walnut-chili/#wprm-recipe-53681-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/02/Vegan-Walnut-Chili-1.jpg"
    },
    {
      "text": "In a pan, heat up the avocado oil and add the celery. Cook until softened up while stirring occasionally, about 4-5 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-vegan-walnut-chili/#wprm-recipe-53681-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/02/Vegan-Walnut-Chili-2.jpg"
    },
    {
      "text": "Add garlic, cinnamon, chili powder, cumin, and smoked paprika. Stir this together until well combined.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-vegan-walnut-chili/#wprm-recipe-53681-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/02/Vegan-Walnut-Chili-3.jpg"
    },
    {
      "text": "Add bell pepper, zucchini, and mushrooms. Season with salt and pepper to taste. Cook this for 4-6 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-vegan-walnut-chili/#wprm-recipe-53681-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/02/Vegan-Walnut-Chili-4.jpg"
    },
    {
      "text": "Add the chipotle pepper, tomato paste, tomatoes, vegetable broth, coconut milk, vegan meat crumble, walnuts, and unsweetened cocoa powder. Stir until well combined. Let this cook for 20-25 minutes until the chili is thick and hot.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-vegan-walnut-chili/#wprm-recipe-53681-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/02/Vegan-Walnut-Chili-5.jpg"
    },
    {
      "text": "Top the chili with fresh cilantro, avocado slices, and sliced radishes. Season with additional salt and pepper to taste.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-vegan-walnut-chili/#wprm-recipe-53681-step-0-5",
      "imageSource": null
    }
