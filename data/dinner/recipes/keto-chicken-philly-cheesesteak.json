  "ingredients": [
    "1 tablespoon butter",
    "32 ounce boneless, skinless chicken thighs (diced)",
    "1/2 medium yellow onion (chopped)",
    "1 medium green bell pepper (sliced)",
    "8 ounce cremini mushrooms (halved )",
    "2 teaspoon fresh garlic",
    "salt and pepper (to taste)",
    "8 ounce cream cheese (softened )",
    "1/2 cup heavy cream",
    "2 tablespoon worcestershire sauce",
    "8 ounce cheddar cheese (shredded)",
    "8 ounce provolone cheese"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all ingredients. Preheat oven to 375F.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-philly-cheesesteak/#wprm-recipe-53641-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/01/Chicken-Philly-Cheesesteak-Casserole-1.jpg"
    },
    {
      "text": "On medium to high heat, add butter to a frying pan. Add in the chicken and fry until done.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-philly-cheesesteak/#wprm-recipe-53641-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/01/Chicken-Philly-Cheesesteak-Casserole-2.jpg"
    },
    {
      "text": "Then, add in onion, bell pepper, and mushrooms. Add in half of the garlic and salt and pepper to taste. Fry the chicken and vegetables until tender. Then, remove from heat.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-philly-cheesesteak/#wprm-recipe-53641-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/01/Chicken-Philly-Cheesesteak-Casserole-3.jpg"
    },
    {
      "text": "In a bowl, combine the rest of the garlic, cream cheese, heavy cream, worcestershire sauce, and shredded cheddar cheese. Mix this into the chicken and vegetables.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-philly-cheesesteak/#wprm-recipe-53641-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/01/Chicken-Philly-Cheesesteak-Casserole-4.jpg"
    },
    {
      "text": "Put this in a baking dish and top with provolone cheese.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-philly-cheesesteak/#wprm-recipe-53641-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/01/Chicken-Philly-Cheesesteak-Casserole-5.png"
    },
    {
      "text": "Bake in the oven for 25-30 minutes or until cheese is golden brown. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-philly-cheesesteak/#wprm-recipe-53641-step-0-5",
      "imageSource": null
    }
  ],
