  "ingredients": [
    "12 ounce boneless, skinless chicken thighs",
    "salt and pepper (to taste)",
    "1 tablespoon avocado oil",
    "1/3 cup almond butter",
    "1 tablespoon soy sauce",
    "2 teaspoon chili-garlic paste",
    "1 tablespoon lime juice (plus more if needed)",
    "200 gram broccolini",
    "2 tablespoon butter"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all the ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chicken-satay-with-broccolini/#wprm-recipe-53881-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/06/Chicken-Satay-with-Broccolini-1.jpg"
    },
    {
      "text": "Cut the chicken thighs into smaller pieces. Season the chicken thighs with salt and pepper to taste.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chicken-satay-with-broccolini/#wprm-recipe-53881-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/06/Chicken-Satay-with-Broccolini-2.jpg"
    },
    {
      "text": "Make the sauce by combining almond butter, soy sauce, chili-garlic paste, and lime juice. Stir to combine well and set aside.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chicken-satay-with-broccolini/#wprm-recipe-53881-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/06/Chicken-Satay-with-Broccolini-3.jpg"
    },
    {
      "text": "In a frying pan, add the avocado oil and the sliced chicken thighs and let cook over medium to high heat until internal temperature reaches 165F.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chicken-satay-with-broccolini/#wprm-recipe-53881-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/06/Chicken-Satay-with-Broccolini-4.jpg"
    },
    {
      "text": "Add about half of the sauce to the chicken slices in the frying pan. Stir well and make sure all sides of the chicken slices are covered. Save the other half for serving.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chicken-satay-with-broccolini/#wprm-recipe-53881-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/06/Chicken-Satay-with-Broccolini-5.jpg"
    },
    {
      "text": "Sautee the broccolini in a frying pan with butter.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chicken-satay-with-broccolini/#wprm-recipe-53881-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/06/Chicken-Satay-with-Broccolini-6.jpg"
    },
    {
      "text": "Serve the chicken with the broccolini.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chicken-satay-with-broccolini/#wprm-recipe-53881-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/06/Chicken-Satay-with-Broccolini-7.jpg"
    },
    {
      "text": "Serve with the extra sauce and lime slices.",
