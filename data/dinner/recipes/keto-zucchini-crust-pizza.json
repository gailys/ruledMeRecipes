  "ingredients": [
    "1 large egg (slightly beaten)",
    "2 cup zucchini (shredded + squeezed dry)",
    "2 tablespoon cream cheese",
    "1/2 cup shredded mozzarella",
    "1/2 cup grated parmesan cheese",
    "1/4 cup almond flour",
    "1 tablespoon olive oil",
    "1 tablespoon fresh basil (minced)",
    "1 teaspoon fresh thyme (minced)",
    "1 cup shredded mozzarella",
    "1/2 cup pepperoni"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all of the ingredients. Preheat oven to 400F.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-zucchini-crust-pizza/#wprm-recipe-54471-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/10/Zucchini-Crust-Pizza-1.jpg"
    },
    {
      "text": "In a bowl, combine egg, shredded zucchini, cream cheese, mozzarella, parmesan, almond flour, and olive oil. Stir to combine well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-zucchini-crust-pizza/#wprm-recipe-54471-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/10/Zucchini-Crust-Pizza-2.jpg"
    },
    {
      "text": "Grease a pizza pan, then form the dough into a circle with your hands. Bake in the oven for 15 minutes or until the crust is golden brown in color.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-zucchini-crust-pizza/#wprm-recipe-54471-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/10/Zucchini-Crust-Pizza-3.jpg"
    },
    {
      "text": "Add the mozzarella cheese, pepperoni, basil, and thyme. Place back in the oven for 10 minutes longer or until the cheese has all melted.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-zucchini-crust-pizza/#wprm-recipe-54471-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/10/Zucchini-Crust-Pizza-4.jpg"
    },
    {
      "text": "Slice, serve, and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-zucchini-crust-pizza/#wprm-recipe-54471-step-0-4",
      "imageSource": null
    }
