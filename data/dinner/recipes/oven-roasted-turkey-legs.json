  ],
  "instructions": [
    {
      "text": "Mix together all dry spices in a small bowl. Then, add wet ingredients and mix together into a rub.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/oven-roasted-turkey-legs/#wprm-recipe-51495-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/11/img_9924.jpg"
    },
    {
      "text": "Pat turkey legs completely dry with paper towels and season generously with the spice mix.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/oven-roasted-turkey-legs/#wprm-recipe-51495-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/11/img_9940.jpg"
    },
    {
      "text": "Preheat oven to 350F. Bring the lard (or oil) to a medium-high heat in a cast-iron skillet. Once the oil starts to smoke, add the turkey legs to the pan and sear on each side for 1–2 minutes — you want the entire leg to have a sear on it.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/oven-roasted-turkey-legs/#wprm-recipe-51495-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/11/img_9953.jpg"
    },
    {
      "text": "Place in the oven for 50–60 minutes or until cooked through.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/oven-roasted-turkey-legs/#wprm-recipe-51495-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/11/img_9957.jpg"
    },
    {
      "text": "Remove the turkey from the oven and let rest for a few minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/oven-roasted-turkey-legs/#wprm-recipe-51495-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/11/img_9962.jpg"
    },
    {
      "text": "Serve with a favorite fatty side dish and enjoy the holiday meal!",
      "group": "",
