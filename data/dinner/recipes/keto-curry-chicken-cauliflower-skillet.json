  "ingredients": [
    "2 tablespoon butter",
    "1/2 medium yellow onion (diced)",
    "2 tablespoon red curry paste",
    "100 gram canned tomatoes with green chiles",
    "100 gram heavy whipping cream",
    "1/4 cup chicken stock",
    "sea salt (to taste)",
    "22 ounce boneless, skinless chicken thighs",
    "salt and pepper (to taste)",
    "1 medium cauliflower",
    "4 tablespoon olive oil",
    "1 tablespoon fresh parsley (chopped)"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all the ingredients. Prepare the red curry sauce by heating a saucepan over medium heat and adding in the ingredients for the sauce. Once warm, pulse in a blender until smooth.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-curry-chicken-cauliflower-skillet/#wprm-recipe-54075-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/12/Curry-Chicken-and-Cauliflower-Skillet-1.jpg"
    },
    {
      "text": "Chop up the chicken into bite size pieces. Wash and cut the cauliflower into florets. Season the chicken with salt and pepper.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-curry-chicken-cauliflower-skillet/#wprm-recipe-54075-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/12/Curry-Chicken-and-Cauliflower-Skillet-2.jpg"
    },
    {
      "text": "In a skillet over medium heat, add the olive oil and chopped chicken. Cook until there is no more pink.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-curry-chicken-cauliflower-skillet/#wprm-recipe-54075-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/12/Curry-Chicken-and-Cauliflower-Skillet-3.jpg"
    },
    {
      "text": "Add in the chopped cauliflower and curry sauce. Stir so the cauliflower and chicken is soaked in curry sauce.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-curry-chicken-cauliflower-skillet/#wprm-recipe-54075-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/12/Curry-Chicken-and-Cauliflower-Skillet-4.jpg"
    },
    {
      "text": "Place a lid on the skillet and let simmer for about 10 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-curry-chicken-cauliflower-skillet/#wprm-recipe-54075-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/12/Curry-Chicken-and-Cauliflower-Skillet-5.jpg"
    },
    {
      "text": "Serve with chopped parsley. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-curry-chicken-cauliflower-skillet/#wprm-recipe-54075-step-0-5",
      "imageSource": null
    }
