  "ingredients": [
    "2 medium zucchini (sliced into half moons)",
    "1/3 cup heavy cream",
    "3 large egg",
    "1/4 cup grated parmesan cheese",
    "4 teaspoon fresh garlic (minced)",
    "1 teaspoon dried basil",
    "1/8 teaspoon ground nutmeg",
    "1 1/2 cup cheddar cheese (shredded + divided)",
    "2 tablespoon butter (sliced into 1/4\" thick pieces)",
    "salt and pepper (to taste)",
    "2 tablespoon fresh parsley (chopped + for garnish)"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all of the ingredients. Preheat oven to 350F. Grease a baking dish.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheesy-zucchini-casserole/#wprm-recipe-54563-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/02/Keto-Cheesy-Zucchini-Casserole-1.jpg"
    },
    {
      "text": "In a bowl, combine heavy cream, eggs, parmesan cheese, minced garlic, dried basil, ground nutmeg, and black pepper.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheesy-zucchini-casserole/#wprm-recipe-54563-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/02/Keto-Cheesy-Zucchini-Casserole-2.jpg"
    },
    {
      "text": "Stir this mixture to combine well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheesy-zucchini-casserole/#wprm-recipe-54563-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/02/Keto-Cheesy-Zucchini-Casserole-3.jpg"
    },
    {
      "text": "In the greased baking sheet, add the sliced zucchinis and add half of the shredded cheddar cheese. Pour the cheesy mixture over the top.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheesy-zucchini-casserole/#wprm-recipe-54563-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/02/Keto-Cheesy-Zucchini-Casserole-4.jpg"
    },
    {
      "text": "Add the thick butter pieces to the pan.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheesy-zucchini-casserole/#wprm-recipe-54563-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/02/Keto-Cheesy-Zucchini-Casserole-5.jpg"
    },
    {
      "text": "Bake in the oven for 35 - 30 minutes. Take out and add the rest of the shredded cheddar cheese to the top of the dish and put back in the oven for 10 more minutes or until the cheese has melted.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheesy-zucchini-casserole/#wprm-recipe-54563-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/02/Keto-Cheesy-Zucchini-Casserole-6.jpg"
    },
    {
      "text": "Slice, garnish with the chopped parsley, serve, and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheesy-zucchini-casserole/#wprm-recipe-54563-step-0-6",
      "imageSource": null
    }
  ],
