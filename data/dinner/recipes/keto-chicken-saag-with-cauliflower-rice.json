    },
    {
      "text": "In a frying pan over medium heat, melt half of the ghee, coriander, and cardamom.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-saag-with-cauliflower-rice/#wprm-recipe-54207-step-0-1",
