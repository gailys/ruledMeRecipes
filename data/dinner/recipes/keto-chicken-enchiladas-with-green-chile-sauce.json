  "ingredients": [
    "3 cup cooked chicken (shredded)",
    "4 medium green onion (chopped)",
    "1 cup cheddar cheese (shredded)",
    "1/3 cup fresh cilantro (chopped)",
    "1/2 teaspoon cumin",
    "salt and pepper (to taste)",
    "1 cup chicken broth",
    "1 cup sour cream",
    "14 ounce canned green chile",
    "3/4 medium green cabbage"
  ],
  "instructions": [
    {
      "text": "Bring a pot of salted water to a boil. Preheat your oven to 350F.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-enchiladas-with-green-chile-sauce/#wprm-recipe-53171-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/10/green-chile-cabbage-enchiladas-01.jpg"
    },
    {
      "text": "Mix the shredded chicken with green onion, ¾ of the shredded cheese, cilantro, cumin, salt, and pepper.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-enchiladas-with-green-chile-sauce/#wprm-recipe-53171-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/10/green-chile-cabbage-enchiladas-02.jpg"
    },
    {
      "text": "Pour the chicken broth into a saucepan then bring to a boil. Turn the heat down then stir in the sour cream and green chiles. Let the sauce simmer, stirring often, until the sauce thickens.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-enchiladas-with-green-chile-sauce/#wprm-recipe-53171-step-0-2",
      "imageSource": null
    },
    {
      "text": "Peel the leaves off the cabbage, being careful not to tear them. Plunge the cabbage leaves into the boiling water for a few minutes, before drying them on paper towels.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-enchiladas-with-green-chile-sauce/#wprm-recipe-53171-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/10/green-chile-cabbage-enchiladas-03.jpg"
    },
    {
      "text": "Spoon some of the chicken mixture into each of the cabbage leaves, placing a spoonful of green chile sauce on top. Roll the leaves up then place seam side down inside a baking dish.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-enchiladas-with-green-chile-sauce/#wprm-recipe-53171-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/10/green-chile-cabbage-enchiladas-05.jpg"
    },
    {
      "text": "Spread the rest of the green chile sauce on top of the cabbage rolls, then top with the remaining cheese. Bake for 25-30 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-enchiladas-with-green-chile-sauce/#wprm-recipe-53171-step-0-5",
      "imageSource": null
    }
  ],
