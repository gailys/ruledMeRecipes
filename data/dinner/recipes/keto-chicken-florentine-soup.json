  "ingredients": [
    "3 cup cooked chicken (shredded)",
    "1/4 cup butter",
    "1 teaspoon fresh garlic (minced)",
    "4 ounce baby spinach",
    "8 ounce cream cheese",
    "3/4 cup asiago cheese (shredded)",
    "4 cup chicken broth",
    "1 whole chicken bouillon cube",
    "1/4 teaspoon ground nutmeg",
    "salt and pepper (to taste)"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all the ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-florentine-soup/#wprm-recipe-53593-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/12/Chicken-Florentine-Soup-1.jpg"
    },
    {
      "text": "In a pan on low to medium heat, melt the butter.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-florentine-soup/#wprm-recipe-53593-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/12/Chicken-Florentine-Soup-2.jpg"
    },
    {
      "text": "Add the garlic and spinach to the pan. Stir this together for about 3 minutes until the spinach is wilted and garlic is fragrant.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-florentine-soup/#wprm-recipe-53593-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/12/Chicken-Florentine-Soup-3.jpg"
    },
    {
      "text": "Add in the cream cheese and asiago cheese to the pan, then stir until well combined.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-florentine-soup/#wprm-recipe-53593-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/12/Chicken-Florentine-Soup-4.jpg"
    },
    {
      "text": "Next, add in the cooked shredded chicken, chicken broth, chicken bouillon cube, ground nutmeg, and salt and pepper to taste.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-florentine-soup/#wprm-recipe-53593-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/12/Chicken-Florentine-Soup-5.jpg"
    },
    {
      "text": "Stir this together until hot all the way through, make sure not to boil.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-florentine-soup/#wprm-recipe-53593-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/12/Chicken-Florentine-Soup-6.jpg"
    },
    {
      "text": "Taste and add more salt if needed. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-florentine-soup/#wprm-recipe-53593-step-0-6",
      "imageSource": null
    }
  ],
