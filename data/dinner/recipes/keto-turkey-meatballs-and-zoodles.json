  "instructions": [
    {
      "text": "Measure out and prepare all of the ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-turkey-meatballs-and-zoodles/#wprm-recipe-54423-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/09/Keto-Turkey-Meatballs-and-Zoodles-1.jpg"
    },
    {
      "text": "In a bowl, combine the ground turkey, mayonnaise, salt, pepper, and onion powder. Stir and mash up until combined well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-turkey-meatballs-and-zoodles/#wprm-recipe-54423-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/09/Keto-Turkey-Meatballs-and-Zoodles-2.jpg"
    },
    {
      "text": "Using your hands roll the turkey into the size of a meatball.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-turkey-meatballs-and-zoodles/#wprm-recipe-54423-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/09/Keto-Turkey-Meatballs-and-Zoodles-3.jpg"
    },
    {
      "text": "In a frying pan over medium heat, add the olive oil. Place the meatballs in the pan and let cook about 2-4 minutes per side.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-turkey-meatballs-and-zoodles/#wprm-recipe-54423-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/09/Keto-Turkey-Meatballs-and-Zoodles-4.jpg"
    },
    {
      "text": "Remove the meatballs from the frying pan with a slotted spoon so the oil can drip off. Set aside. Leave the excess oil in the pan.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-turkey-meatballs-and-zoodles/#wprm-recipe-54423-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/09/Keto-Turkey-Meatballs-and-Zoodles-5.jpg"
    },
    {
      "text": "Add in the Rao's tomato sauce, olive oil, season with salt and pepper, and stir well. Simmer for 5 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-turkey-meatballs-and-zoodles/#wprm-recipe-54423-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/09/Keto-Turkey-Meatballs-and-Zoodles-6.jpg"
    },
    {
      "text": "Add the meatballs back into the pan to get warm.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-turkey-meatballs-and-zoodles/#wprm-recipe-54423-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/09/Keto-Turkey-Meatballs-and-Zoodles-7.jpg"
    },
    {
      "text": "Boil the spiralized zucchini in a pot of water for 1-2 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-turkey-meatballs-and-zoodles/#wprm-recipe-54423-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/09/Keto-Turkey-Meatballs-and-Zoodles-8.jpg"
    },
    {
      "text": "Put the boiled zucchini noodles in a serving bowl. Drizzle with olive oil.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-turkey-meatballs-and-zoodles/#wprm-recipe-54423-step-0-8",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/09/Keto-Turkey-Meatballs-and-Zoodles-9.jpg"
    },
    {
      "text": "Plate the zucchini noodles and top with the turkey meatballs. Garnish with basil. Serve and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-turkey-meatballs-and-zoodles/#wprm-recipe-54423-step-0-9",
