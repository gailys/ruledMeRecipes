  "ingredients": [
    "1/4 cup grated parmesan cheese",
    "3 tablespoon mayonnaise",
    "1 tablespoon butter (softened)",
    "1 tablespoon lime juice",
    "1 teaspoon fresh garlic (minced)",
    "1/4 teaspoon onion powder",
    "1/2 teaspoon paprika",
    "salt and pepper (to taste)",
    "16 ounce tilapia",
    "16 ounce asparagus spears (trimmed)",
    "3 tablespoon butter",
    "2 teaspoon fresh garlic (minced)",
    "salt and pepper (to taste)"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all of the ingredients. Preheat the oven to 425F.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-tangy-tilapia/#wprm-recipe-54415-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/08/Keto-Tangy-Tilapia-1.jpg"
    },
    {
      "text": "In a bowl, combine the parmesan cheese, mayonnaise, softened butter, lime juice, minced garlic, onion powder, paprika, salt, and pepper. Stir to combine well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-tangy-tilapia/#wprm-recipe-54415-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/08/Keto-Tangy-Tilapia-2.jpg"
    },
    {
      "text": "Line a baking sheet with aluminum foil. Place the tilapia on the aluminum foil and season with salt and pepper. Smear the tilapia with the spread. Bake in the oven for 7-8 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-tangy-tilapia/#wprm-recipe-54415-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/08/Keto-Tangy-Tilapia-3.jpg"
    },
    {
      "text": "While the tilapia is baking, cook the asparagus. In a frying pan over medium heat, add in the butter and minced garlic. Fry until fragrant. Add in the trimmed asparagus spears. Season with salt and pepper and cook until tender.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-tangy-tilapia/#wprm-recipe-54415-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/08/Keto-Tangy-Tilapia-4.jpg"
    },
    {
      "text": "Serve the tilapia with the asparagus spears. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-tangy-tilapia/#wprm-recipe-54415-step-0-4",
      "imageSource": null
    }
  ],
