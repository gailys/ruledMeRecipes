    "servingSize": "1 serving"
  },
  "nutritionPerServing": {
    "calories": 1036,
    "netCarbsGrams": 16.2,
    "proteinGrams": 44.5,
    "fatGrams": 83.8
  },
  "ingredients": [
    "4 large egg",
    "1 1/2 tablespoon psyllium husk powder",
    "2 teaspoon baking powder",
    "2 tablespoon chia seeds",
    "9 ounce cheddar cheese (grated)",
    "16 ounce rutabaga",
    "3 tablespoon coconut oil",
    "4 tablespoon sour cream",
    "4 tablespoon mayonnaise",
    "4 tablespoon roasted red pepper (pureed)",
    "2 ounce iceberg lettuce",
    "1 medium fresh tomatoes",
    "1 medium avocado",
    "12 ounce halloumi cheese",
    "2 tablespoon butter",
    "salt (to taste)"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 400F. Gather ingredients together.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/halloumi-burger-with-rutabaga-fries/#wprm-recipe-59722-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/06/halloumi-burger-with-rutabaga-fries-step-01.jpg"
    },
    {
      "text": "Beat the eggs, for several minutes, until they are fluffy.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/halloumi-burger-with-rutabaga-fries/#wprm-recipe-59722-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/06/halloumi-burger-with-rutabaga-fries-step-02.jpg"
    },
    {
      "text": "Mix the psyllium husk, baking powder, and chia seeds.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/halloumi-burger-with-rutabaga-fries/#wprm-recipe-59722-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/06/halloumi-burger-with-rutabaga-fries-step-03.jpg"
    },
    {
      "text": "Add the dry mix and shredded cheese to the beaten eggs.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/halloumi-burger-with-rutabaga-fries/#wprm-recipe-59722-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/06/halloumi-burger-with-rutabaga-fries-step-04.jpg"
    },
    {
      "text": "Mix together then let the batter rise for 10 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/halloumi-burger-with-rutabaga-fries/#wprm-recipe-59722-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/06/halloumi-burger-with-rutabaga-fries-step-05.jpg"
    },
    {
      "text": "Create 8 buns on a parchment lined baking sheet.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/halloumi-burger-with-rutabaga-fries/#wprm-recipe-59722-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/06/halloumi-burger-with-rutabaga-fries-step-06.jpg"
    },
    {
      "text": "Bake for 15 minutes until they turn golden brown. Allow to cool.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/halloumi-burger-with-rutabaga-fries/#wprm-recipe-59722-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/06/halloumi-burger-with-rutabaga-fries-step-07.jpg"
    },
    {
      "text": "Increase the oven temp to 450F.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/halloumi-burger-with-rutabaga-fries/#wprm-recipe-59722-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/06/halloumi-burger-with-rutabaga-fries-step-08.jpg"
    },
    {
      "text": "Peel the rutabaga and cut it into fries.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/halloumi-burger-with-rutabaga-fries/#wprm-recipe-59722-step-0-8",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/06/halloumi-burger-with-rutabaga-fries-step-09.jpg"
    },
    {
      "text": "Drop the fries into salted boiling water and cook for a few minutes. Remove the water and let it rest in a strainer.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/halloumi-burger-with-rutabaga-fries/#wprm-recipe-59722-step-0-9",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/06/halloumi-burger-with-rutabaga-fries-step-10.jpg"
    },
    {
      "text": "Melt the coconut oil for the fries in a bowl. Then add the rutabaga and toss so that all the fries are coated with oil.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/halloumi-burger-with-rutabaga-fries/#wprm-recipe-59722-step-0-10",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/06/halloumi-burger-with-rutabaga-fries-step-11.jpg"
    },
    {
      "text": "Spread the fries out on a baking sheet, then bake until crispy and brown on the outside. Turn during baking time to ensure even cooking.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/halloumi-burger-with-rutabaga-fries/#wprm-recipe-59722-step-0-11",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/06/halloumi-burger-with-rutabaga-fries-step-12.jpg"
    },
    {
      "text": "Mix the sour cream, mayonnaise, and red pepper puree. Place in the refrigerator to keep chilled.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/halloumi-burger-with-rutabaga-fries/#wprm-recipe-59722-step-0-12",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/06/halloumi-burger-with-rutabaga-fries-step-13.jpg"
    },
    {
      "text": "Rinse the lettuce, tomato, and avocado. Slice up the tomato and halloumi cheese.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/halloumi-burger-with-rutabaga-fries/#wprm-recipe-59722-step-0-13",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/06/halloumi-burger-with-rutabaga-fries-step-14.jpg"
    },
    {
      "text": "Fry the cheese slices in butter until both sides are browned.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/halloumi-burger-with-rutabaga-fries/#wprm-recipe-59722-step-0-14",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/06/halloumi-burger-with-rutabaga-fries-step-15.jpg"
    },
    {
      "text": "Load the cheese bread up with fried cheese, vegetables, and sauce. Serve with rutabaga fries.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/halloumi-burger-with-rutabaga-fries/#wprm-recipe-59722-step-0-15",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/06/halloumi-burger-with-rutabaga-fries-step-16.jpg"
    }
  ],
