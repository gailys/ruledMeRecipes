  "description": "This makes a total of 4 servings of Halloumi Burger with Rutabaga Fries. Each serving comes out to be 1036 calories, 83.8g fats, 16.2g net carbs, and 44.5g protein.",
  "servings": 4,
  "yield": [
    "4",
    "4 servings"
  ],
  "prepTime": "PT30M",
  "cookTime": "PT30M",
  "totalTime": "PT60M",
  "totalMinutes": 60,
  "nutrition": {
    "@type": "NutritionInformation",
    "calories": "1036 kcal",
    "fatContent": "83.8 g",
    "proteinContent": "44.5 g",
