  "instructions": [
    {
      "text": "Measure out and prepare all the ingredients. Dice the onion. Cut the avocado in half, take out the seed, and peel the skin off.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-seared-salmon-with-guacamole/#wprm-recipe-54123-step-0-0",
