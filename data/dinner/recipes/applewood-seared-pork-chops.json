  "instructions": [
    {
      "text": "Measure out the spices.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/applewood-seared-pork-chops/#wprm-recipe-50777-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/01/applewood-seared-pork-chops-01.jpg"
    },
    {
      "text": "Season one side of the pork chop liberally.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/applewood-seared-pork-chops/#wprm-recipe-50777-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/01/applewood-seared-pork-chops-02.jpg"
    },
    {
      "text": "Flip over and season the second side of the chop. If you have any extra spices, use it to rub on the sides of the meat.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/applewood-seared-pork-chops/#wprm-recipe-50777-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/01/applewood-seared-pork-chops-03.jpg"
    },
    {
      "text": "Add olive oil to a pan and bring to medium heat. Once the pan is hot, add your pork chops.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/applewood-seared-pork-chops/#wprm-recipe-50777-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/01/applewood-seared-pork-chops-04.jpg"
    },
    {
      "text": "Cover your pan and cook for 10-11 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/applewood-seared-pork-chops/#wprm-recipe-50777-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/01/applewood-seared-pork-chops-09.jpg"
    },
    {
      "text": "Flip your pork chops after they have cooked on one side and cover the pan. Continue cooking for 5 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/applewood-seared-pork-chops/#wprm-recipe-50777-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/01/applewood-seared-pork-chops-10.jpg"
    },
    {
      "text": "Remove the lid from the pan, and flip the pork chops one last time (to the original side). Let this cook on highest heat for 2 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/applewood-seared-pork-chops/#wprm-recipe-50777-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/01/applewood-seared-pork-chops-12.jpg"
    },
    {
      "text": "Remove from the pan and cover with foil to rest for 5 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/applewood-seared-pork-chops/#wprm-recipe-50777-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/01/applewood-seared-pork-chops-07.jpg"
    },
    {
      "text": "Serve with brussels sprouts liberally coated in oil and butter. The bacon brussels sprouts go really well with this!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/applewood-seared-pork-chops/#wprm-recipe-50777-step-0-8",
      "imageSource": null
    }
  ],
