  "ingredients": [
    "2 tablespoon curry powder",
    "1 tablespoon cumin",
    "2 teaspoon garlic powder",
    "1 teaspoon chili powder",
    "1 teaspoon onion powder",
    "1 teaspoon cayenne pepper",
    "1 teaspoon paprika",
    "1/2 teaspoon ground ginger",
    "1/2 teaspoon ground coriander",
    "1/2 teaspoon turmeric powder",
    "1/2 teaspoon black pepper",
    "1/4 teaspoon cardamom",
    "1/4 teaspoon ground cinnamon",
    "3 tablespoon olive oil",
    "1 medium onion",
    "salt and pepper (to taste)",
    "1/4 cup heavy whipping cream",
    "1/4 teaspoon xanthan gum",
    "1/4 cup butter",
    "4 cup chicken broth",
    "1 cup unsweetened carton coconut milk",
    "294 gram cauliflower",
    "24 ounce shrimp (shelled, deveined)",
    "1 tablespoon coconut flour",
    "5 cup spinach"
  ],
  "instructions": [
    {
      "text": "Measure out the curry powder, cumin, garlic powder, chili powder, onion powder, cayenne pepper, paprika, ground ginger, coriander, turmeric, pepper, cardamom, and cinnamon. Set these spices aside.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/shrimp-cauliflower-curry/#wprm-recipe-50925-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_3716.jpg"
    },
    {
      "text": "Heat up the olive oil over a high heat.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/shrimp-cauliflower-curry/#wprm-recipe-50925-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_3724.jpg"
    },
    {
      "text": "Slice one medium onion into small strips as the oil heats up.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/shrimp-cauliflower-curry/#wprm-recipe-50925-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_3728.jpg"
    },
    {
      "text": "Add the onions to pan, season with salt and pepper as needed, and allow them to cook down until soft and slightly browned.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/shrimp-cauliflower-curry/#wprm-recipe-50925-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_3736.jpg"
    },
    {
      "text": "Add the heavy cream and half of the xanthan gum to the onions and mix well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/shrimp-cauliflower-curry/#wprm-recipe-50925-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_3737.jpg"
    },
    {
      "text": "Add the butter to the onion mixture and stir in well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/shrimp-cauliflower-curry/#wprm-recipe-50925-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_3742.jpg"
    },
    {
      "text": "Dump in the spices from earlier and mix until well combined. They should soak up most of the moisture. Let cook for 1–2 minutes to allow them to release their fragrances.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/shrimp-cauliflower-curry/#wprm-recipe-50925-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_3748.jpg"
    },
    {
      "text": "Add in the chicken broth and coconut milk.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/shrimp-cauliflower-curry/#wprm-recipe-50925-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_3758.jpg"
    },
    {
      "text": "Bring to a boil, then cover with a lid and turn the heat to low. Let simmer for 30–45 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/shrimp-cauliflower-curry/#wprm-recipe-50925-step-0-8",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_3762.jpg"
    },
    {
      "text": "Chop the cauliflower into small florets.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/shrimp-cauliflower-curry/#wprm-recipe-50925-step-0-9",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_3765.jpg"
    },
    {
      "text": "Add the cauliflower to the curry and stir in well. Let cook uncovered for 15–20 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/shrimp-cauliflower-curry/#wprm-recipe-50925-step-0-10",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_3770.jpg"
    },
    {
      "text": "Add the shelled, deveined shrimp to the curry and stir them in. Let cook uncovered for an additional 10–20 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/shrimp-cauliflower-curry/#wprm-recipe-50925-step-0-11",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_3774.jpg"
    },
    {
      "text": "Mix the coconut flour and remaining xanthan gum into the curry and let simmer again for 5–10 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/shrimp-cauliflower-curry/#wprm-recipe-50925-step-0-12",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_3785.jpg"
    },
    {
      "text": "Add in the spinach and let wilt.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/shrimp-cauliflower-curry/#wprm-recipe-50925-step-0-13",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_3791.jpg"
    },
    {
      "text": "Taste the curry and season as needed. Once the spinach is wilted, mix it into the curry well and cook for 4–5 minutes longer.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/shrimp-cauliflower-curry/#wprm-recipe-50925-step-0-14",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_3795.jpg"
    },
    {
      "text": "Serve hot!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/shrimp-cauliflower-curry/#wprm-recipe-50925-step-0-15",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/ShrimpCauliflowerCurry5.jpg"
    }
  ],
