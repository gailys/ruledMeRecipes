  "ingredients": [
    "1 small cauliflower",
    "1 cup cream cheese",
    "1 cup cheddar cheese (shredded)",
    "4 slice cooked bacon (chopped)",
    "1/4 cup mushrooms (chopped)",
    "1 medium jalapeno pepper (chopped)",
    "10 ounce boneless, skinless chicken thighs"
  ],
  "instructions": [
    {
      "text": "Pre-heat oven to 350 degrees. Chop cauliflower into florets and place it in a casserole dish.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/loaded-cauliflower-casserole/#wprm-recipe-52898-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/02/loaded-cauliflower-casserole-01.jpg"
    },
    {
      "text": "In a separate dish, mix cream cheese together with shredded cheddar cheese and chopped jalapeno, mushrooms, and bacon.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/loaded-cauliflower-casserole/#wprm-recipe-52898-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/02/loaded-cauliflower-casserole-05.jpg"
    },
    {
      "text": "Spoon the cheese mixture onto the cauliflower and mix well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/loaded-cauliflower-casserole/#wprm-recipe-52898-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/02/loaded-cauliflower-casserole-06.jpg"
    },
    {
      "text": "Coat baking pan with a layer of non-stick spray. Layer the cauliflower mixture and chicken thighs into the baking pan.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/loaded-cauliflower-casserole/#wprm-recipe-52898-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/02/loaded-cauliflower-casserole-08.jpg"
    },
    {
      "text": "Bake for 1 hour or until the cheese has melted, the chicken is cooked, and the top of the casserole is nicely browned.",
      "group": "",
