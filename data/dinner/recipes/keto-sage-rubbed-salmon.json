  "ingredients": [
    "2 tablespoon olive oil",
    "2 tablespoon fresh sage (minced)",
    "2 teaspoon fresh garlic (minced)",
    "salt and pepper (to taste)",
    "12 ounce salmon",
    "250 gram green cabbage (thinly sliced)",
    "2 tablespoon olive oil",
    "1/4 medium yellow onion (chopped)",
    "1/4 teaspoon thyme",
    "1 teaspoon fresh garlic (minced)",
    "salt and pepper (to taste)"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all of the ingredients. Preheat oven to 375F.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-sage-rubbed-salmon/#wprm-recipe-54275-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/04/Keto-Sage-Rubbed-Salmon-1.jpg"
    },
    {
      "text": "Combine the seasonings in a bowl: olive oil, fresh sage, garlic, salt, and pepper. Stir to combine well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-sage-rubbed-salmon/#wprm-recipe-54275-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/04/Keto-Sage-Rubbed-Salmon-2.jpg"
    },
    {
      "text": "Rub this onto the salmon filet.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-sage-rubbed-salmon/#wprm-recipe-54275-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/04/Keto-Sage-Rubbed-Salmon-3.jpg"
    },
    {
      "text": "Cut the salmon into smaller pieces.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-sage-rubbed-salmon/#wprm-recipe-54275-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/04/Keto-Sage-Rubbed-Salmon-4.jpg"
    },
    {
      "text": "In a pan over medium heat, add in the olive oil. Add salmon and let cook for 5 minutes in pan.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-sage-rubbed-salmon/#wprm-recipe-54275-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/04/Keto-Sage-Rubbed-Salmon-5.jpg"
    },
    {
      "text": "Transfer to the preheated oven and let cook for about 10 minutes or until the salmon starts to get flaky.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-sage-rubbed-salmon/#wprm-recipe-54275-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/04/Keto-Sage-Rubbed-Salmon-6.jpg"
    },
    {
      "text": "Cook the cabbage with olive oil, chopped onion, thyme, minced garlic, salt, and pepper over medium heat. Stir to combine well and let cook for about 6 - 8 minutes or until tender.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-sage-rubbed-salmon/#wprm-recipe-54275-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/04/Keto-Sage-Rubbed-Salmon-7.jpg"
    },
    {
      "text": "Serve the cabbage with the salmon. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-sage-rubbed-salmon/#wprm-recipe-54275-step-0-7",
