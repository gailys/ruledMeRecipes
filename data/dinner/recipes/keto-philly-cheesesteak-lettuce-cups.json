  "ingredients": [
    "4 tablespoon butter",
    "1 medium onion",
    "1 medium red bell pepper",
    "salt and pepper (to taste)",
    "16 ounce skirt steak (thinly sliced)",
    "1 cup provolone cheese (shredded)",
    "8 medium butter lettuce leaf",
    "3 tablespoon fresh parsley"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all the ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-philly-cheesesteak-lettuce-cups/#wprm-recipe-53941-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/09/Philly-Cheesesteak-Lettuce-Cups-1.jpg"
    },
    {
      "text": "Heat half the butter in a skillet over medium heat. Add in the onion and red bell pepper. Season with salt and pepper. Sautee this for about 5 - 10 minutes, stirring occasionally. Remove from skillet and set aside.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-philly-cheesesteak-lettuce-cups/#wprm-recipe-53941-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/09/Philly-Cheesesteak-Lettuce-Cups-2.jpg"
    },
    {
      "text": "Heat the other half of the butter in the skillet. Add the skirt steak to the pan. Season with salt and pepper. Cook the steak on both sides for about 2 - 4 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-philly-cheesesteak-lettuce-cups/#wprm-recipe-53941-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/09/Philly-Cheesesteak-Lettuce-Cups-3.jpg"
    },
    {
      "text": "Once the steak is cooked to your standards, add the onion and bell peppers to the pan. Stir together well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-philly-cheesesteak-lettuce-cups/#wprm-recipe-53941-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/09/Philly-Cheesesteak-Lettuce-Cups-4.jpg"
    },
    {
      "text": "Add the shredded provolone cheese to the skillet. Put a lid over the skillet and let cook until cheese starts to melt.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-philly-cheesesteak-lettuce-cups/#wprm-recipe-53941-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/09/Philly-Cheesesteak-Lettuce-Cups-5.jpg"
    },
    {
      "text": "Place the lettuce leaves on a plate and spoon the steak mixture on each lettuce leaf. Garnish with parsley. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-philly-cheesesteak-lettuce-cups/#wprm-recipe-53941-step-0-5",
      "imageSource": null
    }
  ],
