  "ingredients": [
    "16 ounce ground turkey",
    "1 small cauliflower (chopped)",
    "1 teaspoon cumin",
    "1 teaspoon dried parsley",
    "1 teaspoon turmeric powder",
    "1 teaspoon dried oregano",
    "salt and pepper (to taste)",
    "1/4 cup onion (diced)",
    "1 teaspoon fresh garlic (minced)",
    "1/4 cup red bell pepper (diced)",
    "1 medium jalapeno pepper (chopped)",
    "1 1/2 cup cheddar cheese (shredded)",
    "1 cup sour cream"
  ],
  "instructions": [
    {
      "text": "Preheat over to 350F. Place ground meat and cauliflower into a bowl.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-taco-casserole/#wprm-recipe-52507-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/01/taco-casserole-01.jpg"
    },
    {
      "text": "Add in herbs and spices, including salt and pepper, and mix everything together.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-taco-casserole/#wprm-recipe-52507-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/01/taco-casserole-04.jpg"
    },
    {
      "text": "Stir in onions, garlic, red peppers and jalapenos.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-taco-casserole/#wprm-recipe-52507-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/01/taco-casserole-07.jpg"
    },
    {
      "text": "Mix in the shredded cheddar cheese, reserving some for topping.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-taco-casserole/#wprm-recipe-52507-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/01/taco-casserole-08.jpg"
    },
    {
      "text": "Pour the mixture into a casserole dish. Top with the reserved cheese. Bake for 1 hour.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-taco-casserole/#wprm-recipe-52507-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/01/taco-casserole-09.jpg"
    },
    {
      "text": "Serve with a dollop of sour cream on top and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-taco-casserole/#wprm-recipe-52507-step-0-5",
      "imageSource": null
    }
  ],
