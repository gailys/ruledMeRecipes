  "ingredients": [
    "2 tablespoon olive oil",
    "17 ounce boneless, skinless chicken breast",
    "1 teaspoon fresh garlic",
    "5 slice bacon (chopped)",
    "1 cup mushrooms (sliced)",
    "1/3 cup fresh basil",
    "5 ounce spinach",
    "4 whole sun-dried tomatoes",
    "1 cup ranch dressing"
  ],
