  "ingredients": [
    "2 tablespoon avocado oil",
    "24 ounce boneless, skinless chicken thighs",
    "1/2 teaspoon herbes de provence",
    "2 teaspoon fresh garlic (sliced)",
    "1 tablespoon paprika",
    "1 cup chicken stock",
    "1/2 cup heavy cream",
    "salt and pepper (to taste)",
    "3 tablespoon olive oil",
    "16 ounce cauliflower (florets)",
    "1 1/2 teaspoon paprika",
    "salt and pepper (to taste)"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all of the ingredients. Preheat oven to 425F.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-paprika-creamed-chicken/#wprm-recipe-54267-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/04/Keto-Paprika-Creamed-Chicken-1.jpg"
    },
    {
      "text": "Season the chicken with herbs de Provence, salt, and pepper.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-paprika-creamed-chicken/#wprm-recipe-54267-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/04/Keto-Paprika-Creamed-Chicken-2.jpg"
    },
    {
      "text": "In a frying pan over medium heat, add in the avocado oil.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-paprika-creamed-chicken/#wprm-recipe-54267-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/04/Keto-Paprika-Creamed-Chicken-3.jpg"
    },
    {
      "text": "Add in the seasoned chicken thighs to the pan. Cook for about 5 minutes per side or until internal temp reaches 165F. Add in the paprika and sliced garlic. Make sure the chicken is coated with these seasonings.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-paprika-creamed-chicken/#wprm-recipe-54267-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/04/Keto-Paprika-Creamed-Chicken-4.jpg"
    },
    {
      "text": "On a baking sheet lined with parchment paper, add the cauliflower florets. Season with olive oil, paprika, salt, and pepper. Bake in the oven for 15-20 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-paprika-creamed-chicken/#wprm-recipe-54267-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/04/Keto-Paprika-Creamed-Chicken-5.jpg"
    },
    {
      "text": "Add the chicken stock into the frying pan along with the heavy cream and salt and pepper. Let simmer for 3-5 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-paprika-creamed-chicken/#wprm-recipe-54267-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/04/Keto-Paprika-Creamed-Chicken-6.jpg"
    },
    {
      "text": "Serve the paprika chicken with the roasted cauliflower. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-paprika-creamed-chicken/#wprm-recipe-54267-step-0-6",
      "imageSource": null
    }
  ],
