  "ingredients": [
    "24 ounce boneless pork chops",
    "salt and pepper (to taste)",
    "1/4 cup flaxseed meal",
    "2 teaspoon cumin",
    "1 teaspoon ground coriander",
    "1 teaspoon cardamom",
    "3 tablespoon coconut oil (for frying)",
    "1 medium orange bell pepper",
    "1/2 medium onion",
    "80 gram celery",
    "1/4 cup dry white wine",
    "salt and pepper (to taste)"
  ],
  "instructions": [
    {
      "text": "Season both sides of the pork chops with salt and pepper. Mix together golden flaxseed, cumin, coriander, and cardamom.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cumin-crusted-pork-chops/#wprm-recipe-50997-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_6772.jpg"
    },
    {
      "text": "Dip the pork chops into the crust mixture, making sure to coat every side of the chops.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cumin-crusted-pork-chops/#wprm-recipe-50997-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_6777.jpg"
    },
    {
      "text": "Heat coconut oil in a cast iron skillet over medium-high heat.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cumin-crusted-pork-chops/#wprm-recipe-50997-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_6779.jpg"
    },
    {
      "text": "Once the oil is hot, add the pork chops to the pan.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cumin-crusted-pork-chops/#wprm-recipe-50997-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_6781.jpg"
    },
    {
      "text": "While the pork chops are cooking, prep the vegetables by slicing the orange pepper and onion and chopping the celery.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cumin-crusted-pork-chops/#wprm-recipe-50997-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_6789.jpg"
    },
    {
      "text": "Flip pork chops over and reduce heat to medium-low. Continue cooking until pork chops reach an internal temperature of 145F.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cumin-crusted-pork-chops/#wprm-recipe-50997-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_6791.jpg"
    },
    {
      "text": "Remove pork chops and place in foil to rest. In the remaining fats and oil, add seasoned vegetables and sautee until soft. Once soft, add the white wine and continue to cook down.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cumin-crusted-pork-chops/#wprm-recipe-50997-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_6800.jpg"
    },
    {
      "text": "Serve chops with vegetables and extra fat from the pan!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cumin-crusted-pork-chops/#wprm-recipe-50997-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/CuminPorkChopRedo.jpg"
    }
  ],
