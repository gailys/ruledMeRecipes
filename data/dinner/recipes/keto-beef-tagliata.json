  "ingredients": [
    "2 tablespoon olive oil",
    "2 teaspoon fresh garlic (crushed)",
    "600 gram sirloin steak",
    "salt and pepper (to taste)",
    "6 ounce spring mix",
    "6 ounce kale (leaves trimmed + stems discarded)",
    "1/4 cup olive oil",
    "1 teaspoon fresh garlic (crushed)",
    "2 tablespoon white wine vinegar",
    "salt and pepper (to taste)"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all the ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-beef-tagliata/#wprm-recipe-54175-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/02/Beef-Tagliata-1.jpg"
    },
    {
      "text": "In a bowl, combine the kale, olive oil, crushed garlic, white wine vinegar, salt, and pepper. Transfer to a pan of boiling water. Let this cook for about 30 seconds. Drain and transfer to ice water. Squeeze and transfer to a food processor. Pulse until it forms a paste.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-beef-tagliata/#wprm-recipe-54175-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/02/Beef-Tagliata-2.png"
    },
    {
      "text": "Prepare the sirloin steaks by drizzling with olive oil, and seasoning with crushed garlic, salt, and pepper.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-beef-tagliata/#wprm-recipe-54175-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/02/Beef-Tagliata-3.jpg"
    },
    {
      "text": "Cook the steaks in a frying pan over medium-high heat for 3 - 4 minutes per side or until cooked to your liking.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-beef-tagliata/#wprm-recipe-54175-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/02/Beef-Tagliata-4.jpg"
    },
    {
      "text": "Slice the steaks and serve with spring mix. Drizzle with the dressing. Serve and enjoy!",
