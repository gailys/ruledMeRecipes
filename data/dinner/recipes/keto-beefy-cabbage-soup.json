  "ingredients": [
    "16 ounce ground beef (85/15)",
    "3 tablespoon butter",
    "16 ounce green cabbage (shredded)",
    "6 cup beef broth",
    "2 tablespoon dijon mustard",
    "2 tablespoon tomato paste",
    "2 whole bay leaf",
    "1 tablespoon soy sauce (or coconut aminos)",
    "2 teaspoon worcestershire sauce",
    "3 ounce leek (finely chopped)",
    "1/2 cup sour cream",
    "1/4 cup fresh parsley (chopped)"
  ],
  "instructions": [
    {
      "text": "Gather and prep all of your ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-beefy-cabbage-soup/#wprm-recipe-56633-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/05/Keto-Beefy-Cabbage-Soup-1.jpg"
    },
    {
      "text": "In a pot over medium-high heat, add the ground beef and butter, then season with salt and pepper. Cook until browned.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-beefy-cabbage-soup/#wprm-recipe-56633-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/05/Keto-Beefy-Cabbage-Soup-2.jpg"
    },
    {
      "text": "Add the cabbage and continue to cook until cabbage has softened.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-beefy-cabbage-soup/#wprm-recipe-56633-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/05/Keto-Beefy-Cabbage-Soup-3.jpg"
    },
    {
      "text": "Add in the remaining ingredients (except for the leek). Bring to a boil and then reduce the heat. Simmer for additional 15-20 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-beefy-cabbage-soup/#wprm-recipe-56633-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/05/Keto-Beefy-Cabbage-Soup-4.jpg"
    },
    {
      "text": "Remove the bay leaves if still whole, then add the leek into the soup a few minutes before serving. Taste and season with salt and pepper as needed.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-beefy-cabbage-soup/#wprm-recipe-56633-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/05/Keto-Beefy-Cabbage-Soup-5.jpg"
    },
    {
      "text": "Serve with a dollop of sour cream and garnish with freshly chopped parsley. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-beefy-cabbage-soup/#wprm-recipe-56633-step-0-5",
