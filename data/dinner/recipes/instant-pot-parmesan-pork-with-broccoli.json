  "ingredients": [
    "28 ounce boneless pork shoulder (cut into pieces)",
    "2 ounce parmesan cheese (grated)",
    "3/4 cup low-carb tomato sauce",
    "2 tablespoon butter",
    "1 tablespoon dried basil",
    "salt and pepper (to taste)",
    "16 ounce broccoli (cut into florets)",
    "4 tablespoon olive oil",
    "1 teaspoon italian seasoning",
    "salt and pepper (to taste)"
  ],
  "instructions": [
    {
      "text": "Gather and prep all of your ingredients.",
      "group": "",
