  "ingredients": [
    "1 large egg",
    "3/4 cup parmesan cheese (shredded)",
    "1/4 cup almond flour",
    "salt and pepper (to taste)",
    "2 teaspoon dried thyme",
    "1 teaspoon onion powder",
    "1 teaspoon garlic powder",
    "2 ounce butter",
    "24 ounce boneless, skinless chicken breast (thinly sliced + pounded)",
    "1 tablespoon dijon mustard",
    "3/4 cup mayonnaise",
    "14 ounce green beans",
    "1 medium lemon",
    "1 tablespoon capers"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all the ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-schnitzel-with-green-beans/#wprm-recipe-54083-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/01/Keto-Schnitzel-Green-Beans-1.jpg"
    },
    {
      "text": "In a bowl, mix up the eggs with a fork. On a plate, add the seasonings of parmesan cheese, almond flour, salt, pepper, thyme, onion powder, and garlic powder.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-schnitzel-with-green-beans/#wprm-recipe-54083-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/01/Keto-Schnitzel-Green-Beans-2.jpg"
    },
    {
      "text": "Grab the thinly sliced + pounded chicken breasts, dip them in the egg batter on both sides then into the seasonings on both sides.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-schnitzel-with-green-beans/#wprm-recipe-54083-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/01/Keto-Schnitzel-Green-Beans-3.jpg"
    },
    {
      "text": "Add butter to a frying pan over medium heat.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-schnitzel-with-green-beans/#wprm-recipe-54083-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/01/Keto-Schnitzel-Green-Beans-4.jpg"
    },
    {
      "text": "Add in the seasoned chicken, letting it cook for about 5-6 minutes on each side or until golden brown. Remove from the pan and set aside.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-schnitzel-with-green-beans/#wprm-recipe-54083-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/01/Keto-Schnitzel-Green-Beans-5.jpg"
    },
    {
      "text": "Add the green beans to the same pan. Let these sautee for 5 about minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-schnitzel-with-green-beans/#wprm-recipe-54083-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/01/Keto-Schnitzel-Green-Beans-6.jpg"
    },
    {
      "text": "In a bowl, combine the dijon mustard and the mayonnaise. Stir to combine well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-schnitzel-with-green-beans/#wprm-recipe-54083-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/01/Keto-Schnitzel-Green-Beans-7.jpg"
    },
    {
      "text": "Serve the seasoned chicken with the green beans, mayonnaise mixture, capers, and lemon wedges. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-schnitzel-with-green-beans/#wprm-recipe-54083-step-0-7",
      "imageSource": null
    }
