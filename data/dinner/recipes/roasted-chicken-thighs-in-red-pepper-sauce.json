  "ingredients": [
    "24 ounce boneless, skinless chicken thighs",
    "salt and pepper (to taste)",
    "1 tablespoon avocado oil",
    "4 ounce goat cheese",
    "2 tablespoon fresh parsley (chopped)",
    "4 ounce roasted red pepper",
    "2 teaspoon fresh garlic (minced)",
    "2 tablespoon olive oil",
    "1/2 cup heavy cream",
    "salt and pepper (to taste)"
  ],
  "instructions": [
    {
      "text": "Preheat your oven to 350 degrees Fahrenheit. At the same time, preheat a skillet over medium-high heat.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/roasted-chicken-thighs-in-red-pepper-sauce/#wprm-recipe-53076-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/07/roasted-red-pepper-chicken-thighs-01.jpg"
    },
    {
      "text": "Season the thighs with salt and pepper.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/roasted-chicken-thighs-in-red-pepper-sauce/#wprm-recipe-53076-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/07/roasted-red-pepper-chicken-thighs-02.jpg"
    },
    {
      "text": "Add the avocado oil to the preheated skillet. Once the oil is hot, place the chicken thighs into the skillet. Sear for 5 minutes on each side or until the chicken is browned.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/roasted-chicken-thighs-in-red-pepper-sauce/#wprm-recipe-53076-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/07/roasted-red-pepper-chicken-thighs-05.jpg"
    },
    {
      "text": "Puree the roasted red peppers, garlic, and olive oil in a blender. Pour the heavy cream into the blended peppers, then blend until thoroughly mixed. Season with salt and pepper to taste.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/roasted-chicken-thighs-in-red-pepper-sauce/#wprm-recipe-53076-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/07/roasted-red-pepper-chicken-thighs-06.jpg"
    },
    {
      "text": "Remove the skillet from the stove, then pour the sauce over the top of the thighs. Flip them over to ensure that both sides are coated.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/roasted-chicken-thighs-in-red-pepper-sauce/#wprm-recipe-53076-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/07/roasted-red-pepper-chicken-thighs-08.jpg"
    },
    {
      "text": "Crumble the goat cheese over the top of the sauced chicken. Transfer the skillet to the oven then bake for 10-15 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/roasted-chicken-thighs-in-red-pepper-sauce/#wprm-recipe-53076-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/07/roasted-red-pepper-chicken-thighs-09.jpg"
    },
    {
      "text": "Garnish with fresh parsley before serving.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/roasted-chicken-thighs-in-red-pepper-sauce/#wprm-recipe-53076-step-0-6",
      "imageSource": null
    }
