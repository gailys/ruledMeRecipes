  "ingredients": [
    "8 ounce salmon",
    "3/4 teaspoon dried tarragon",
    "3/4 teaspoon dried dill",
    "salt and pepper (to taste)",
    "1 tablespoon ghee",
    "2 tablespoon butter",
    "1/2 teaspoon dried tarragon",
    "1/2 teaspoon dried dill",
    "salt and pepper (to taste)",
    "1/4 cup heavy whipping cream"
  ],
  "instructions": [
    {
      "text": "Slice the salmon in half to create smaller fillets. Season the fish with tarragon, dill, salt and pepper. Flip over and season the skin with salt and pepper only.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/salmon-tarragon-dill-cream-sauce/#wprm-recipe-51515-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/12/img_1297.jpg"
    },
    {
      "text": "Heat ghee in a ceramic cast-iron skillet (or any pan that will hold heat well) over a medium heat. Once hot, add the salmon skin-side down.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/salmon-tarragon-dill-cream-sauce/#wprm-recipe-51515-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/12/img_1299.jpg"
    },
    {
      "text": "Allow the salmon to cook for 4–6 minutes while the skin crisps up. Once crisp, reduce to low heat and flip the salmon.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/salmon-tarragon-dill-cream-sauce/#wprm-recipe-51515-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/12/img_1304.jpg"
    },
    {
      "text": "Cook to the desired level of doneness (generally about 7–15 minutes on low heat). Optional: If desired, cook for 20–40 seconds on the sides to get darker edges.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/salmon-tarragon-dill-cream-sauce/#wprm-recipe-51515-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/12/img_1307.jpg"
    },
    {
      "text": "Remove the salmon from the pan and set aside. Add the butter and spices to the pan and let brown. Once browned, add in the heavy whipping cream and stir to combine.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/salmon-tarragon-dill-cream-sauce/#wprm-recipe-51515-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/12/img_1316.jpg"
    },
    {
      "text": "Serve the salmon with broccoli or asparagus (or a favorite side dish) with the cream sauce slathered on top.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/salmon-tarragon-dill-cream-sauce/#wprm-recipe-51515-step-0-5",
      "imageSource": null
    }
  ],
