  "ingredients": [
    "12 ounce boneless, skinless chicken breast",
    "1 medium cauliflower (grated or riced)",
    "1/2 cup cremini mushrooms",
    "1/4 cup green onion (chopped)",
    "1/2 cup broccoli (florets)",
    "2/3 cup chicken broth",
    "1/2 cup heavy whipping cream",
    "3 tablespoon olive oil",
    "1/2 teaspoon xanthan gum",
    "1 teaspoon dried parsley",
    "salt and pepper (to Taste)"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 350F. Place chicken breasts in a casserole dish.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chicken-pot-pie-casserole/#wprm-recipe-52706-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/09/chicken-pot-casserole-01.jpg"
    },
    {
      "text": "Top the chicken with cauliflower rice, mushrooms, green onions, and broccoli.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chicken-pot-pie-casserole/#wprm-recipe-52706-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/09/chicken-pot-casserole-03.jpg"
    },
    {
      "text": "In a separate bowl mix together the chicken broth and cream.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chicken-pot-pie-casserole/#wprm-recipe-52706-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/09/chicken-pot-casserole-05.jpg"
    },
    {
      "text": "In another small bowl, whisk together the olive oil and xanthan gum. Quickly pour it into the creamy broth mixture, stirring well to combine.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chicken-pot-pie-casserole/#wprm-recipe-52706-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/09/chicken-pot-casserole-06.jpg"
    },
    {
      "text": "Whisk in the parsley and some salt and pepper. Let it sit for 5 minutes so it can thicken up.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chicken-pot-pie-casserole/#wprm-recipe-52706-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/09/chicken-pot-casserole-07.jpg"
    },
    {
      "text": "Pour the sauce onto your vegetables.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chicken-pot-pie-casserole/#wprm-recipe-52706-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/09/chicken-pot-casserole-08.jpg"
    },
    {
      "text": "Stir it all together.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chicken-pot-pie-casserole/#wprm-recipe-52706-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/09/chicken-pot-casserole-09.jpg"
    },
    {
      "text": "Cover with foil.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chicken-pot-pie-casserole/#wprm-recipe-52706-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/09/chicken-pot-casserole-10.jpg"
    },
    {
      "text": "Bake for 1 hour. Plate and serve.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chicken-pot-pie-casserole/#wprm-recipe-52706-step-0-8",
      "imageSource": null
    }
  ],
