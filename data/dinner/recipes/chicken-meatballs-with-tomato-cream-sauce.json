  },
  "ingredients": [
    "20 ounce ground chicken",
    "1 large egg",
    "2 ounce grated parmesan cheese",
    "2 tablespoon fresh basil",
    "4 tablespoon sun-dried tomatoes",
    "2 teaspoon fresh garlic (minced)",
    "1 tablespoon butter (for frying)",
    "salt and pepper (to taste)",
    "16 ounce broccoli",
    "4 tablespoon butter (for broccoli)",
    "1 cup heavy cream",
    "1 tablespoon tomato paste",
    "3 tablespoon fresh basil"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all the ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chicken-meatballs-with-tomato-cream-sauce/#wprm-recipe-53649-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/01/Chicken-Meatball-in-Tomato-Cream-Sauce-1.jpg"
    },
    {
      "text": "In a bowl, combine ground chicken, eggs, parmesan cheese, fresh basil, sun-dried tomatoes, minced garlic, and salt and pepper to taste. Stir until well combined. Form the meatballs with your hands into about golf ball size pieces.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chicken-meatballs-with-tomato-cream-sauce/#wprm-recipe-53649-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/01/Chicken-Meatball-in-Tomato-Cream-Sauce-2.jpg"
    },
    {
      "text": "Over medium-high heat, add butter into a frying pan and cook the meatballs, leaving room between them. Turn the meatballs every few minutes and make sure all sides are brown, about 12-15 minutes in total.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chicken-meatballs-with-tomato-cream-sauce/#wprm-recipe-53649-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/01/Chicken-Meatball-in-Tomato-Cream-Sauce-3.jpg"
    },
    {
      "text": "Add the heavy cream and tomato paste to the pan and mix together until combined.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chicken-meatballs-with-tomato-cream-sauce/#wprm-recipe-53649-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/01/Chicken-Meatball-in-Tomato-Cream-Sauce-4.jpg"
    },
    {
      "text": "Bring to a boil, then reduce heat to low. Cook for about 10 minutes, allowing to simmer and stirring occasionally. Season with salt and pepper to taste, then top with fresh basil.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chicken-meatballs-with-tomato-cream-sauce/#wprm-recipe-53649-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/01/Chicken-Meatball-in-Tomato-Cream-Sauce-5.jpg"
    },
    {
      "text": "While meatballs are cooking, bring a pot of salted water to a boil. Add the broccoli and cook until fork tender. Drain the pan completely, then add broccoli and butter back to the pot, stirring together for a minute to coat. Season with salt and pepper to taste.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chicken-meatballs-with-tomato-cream-sauce/#wprm-recipe-53649-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/01/Chicken-Meatball-in-Tomato-Cream-Sauce-6.jpg"
    },
    {
      "text": "Serve the meatballs with butter and broccoli. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chicken-meatballs-with-tomato-cream-sauce/#wprm-recipe-53649-step-0-6",
      "imageSource": null
    }
  ],
