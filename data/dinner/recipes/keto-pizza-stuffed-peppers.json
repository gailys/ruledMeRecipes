  "ingredients": [
    "2 large green bell pepper",
    "8 ounce mild italian sausage (cooked)",
    "1/2 cup pepperoni (chopped)",
    "1 cup low-carb tomato sauce",
    "1 1/2 cup mozzarella cheese (divided)",
    "2 tablespoon fresh basil (chopped)"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all of the ingredients. Preheat oven to 375F.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pizza-stuffed-peppers/#wprm-recipe-54591-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/02/Keto-Pizza-Stuffed-Peppers-1.jpg"
    },
    {
      "text": "Cut the green bell peppers in half and remove the seeds and stem. Place the cut and de-seeded peppers in a cast iron skillet.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pizza-stuffed-peppers/#wprm-recipe-54591-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/02/Keto-Pizza-Stuffed-Peppers-2.jpg"
    },
    {
      "text": "In a mixing bowl, combine the cooked Italian sausage, pepperoni, half of the mozzarella, and tomato sauce. Mix to combine well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pizza-stuffed-peppers/#wprm-recipe-54591-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/02/Keto-Pizza-Stuffed-Peppers-3.jpg"
    },
    {
      "text": "Using a spoon, evenly distribute the mixture into the bell peppers.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pizza-stuffed-peppers/#wprm-recipe-54591-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/02/Keto-Pizza-Stuffed-Peppers-4.jpg"
    },
    {
      "text": "Using the rest of the mozzarella cheese, add it to the top of the peppers. Bake in the preheated oven for 30 minutes or when the cheese has melted and the peppers are soft.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pizza-stuffed-peppers/#wprm-recipe-54591-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/02/Keto-Pizza-Stuffed-Peppers-5.jpg"
    },
    {
      "text": "Garnish with basil. Serve immediately and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pizza-stuffed-peppers/#wprm-recipe-54591-step-0-5",
      "imageSource": null
    }
  ],
