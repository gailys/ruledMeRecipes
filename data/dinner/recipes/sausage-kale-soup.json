  "ingredients": [
    "16 ounce ground mild italian sausage",
    "1 tablespoon butter",
    "1 medium yellow onion (chopped)",
    "70 gram carrot (peeled and diced)",
    "2 teaspoon fresh garlic (crushed)",
    "2 tablespoon red wine vinegar",
    "1 teaspoon dried oregano",
    "1 teaspoon dried basil",
    "1 teaspoon dried sage",
    "1/2 teaspoon crushed red pepper flakes",
    "4 cup chicken broth",
    "1 cup heavy whipping cream",
    "294 gram cauliflower (cut into small florets)",
    "3 cup kale (chopped)",
    "sea salt (to taste)",
    "1/2 teaspoon black pepper"
  ],
  "instructions": [
    {
      "text": "Heat a large saucepan or Dutch oven over medium-high heat. Add ground sausage, breaking up the meat. Cook, stirring occasionally until browned and cooked through. This takes about 5 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/sausage-kale-soup/#wprm-recipe-52027-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/12/DSC_30800.jpg"
    },
    {
      "text": "Using a slotted spoon, remove cooked sausage and allow to drain on a plate covered with paper towels. Discard drippings, but do not wash pan.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/sausage-kale-soup/#wprm-recipe-52027-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/12/DSC_3146.jpg"
    },
    {
      "text": "Melt butter over medium heat. When bubbling subsides, add onion and carrot. Cook until onion begins to brown on the edges and becomes somewhat translucent.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/sausage-kale-soup/#wprm-recipe-52027-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/12/DSC_3093.jpg"
    },
    {
      "text": "Stir in oregano, basil, sage and red pepper flakes. Pour in stock and heavy cream. Increase heat to medium-high.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/sausage-kale-soup/#wprm-recipe-52027-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/12/DSC_3133.jpg"
    },
    {
      "text": "When soup reaches a simmer, add cauliflower and turn heat down to medium-low. Simmer uncovered until cauliflower is fork-tender, about 10 minutes. Stir in kale and cooked sausage. Cook 1 to 2 minutes longer, or until kale wilts and the sausage is reheated.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/sausage-kale-soup/#wprm-recipe-52027-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/12/DSC_3153.jpg"
    },
    {
      "text": "Season to taste with salt and pepper. The amount of salt needed may vary due to variation in brands of broth.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/sausage-kale-soup/#wprm-recipe-52027-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/12/soup15-1.jpg"
    }
  ],
