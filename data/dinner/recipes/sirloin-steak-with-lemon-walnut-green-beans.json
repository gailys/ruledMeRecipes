  "ingredients": [
    "1 tablespoon butter",
    "6 ounce sirloin steak",
    "3 ounce green beans (washed and trimmed)",
    "2 tablespoon walnuts (chopped)",
    "1/2 teaspoon lemon zest",
    "salt and pepper (to taste)"
  ],
  "instructions": [
    {
      "text": "Gather and prep all ingredients. If preferred, wash and trim green beans. Season steak(s) with salt and pepper.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/sirloin-steak-with-lemon-walnut-green-beans/#wprm-recipe-54765-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/08/Sirloin-Steak-with-Lemon-Walnut-Green-Beans-1.jpg"
    },
    {
      "text": "Add butter to a pan over medium-high heat. Once hot, add in the steak and fry until browned on both sides. A few minutes per side, depending on the thickness of the steak. Once finished, set aside and wrap in foil to rest.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/sirloin-steak-with-lemon-walnut-green-beans/#wprm-recipe-54765-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/08/Sirloin-Steak-with-Lemon-Walnut-Green-Beans-2.jpg"
    },
    {
      "text": "In the same pan, add green beans and season with salt and pepper.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/sirloin-steak-with-lemon-walnut-green-beans/#wprm-recipe-54765-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/08/Sirloin-Steak-with-Lemon-Walnut-Green-Beans-3.jpg"
    },
    {
      "text": "Cook green beans until crisp, but tender. Add in the walnuts and lemon zest and stir to combine. Cook for an additional 30-60 seconds or until fragrant.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/sirloin-steak-with-lemon-walnut-green-beans/#wprm-recipe-54765-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/08/Sirloin-Steak-with-Lemon-Walnut-Green-Beans-5.jpg"
    },
    {
      "text": "Plate the green beans and steak. Pour any pan drippings over the top and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/sirloin-steak-with-lemon-walnut-green-beans/#wprm-recipe-54765-step-0-4",
