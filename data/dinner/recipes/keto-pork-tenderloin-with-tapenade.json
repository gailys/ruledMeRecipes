  "ingredients": [
    "24 ounce pork tenderloin",
    "1 tablespoon olive oil",
    "1 tablespoon italian seasoning",
    "salt and pepper (to taste)",
    "3 ounce green olive (pitted)",
    "2 ounce black olives (pitted)",
    "1/2 ounce sun-dried tomatoes",
    "2 tablespoon capers",
    "2 teaspoon fresh garlic",
    "1/4 cup fresh basil (chopped)",
    "1 tablespoon red wine vinegar",
    "1 tablespoon olive oil",
    "8 ounce mixed greens",
    "8 tablespoon italian dressing"
  ],
  "instructions": [
    {
      "text": "Gather and prep all of your ingredients. Trim silver skin off of the tenderloin if needed. Pre-heat oven to 400F.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pork-tenderloin-with-tapenade/#wprm-recipe-56620-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/05/Pork-Tenderloin-with-Olive-Tapenade-1.jpg"
    },
    {
      "text": "Rub oil over the tenderloin as needed, then season with salt, pepper, and Italian seasoning.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pork-tenderloin-with-tapenade/#wprm-recipe-56620-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/05/Pork-Tenderloin-with-Olive-Tapenade-2.jpg"
    },
    {
      "text": "Place the tenderloins into a baking tray or onto a baking sheet, then bake for 22-25 minutes or until internal temperature is 145F.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pork-tenderloin-with-tapenade/#wprm-recipe-56620-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/05/Pork-Tenderloin-with-Olive-Tapenade-3.jpg"
    },
    {
      "text": "While the pork is cooking, make the tapenade by adding all of the tapenade ingredients to a food processor.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pork-tenderloin-with-tapenade/#wprm-recipe-56620-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/05/Pork-Tenderloin-with-Olive-Tapenade-4.jpg"
    },
    {
      "text": "Pulse the tapenade until everything is well combined but still chunky.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pork-tenderloin-with-tapenade/#wprm-recipe-56620-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/05/Pork-Tenderloin-with-Olive-Tapenade-5.jpg"
    },
    {
      "text": "Allow pork to rest for 5-10 minutes prior to serving. Once ready, slice the pork and spoon tapenade mixture over the top. Serve with a side salad of mixed greens and Italian dressing. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pork-tenderloin-with-tapenade/#wprm-recipe-56620-step-0-5",
      "imageSource": null
    }
  ],
