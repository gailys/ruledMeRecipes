  "ingredients": [
    "32 ounce boneless, skinless chicken thighs",
    "8 ounce cremini mushrooms (sliced)",
    "1 medium green bell pepper (julienned)",
    "1 medium red bell pepper (julienned)",
    "1/2 medium onion (sliced)",
    "2 teaspoon fresh garlic (sliced)",
    "1 tablespoon garlic and herb seasoning",
    "1/3 cup chicken broth",
    "1/3 cup olive oil",
    "1/4 teaspoon salt",
    "1 teaspoon xanthan gum"
  ],
  "instructions": [
    {
      "text": "Gather ingredients. Dry the chicken then slice in half lengthwise. Cut into strips on a bias. Marinate with a little of the olive oil and the garlic and herb seasoning blend.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-cacciatore-tomato-free/#wprm-recipe-59564-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/09/keto-chicken-cacciatore-tomato-free-step-01.jpg"
    },
    {
      "text": "Preheat a large saute pan over medium heat. Add some of the olive oil, then brown the chicken in batches. Cook all the way through, then set the chicken aside.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-cacciatore-tomato-free/#wprm-recipe-59564-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/09/keto-chicken-cacciatore-tomato-free-step-02.jpg"
    },
    {
      "text": "Add more olive oil to the pan, then brown the mushrooms in batches, making sure both sides have a nice golden color. Set the mushrooms aside, then add the rest of the vegetables to the pan and cook until softened.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-cacciatore-tomato-free/#wprm-recipe-59564-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/09/keto-chicken-cacciatore-tomato-free-step-03.jpg"
    },
    {
      "text": "Add the chicken broth, then scrape the brown bits off the bottom of the pan.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-cacciatore-tomato-free/#wprm-recipe-59564-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/09/keto-chicken-cacciatore-tomato-free-step-04.jpg"
    },
    {
      "text": "Add the chicken and mushrooms back then cover with a lid, and simmer. Add the xanthan gum, then stir and cook down until the sauce has thickened. Season with salt and serve.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-cacciatore-tomato-free/#wprm-recipe-59564-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/09/keto-chicken-cacciatore-tomato-free-step-05.jpg"
    }
  ],
