  "ingredients": [
    "2 teaspoon sesame oil",
    "1 teaspoon fresh garlic (minced)",
    "16 ounce ground chicken",
    "4 tablespoon soy sauce (or coconut aminos)",
    "2 teaspoon chili paste (like sambal oelek)",
    "3 tablespoon peanut butter",
    "1 tablespoon lime juice",
    "1 tablespoon erythritol",
    "1/4 teaspoon cayenne pepper",
    "1/4 teaspoon paprika",
    "30 gram green onion (sliced)",
    "1/3 medium yellow bell pepper (sliced)",
    "1 tablespoon unseasoned rice vinegar"
  ],
  "instructions": [
    {
      "text": "Heat sesame oil on medium-high in a pan. Once the oil is hot, add ground chicken to the pan and allow it to brown.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-chicken-satay/#wprm-recipe-51009-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/low-carb-chicken-satay-step-01.jpg"
    },
    {
      "text": "Once the chicken is slightly browned, move it to one side of the pan and add minced garlic.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-chicken-satay/#wprm-recipe-51009-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/low-carb-chicken-satay-step-02.jpg"
    },
    {
      "text": "Once garlic is browned, mix everything together and add soy sauce, erythritol, rice vinegar, and chili paste to the pan.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-chicken-satay/#wprm-recipe-51009-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/low-carb-chicken-satay-step-03.jpg"
    },
    {
      "text": "Allow it all to cook down for a minute, then add peanut butter and the lime juice.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-chicken-satay/#wprm-recipe-51009-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/low-carb-chicken-satay-step-04.jpg"
    },
    {
      "text": "Mix everything well, then add cayenne pepper and paprika.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-chicken-satay/#wprm-recipe-51009-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/low-carb-chicken-satay-step-05.jpg"
    },
    {
      "text": "Cook everything down. Once it’s cooked down, add sliced spring onions, and sliced yellow bell pepper.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-chicken-satay/#wprm-recipe-51009-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/low-carb-chicken-satay-step-06.jpg"
    },
    {
      "text": "Serve hot!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-chicken-satay/#wprm-recipe-51009-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/low-carb-chicken-satay-step-07.jpg"
    }
