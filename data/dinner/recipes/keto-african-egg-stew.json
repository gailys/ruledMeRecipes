  "ingredients": [
    "6 large egg",
    "2 medium fresh tomatoes",
    "1/2 medium onion",
    "2 teaspoon fresh garlic",
    "1/2 cup olive oil",
    "1 medium red bell pepper",
    "1 medium jalapeno pepper",
    "1 teaspoon curry powder",
    "1/2 teaspoon fresh thyme",
    "1 whole chicken bouillon cube",
    "salt (to taste)"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all of the ingredients. Core the tomatoes. Slice the red bell pepper and remove seeds. Slice half of the onion and jalapeno pepper.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-african-egg-stew/#wprm-recipe-54319-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/05/Keto-African-Egg-Stew-1.jpg"
    },
    {
      "text": "In a blender, add the cored tomatoes, sliced red bell pepper, onion, and jalapeno pepper. Blend for a few seconds.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-african-egg-stew/#wprm-recipe-54319-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/05/Keto-African-Egg-Stew-2.png"
    },
    {
      "text": "Mince the garlic and slice the other half of the onion.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-african-egg-stew/#wprm-recipe-54319-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/05/Keto-African-Egg-Stew-3.jpg"
    },
    {
      "text": "In a frying pan over medium heat, add the olive oil and saute the garlic and sliced onion for about 1 minute.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-african-egg-stew/#wprm-recipe-54319-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/05/Keto-African-Egg-Stew-5.jpg"
    },
    {
      "text": "Meanwhile, in a bowl, whip up the eggs.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-african-egg-stew/#wprm-recipe-54319-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/05/Keto-African-Egg-Stew-4.jpg"
    },
    {
      "text": "Pour the blended tomatoes into the frying pan. Stir while simmering for about 5 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-african-egg-stew/#wprm-recipe-54319-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/05/Keto-African-Egg-Stew-6.jpg"
    },
    {
      "text": "Add the jalapeno, curry powder, thyme, and chicken bouillon cube. Stir this together and let sit for about 2 - 4 minutes more.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-african-egg-stew/#wprm-recipe-54319-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/05/Keto-African-Egg-Stew-7.jpg"
    },
    {
      "text": "Pour in the eggs. Let cook for about 2 - 3 minutes without stirring. Then, stir everything together for about 1 minute.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-african-egg-stew/#wprm-recipe-54319-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/05/Keto-African-Egg-Stew-8.jpg"
    },
    {
      "text": "Garnish with a dash of salt and extra thyme. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-african-egg-stew/#wprm-recipe-54319-step-0-8",
      "imageSource": null
    }
  ],
