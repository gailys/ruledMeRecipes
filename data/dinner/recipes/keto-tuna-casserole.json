  "ingredients": [
    "1 tablespoon butter",
    "1/4 cup carrot (chopped)",
    "1/4 cup cremini mushrooms (chopped)",
    "1/4 cup green onion (chopped)",
    "1 cup heavy whipping cream",
    "1/4 teaspoon xanthan gum",
    "678 gram shirataki noodles",
    "3/4 cup cheddar cheese (shredded)",
    "146 gram canned tuna (drained)",
    "salt and pepper (to taste)",
    "2 tablespoon almond flour"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 350F. Melt the butter in a deep pot on medium.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-tuna-casserole/#wprm-recipe-52401-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/11/tuna-casserole-01.jpg"
    },
    {
      "text": "Add in the green onions, mushrooms, and carrots.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-tuna-casserole/#wprm-recipe-52401-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/11/tuna-casserole-02.jpg"
    },
    {
      "text": "Saute the veggies for 3-5 minutes. Sprinkle xanthan gum over the vegetables.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-tuna-casserole/#wprm-recipe-52401-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/11/tuna-casserole-03.jpg"
    },
    {
      "text": "Quickly add in the cream and stir. It should start thickening immediately, but continue heating until it starts to bubble.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-tuna-casserole/#wprm-recipe-52401-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/11/tuna-casserole-04.jpg"
    },
    {
      "text": "Drain shirataki noodles and rinse very well. Dry with paper towel. Place the shirataki noodles in a casserole dish.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-tuna-casserole/#wprm-recipe-52401-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/11/tuna-casserole-05.jpg"
    },
    {
      "text": "Stir the cream mixture into the noodles.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-tuna-casserole/#wprm-recipe-52401-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/11/tuna-casserole-06.jpg"
    },
    {
      "text": "Mix in the cheddar cheese and flaked tuna.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-tuna-casserole/#wprm-recipe-52401-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/11/tuna-casserole-09.jpg"
    },
    {
      "text": "Top the casserole with almond flour.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-tuna-casserole/#wprm-recipe-52401-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/11/tuna-casserole-11-1.jpg"
    },
    {
      "text": "Bake for 35 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-tuna-casserole/#wprm-recipe-52401-step-0-8",
      "imageSource": null
    }
  ],
