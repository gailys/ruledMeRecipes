  "ingredients": [
    "1/2 cup sour cream",
    "2 large egg",
    "1/2 tablespoon garlic powder",
    "1/2 tablespoon onion powder",
    "1/2 teaspoon salt",
    "1/4 teaspoon black pepper",
    "1/4 cup butter",
    "2 teaspoon xanthan gum",
    "2 cup chicken broth",
    "5 cup cauliflower rice",
    "3 cup rotisserie chicken (chopped or Torn)",
    "3 ounce pork rinds (crushed)",
    "1/4 cup parmesan cheese",
    "2 tablespoon parmesan cheese"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 350F and lightly grease a casserole dish.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-and-rice-casserole/#wprm-recipe-52686-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/08/chicken-n-rice-casserole-01.jpg"
    },
    {
      "text": "In a small bowl whisk together the sour cream, eggs, garlic powder, onion powder, salt, and pepper. Set aside.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-and-rice-casserole/#wprm-recipe-52686-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/08/chicken-n-rice-casserole-02.jpg"
    },
    {
      "text": "In a large skillet melt the butter over medium heat.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-and-rice-casserole/#wprm-recipe-52686-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/08/chicken-n-rice-casserole-03.jpg"
    },
    {
      "text": "Whisk in the xanthan gum, stirring constantly, until the mixture turns golden brown, about 5 minutes. Watch carefully as it can burn easily. Whisk in the chicken broth and allow the sauce to simmer and thicken, about 5 minutes more. Remove from the heat and allow to cool slightly.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-and-rice-casserole/#wprm-recipe-52686-step-0-3",
      "imageSource": null
    },
    {
      "text": "Stir the riced cauliflower into the sauce mixture to combine.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-and-rice-casserole/#wprm-recipe-52686-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/08/chicken-n-rice-casserole-05.jpg"
    },
    {
      "text": "Add the cauliflower, cooked chicken, 1/2 the ground pork rinds, the larger amount of Parmesan cheese, and the sour cream mixture to the prepared casserole dish. Stir well to combine.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-and-rice-casserole/#wprm-recipe-52686-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/08/chicken-n-rice-casserole-06.jpg"
    },
    {
      "text": "Combine the remaining ground pork rinds with the smaller amount of Parmesan cheese. Sprinkle evenly over the top of the casserole.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-and-rice-casserole/#wprm-recipe-52686-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/08/chicken-n-rice-casserole-08.jpg"
    },
    {
      "text": "Bake for 60 minutes or until the top is golden brown.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-and-rice-casserole/#wprm-recipe-52686-step-0-7",
      "imageSource": null
    }
  ],
