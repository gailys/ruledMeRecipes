  "ingredients": [
    "Leftover BBQ Pulled Chicken",
    "1/3 Cup Honeyville Almond Flour",
    "1/4 Cup Flax Seed Meal",
    "3 Tbsp. Parmesan Cheese",
    "2 Tbsp. Cheddar Cheese (per slider)",
    "2 large Eggs",
    "4 Tbsp. Butter",
    "8 drops Liquid Stevia",
    "1 tsp. Baking Soda",
    "1 tsp. Southwest Chipotle Seasoning",
    "1 tsp. Paprika",
    "1/2 tsp. Apple Cider Vinegar"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 350F.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/bbq-pulled-chicken-sliders/#wprm-recipe-50829-step-0-0",
      "imageSource": null
    },
    {
      "text": "Mix together all dry ingredients in a large mixing bowl.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/bbq-pulled-chicken-sliders/#wprm-recipe-50829-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/02/P2075110.jpg"
    },
    {
      "text": "Melt butter in the microwave, then add eggs, vinegar, stevia and butter to mixture.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/bbq-pulled-chicken-sliders/#wprm-recipe-50829-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/02/P2075112.jpg"
    },
    {
      "text": "Mix everything well and spread the mixture out between 8 Muffin Top slots in a pan.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/bbq-pulled-chicken-sliders/#wprm-recipe-50829-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/02/P2075114.jpg"
    },
    {
      "text": "In a pan, heat the BBQ Pulled Chicken Leftovers. Let the sauce reduce so that it is thick.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/bbq-pulled-chicken-sliders/#wprm-recipe-50829-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/02/P2075124.jpg"
    },
    {
      "text": "Bake for 15-17 minutes. Once baked, let cool for 5 minutes, then cut buns in half.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/bbq-pulled-chicken-sliders/#wprm-recipe-50829-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/02/oven.jpg"
    },
    {
      "text": "Grate cheddar cheese and use about 2 Tbsp. Cheddar per Slider.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/bbq-pulled-chicken-sliders/#wprm-recipe-50829-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/02/P2075118.jpg"
    },
    {
      "text": "Assemble slider together with bun, cheese, and BBQ Pulled Chicken.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/bbq-pulled-chicken-sliders/#wprm-recipe-50829-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/02/P2075133.jpg"
