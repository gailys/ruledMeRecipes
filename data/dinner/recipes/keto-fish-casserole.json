  "ingredients": [
    "2 tablespoon olive oil",
    "16 ounce broccoli",
    "5 ounce spinach",
    "6 medium green onion",
    "2 tablespoon capers",
    "1 tablespoon butter (for greasing dish)",
    "24 ounce white fish",
    "1 1/4 cup heavy cream",
    "1/2 medium lemon (juice of)",
    "1 tablespoon dijon mustard",
    "1 tablespoon fresh parsley (chopped)",
    "6 tablespoon butter",
    "salt and pepper (to taste)"
  ],
  "instructions": [
    {
      "text": "Measure and prepare all ingredients. Grease a baking dish with butter and preheat oven to 400F.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-fish-casserole/#wprm-recipe-53653-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/01/Fish-Casserole-1.jpg"
    },
    {
      "text": "Cut broccoli into small florets, keeping the stem pieces.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-fish-casserole/#wprm-recipe-53653-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/01/Fish-Casserole-2.jpg"
    },
    {
      "text": "Place the oil in a pan on medium heat. Once hot, add the broccoli and cook until fork-tender, about 4-5 minutes. Add the spinach to the broccoli and allow to wilt for 45-60 seconds.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-fish-casserole/#wprm-recipe-53653-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/01/Fish-Casserole-3.jpg"
    },
    {
      "text": "Once the spinach is wilted, add the green onions and capers to the pan. Saute for another 1-2 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-fish-casserole/#wprm-recipe-53653-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/01/Fish-Casserole-4.jpg"
    },
    {
      "text": "Add the vegetables to the greased baking dish. Place the fish on top of the vegetables, covering the sides of the fish with the vegetables.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-fish-casserole/#wprm-recipe-53653-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/01/Fish-Casserole-5.jpg"
    },
    {
      "text": "Mix together the heavy cream, lemon juice, Dijon mustard, and chopped parsley well. Pour over the top of the fish and vegetables, then top with slices of butter. Bake in the oven for 20 minutes or until fish is flakey.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-fish-casserole/#wprm-recipe-53653-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/01/Fish-Casserole-6.jpg"
    },
    {
      "text": "Serve warm and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-fish-casserole/#wprm-recipe-53653-step-0-6",
      "imageSource": null
    }
  ],
