  "ingredients": [
    "1/2 cup heavy cream",
    "3 tablespoon dijon mustard",
    "2 teaspoon low-carb brown sugar replacement",
    "16 ounce boneless, skinless chicken thighs",
    "salt and pepper (to taste)",
    "1 tablespoon olive oil",
    "1 tablespoon butter",
    "1/2 medium onion (thinly sliced)",
    "1 tablespoon fresh parsley (minced)",
    "16 ounce broccoli",
    "2 tablespoon olive oil"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all of the ingredients. Preheat oven to 400F.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-creamy-dijon-chicken/#wprm-recipe-54223-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/03/Keto-Creamy-Dijon-Chicken-1.jpg"
    },
    {
      "text": "Add the broccoli to a baking sheet and drizzle with olive oil. Roast in the oven for 25 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-creamy-dijon-chicken/#wprm-recipe-54223-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/03/Keto-Creamy-Dijon-Chicken-2.jpg"
    },
    {
      "text": "Meanwhile, season the chicken thighs with salt and pepper.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-creamy-dijon-chicken/#wprm-recipe-54223-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/03/Keto-Creamy-Dijon-Chicken-3.jpg"
    },
    {
      "text": "In a bowl, whisk together the heavy cream, dijon mustard, and brown sugar replacement.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-creamy-dijon-chicken/#wprm-recipe-54223-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/03/Keto-Creamy-Dijon-Chicken-4.jpg"
    },
    {
      "text": "In a frying pan over medium to high heat, add the olive oil and butter. Cook the chicken through until there is no more pink.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-creamy-dijon-chicken/#wprm-recipe-54223-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/03/Keto-Creamy-Dijon-Chicken-5.jpg"
    },
    {
      "text": "Add the heavy cream and dijon mustard mixture to the pan and turn the heat up to high to bring it to a boil. Add in the thinly sliced onion.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-creamy-dijon-chicken/#wprm-recipe-54223-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/03/Keto-Creamy-Dijon-Chicken-6.jpg"
    },
    {
      "text": "Turn the heat down to low and let simmer for about 10 minutes or until internal temperature of the chicken reaches 165F.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-creamy-dijon-chicken/#wprm-recipe-54223-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/03/Keto-Creamy-Dijon-Chicken-7.jpg"
    },
    {
      "text": "The broccoli should now be done. Remove from oven.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-creamy-dijon-chicken/#wprm-recipe-54223-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/03/Keto-Creamy-Dijon-Chicken-8.jpg"
    },
    {
      "text": "Serve the creamy dijon chicken with the broccoli. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-creamy-dijon-chicken/#wprm-recipe-54223-step-0-8",
      "imageSource": null
    }
  ],
