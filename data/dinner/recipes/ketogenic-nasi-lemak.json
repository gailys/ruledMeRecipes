  "ingredients": [
    "12 ounce boneless, skinless chicken thighs",
    "1/2 teaspoon curry powder",
    "1/4 teaspoon turmeric powder",
    "1 teaspoon lime juice",
    "salt (to taste)",
    "1 teaspoon coconut oil",
    "7 ounce cauliflower (riced)",
    "3 tablespoon canned coconut milk",
    "1 teaspoon fresh ginger",
    "1/2 medium shallot (sliced)",
    "1/4 teaspoon salt (or to taste)",
    "20 gram cucumber",
    "1 large egg",
    "1/2 tablespoon butter",
    "1 tablespoon chili-garlic paste"
  ],
  "instructions": [
    {
      "text": "Marinate boneless chicken thighs with curry powder, turmeric powder, lime juice and salt. Set aside.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/ketogenic-nasi-lemak/#wprm-recipe-51611-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/03/7-2.jpg"
    },
    {
      "text": "Prepare the cauliflower rice (by ricing cauliflower) and squeeze water out. Set aside.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/ketogenic-nasi-lemak/#wprm-recipe-51611-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/03/7-1.jpg"
    },
    {
      "text": "Fry the marinated chicken thighs until brown.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/ketogenic-nasi-lemak/#wprm-recipe-51611-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/03/7-7.jpg"
    },
    {
      "text": "To prepare the rice, boil in a saucepan over medium heat: coconut milk, ginger, shallot and salt. It should take about a minute or less.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/ketogenic-nasi-lemak/#wprm-recipe-51611-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/03/7-8.jpg"
    },
    {
      "text": "Once bubbling, add in the riced cauliflower and mix well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/ketogenic-nasi-lemak/#wprm-recipe-51611-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/03/7-9.jpg"
    },
    {
      "text": "Prepare Sambal (from our recipe on the website) if making from scratch, or you can use pre-made Sambal.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/ketogenic-nasi-lemak/#wprm-recipe-51611-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/03/7-6.jpg"
    },
    {
      "text": "Serve with sliced cucumber and a fried egg, along with sambal and a chicken thigh.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/ketogenic-nasi-lemak/#wprm-recipe-51611-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/03/nasilemak1.jpg"
    }
  ],
