  "ingredients": [
    "12 ounce boneless, skinless chicken thighs",
    "4 tablespoon caesar dressing",
    "1 teaspoon lemon juice",
    "1 teaspoon kosher salt",
    "1/4 teaspoon garlic powder",
    "1/4 teaspoon onion powder",
    "12 ounce spring mix",
    "4 tablespoon caesar dressing"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all the ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-baked-caesar-chicken/#wprm-recipe-53633-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/01/Keto-Caesar-Baked-Chicken-1.jpg"
    },
    {
      "text": "In a bowl, combine caesar dressing, lemon juice, salt, garlic, and onion powder. Stir until well combined.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-baked-caesar-chicken/#wprm-recipe-53633-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/01/Keto-Caesar-Baked-Chicken-2.jpg"
    },
    {
      "text": "Add the chicken into the bowl, smothering them and getting the marinade on every part of the chicken.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-baked-caesar-chicken/#wprm-recipe-53633-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/01/Keto-Caesar-Baked-Chicken-3.jpg"
    },
    {
      "text": "Cover with plastic wrap and put in refrigerator for at least 2 hours but up to 24 hours.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-baked-caesar-chicken/#wprm-recipe-53633-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/01/Keto-Caesar-Baked-Chicken-4.jpg"
    },
    {
      "text": "Before cooking, pre-heat oven to 400F. Evenly space out the chicken on a baking sheet lined with aluminum foil.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-baked-caesar-chicken/#wprm-recipe-53633-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/01/Keto-Caesar-Baked-Chicken-5.jpg"
    },
    {
      "text": "Bake chicken in the oven for 30-35 minutes or until chicken reaches an internal temperature of 165F.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-baked-caesar-chicken/#wprm-recipe-53633-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/01/Keto-Caesar-Baked-Chicken-6.jpg"
    },
    {
      "text": "Plate the chicken with leafy greens and additional caesar dressing. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-baked-caesar-chicken/#wprm-recipe-53633-step-0-6",
      "imageSource": null
    }
