    "fatGrams": 33.3
  },
  "ingredients": [
    "1 tablespoon olive oil",
    "3 teaspoon fresh garlic (minced)",
    "1 medium yellow onion (diced)",
    "16 ounce ground lamb",
    "4 tablespoon tomato paste",
    "3/4 teaspoon ground cinnamon",
    "1/2 teaspoon dried oregano",
    "1/4 teaspoon ground nutmeg",
    "1/2 cup chicken broth",
    "1/2 medium green cabbage (cored and thinly sliced)",
    "2 ounce feta cheese (crumbled)",
    "salt and pepper (to taste)"
  ],
  "instructions": [
    {
      "text": "Gather and prep all of your ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/greek-one-pan-lamb-cabbage-bowl/#wprm-recipe-56898-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/06/Greek-One-Pan-Lamb-Cabbage-Bowl-1.jpg"
    },
    {
      "text": "In a large pan over medium-high heat, add in the olive oil, onion, garlic, and ground lamb. Season with salt and pepper to taste. Cook until lamb starts to brown, about 6-8 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/greek-one-pan-lamb-cabbage-bowl/#wprm-recipe-56898-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/06/Greek-One-Pan-Lamb-Cabbage-Bowl-2.jpg"
    },
    {
      "text": "Once lamb has started to brown, add in the tomato paste, cinnamon, oregano, and nutmeg. Mix together well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/greek-one-pan-lamb-cabbage-bowl/#wprm-recipe-56898-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/06/Greek-One-Pan-Lamb-Cabbage-Bowl-3.jpg"
    },
    {
      "text": "Add in the green cabbage and stir together.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/greek-one-pan-lamb-cabbage-bowl/#wprm-recipe-56898-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/06/Greek-One-Pan-Lamb-Cabbage-Bowl-4.jpg"
    },
    {
      "text": "Continue to sauté. You want the cabbage to tender but still crisp, not soft.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/greek-one-pan-lamb-cabbage-bowl/#wprm-recipe-56898-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/06/Greek-One-Pan-Lamb-Cabbage-Bowl-5.jpg"
    },
    {
      "text": "Once the cabbage has become tender, add in the broth as needed to add moisture and to release any burnt bits from the bottom of the pan. You do not have to use all of the stock if you don't think it's needed.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/greek-one-pan-lamb-cabbage-bowl/#wprm-recipe-56898-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/06/Greek-One-Pan-Lamb-Cabbage-Bowl-6.jpg"
    },
    {
      "text": "Taste again and season with salt if needed. Serve with crumbled feta cheese and optional parsley over the top. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/greek-one-pan-lamb-cabbage-bowl/#wprm-recipe-56898-step-0-6",
      "imageSource": null
    }
  ],
