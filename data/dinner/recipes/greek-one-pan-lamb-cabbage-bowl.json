  "description": "This makes a total of 4 servings of Greek One-Pan Lamb & Cabbage Bowl. Each serving comes out to be 447 calories, 33.3g fats, 9.8g net carbs, and 23.6g protein.",
  "servings": 4,
  "yield": [
    "4",
    "4 servings"
  ],
  "prepTime": "PT5M",
  "cookTime": "PT20M",
  "totalTime": "PT25M",
