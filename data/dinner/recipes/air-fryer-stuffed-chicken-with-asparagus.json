  "ingredients": [
    "12 ounce boneless, skinless chicken breast",
    "4 ounce cream cheese",
    "2 tablespoon pesto",
    "2 tablespoon parmesan cheese (grated)",
    "2 teaspoon olive oil",
    "salt and pepper (to taste)",
    "6 ounce asparagus spears",
    "2 tablespoon olive oil",
    "1/2 teaspoon garlic powder",
    "1/2 teaspoon onion powder",
    "salt and pepper (to taste)"
  ],
  "instructions": [
    {
      "text": "Gather and prep all ingredients. Pre-heat air fryer to 350F.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/air-fryer-stuffed-chicken-with-asparagus/#wprm-recipe-54905-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/08/Air-Fryer-Stuffed-Chicken-with-Asparagus-1.jpg"
    },
    {
      "text": "Toss the asparagus with olive oil, garlic powder, onion powder, and salt and pepper to taste. Set aside.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/air-fryer-stuffed-chicken-with-asparagus/#wprm-recipe-54905-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/08/Air-Fryer-Stuffed-Chicken-with-Asparagus-2.jpg"
    },
    {
      "text": "Lay chicken breast flat on a cutting board. Using a sharp knife, cut a pocket into the chicken breast deep enough to fill.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/air-fryer-stuffed-chicken-with-asparagus/#wprm-recipe-54905-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/08/Air-Fryer-Stuffed-Chicken-with-Asparagus-3.jpg"
    },
    {
      "text": "In a small bowl, combine the filling for the chicken. Combine cream cheese, pesto, parmesan cheese, and salt and pepper to taste.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/air-fryer-stuffed-chicken-with-asparagus/#wprm-recipe-54905-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/08/Air-Fryer-Stuffed-Chicken-with-Asparagus-4.jpg"
    },
    {
      "text": "Spoon the filling mixture into the pockets.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/air-fryer-stuffed-chicken-with-asparagus/#wprm-recipe-54905-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/08/Air-Fryer-Stuffed-Chicken-with-Asparagus-5.jpg"
    },
    {
      "text": "Drizzle oil over the chicken breast and season with salt and pepper to taste.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/air-fryer-stuffed-chicken-with-asparagus/#wprm-recipe-54905-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/08/Air-Fryer-Stuffed-Chicken-with-Asparagus-6.jpg"
    },
    {
      "text": "Lay the asparagus on the bottom of the air fryer compartment, then lay chicken over the top of the asparagus.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/air-fryer-stuffed-chicken-with-asparagus/#wprm-recipe-54905-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/08/Air-Fryer-Stuffed-Chicken-with-Asparagus-8.jpg"
    },
    {
      "text": "Cook for 18-22 minutes or until chicken is cooked through. Serve and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/air-fryer-stuffed-chicken-with-asparagus/#wprm-recipe-54905-step-0-7",
