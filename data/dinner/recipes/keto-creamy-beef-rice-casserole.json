  "ingredients": [
    "16 ounce ground beef",
    "1 medium onion (minced)",
    "3 ounce cream cheese",
    "1/2 cup beef broth",
    "1/2 cup heavy whipping cream",
    "1 tablespoon butter",
    "1 teaspoon garlic powder",
    "1 tablespoon tomato paste",
    "10 ounce cauliflower (riced)",
    "1/2 cup cheddar cheese (shredded)",
    "1/2 cup mozzarella cheese (shredded)",
    "2 tablespoon fresh parsley (chopped)",
    "1/2 teaspoon crushed red pepper flakes"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all the ingredients. Rinse and put the cauliflower in a food processor to rice it.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-creamy-beef-rice-casserole/#wprm-recipe-53901-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/06/Creamy-Beef-Rice-Casserole-1.jpg"
    },
    {
      "text": "Add butter and ground beef to a frying pan. Fry over medium to high heat until the beef starts to brown.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-creamy-beef-rice-casserole/#wprm-recipe-53901-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/06/Creamy-Beef-Rice-Casserole-2.jpg"
    },
    {
      "text": "Add the minced onion to the frying pan with the beef and stir to combine.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-creamy-beef-rice-casserole/#wprm-recipe-53901-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/06/Creamy-Beef-Rice-Casserole-3.jpg"
    },
    {
      "text": "Add the cream cheese to the pan with the beef broth, heavy whipping cream, garlic powder, and tomato paste.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-creamy-beef-rice-casserole/#wprm-recipe-53901-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/06/Creamy-Beef-Rice-Casserole-4.jpg"
    },
    {
      "text": "In a microwave safe bowl, add the riced cauliflower with some water. Put in the microwave for 5 minutes, this steams the cauliflower. Watch and add more water as needed.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-creamy-beef-rice-casserole/#wprm-recipe-53901-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/06/Creamy-Beef-Rice-Casserole-5.jpg"
    },
    {
      "text": "Add the cauliflower rice to the pan and stir to combine well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-creamy-beef-rice-casserole/#wprm-recipe-53901-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/06/Creamy-Beef-Rice-Casserole-6.jpg"
    },
    {
      "text": "Let this cook for 6 - 8 minutes on low to medium heat while all the juices get absorbed by the beef.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-creamy-beef-rice-casserole/#wprm-recipe-53901-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/06/Creamy-Beef-Rice-Casserole-7.jpg"
    },
    {
      "text": "Add the cheddar and mozzarella cheese on top. Cover with a lid and let cook until the cheese has melted.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-creamy-beef-rice-casserole/#wprm-recipe-53901-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/06/Creamy-Beef-Rice-Casserole-8.jpg"
    },
    {
      "text": "Serve immediately with parsley and crushed red pepper flakes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-creamy-beef-rice-casserole/#wprm-recipe-53901-step-0-8",
      "imageSource": null
    }
  ],
