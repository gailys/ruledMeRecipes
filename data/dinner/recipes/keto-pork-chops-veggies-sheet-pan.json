  "ingredients": [
    "16 ounce boneless pork chops",
    "4 tablespoon dijon mustard",
    "6 tablespoon olive oil (divided)",
    "2 teaspoon fresh garlic (minced)",
    "1 teaspoon dried rosemary",
    "1 teaspoon dried thyme",
    "1 medium lemon (zest + (juice for salad))",
    "salt and pepper (to taste)",
    "8 ounce cremini mushrooms",
    "8 ounce cherry tomatoes",
    "1 medium red onion",
    "8 ounce spring mix",
    "2 tablespoon olive oil"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all the ingredients. Preheat oven to 425F.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pork-chops-veggies-sheet-pan/#wprm-recipe-53965-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/10/Sheet-Pan-Pork-Chops-and-Veggies-1.jpg"
    },
    {
      "text": "Line a baking sheet with parchment paper.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pork-chops-veggies-sheet-pan/#wprm-recipe-53965-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/10/Sheet-Pan-Pork-Chops-and-Veggies-2.jpg"
    },
    {
      "text": "Put the pork chops, mushrooms, cherry tomatoes, and red onion on top of the parchment paper lined baking sheet. Slice a lemon and add lemon slices. Season with salt and pepper to taste.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pork-chops-veggies-sheet-pan/#wprm-recipe-53965-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/10/Sheet-Pan-Pork-Chops-and-Veggies-3.jpg"
    },
    {
      "text": "In a glass bowl, add olive oil, dijon mustard, minced garlic, rosemary, thyme, and lemon zest. Stir this together well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pork-chops-veggies-sheet-pan/#wprm-recipe-53965-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/10/Sheet-Pan-Pork-Chops-and-Veggies-4.jpg"
    },
    {
      "text": "Using a brush, brush this mixture on top of the pork chops (both sides) and sprinkle the rest of the vegetables with this.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pork-chops-veggies-sheet-pan/#wprm-recipe-53965-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/10/Sheet-Pan-Pork-Chops-and-Veggies-5.jpg"
    },
    {
      "text": "Bake this in the oven for 40 minutes or until pork chops are 165F internal temperature.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pork-chops-veggies-sheet-pan/#wprm-recipe-53965-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/10/Sheet-Pan-Pork-Chops-and-Veggies-6.jpg"
    },
    {
      "text": "Mix lemon juice with olive oil (+ any pan drippings).",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pork-chops-veggies-sheet-pan/#wprm-recipe-53965-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/10/Sheet-Pan-Pork-Chops-and-Veggies-7.jpg"
    },
    {
      "text": "Toss the spring mix with the lemon juice and olive oil.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pork-chops-veggies-sheet-pan/#wprm-recipe-53965-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/10/Sheet-Pan-Pork-Chops-and-Veggies-8.jpg"
    },
    {
      "text": "Serve the pork chops and veggies with the side of spring mix. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pork-chops-veggies-sheet-pan/#wprm-recipe-53965-step-0-8",
      "imageSource": null
    }
  ],
