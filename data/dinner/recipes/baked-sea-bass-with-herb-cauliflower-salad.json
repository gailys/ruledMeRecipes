  "ingredients": [
    "1/3 cup fresh parsley",
    "1/3 cup fresh mint",
    "10 ounce whole sea bass (cleaned and scaled)",
    "3 tablespoon olive oil",
    "salt and pepper (to taste)",
    "2 medium lemon",
    "1/3 cup green olive",
    "1 cup cauliflower (grated)"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 400F.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/baked-sea-bass-with-herb-cauliflower-salad/#wprm-recipe-52229-step-0-0",
      "imageSource": null
    },
    {
      "text": "Finely chop the parsley and mint. Place the sea bass on a baking dish lined with parchment paper and rub with one-third of the extra virgin olive oil. Season with salt and pepper. Thinly slice half of the lemons and stuff the slices into the sea bass with a small amount of the fresh herbs. Bake in the oven for 15 minutes, or until the thickest part of the fish is cooked.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/baked-sea-bass-with-herb-cauliflower-salad/#wprm-recipe-52229-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/06/baked-sea-bass-01.jpg"
    },
    {
      "text": "Meanwhile, finely chop the olives. Zest and juice the remaining lemon.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/baked-sea-bass-with-herb-cauliflower-salad/#wprm-recipe-52229-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/06/baked-sea-bass-03.jpg"
    },
    {
      "text": "In a large bowl, mix together the grated cauliflower, herbs, olives, lemon zest, lemon juice, and remaining olive oil. Season with salt and pepper to taste.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/baked-sea-bass-with-herb-cauliflower-salad/#wprm-recipe-52229-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/06/baked-sea-bass-04.jpg"
    },
    {
      "text": "Remove the sea bass from the oven when cooked and serve with the herbed cauliflower salad.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/baked-sea-bass-with-herb-cauliflower-salad/#wprm-recipe-52229-step-0-4",
      "imageSource": null
    }
