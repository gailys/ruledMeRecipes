  "ingredients": [
    "8 ounce ground beef",
    "1 teaspoon salt",
    "1/2 teaspoon black pepper",
    "1 teaspoon cajun seasoning",
    "1 ounce mozzarella cheese",
    "2 ounce cheddar cheese",
    "1 tablespoon butter (per burger)",
    "2 slice cooked bacon"
  ],
  "instructions": [
    {
      "text": "Season the ground beef with the salt, pepper, and cajun seasoning. Mix together lightly until combined.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cheese-stuffed-bacon-cheeseburger/#wprm-recipe-51713-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/06/img_4449.jpg"
    },
    {
      "text": "Prepare the cheese by cubing the mozzarella and slicing the cheddar.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cheese-stuffed-bacon-cheeseburger/#wprm-recipe-51713-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/06/img_4460.jpg"
    },
    {
      "text": "Form the ground beef into rough patties and place the mozzarella inside, enclosing the cheese within the beef.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cheese-stuffed-bacon-cheeseburger/#wprm-recipe-51713-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/06/img_4462.jpg"
    },
    {
      "text": "Heat the butter in a pan, and wait until it's bubbling and hot. Add the burger to the pan.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cheese-stuffed-bacon-cheeseburger/#wprm-recipe-51713-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/06/img_4469.jpg"
    },
    {
      "text": "Cover with a cloche and let cook for 5–6 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cheese-stuffed-bacon-cheeseburger/#wprm-recipe-51713-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/06/img_4474.jpg"
    },
    {
      "text": "Flip the burger and place the cheddar cheese on top. Cover again and let cook until the desired temperature is reached (about 3–4 more minutes).",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cheese-stuffed-bacon-cheeseburger/#wprm-recipe-51713-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/06/img_4479.jpg"
    },
    {
      "text": "Chop the bacon in half and place it on top of the burger. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cheese-stuffed-bacon-cheeseburger/#wprm-recipe-51713-step-0-6",
      "imageSource": null
    }
  ],
