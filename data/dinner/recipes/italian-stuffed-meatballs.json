  "ingredients": [
    "24 ounce ground beef (80/20)",
    "1 teaspoon dried oregano",
    "1/2 teaspoon italian seasoning",
    "salt and pepper (to taste)",
    "2 teaspoon fresh garlic (minced)",
    "1/2 teaspoon onion powder",
    "2 large egg",
    "3 tablespoon tomato paste",
    "3 tablespoon flaxseed meal",
    "1 teaspoon worcestershire sauce",
    "1/2 cup green olive (sliced)",
    "1/2 cup mozzarella cheese",
    "4 cup spinach"
  ],
  "instructions": [
    {
      "text": "Combine the ground beef, oregano, Italian seasoning, salt and pepper, garlic, and onion powder in a mixing bowl. Mix together well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/italian-stuffed-meatballs/#wprm-recipe-51459-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/11/img_8499.jpg"
    },
    {
      "text": "Add the eggs, tomato paste, flaxseed, and Worcestershire sauce to the meat and mix well to combine.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/italian-stuffed-meatballs/#wprm-recipe-51459-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/11/img_8509.jpg"
    },
    {
      "text": "Finally, dice the olives and add them to the meat along with shredded mozzarella cheese. Season and mix everything together well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/italian-stuffed-meatballs/#wprm-recipe-51459-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/11/img_8511.jpg"
    },
    {
      "text": "Preheat oven to 400F. Meanwhile, form the meat mixture into balls by hand (about the size of a golf ball). Place them on a foil-lined cookie sheet.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/italian-stuffed-meatballs/#wprm-recipe-51459-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/11/img_8517.jpg"
    },
    {
      "text": "Bake for 16–20 minutes or until the desired doneness is reached.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/italian-stuffed-meatballs/#wprm-recipe-51459-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/11/img_8528.jpg"
    },
    {
      "text": "Serve with a simple spinach salad underneath, drizzling the excess fat from the cookie sheet on top.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/italian-stuffed-meatballs/#wprm-recipe-51459-step-0-5",
      "imageSource": null
    }
  ],
