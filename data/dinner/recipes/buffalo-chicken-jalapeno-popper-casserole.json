  "ingredients": [
    "32 ounce boneless, skinless chicken thighs",
    "salt and pepper (to taste)",
    "6 ounce bacon",
    "3 medium jalapeno pepper (sliced and optionally deseeded)",
    "12 ounce cream cheese",
    "1/4 cup mayonnaise",
    "1/4 cup hot sauce",
    "4 ounce cheddar cheese (shredded)",
    "2 ounce mozzarella cheese (shredded)"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 400F. Debone the chicken thighs and season well with salt and pepper. Place on a cooling rack over a foil-lined baking sheet and bake for 40 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/buffalo-chicken-jalapeno-popper-casserole/#wprm-recipe-51523-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/12/img_0957.jpg"
    },
    {
      "text": "After about 20 minutes, start preparing the filling. Chop the bacon into pieces and add them to a pan over medium heat.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/buffalo-chicken-jalapeno-popper-casserole/#wprm-recipe-51523-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/12/img_0969.jpg"
    },
    {
      "text": "Once the bacon is mostly crisped, add the jalapeños to the pan and let them cook down.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/buffalo-chicken-jalapeno-popper-casserole/#wprm-recipe-51523-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/12/img_0981.jpg"
    },
    {
      "text": "Once the jalapeños are soft and cooked, add the cream cheese, mayo, and hot sauce to the pan. Mix to combine and season to taste.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/buffalo-chicken-jalapeno-popper-casserole/#wprm-recipe-51523-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/12/img_0991.jpg"
    },
    {
      "text": "Remove the chicken from the oven and let cool slightly. Once cooled, remove the skins from the chicken.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/buffalo-chicken-jalapeno-popper-casserole/#wprm-recipe-51523-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/12/img_0994.jpg"
    },
    {
      "text": "Transfer the thighs to the bottom of a casserole dish. Spread the cream cheese mixture over them and top with the shredded cheddar and mozzarella cheeses.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/buffalo-chicken-jalapeno-popper-casserole/#wprm-recipe-51523-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/12/img_0996.jpg"
    },
    {
      "text": "Bake for 10–15 minutes. Broil for an additional 3–5 minutes to finish. Remove from the oven and let cool for about 5 minutes before serving.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/buffalo-chicken-jalapeno-popper-casserole/#wprm-recipe-51523-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/12/img_1007.jpg"
    },
    {
      "text": "Slice, serve, and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/buffalo-chicken-jalapeno-popper-casserole/#wprm-recipe-51523-step-0-7",
      "imageSource": null
    }
  ],
