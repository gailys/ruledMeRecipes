  "ingredients": [
    "32 ounce bone-in, skin-on chicken thighs (deboned)",
    "salt and pepper (to taste)",
    "1 tablespoon olive oil",
    "3 medium jalapeno pepper (diced)",
    "2 teaspoon fresh garlic (minced)",
    "3 cup chicken broth",
    "1 teaspoon onion powder",
    "1 teaspoon ground coriander",
    "1 teaspoon cajun seasoning",
    "6 ounce cream cheese",
    "4 ounce cheddar cheese",
    "4 ounce bacon (for garnish)"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 400F. Debone the chicken thighs (reserving the bones), and season on both sides with salt and pepper to taste. Place them on a cooling rack that is placed over a baking sheet lined with foil.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/jalapeno-popper-soup/#wprm-recipe-51499-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/11/img_9060.jpg"
    },
    {
      "text": "Bake the thighs for 50–55 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/jalapeno-popper-soup/#wprm-recipe-51499-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/11/img_9069.jpg"
    },
    {
      "text": "Meanwhile, heat the olive oil in a pot over medium-high heat. Once hot, add the reserved chicken bones to the pot and fry for 5–10 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/jalapeno-popper-soup/#wprm-recipe-51499-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/11/img_9077.jpg"
    },
    {
      "text": "Add the diced jalapeño peppers and garlic to the mixture. Let cook for 3–4 minutes or until soft.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/jalapeno-popper-soup/#wprm-recipe-51499-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/11/img_9080.jpg"
    },
    {
      "text": "Add the broth and spices to the mixture and stir to deglaze the pan. Once boiling, reduce heat to simmer until the chicken thighs are ready to remove from the oven.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/jalapeno-popper-soup/#wprm-recipe-51499-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/11/img_9084.jpg"
    },
    {
      "text": "Once the thighs are cooked, remove the crispy chicken skins and set them aside for later. Discard the bones from the broth.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/jalapeno-popper-soup/#wprm-recipe-51499-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/11/img_9095.jpg"
    },
    {
      "text": "Add any excess chicken fat to the pot. Using an immersion blender, puree the jalapeños and garlic into the broth. Shred the chicken meat and add it to the pot. Let this simmer for 10–15 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/jalapeno-popper-soup/#wprm-recipe-51499-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/11/img_9102.jpg"
    },
    {
      "text": "Add the cream cheese and cheddar cheese to the soup and stir while simmering for 5 minutes, or until all the cheese has melted and is well incorporated.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/jalapeno-popper-soup/#wprm-recipe-51499-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/11/img_9110.jpg"
    },
    {
      "text": "Slice up the bacon and cook over medium-high heat until crisp. Let rest on paper towels for a few minutes to crisp up.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/jalapeno-popper-soup/#wprm-recipe-51499-step-0-8",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/11/img_9119.jpg"
    },
    {
      "text": "Garnish the soup with pieces of bacon. Serve with the crispy chicken skins on the side.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/jalapeno-popper-soup/#wprm-recipe-51499-step-0-9",
      "imageSource": null
    }
  ],
