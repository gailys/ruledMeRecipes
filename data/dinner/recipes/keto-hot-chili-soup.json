  "ingredients": [
    "16 ounce boneless, skinless chicken thighs",
    "salt and pepper (to taste)",
    "2 tablespoon olive oil",
    "1 teaspoon ground coriander",
    "2 medium bird's eye chile pepper (sliced)",
    "2 cup chicken broth",
    "2 cup water",
    "1 teaspoon turmeric powder",
    "1/2 teaspoon cumin",
    "4 tablespoon tomato paste",
    "2 tablespoon butter",
    "1 tablespoon lime juice",
    "1 medium avocado (sliced)",
    "2 ounce queso fresco (crumbled)",
    "4 tablespoon fresh cilantro (chopped)"
  ],
  "instructions": [
    {
      "text": "Cut the chicken thighs into bite-sized pieces and heat them in an oiled pan. Season with salt and pepper, cook, and set aside for later.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-hot-chili-soup/#wprm-recipe-51883-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/02/01Cook-chicken.jpg"
    },
    {
      "text": "Heat up the olive oil in a separate pan. Lightly toast the coriander seeds to release more of their flavor and aroma.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-hot-chili-soup/#wprm-recipe-51883-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/02/02Cook-coriander-seeds.jpg"
    },
    {
      "text": "Once fragrant, add in the sliced chile peppers to infuse their flavor into the oil.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-hot-chili-soup/#wprm-recipe-51883-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/02/03Cook-chilis.jpg"
    },
    {
      "text": "Add broth and water and bring to a simmer. Season with turmeric, ground cumin, and salt and pepper to taste.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-hot-chili-soup/#wprm-recipe-51883-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/02/04Season-the-soup.jpg"
    },
    {
      "text": "Once simmering, add the tomato paste and butter and stir until melted and combined. Let simmer for about 5–10 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-hot-chili-soup/#wprm-recipe-51883-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/02/05Add-tomato-paste.jpg"
    },
    {
      "text": "Reduce the heat and add the lime juice.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-hot-chili-soup/#wprm-recipe-51883-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/02/06Add-lime-juice.jpg"
    },
    {
      "text": "Serve by placing individual portions of chicken in the bottom of each bowl.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-hot-chili-soup/#wprm-recipe-51883-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/02/07Add-chicken.jpg"
    },
    {
      "text": "Ladle the soup over the chicken. Garnish with avocado, queso fresco, and cilantro.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-hot-chili-soup/#wprm-recipe-51883-step-0-7",
      "imageSource": null
    }
  ],
