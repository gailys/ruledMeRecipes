  "instructions": [
    {
      "text": "Measure out and prepare all the ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/italian-chicken-skillet/#wprm-recipe-53781-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/03/Italian-Chicken-Skillet-1.jpg"
    },
    {
      "text": "In a skillet over medium to high heat, add the avocado oil, chicken, and salt and pepper. Fry until done.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/italian-chicken-skillet/#wprm-recipe-53781-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/03/Italian-Chicken-Skillet-2.jpg"
    },
    {
      "text": "Add in the broccoli florets, cook for 3-5 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/italian-chicken-skillet/#wprm-recipe-53781-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/03/Italian-Chicken-Skillet-3.jpg"
    },
    {
      "text": "The, add in the spinach and cook for another 2-3 minutes until the spinach gets hot and starts to wilt.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/italian-chicken-skillet/#wprm-recipe-53781-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/03/Italian-Chicken-Skillet-4.jpg"
    },
    {
      "text": "Add the cherry tomatoes with the Italian dressing and cook until tomatoes are hot.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/italian-chicken-skillet/#wprm-recipe-53781-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/03/Italian-Chicken-Skillet-5.jpg"
    },
    {
      "text": "Serve and enjoy!",
      "group": "",
