  "ingredients": [
    "3 tablespoon avocado oil",
    "12 ounce boneless, skinless chicken thighs (diced)",
    "salt and pepper (to taste)",
    "280 gram broccoli (florets)",
    "2 ounce baby spinach",
    "6 tablespoon italian dressing",
    "3 ounce cherry tomatoes"
