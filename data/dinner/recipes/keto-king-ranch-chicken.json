    "recipeInstructions": [
      {
        "@type": "HowToStep",
        "text": "Cut up chicken into bite sized pieces if using raw. Dice onion and bell pepper.",
        "name": "Cut up chicken into bite sized pieces if using raw. Dice onion and bell pepper.",
        "url": "https://www.ruled.me/keto-king-ranch-chicken/#wprm-recipe-50565-step-0-0",
        "image": "https://www.ruled.me/wp-content/uploads/2013/12/King-Ranch-Chicken-1.jpg"
      },
      {
        "@type": "HowToStep",
        "text": "If you are using raw chicken, melt 1 Tbs of the butter or coconut oil in a pan and cook the chicken until done.",
