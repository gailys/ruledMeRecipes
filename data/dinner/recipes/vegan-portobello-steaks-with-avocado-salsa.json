  "ingredients": [
    "2 tablespoon avocado oil",
    "1 tablespoon coconut aminos",
    "1 teaspoon liquid smoke",
    "2 teaspoon fresh garlic (minced)",
    "1/2 teaspoon cumin",
    "1 teaspoon balsamic vinegar",
    "2 large portobello mushrooms",
    "1 medium avocado (diced)",
    "1 medium fresh tomatoes (diced)",
    "1/2 cup fresh parsley (finely minced)",
    "2 tablespoon hemp hearts",
    "salt and pepper (to taste)"
  ],
  "instructions": [
    {
      "text": "In a small dish, whisk together the marinade ingredients then set aside.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/vegan-portobello-steaks-with-avocado-salsa/#wprm-recipe-52970-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/03/vegan-portobello-steaks-01.jpg"
    },
    {
      "text": "Clean and trim the portobello mushrooms. Remove any dirt with a soft towel. Trim the stem if desired.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/vegan-portobello-steaks-with-avocado-salsa/#wprm-recipe-52970-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/03/vegan-portobello-steaks-02.jpg"
    },
    {
      "text": "In a shallow dish, saturate the mushrooms with the marinade and toss a few times to coat. Let them sit for at least five minutes, turning occasionally to absorb the sauce.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/vegan-portobello-steaks-with-avocado-salsa/#wprm-recipe-52970-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/03/vegan-portobello-steaks-03.jpg"
    },
    {
      "text": "Combine the diced avocado, tomato, and finely minced parsley in a small bowl. Sprinkle with salt and half of the hemp seeds. Toss to coat.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/vegan-portobello-steaks-with-avocado-salsa/#wprm-recipe-52970-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/03/vegan-portobello-steaks-04.jpg"
    },
    {
      "text": "Preheat a dark-coated or cast-iron skillet over medium-high heat. Pan sear the seasoned mushrooms until each side browns and the mushrooms begin to soften.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/vegan-portobello-steaks-with-avocado-salsa/#wprm-recipe-52970-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/03/vegan-portobello-steaks-05.jpg"
    },
    {
      "text": "Top each mushroom with avocado salsa and remaining hemp seeds. Serve hot.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/vegan-portobello-steaks-with-avocado-salsa/#wprm-recipe-52970-step-0-5",
      "imageSource": null
