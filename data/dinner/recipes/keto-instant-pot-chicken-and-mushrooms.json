  "ingredients": [
    "4 tablespoon butter",
    "10 ounce mushrooms (quartered)",
    "3 teaspoon fresh garlic (minced)",
    "1/2 teaspoon dried thyme",
    "salt and pepper (to taste)",
    "24 ounce boneless, skinless chicken thighs (cut into bite sized pieces)",
    "1/4 cup chicken broth",
    "1/2 cup heavy cream",
    "1 tablespoon dijon mustard",
    "1/4 teaspoon xanthan gum"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all of the ingredients. Turn the Instant Pot on and to saute mode.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-instant-pot-chicken-and-mushrooms/#wprm-recipe-54527-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/01/Instant-Pot-Chicken-and-Mushrooms-1.jpg"
    },
    {
      "text": "Add butter and let it melt. Add in the minced garlic and mushrooms. Stir until the mushrooms get tender. Add in the dried thyme, salt, and pepper.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-instant-pot-chicken-and-mushrooms/#wprm-recipe-54527-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/01/Instant-Pot-Chicken-and-Mushrooms-2.jpg"
    },
    {
      "text": "Place the diced chicken into the Instant Pot and season with salt and pepper. Add in the chicken broth and place the lid onto the Instant Pot. Set to manual function and cook for 5 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-instant-pot-chicken-and-mushrooms/#wprm-recipe-54527-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/01/Instant-Pot-Chicken-and-Mushrooms-3.jpg"
    },
    {
      "text": "Release naturally once done cooking. Take the chicken out of the Instant Pot and set aside, leaving the mushrooms in.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-instant-pot-chicken-and-mushrooms/#wprm-recipe-54527-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/01/Instant-Pot-Chicken-and-Mushrooms-4.jpg"
    },
    {
      "text": "Add in the heavy cream and dijon mustard. Stir together until combined well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-instant-pot-chicken-and-mushrooms/#wprm-recipe-54527-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/01/Instant-Pot-Chicken-and-Mushrooms-5.jpg"
    },
    {
      "text": "Let cook on sautee mode until the consistency gets thicker.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-instant-pot-chicken-and-mushrooms/#wprm-recipe-54527-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/01/5e6e4899e28ebf76944b46f4cf94abf6.jpg"
    },
    {
      "text": "Take a bowl and remove around half of the liquid.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-instant-pot-chicken-and-mushrooms/#wprm-recipe-54527-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/01/Instant-Pot-Chicken-and-Mushrooms-7.jpg"
    },
    {
      "text": "Stir the xanthan gum into the Instant Pot. Then add the liquid back into the pot. This will help to get the consistency thick. Add the chicken back into the pot once the consistency is thick.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-instant-pot-chicken-and-mushrooms/#wprm-recipe-54527-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/01/c4867962197e02e0fc351bbcef6924da.jpg"
    },
    {
      "text": "Serve and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-instant-pot-chicken-and-mushrooms/#wprm-recipe-54527-step-0-8",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/01/1e23e92cd8e18d89e8c2a7ad223bfd34.jpg"
    }
  ],
