  "rawRecipe": {
    "@type": "Recipe",
    "name": "Cheddar and Bacon BBQ Meatballs",
    "author": {
      "@type": "Person",
      "name": "Craig Clarke",
      "url": "https://www.ruled.me/about-us/#craig-clarke"
    },
    "description": "This makes a total of 4 servings of Cheddar and Bacon BBQ Meatballs. Each serving comes out to be 528 calories, 34.4g fats, 1.8g net carbs, and 49.5g protein.",
    "datePublished": "2013-12-05T13:06:27+00:00",
    "image": [
      "https://www.ruled.me/wp-content/uploads/2013/12/cheddar_and_bacon_bbq_meatballs-featured.jpg"
    ],
    "recipeYield": [
      "4",
      "4 servings"
    ],
    "prepTime": "PT15M",
    "cookTime": "PT30M",
    "totalTime": "PT45M",
    "recipeIngredient": [
      "3/4 cup pork rinds",
      "24 ounce ground beef (93/7)",
      "1 large egg",
      "3/4 teaspoon salt",
      "3/4 teaspoon black pepper",
      "3/4 teaspoon cumin",
      "3/4 teaspoon garlic powder",
      "3/4 cup cheddar cheese (shredded)",
      "4 ounce bacon"
    ],
    "recipeInstructions": [
      {
        "@type": "HowToStep",
        "text": "Grab your pork rinds. Mine are BBQ flavor which works perfectly for this recipe.",
        "name": "Grab your pork rinds. Mine are BBQ flavor which works perfectly for this recipe.",
        "url": "https://www.ruled.me/cheddar-bacon-bbq-meatballs/#wprm-recipe-50473-step-0-0",
        "image": "https://www.ruled.me/wp-content/uploads/2013/12/Meatball_Trio-1-1.jpg"
      },
      {
        "@type": "HowToStep",
        "text": "Put the pork rinds into a Ziploc bag and crush them until they are relatively fine. I don’t mind leaving a few bigger pieces in there for texture.  You can also use a food processor, as shown.",
        "name": "Put the pork rinds into a Ziploc bag and crush them until they are relatively fine. I don’t mind leaving a few bigger pieces in there for texture.  You can also use a food processor, as shown.",
        "url": "https://www.ruled.me/cheddar-bacon-bbq-meatballs/#wprm-recipe-50473-step-0-1",
        "image": "https://www.ruled.me/wp-content/uploads/2013/12/Meatball_Trio-3.jpg"
      },
      {
        "@type": "HowToStep",
        "text": "In a mixing bowl, put your ground beef, egg, salt, pepper, cumin, and garlic powder.",
        "name": "In a mixing bowl, put your ground beef, egg, salt, pepper, cumin, and garlic powder.",
        "url": "https://www.ruled.me/cheddar-bacon-bbq-meatballs/#wprm-recipe-50473-step-0-2",
        "image": "https://www.ruled.me/wp-content/uploads/2013/12/cheddar_and_bacon_bbq_meatballs-1-1.jpg"
      },
      {
        "@type": "HowToStep",
        "text": "Add your pork rind crumbs. Mix together well.",
        "name": "Add your pork rind crumbs. Mix together well.",
        "url": "https://www.ruled.me/cheddar-bacon-bbq-meatballs/#wprm-recipe-50473-step-0-3",
        "image": "https://www.ruled.me/wp-content/uploads/2013/12/cheddar_and_bacon_bbq_meatballs-2.jpg"
      },
      {
        "@type": "HowToStep",
        "text": "Make a small hole in the meat and add your cheese.",
        "name": "Make a small hole in the meat and add your cheese.",
        "url": "https://www.ruled.me/cheddar-bacon-bbq-meatballs/#wprm-recipe-50473-step-0-4",
        "image": "https://www.ruled.me/wp-content/uploads/2013/12/cheddar_and_bacon_bbq_meatballs-3.jpg"
      },
      {
        "@type": "HowToStep",
        "text": "Mix these all together well.",
        "name": "Mix these all together well.",
        "url": "https://www.ruled.me/cheddar-bacon-bbq-meatballs/#wprm-recipe-50473-step-0-5",
        "image": "https://www.ruled.me/wp-content/uploads/2013/12/cheddar_and_bacon_bbq_meatballs-4.jpg"
      },
      {
        "@type": "HowToStep",
        "text": "Cut your bacon into thin strips. Easiest way is to use a pair of scissors. If you plan to use a knife, put your bacon in the freezer for 20 minutes prior to cutting it.",
        "name": "Cut your bacon into thin strips. Easiest way is to use a pair of scissors. If you plan to use a knife, put your bacon in the freezer for 20 minutes prior to cutting it.",
        "url": "https://www.ruled.me/cheddar-bacon-bbq-meatballs/#wprm-recipe-50473-step-0-6",
        "image": "https://www.ruled.me/wp-content/uploads/2013/12/cheddar_and_bacon_bbq_meatballs-4a.jpg"
      },
      {
        "@type": "HowToStep",
        "text": "Add your bacon to a hot pan and let it fry up.",
        "name": "Add your bacon to a hot pan and let it fry up.",
        "url": "https://www.ruled.me/cheddar-bacon-bbq-meatballs/#wprm-recipe-50473-step-0-7",
        "image": "https://www.ruled.me/wp-content/uploads/2013/12/cheddar_and_bacon_bbq_meatballs-4b.jpg"
      },
      {
        "@type": "HowToStep",
        "text": "Keep cooking your bacon until it reaches a crisp point.",
        "name": "Keep cooking your bacon until it reaches a crisp point.",
        "url": "https://www.ruled.me/cheddar-bacon-bbq-meatballs/#wprm-recipe-50473-step-0-8",
        "image": "https://www.ruled.me/wp-content/uploads/2013/12/cheddar_and_bacon_bbq_meatballs-4d.jpg"
      },
      {
        "@type": "HowToStep",
        "text": "Remove your bacon and place on a paper towel to dry and crisp up. Keep the pan with the bacon fat in it – we will be using it to cook the meatballs!",
        "name": "Remove your bacon and place on a paper towel to dry and crisp up. Keep the pan with the bacon fat in it – we will be using it to cook the meatballs!",
        "url": "https://www.ruled.me/cheddar-bacon-bbq-meatballs/#wprm-recipe-50473-step-0-9",
        "image": "https://www.ruled.me/wp-content/uploads/2013/12/cheddar_and_bacon_bbq_meatballs-4e.jpg"
      },
      {
        "@type": "HowToStep",
        "text": "Once your bacon has cooled off a bit, add it to the meat mixture and mix well. Roll out into meatballs and reserve beside your stove.",
        "name": "Once your bacon has cooled off a bit, add it to the meat mixture and mix well. Roll out into meatballs and reserve beside your stove.",
        "url": "https://www.ruled.me/cheddar-bacon-bbq-meatballs/#wprm-recipe-50473-step-0-10",
        "image": "https://www.ruled.me/wp-content/uploads/2013/12/cheddar_and_bacon_bbq_meatballs-5.jpg"
      },
      {
        "@type": "HowToStep",
        "text": "Once all the meatballs are rolled out, add enough to a hot pan to cook without crowding each other. I don’t like cooking them all at once because they don’t turn out as well.",
        "name": "Once all the meatballs are rolled out, add enough to a hot pan to cook without crowding each other. I don’t like cooking them all at once because they don’t turn out as well.",
        "url": "https://www.ruled.me/cheddar-bacon-bbq-meatballs/#wprm-recipe-50473-step-0-11",
        "image": "https://www.ruled.me/wp-content/uploads/2013/12/cheddar_and_bacon_bbq_meatballs-10.jpg"
      },
      {
        "@type": "HowToStep",
        "text": "Let them brown on one side and then flip them over.",
        "name": "Let them brown on one side and then flip them over.",
        "url": "https://www.ruled.me/cheddar-bacon-bbq-meatballs/#wprm-recipe-50473-step-0-12",
        "image": "https://www.ruled.me/wp-content/uploads/2013/12/cheddar_and_bacon_bbq_meatballs-8.jpg"
      },
      {
        "@type": "HowToStep",
        "text": "Allow them to keep cooking, turning them on their other sides as needed. Remove them from the pan when they are rare (still semi-raw in the middle).",
        "name": "Allow them to keep cooking, turning them on their other sides as needed. Remove them from the pan when they are rare (still semi-raw in the middle).",
        "url": "https://www.ruled.me/cheddar-bacon-bbq-meatballs/#wprm-recipe-50473-step-0-13",
        "image": "https://www.ruled.me/wp-content/uploads/2013/12/cheddar_and_bacon_bbq_meatballs-9.jpg"
      },
      {
        "@type": "HowToStep",
        "text": "Cook the remaining meatballs. Once they are at a rare state, add all the meatballs to the pan.",
        "name": "Cook the remaining meatballs. Once they are at a rare state, add all the meatballs to the pan.",
        "url": "https://www.ruled.me/cheddar-bacon-bbq-meatballs/#wprm-recipe-50473-step-0-14",
        "image": "https://www.ruled.me/wp-content/uploads/2013/12/cheddar_and_bacon_bbq_meatballs-12.jpg"
      },
      {
        "@type": "HowToStep",
        "text": "Turn down the heat to low and cover the pan with a lid. Let these cook until they are to desired wellness. I usually let them cook while I am making the BBQ sauce. By the time I’m done, they’re also done.",
        "name": "Turn down the heat to low and cover the pan with a lid. Let these cook until they are to desired wellness. I usually let them cook while I am making the BBQ sauce. By the time I’m done, they’re also done.",
        "url": "https://www.ruled.me/cheddar-bacon-bbq-meatballs/#wprm-recipe-50473-step-0-15",
        "image": "https://www.ruled.me/wp-content/uploads/2013/12/cheddar_and_bacon_bbq_meatballs-11.jpg"
      },
      {
        "@type": "HowToStep",
        "text": "Remove the meatballs from the pan and let them rest for about 5 minutes.",
        "name": "Remove the meatballs from the pan and let them rest for about 5 minutes.",
        "url": "https://www.ruled.me/cheddar-bacon-bbq-meatballs/#wprm-recipe-50473-step-0-16",
        "image": "https://www.ruled.me/wp-content/uploads/2013/12/cheddar_and_bacon_bbq_meatballs-13.jpg"
      },
      {
        "@type": "HowToStep",
        "text": "Serve them out, usually 4-5 meatballs per person.",
        "name": "Serve them out, usually 4-5 meatballs per person.",
        "url": "https://www.ruled.me/cheddar-bacon-bbq-meatballs/#wprm-recipe-50473-step-0-17",
        "image": "https://www.ruled.me/wp-content/uploads/2013/12/cheddar_and_bacon_bbq_meatballs-17.jpg"
      },
      {
        "@type": "HowToStep",
        "text": "Apply your low-carb BBQ sauce on the top. This is to preference!",
        "name": "Apply your low-carb BBQ sauce on the top. This is to preference!",
        "url": "https://www.ruled.me/cheddar-bacon-bbq-meatballs/#wprm-recipe-50473-step-0-18"
      }
    ],
