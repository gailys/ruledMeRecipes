  "ingredients": [
    "16 ounce cauliflower rice",
    "24 ounce ground beef (80/20)",
    "15 ounce green enchilada sauce",
    "1/2 cup sour cream",
    "1 1/4 cup cottage cheese",
    "2 cup cheddar cheese (shredded)",
    "1/2 cup green onion (sliced)",
    "1 teaspoon salt",
    "1 teaspoon black pepper"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 350F. Place the cauliflower rice in a microwaveable bowl, then cook for 4-5 minutes until it is softened.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-beef-casserole/#wprm-recipe-52465-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/01/creamy-beef-casserole-01.jpg"
    },
    {
      "text": "Brown the beef over medium-high heat, scrambling it as you cook. Pour in the green enchilada sauce, then season with the salt and pepper.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-beef-casserole/#wprm-recipe-52465-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/01/creamy-beef-casserole-03.jpg"
    },
    {
      "text": "Add the sour cream, cottage cheese, and green onions to the bowl with the cauliflower. Mix together very well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-beef-casserole/#wprm-recipe-52465-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/01/creamy-beef-casserole-04.jpg"
    },
    {
      "text": "Put the cauliflower mixture into a casserole dish and spread out in an even layer.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-beef-casserole/#wprm-recipe-52465-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/01/creamy-beef-casserole-05.jpg"
    },
    {
      "text": "Top the cauliflower with half of the beef mixture.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-beef-casserole/#wprm-recipe-52465-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/01/creamy-beef-casserole-06.jpg"
    },
    {
      "text": "Sprinkle on half of the shredded cheddar cheese.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-beef-casserole/#wprm-recipe-52465-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/01/creamy-beef-casserole-07.jpg"
    },
    {
      "text": "Create another layer with the remaining beef and another layer with the remaining cheddar cheese.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-beef-casserole/#wprm-recipe-52465-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/01/creamy-beef-casserole-08.jpg"
    },
    {
      "text": "Bake for 20 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-beef-casserole/#wprm-recipe-52465-step-0-7",
      "imageSource": null
    }
  ],
