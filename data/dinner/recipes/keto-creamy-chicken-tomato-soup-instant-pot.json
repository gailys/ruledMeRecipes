  "ingredients": [
    "4 tablespoon butter",
    "1/2 medium onion (chopped)",
    "3 teaspoon fresh garlic (minced)",
    "2 teaspoon dried oregano",
    "salt and pepper (to taste)",
    "14 ounce boneless, skinless chicken breast",
    "2 cup chicken broth",
    "28 ounce canned whole tomatoes",
    "1 medium red bell pepper (roughly chopped)",
    "3/4 cup heavy cream",
    "1/4 cup fresh basil (chopped)"
  ],
  "instructions": [
    {
      "text": "Gather and prep all ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-creamy-chicken-tomato-soup-instant-pot/#wprm-recipe-54805-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/08/Keto-Creamy-Chicken-Tomato-Soup-Instant-Pot-1.jpg"
    },
    {
      "text": "Turn Instant Pot to the \"saute\" function and allow it to heat up. Once hot, add butter, onion, garlic, red bell pepper, oregano, and salt and pepper to taste.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-creamy-chicken-tomato-soup-instant-pot/#wprm-recipe-54805-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/08/Keto-Creamy-Chicken-Tomato-Soup-Instant-Pot-2.jpg"
    },
    {
      "text": "Saute for a few minutes or until the onion is softened, then add in the chicken stock, canned tomatoes, and chicken breast. Put the lid on and cook using 'High Pressure' for 10 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-creamy-chicken-tomato-soup-instant-pot/#wprm-recipe-54805-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/08/Keto-Creamy-Chicken-Tomato-Soup-Instant-Pot-3.jpg"
    },
    {
      "text": "Once finished, allow the Instant Pot to naturally depressurize. Remove the chicken breast from the pot, shred, and set aside.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-creamy-chicken-tomato-soup-instant-pot/#wprm-recipe-54805-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/08/Keto-Creamy-Chicken-Tomato-Soup-Instant-Pot-4.jpg"
    },
    {
      "text": "Using an immersion blender, blend together the soup until smooth.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-creamy-chicken-tomato-soup-instant-pot/#wprm-recipe-54805-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/08/Keto-Creamy-Chicken-Tomato-Soup-Instant-Pot-5.jpg"
    },
    {
      "text": "Add heavy cream to the soup and stir well to mix.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-creamy-chicken-tomato-soup-instant-pot/#wprm-recipe-54805-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/08/Keto-Creamy-Chicken-Tomato-Soup-Instant-Pot-6.jpg"
    },
    {
      "text": "Add the shredded chicken back into the soup and allow the chicken to soak up the flavor for a few minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-creamy-chicken-tomato-soup-instant-pot/#wprm-recipe-54805-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/08/Keto-Creamy-Chicken-Tomato-Soup-Instant-Pot-7.jpg"
    },
    {
      "text": "Serve with fresh basil sprinkled over the top. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-creamy-chicken-tomato-soup-instant-pot/#wprm-recipe-54805-step-0-7",
      "imageSource": null
    }
  ],
