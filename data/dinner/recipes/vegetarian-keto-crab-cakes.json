  "ingredients": [
    "14 ounce can hearts of palm",
    "2 tablespoon mayonnaise",
    "1 teaspoon old bay seasoning",
    "1 tablespoon fresh parsley (chopped)",
    "1/4 cup almond flour",
    "salt and pepper (to taste)",
    "1 large egg (beaten)",
    "1 teaspoon butter",
    "1/4 medium onion (diced)",
    "3 tablespoon almond flour",
    "2 tablespoon grated parmesan cheese",
    "4 tablespoon avocado oil"
  ],
  "instructions": [
    {
      "text": "Drain the hearts of palm. Using a fork, shred the pieces until they resemble crab meat.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/vegetarian-keto-crab-cakes/#wprm-recipe-52942-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/03/keto-vegetarian-crab-cakes-01.jpg"
    },
    {
      "text": "Mix in the Old Bay, mayonnaise, almond flour, beaten egg, and parsley to combine.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/vegetarian-keto-crab-cakes/#wprm-recipe-52942-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/03/keto-vegetarian-crab-cakes-02.jpg"
    },
    {
      "text": "In a skillet heat the butter over medium heat and sauté the diced onion until translucent then gently fold into the hearts of palm mixture.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/vegetarian-keto-crab-cakes/#wprm-recipe-52942-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/03/keto-vegetarian-crab-cakes-03.jpg"
    },
    {
      "text": "Place the almond meal and Parmesan cheese in a shallow dish. Mix together. Separate the mixture into six equal balls roll. Press into the mixture so that each ball is flattened into a patting and covered with the coating.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/vegetarian-keto-crab-cakes/#wprm-recipe-52942-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/03/keto-vegetarian-crab-cakes-04.jpg"
    },
    {
      "text": "Place each patty on a baking sheet, top with any remaining coating.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/vegetarian-keto-crab-cakes/#wprm-recipe-52942-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/03/keto-vegetarian-crab-cakes-05.jpg"
    },
    {
      "text": "Preheat a skillet over medium-high heat. Add the avocado oil. Fry patties in batches without overcrowding the pan, turning carefully to brown each side. Serve hot.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/vegetarian-keto-crab-cakes/#wprm-recipe-52942-step-0-5",
      "imageSource": null
    }
  ],
