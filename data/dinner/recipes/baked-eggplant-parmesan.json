  "ingredients": [
    "1 large eggplant (sliced into 8 (1/2 inch) sliced)",
    "salt (As needed)",
    "1/4 cup pork rinds (Crushed)",
    "1/2 cup grated parmesan cheese",
    "1/2 tablespoon italian seasoning",
    "1 large egg",
    "4 tablespoon butter (melted)",
    "1 cup low-carb tomato sauce",
    "1/2 cup mozzarella cheese (shredded)"
  ],
  "instructions": [
    {
      "text": "Preheat the oven to 400F. Place the eggplant rounds on a baking sheet lined with a paper towel and sprinkle both sides with salt. Let sit for at least 30 minutes to allow the moisture to release.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/baked-eggplant-parmesan/#wprm-recipe-52694-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/08/baked-eggplant-parmesan-02.jpg"
    },
    {
      "text": "Combine the ground pork rinds, parmesan cheese, and Italian seasoning in a shallow dish. Set aside.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/baked-eggplant-parmesan/#wprm-recipe-52694-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/08/baked-eggplant-parmesan-01.jpg"
    },
    {
      "text": "Beat the egg in a separate shallow dish. Set up a breading station with the pork rind mix and egg.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/baked-eggplant-parmesan/#wprm-recipe-52694-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/08/baked-eggplant-parmesan-03.jpg"
    },
    {
      "text": "Melt the butter and pour into the bottom of a 9x13 inch baking dish.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/baked-eggplant-parmesan/#wprm-recipe-52694-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/08/baked-eggplant-parmesan-04.jpg"
    },
    {
      "text": "Pat the eggplant dry, while wiping away the excess salt. Dip each slice in the beaten egg, then in the pork rind/cheese mixture, coating each side with crumbs. Place into the buttered baking dish and bake for 20 minutes. Flip the eggplant over and bake an additional 20 minutes or until golden brown.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/baked-eggplant-parmesan/#wprm-recipe-52694-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/08/baked-eggplant-parmesan-05.jpg"
    },
    {
      "text": "Top the eggplant with low-carb tomato sauce and the shredded mozzarella. Return to the oven for an additional 5 minutes or until the cheese has melted.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/baked-eggplant-parmesan/#wprm-recipe-52694-step-0-5",
      "imageSource": null
    }
  ],
