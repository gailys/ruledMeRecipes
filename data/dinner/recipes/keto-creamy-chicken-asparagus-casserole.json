  "ingredients": [
    "16 ounce boneless, skinless chicken thighs (diced)",
    "salt and pepper (to taste)",
    "2 tablespoon olive oil (divided)",
    "1/2 medium yellow onion (diced)",
    "2 teaspoon fresh garlic (minced)",
    "6 ounce cremini mushrooms (sliced)",
    "10 ounce asparagus spears (chopped into 1\" pieces)",
    "1/2 cup chicken broth",
    "1/2 cup heavy cream",
    "1/2 cup unsweetened almond milk",
    "2 ounce cream cheese (softened)",
    "1/2 cup full-fat plain greek yogurt",
    "1/2 cup gruyere cheese",
    "1/3 cup cheddar cheese"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all the ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-creamy-chicken-asparagus-casserole/#wprm-recipe-53897-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/06/Creamy-Chicken-Asparagus-Casserole-1.jpg"
    },
    {
      "text": "In a frying pan, add half the olive oil and the diced chicken to the pan. Cook the chicken until internal temperature reaches 165F then remove from pan and set aside.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-creamy-chicken-asparagus-casserole/#wprm-recipe-53897-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/06/Creamy-Chicken-Asparagus-Casserole-.jpg"
    },
    {
      "text": "Add the other half of the olive oil along with the onion and minced garlic.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-creamy-chicken-asparagus-casserole/#wprm-recipe-53897-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/06/Creamy-Chicken-Asparagus-Casserole-2.jpg"
    },
    {
      "text": "Then, add in the cremini mushrooms and asparagus pieces. Stir to combine well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-creamy-chicken-asparagus-casserole/#wprm-recipe-53897-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/06/Creamy-Chicken-Asparagus-Casserole-3.jpg"
    },
    {
      "text": "Sautee on low to medium heat for 2 - 4 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-creamy-chicken-asparagus-casserole/#wprm-recipe-53897-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/06/Creamy-Chicken-Asparagus-Casserole-4.jpg"
    },
    {
      "text": "Put the cooked chicken back into the pan with the chicken broth, heavy cream, and almond milk. Stir to combine well. Cook for 1 - 2 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-creamy-chicken-asparagus-casserole/#wprm-recipe-53897-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/06/Creamy-Chicken-Asparagus-Casserole-5.jpg"
    },
    {
      "text": "Put the cream cheese into the pan and stir to combine well. Cook for 1 minute or so.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-creamy-chicken-asparagus-casserole/#wprm-recipe-53897-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/06/Creamy-Chicken-Asparagus-Casserole-6.jpg"
    },
    {
      "text": "Remove the pan from heat.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-creamy-chicken-asparagus-casserole/#wprm-recipe-53897-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/06/Creamy-Chicken-Asparagus-Casserole-7.jpg"
    },
    {
      "text": "Add in the greek yogurt and stir well. Add in the gruyere cheese and cheddar cheese. Stir well to combine.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-creamy-chicken-asparagus-casserole/#wprm-recipe-53897-step-0-8",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/06/Creamy-Chicken-Asparagus-Casserole-8.jpg"
    },
    {
      "text": "Place in the oven to broil until the cheese has just melted.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-creamy-chicken-asparagus-casserole/#wprm-recipe-53897-step-0-9",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/06/Creamy-Chicken-Asparagus-Casserole-9.jpg"
    },
    {
      "text": "Remove from oven and serve immediately. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-creamy-chicken-asparagus-casserole/#wprm-recipe-53897-step-0-10",
      "imageSource": null
    }
  ],
