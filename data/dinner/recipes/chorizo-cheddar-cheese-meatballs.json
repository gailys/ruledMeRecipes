  "ingredients": [
    "1/3 cup pork rinds (crushed)",
    "16 ounce chorizo sausage",
    "24 ounce ground beef",
    "1 cup cheddar cheese",
    "1 teaspoon cumin",
    "1 teaspoon chili powder",
    "1 teaspoon kosher salt",
    "2 large egg",
    "1 cup low-carb tomato sauce (such as Rao's)"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 350F. Add the pork rinds to a food processor and pulse until completely crushed.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chorizo-cheddar-cheese-meatballs/#wprm-recipe-50653-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/12/Meatball_Trio-1-3.jpg"
    },
    {
      "text": "Break the chorizo sausage into small, even-sized pieces and place them in a large mixing bowl.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chorizo-cheddar-cheese-meatballs/#wprm-recipe-50653-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/12/Chorizo_and_Cheddar-01.jpg"
    },
    {
      "text": "Add in the ground beef, crushed pork rinds, and cheddar cheese.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chorizo-cheddar-cheese-meatballs/#wprm-recipe-50653-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/12/Chorizo_and_Cheddar-2.jpg"
    },
    {
      "text": "Measure out the cumin, chili powder, salt, and eggs. Add them to the ground beef mixture — this is where the fun begins.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chorizo-cheddar-cheese-meatballs/#wprm-recipe-50653-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/12/Chorizo_and_Cheddar-5.jpg"
    },
    {
      "text": "Knead everything together well by hand. It's a bit messy, but well worth it!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chorizo-cheddar-cheese-meatballs/#wprm-recipe-50653-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/12/Chorizo_and_Cheddar-6.jpg"
    },
    {
      "text": "Roll the mixture into meatballs and place them on a foil-lined baking tray. Spread the meatballs out evenly to ensure proper cooking and keep them from sticking together.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chorizo-cheddar-cheese-meatballs/#wprm-recipe-50653-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/12/Chorizo_and_Cheddar-7-1.jpg"
    },
    {
      "text": "Bake for 30–35 minutes, depending on the size of the meatballs.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chorizo-cheddar-cheese-meatballs/#wprm-recipe-50653-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/12/Chorizo_and_Cheddar-8.jpg"
    },
    {
      "text": "Let cool for about 5 minutes before removing from the tray. Serve with tomato sauce dolloped over each meatball.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chorizo-cheddar-cheese-meatballs/#wprm-recipe-50653-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/12/Chorizo_and_Cheddar-10.jpg"
    }
  ],
