  "ingredients": [
    "60 ounce beef chuck roast",
    "16 ounce deli-sliced pepperoncinis (drained, reserving the brine)",
    "1 tablespoon dried parsley",
    "1 tablespoon dried chives",
    "1 tablespoon garlic powder",
    "1 tablespoon onion powder",
    "1 tablespoon dried dill",
    "1/2 teaspoon salt",
    "1/4 teaspoon black pepper",
    "2 whole chicken bouillon cube",
    "1/2 cup butter"
  ],
  "instructions": [
    {
      "text": "Place the chuck roast into a slow cooker and set it to high.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-mississippi-roast/#wprm-recipe-52119-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/03/IMG_0362.jpg"
    },
    {
      "text": "Add the pepperoncinis on top of the roast. Pour in enough of the reserved brine to cover the bottom of the slow cooker, discarding the rest.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-mississippi-roast/#wprm-recipe-52119-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/03/IMG_0368.jpg"
    },
    {
      "text": "Add the parsley, chives, garlic powder, onion powder, dried dill, salt, and black pepper.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-mississippi-roast/#wprm-recipe-52119-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/03/IMG_0378.jpg"
    },
    {
      "text": "Add the bouillon and mix everything together.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-mississippi-roast/#wprm-recipe-52119-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/03/IMG_0406.jpg"
    },
    {
      "text": "Place the stick of butter on top of the roast. Cover the slow cooker with a lid and let cook on high for 8–10 hours.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-mississippi-roast/#wprm-recipe-52119-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/03/IMG_0409.jpg"
    },
    {
      "text": "Once the beef has cooked to the point of falling apart, shred the roast up with a fork. Serve the meat directly out of the slow cooker, or remove from the juices and save for later.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-mississippi-roast/#wprm-recipe-52119-step-0-5",
      "imageSource": null
    }
  ],
