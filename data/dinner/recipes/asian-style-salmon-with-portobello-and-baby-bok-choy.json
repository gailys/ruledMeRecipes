  "ingredients": [
    "4 small bok choy",
    "1 tablespoon ground ginger",
    "1 medium lemon (juiced and zested)",
    "20 ounce salmon",
    "2 large portobello mushrooms",
    "1 teaspoon fresh ginger (grated)",
    "1 tablespoon lemon juice",
    "1/2 teaspoon salt",
    "1/2 teaspoon black pepper",
    "1 tablespoon soy sauce",
    "1 tablespoon olive oil",
    "1 teaspoon sesame oil"
  ],
  "instructions": [
    {
      "text": "Gather all ingredients. In a small bowl, whisk all of the marinade ingredients together.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/asian-style-salmon-with-portobello-and-baby-bok-choy/#wprm-recipe-59548-step-0-0",
