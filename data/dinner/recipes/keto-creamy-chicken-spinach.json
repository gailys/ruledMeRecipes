  "ingredients": [
    "24 ounce boneless, skinless chicken thighs",
    "salt and pepper (to taste)",
    "4 tablespoon olive oil",
    "1 medium onion (sliced)",
    "1/3 cup white wine",
    "16 ounce spinach (trimmed)",
    "6 ounce cremini mushrooms (sliced)",
    "1/4 cup sour cream",
    "3 ounce cream cheese",
    "4 tablespoon heavy cream"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all the ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-creamy-chicken-spinach/#wprm-recipe-53889-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/06/Creamy-Chicken-Spinach-1.jpg"
    },
    {
      "text": "In a frying pan, add the oil to the pan along with the chicken. Season the chicken with salt and pepper. Cook the chicken until internal temperature reaches 165F. Then remove from heat and set aside.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-creamy-chicken-spinach/#wprm-recipe-53889-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/06/Creamy-Chicken-Spinach-2.jpg"
    },
    {
      "text": "Using the same pan, add the sliced onion and fry until translucent.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-creamy-chicken-spinach/#wprm-recipe-53889-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/06/Creamy-Chicken-Spinach-3.jpg"
    },
    {
      "text": "Add the sliced mushrooms to the pan as well as the white wine. Fry until the white wine is evaporated by half.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-creamy-chicken-spinach/#wprm-recipe-53889-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/06/Creamy-Chicken-Spinach-4.jpg"
    },
    {
      "text": "Add the spinach and fry until wilted.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-creamy-chicken-spinach/#wprm-recipe-53889-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/06/Creamy-Chicken-Spinach-5.jpg"
    },
    {
      "text": "Then, add in sour cream, cream cheese, and heavy cream. Stir until combined well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-creamy-chicken-spinach/#wprm-recipe-53889-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/06/Creamy-Chicken-Spinach-6.jpg"
    },
    {
      "text": "Put the chicken thighs back in the frying pan and plate all together. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-creamy-chicken-spinach/#wprm-recipe-53889-step-0-6",
      "imageSource": null
    }
  ],
