  "ingredients": [
    "2 tablespoon orange zest",
    "1 medium onion",
    "2 1/2 teaspoon fresh garlic (minced)",
    "32 ounce beef chuck roast",
    "1 teaspoon salt",
    "1 1/2 teaspoon black pepper",
    "3 tablespoon coconut oil",
    "3 cup beef broth",
    "3 tablespoon fresh orange juice (freshly squeezed)",
    "2 tablespoon apple cider vinegar",
    "1 teaspoon soy sauce (or coconut aminos)",
    "1 teaspoon fish sauce",
    "2 whole bay leaf",
    "2 teaspoon ground cinnamon",
    "2 teaspoon erythritol",
    "1 teaspoon dried rosemary",
    "1 teaspoon dried sage",
    "1 tablespoon fresh thyme (finely chopped)"
  ],
  "instructions": [
    {
      "text": "Zest the orange using a microplane and cut it in half, ready to be squeezed later.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cinnamon-orange-beef-stew/#wprm-recipe-50769-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/01/cinnamon-orange-beef-stew-04.jpg"
    },
    {
      "text": "Dice the onion and mince the garlic.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cinnamon-orange-beef-stew/#wprm-recipe-50769-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/01/cinnamon-orange-beef-stew-05.jpg"
    },
    {
      "text": "Cut the meat into 1\" cubes, removing any grit as needed. Season with salt and pepper.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cinnamon-orange-beef-stew/#wprm-recipe-50769-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/01/cinnamon-orange-beef-stew-06.jpg"
    },
    {
      "text": "Heat up the coconut oil in a cast-iron skillet. Once the coconut oil has reached its smoking point, sear the beef in batches, taking care not to overcrowd the pan.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cinnamon-orange-beef-stew/#wprm-recipe-50769-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/01/cinnamon-orange-beef-stew-08.jpg"
    },
    {
      "text": "Once the last batch of beef is seared, add the onions and garlic to the pan, stirring constantly. After 2 minutes, add the orange juice to deglaze the pan.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cinnamon-orange-beef-stew/#wprm-recipe-50769-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/01/cinnamon-orange-beef-stew-11.jpg"
    },
    {
      "text": "Add the remaining ingredients (except the rosemary, sage, and thyme) to the pan, stirring constantly.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cinnamon-orange-beef-stew/#wprm-recipe-50769-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/01/cinnamon-orange-beef-stew-12.jpg"
    },
    {
      "text": "Mix everything together well and transfer the mixture to a slow cooker along with the beef cubes. Cook on high for 3 hours.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cinnamon-orange-beef-stew/#wprm-recipe-50769-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/01/cinnamon-orange-beef-stew-15.jpg"
    },
    {
      "text": "After 3 hours, add the rosemary, sage, and thyme to the slow cooker. Continue to cook, uncovered, for 1–2 hours, or until thickened and reduced to desired consistency. Serve and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cinnamon-orange-beef-stew/#wprm-recipe-50769-step-0-7",
      "imageSource": null
    }
  ],
