  "ingredients": [
    "32 ounce lamb leg",
    "1/4 cup olive oil",
    "2 tablespoon whole grain mustard",
    "1 tablespoon low-carb maple syrup (like Ruled.Me)",
    "salt and pepper (to taste)",
    "3/4 teaspoon fresh garlic (sliced)",
    "3/4 teaspoon dried rosemary",
    "1 teaspoon fresh thyme",
    "2 tablespoon fresh mint"
  ],
  "instructions": [
    {
      "text": "Place the lamb leg in the slow cooker and cut 3 large slits along the top at least 1 1/2\" deep.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/succulent-slow-cooked-lamb/#wprm-recipe-51029-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/04/succulent-slow-cooked-lamb-step-01.jpg"
    },
    {
      "text": "Rub the lamb with the olive oil, mustard, and Ruled.Me Maple Syrup. Add salt and pepper to taste.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/succulent-slow-cooked-lamb/#wprm-recipe-51029-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/04/succulent-slow-cooked-lamb-step-02.jpg"
    },
    {
      "text": "Place the garlic and rosemary inside the slits. Cook on low for 7 hours. Once the lamb is cooked down and surrounded by juices, add the thyme and mint. Cook for an additional 1 hour with the herbs in the juices.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/succulent-slow-cooked-lamb/#wprm-recipe-51029-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/04/succulent-slow-cooked-lamb-step-03.jpg"
    },
    {
      "text": "Remove from the slow cooker and let rest for 5–10 minutes. Slice and serve!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/succulent-slow-cooked-lamb/#wprm-recipe-51029-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/04/succulent-slow-cooked-lamb-step-04.jpg"
    }
  ],
