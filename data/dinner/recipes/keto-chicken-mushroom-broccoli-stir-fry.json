  "ingredients": [
    "2 tablespoon unsalted butter",
    "3 tablespoon avocado oil",
    "12 ounce boneless, skinless chicken thighs",
    "200 gram shiitake mushrooms (halved)",
    "140 gram broccoli",
    "2 teaspoon fresh garlic (minced)",
    "3 tablespoon soy sauce",
    "2 teaspoon unseasoned rice vinegar",
    "salt and pepper (to taste)"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all the ingredients. Dice the chicken.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-mushroom-broccoli-stir-fry/#wprm-recipe-53769-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/03/Keto-Chicken-Mushroom-Broccoli-Stir-Fry-1.jpg"
    },
    {
      "text": "In a frying pan over medium to high heat, heat the butter and avocado oil.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-mushroom-broccoli-stir-fry/#wprm-recipe-53769-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/03/Keto-Chicken-Mushroom-Broccoli-Stir-Fry-2.jpg"
    },
    {
      "text": "Add the diced chicken. and cook until brown.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-mushroom-broccoli-stir-fry/#wprm-recipe-53769-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/03/Keto-Chicken-Mushroom-Broccoli-Stir-Fry-3.jpg"
    },
    {
      "text": "Add the mushrooms and broccoli to the frying pan. Cook for about 5 minutes until everything is done.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-mushroom-broccoli-stir-fry/#wprm-recipe-53769-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/03/Keto-Chicken-Mushroom-Broccoli-Stir-Fry-4.jpg"
    },
    {
      "text": "Season with minced garlic, soy sauce, and rice vinegar. Stir until combined well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-mushroom-broccoli-stir-fry/#wprm-recipe-53769-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/03/Keto-Chicken-Mushroom-Broccoli-Stir-Fry-5.jpg"
    },
    {
      "text": "Season with salt and pepper. Serve and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-mushroom-broccoli-stir-fry/#wprm-recipe-53769-step-0-5",
