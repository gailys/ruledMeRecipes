  "ingredients": [
    "500 gram ground beef",
    "6 slice cheddar cheese",
    "1/4 cup onion (chopped)",
    "1/4 cup green onion (chopped)",
    "1/2 cup spinach",
    "1/4 cup button mushrooms"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 350F. In a small greased bread (or meatloaf) pan, line the bottom and sides with about 2/3 of the ground beef, leaving the center open for your stuffing.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-stuffed-meatloaf/#wprm-recipe-52527-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/01/stuffed-meatloaf-02.jpg"
    },
    {
      "text": "Layer the cheese on the bottom of the meatloaf.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-stuffed-meatloaf/#wprm-recipe-52527-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/01/stuffed-meatloaf-03.jpg"
    },
    {
      "text": "Add in the onions, spinach and mushrooms.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-stuffed-meatloaf/#wprm-recipe-52527-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/01/stuffed-meatloaf-06.jpg"
    },
    {
      "text": "Use the remaining meat and spread evenly on top, covering the spinach and mushrooms so that it acts as a lid.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-stuffed-meatloaf/#wprm-recipe-52527-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/01/stuffed-meatloaf-07.jpg"
    },
    {
      "text": "Bake for one hour, then remove from oven and let rest for 5 minutes in pan. Remove to serving platter, then slice and serve with your favorite side!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-stuffed-meatloaf/#wprm-recipe-52527-step-0-4",
      "imageSource": null
