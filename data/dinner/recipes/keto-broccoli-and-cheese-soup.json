  "ingredients": [
    "1 tablespoon butter",
    "3/4 medium onion (diced)",
    "2 teaspoon fresh garlic (minced)",
    "salt and pepper (to taste)",
    "1/4 teaspoon xanthan gum",
    "1/2 cup chicken broth",
    "1 cup broccoli (chopped)",
    "1 cup heavy cream",
    "1 1/2 cup cheddar cheese (shredded)"
  ],
  "instructions": [
    {
      "text": "Pre-heat the pot on the stove. In the pot, place the onions, minced garlic, salt, and pepper. Sauté on medium until the onions are clear.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-broccoli-and-cheese-soup/#wprm-recipe-52918-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/02/broccoli-n-cheese-soup-01.jpg"
    },
    {
      "text": "Sprinkle xanthan gum over the butter and onions. Stir in the chicken broth.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-broccoli-and-cheese-soup/#wprm-recipe-52918-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/02/broccoli-n-cheese-soup-03.jpg"
    },
    {
      "text": "Put the broccoli in the pot. Ensure the vegetables are coated with broth mixture.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-broccoli-and-cheese-soup/#wprm-recipe-52918-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/02/broccoli-n-cheese-soup-04.jpg"
    },
    {
      "text": "Quickly stir in the cream. Stir frequently so the xanthan gum mixes in and thickens. Bring the soup up to a boil, then reduce heat and simmer.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-broccoli-and-cheese-soup/#wprm-recipe-52918-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/02/broccoli-n-cheese-soup-05.jpg"
    },
    {
      "text": "Once simmering, slowly begin whisking the cheese into the pot. If preferred, add additional chicken broth to achieve desired consistency.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-broccoli-and-cheese-soup/#wprm-recipe-52918-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/02/broccoli-n-cheese-soup-06.jpg"
    },
    {
      "text": "Serve warm.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-broccoli-and-cheese-soup/#wprm-recipe-52918-step-0-5",
      "imageSource": null
    }
  ],
