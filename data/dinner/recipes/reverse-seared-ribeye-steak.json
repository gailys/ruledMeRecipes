  "ingredients": [
    "20 ounce ribeye steak",
    "salt and pepper (to taste)",
    "3 tablespoon lard (or other oil with a high smoke point)"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 250F. Place the steaks on a wire rack on top of a foil lined cookie sheet. Season heavily with salt and pepper on all sides of the meat.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/reverse-seared-ribeye-steak/#wprm-recipe-51677-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/04/img_2136.jpg"
    },
    {
      "text": "Stick an instant-read thermometer through the side of the steak, so that the tip reaches the middle. Set the thermometer for an internal temperature of 123F and bake in the oven until internal temperature is reached (about 40–45 minutes).",
      "group": "",
      "sourceUrl": "https://www.ruled.me/reverse-seared-ribeye-steak/#wprm-recipe-51677-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/04/img_2140.jpg"
    },
    {
      "text": "Let the steaks rest for a few minutes. This is usually all that's needed; the juices won’t run as much with this method, because the meat is cooked low and slow, rather than a fast sear.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/reverse-seared-ribeye-steak/#wprm-recipe-51677-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/04/img_2152.jpg"
    },
    {
      "text": "Heat the oil in a cast-iron skillet or ceramic skillet and wait until the pan is very hot and beginning to smoke. Place the steaks in the skillet and sear for 30–45 seconds per side.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/reverse-seared-ribeye-steak/#wprm-recipe-51677-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/04/img_2165.jpg"
    },
    {
      "text": "Don’t forget to sear the sides of the steak!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/reverse-seared-ribeye-steak/#wprm-recipe-51677-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/04/img_2176.jpg"
    },
    {
      "text": "Let rest for 2–3 minutes and serve warm. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/reverse-seared-ribeye-steak/#wprm-recipe-51677-step-0-5",
      "imageSource": null
    }
  ],
