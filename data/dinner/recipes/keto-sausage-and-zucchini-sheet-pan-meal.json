  "ingredients": [
    "2 medium zucchini",
    "2 medium yellow squash",
    "2 tablespoon olive oil",
    "2 teaspoon italian seasoning",
    "salt and pepper (to taste)",
    "16 ounce pork sausage (smoked)",
    "1 cup grated parmesan cheese"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all the ingredients. Slice the smoked sausage into bite sized pieces and preheat oven to 450F.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-sausage-and-zucchini-sheet-pan-meal/#wprm-recipe-53973-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/10/Sausage-and-Zucchini-Sheet-Pan-Meal-1.jpg"
    },
    {
      "text": "Wash the zucchini and squash and pat dry. Chop the zucchini into small sized pieces then half them.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-sausage-and-zucchini-sheet-pan-meal/#wprm-recipe-53973-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/10/Sausage-and-Zucchini-Sheet-Pan-Meal-2.jpg"
    },
    {
      "text": "Put the zucchini and squash in a bowl. Toss it in olive oil Italian seasoning, and salt and pepper to taste.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-sausage-and-zucchini-sheet-pan-meal/#wprm-recipe-53973-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/10/Sausage-and-Zucchini-Sheet-Pan-Meal-3.jpg"
    },
    {
      "text": "Arrange the zucchini and squash on the baking sheet evenly apart.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-sausage-and-zucchini-sheet-pan-meal/#wprm-recipe-53973-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/10/Sausage-and-Zucchini-Sheet-Pan-Meal-5.jpg"
    },
    {
      "text": "Arrange the sausage in between the zucchini and squash.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-sausage-and-zucchini-sheet-pan-meal/#wprm-recipe-53973-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/10/Sausage-and-Zucchini-Sheet-Pan-Meal-6.jpg"
    },
    {
      "text": "Bake this in the oven for 15 minutes total, flipping half way.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-sausage-and-zucchini-sheet-pan-meal/#wprm-recipe-53973-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/10/Sausage-and-Zucchini-Sheet-Pan-Meal-7.jpg"
    },
    {
      "text": "After 15 minutes, sprinkle the zucchini with the freshly grated parmesan cheese.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-sausage-and-zucchini-sheet-pan-meal/#wprm-recipe-53973-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/10/Sausage-and-Zucchini-Sheet-Pan-Meal-8.jpg"
    },
    {
      "text": "Put back in the oven for 12 more minutes or until the parmesan starts to melt and the zucchini becomes crispy.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-sausage-and-zucchini-sheet-pan-meal/#wprm-recipe-53973-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/10/Sausage-and-Zucchini-Sheet-Pan-Meal-9.jpg"
    },
    {
      "text": "Serve and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-sausage-and-zucchini-sheet-pan-meal/#wprm-recipe-53973-step-0-8",
      "imageSource": null
    }
  ],
