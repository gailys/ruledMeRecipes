  "ingredients": [
    "2 tablespoon olive oil",
    "1 teaspoon garlic powder",
    "1 teaspoon onion powder",
    "2 teaspoon italian seasoning",
    "20 ounce bone-in, skin-on chicken drumsticks",
    "12 tablespoon unsalted butter",
    "2 teaspoon fresh garlic (minced)",
    "1 tablespoon fresh parsley (chopped)",
    "salt and pepper (to taste)",
    "20 ounce broccoli",
    "salt (to taste)"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all ingredients. Preheat oven to 400F.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/roast-chicken-with-broccoli-and-garlic-butter/#wprm-recipe-53657-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/01/Roast-Chicken-with-Broccoli-and-Garlic-1.jpg"
    },
    {
      "text": "In a bowl, combine olive oil, garlic powder, onion powder, and Italian seasoning. Toss the drumsticks in this seasoning.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/roast-chicken-with-broccoli-and-garlic-butter/#wprm-recipe-53657-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/01/Roast-Chicken-with-Broccoli-and-Garlic-2.jpg"
    },
    {
      "text": "Put the drumsticks on a baking sheet and put in oven for 40-45 minutes or until the internal temperature of the chicken reaches 165F.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/roast-chicken-with-broccoli-and-garlic-butter/#wprm-recipe-53657-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/01/Roast-Chicken-with-Broccoli-and-Garlic-3.jpg"
    },
    {
      "text": "Cut the broccoli into small florets.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/roast-chicken-with-broccoli-and-garlic-butter/#wprm-recipe-53657-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/01/Roast-Chicken-with-Broccoli-and-Garlic-4.jpg"
    },
    {
      "text": "While chicken is cooking, boil the broccoli in salted water for 3-5 minutes. Drain and set aside, keep the broccoli warm.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/roast-chicken-with-broccoli-and-garlic-butter/#wprm-recipe-53657-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/01/Roast-Chicken-with-Broccoli-and-Garlic-5.jpg"
    },
    {
      "text": "Make the garlic butter by combining butter, garlic, fresh parsley, and salt and pepper in a bowl. Stir together until well combined.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/roast-chicken-with-broccoli-and-garlic-butter/#wprm-recipe-53657-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/01/Roast-Chicken-with-Broccoli-and-Garlic-6.jpg"
    },
    {
      "text": "Plate the drumsticks along with the broccoli and garlic butter. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/roast-chicken-with-broccoli-and-garlic-butter/#wprm-recipe-53657-step-0-6",
      "imageSource": null
    }
  ],
