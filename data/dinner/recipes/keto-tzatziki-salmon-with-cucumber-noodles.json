  "ingredients": [
    "1/2 cup full-fat plain greek yogurt",
    "1 tablespoon olive oil",
    "1 1/2 teaspoon lemon juice",
    "2 teaspoon fresh garlic (minced)",
    "1/2 teaspoon dried dill",
    "1 teaspoon fresh mint (chopped)",
    "salt and pepper (to taste)",
    "1 medium cucumber (spiralized or thinly sliced)",
    "12 ounce salmon",
    "1 tablespoon olive oil",
    "1 teaspoon lemon zest",
    "2 teaspoon fresh garlic (minced)",
    "salt and pepper (to taste)"
  ],
  "instructions": [
    {
      "text": "Gather and prep all of your ingredients. Pre-heat oven to 400F.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-tzatziki-salmon-with-cucumber-noodles/#wprm-recipe-56742-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/06/Keto-Tzatziki-Salmon-with-Cucumber-Noodles-1.jpg"
    },
    {
      "text": "Add all of the ingredients for the tzatziki sauce into a bowl.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-tzatziki-salmon-with-cucumber-noodles/#wprm-recipe-56742-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/06/Keto-Tzatziki-Salmon-with-Cucumber-Noodles-2.jpg"
    },
    {
      "text": "Stir together well, then set aside in the refrigerator.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-tzatziki-salmon-with-cucumber-noodles/#wprm-recipe-56742-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/06/Keto-Tzatziki-Salmon-with-Cucumber-Noodles-3.jpg"
    },
    {
      "text": "Lay foil over a baking sheet, then put the salmon on top. Brush with olive oil, then spread lemon zest and garlic over the salmon. Season with salt and pepper to taste.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-tzatziki-salmon-with-cucumber-noodles/#wprm-recipe-56742-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/06/Keto-Tzatziki-Salmon-with-Cucumber-Noodles-4.jpg"
    },
    {
      "text": "Wrap the salmon with the foil, then bake for 16-20 minutes, or until cooked through (depending on thickness of salmon).",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-tzatziki-salmon-with-cucumber-noodles/#wprm-recipe-56742-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/06/Keto-Tzatziki-Salmon-with-Cucumber-Noodles-6.jpg"
    },
    {
      "text": "Once salmon is done, plate the cucumber noodles, salmon, and tzatziki sauce as desired. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-tzatziki-salmon-with-cucumber-noodles/#wprm-recipe-56742-step-0-5",
