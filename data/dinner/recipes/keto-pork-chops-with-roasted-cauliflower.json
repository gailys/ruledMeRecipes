  "ingredients": [
    "4 tablespoon butter (room temp)",
    "2 teaspoon fresh garlic (minced)",
    "2 tablespoon fresh parsley (finely chopped)",
    "2 teaspoon lemon juice",
    "salt and pepper (to taste)",
    "24 ounce bone-in pork chops",
    "2 tablespoon butter (for frying)",
    "1 tablespoon fresh parsley (finely chopped)",
    "1 teaspoon dried dill",
    "1 teaspoon onion powder",
    "1/2 teaspoon garlic powder",
    "salt and pepper (to taste)",
    "24 ounce cauliflower",
    "2 tablespoon olive oil",
    "salt and pepper",
    "4 ounce grated parmesan cheese"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all the ingredients. Preheat oven to 400F.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pork-chops-with-roasted-cauliflower/#wprm-recipe-53961-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/09/Pork-Chops-with-Roasted-Cauliflower-1.jpg"
    },
    {
      "text": "Season the pork chops with salt and pepper.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pork-chops-with-roasted-cauliflower/#wprm-recipe-53961-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/09/Pork-Chops-with-Roasted-Cauliflower-2.jpg"
    },
    {
      "text": "Mix together the ingredients for the herbed butter in a bowl. Set aside.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pork-chops-with-roasted-cauliflower/#wprm-recipe-53961-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/09/Pork-Chops-with-Roasted-Cauliflower-3.jpg"
    },
    {
      "text": "Rinse the cauliflower and pat dry. Cut them into smaller pieces.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pork-chops-with-roasted-cauliflower/#wprm-recipe-53961-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/09/Pork-Chops-with-Roasted-Cauliflower-4.jpg"
    },
    {
      "text": "Line a baking sheet with parchment paper. Drizzle olive oil on both sides of the cauliflower and season with salt and pepper.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pork-chops-with-roasted-cauliflower/#wprm-recipe-53961-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/09/Pork-Chops-with-Roasted-Cauliflower-5.jpg"
    },
    {
      "text": "Add the parmesan cheese on top. Bake in the oven for 20 - 25 minutes or until brown.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pork-chops-with-roasted-cauliflower/#wprm-recipe-53961-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/09/Pork-Chops-with-Roasted-Cauliflower-6.jpg"
    },
    {
      "text": "Over medium - high heat, add butter to a skillet along with the pork chops. Fry the pork chops on each side for 5 - 7 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pork-chops-with-roasted-cauliflower/#wprm-recipe-53961-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/09/Pork-Chops-with-Roasted-Cauliflower-7.jpg"
    },
    {
      "text": "Plate the pork chops.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pork-chops-with-roasted-cauliflower/#wprm-recipe-53961-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/09/Pork-Chops-with-Roasted-Cauliflower-8.jpg"
    },
    {
      "text": "Serve the pork chops with the roasted cauliflower and the herbed butter. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pork-chops-with-roasted-cauliflower/#wprm-recipe-53961-step-0-8",
