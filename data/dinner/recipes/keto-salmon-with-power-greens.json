  "ingredients": [
    "16 ounce salmon",
    "2 tablespoon fresh orange juice",
    "3 tablespoon lemon juice",
    "1 medium avocado",
    "1 cup kale",
    "2 cup arugula",
    "2 cup spinach",
    "1/4 cup pumpkin seeds",
    "1 medium shallot",
    "2 tablespoon capers",
    "2 tablespoon olive oil",
    "1 teaspoon old bay seasoning",
    "1 medium jalapeno pepper"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all of the ingredients. Dice the jalapenos and slice the avocado.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-salmon-with-power-greens/#wprm-recipe-54147-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/02/Keto-Salmon-with-Power-Greens-1.jpg"
    },
    {
      "text": "On a cutting board, zest the orange and the lemon. Cut the orange and lemon in half. In a bowl, squeeze the orange and lemon to get all of the juice out of them. Add the zest into the same bowl.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-salmon-with-power-greens/#wprm-recipe-54147-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/02/Keto-Salmon-with-Power-Greens-2.jpg"
    },
    {
      "text": "Marinate the salmon by combining the orange and lemon zest, juice, and peels. Cover and let the salmon marinate for at least 20 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-salmon-with-power-greens/#wprm-recipe-54147-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/02/Keto-Salmon-with-Power-Greens-3.jpg"
    },
    {
      "text": "Rub the salmon with olive oil and season it with old bay seasoning.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-salmon-with-power-greens/#wprm-recipe-54147-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/02/Keto-Salmon-with-Power-Greens-4.jpg"
    },
    {
      "text": "Fry the salmon in a frying pan over medium heat. Let sear for 5-9 minutes per side or until internal temperature reaches 145F.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-salmon-with-power-greens/#wprm-recipe-54147-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/02/Keto-Salmon-with-Power-Greens-5.jpg"
    },
    {
      "text": "Slice the shallots in a bowl with some lemon juice.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-salmon-with-power-greens/#wprm-recipe-54147-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/02/Keto-Salmon-with-Power-Greens-6.jpg"
    },
    {
      "text": "Layer the kale, arugula, and spinach on a serving plate. Top with pumpkin seeds, shallot, capers, and diced jalapeno.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-salmon-with-power-greens/#wprm-recipe-54147-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/02/Keto-Salmon-with-Power-Greens-7.jpg"
    },
    {
      "text": "Add the sliced avocados and the salmon to the plate of greens. Serve and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-salmon-with-power-greens/#wprm-recipe-54147-step-0-7",
      "imageSource": null
    }
  ],
