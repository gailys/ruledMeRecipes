  "ingredients": [
    "16 ounce cauliflower",
    "4 ounce pepper jack cheese (shredded)",
    "4 ounce cream cheese (at room temperature)",
    "1/2 cup sour cream",
    "2 tablespoon hot sauce (or more to taste)",
    "2 medium green onion (chopped)",
    "1/2 teaspoon garlic powder",
    "salt and pepper (to taste)",
    "16 ounce rotisserie chicken (cubed)",
    "2 tablespoon fresh cilantro"
  ],
  "instructions": [
    {
      "text": "Gather and prep all of your ingredients. Pre-heat oven to 350F.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-buffalo-chicken-cauliflower-casserole/#wprm-recipe-57371-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/10/Keto-Buffalo-Cauliflower-Casserole-1.jpg"
    },
    {
      "text": "Chop the cauliflower into bite sized pieces.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-buffalo-chicken-cauliflower-casserole/#wprm-recipe-57371-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/10/Keto-Buffalo-Cauliflower-Casserole-2.jpg"
    },
    {
      "text": "Bring a pot of salted water to a boil, then add the cauliflower and boil for 5-6 minutes or until just tender. Drain and set aside.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-buffalo-chicken-cauliflower-casserole/#wprm-recipe-57371-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/10/Keto-Buffalo-Cauliflower-Casserole-3.jpg"
    },
    {
      "text": "In a bowl, combine the pepper jack, cream cheese, sour cream, hot sauce, green onion, garlic powder. Stir together well, then season with salt and pepper to taste.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-buffalo-chicken-cauliflower-casserole/#wprm-recipe-57371-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/10/Keto-Buffalo-Cauliflower-Casserole-4.jpg"
    },
    {
      "text": "Add the chicken and cauliflower into the cheese mixture, then gently fold together.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-buffalo-chicken-cauliflower-casserole/#wprm-recipe-57371-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/10/Keto-Buffalo-Cauliflower-Casserole-5.jpg"
    },
    {
      "text": "Transfer the mixture into a casserole dish and bake for 20 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-buffalo-chicken-cauliflower-casserole/#wprm-recipe-57371-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/10/Keto-Buffalo-Cauliflower-Casserole-6.jpg"
    },
    {
      "text": "Optionally broil if the cheese is not browned enough. Top with chopped cilantro and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-buffalo-chicken-cauliflower-casserole/#wprm-recipe-57371-step-0-6",
      "imageSource": null
    }
  ],
