  "ingredients": [
    "20 ounce boneless, skinless chicken breast",
    "3 tablespoon olive oil",
    "2 tablespoon smoked paprika",
    "2 tablespoon lemon juice",
    "1 tablespoon low-carb maple syrup",
    "2 teaspoon fresh garlic (minced)",
    "salt and pepper (to taste)"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 350F. Pat the chicken breasts dry with a paper towel.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-paprika-chicken/#wprm-recipe-51005-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/keto-paprika-chicken-01.jpg"
    },
    {
      "text": "Cut the chicken into large chunks.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-paprika-chicken/#wprm-recipe-51005-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/keto-paprika-chicken-03.jpg"
    },
    {
      "text": "In a small ramekin, add the olive oil, paprika, lemon juice, maple syrup, and garlic.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-paprika-chicken/#wprm-recipe-51005-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/keto-paprika-chicken-06.jpg"
    },
    {
      "text": "Season the chunks of chicken with salt and pepper on both sides.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-paprika-chicken/#wprm-recipe-51005-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/keto-paprika-chicken-07.jpg"
    },
    {
      "text": "Spread about one-third of the sauce over the bottom of a casserole dish.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-paprika-chicken/#wprm-recipe-51005-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/keto-paprika-chicken-08.jpg"
    },
    {
      "text": "Add the chicken to the casserole dish, lightly tossing it in the sauce to coat.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-paprika-chicken/#wprm-recipe-51005-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/keto-paprika-chicken-10.jpg"
    },
    {
      "text": "Add the remainder of the sauce on top of the chicken and rub it in well, making sure that each piece is coated.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-paprika-chicken/#wprm-recipe-51005-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/keto-paprika-chicken-11.jpg"
    },
    {
      "text": "Bake in the oven for 30–35 minutes. Once done, broil for an additional 4–5 minutes. Let cool for 4–7 minutes. Serve and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-paprika-chicken/#wprm-recipe-51005-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/keto-paprika-chicken-12.jpg"
    }
  ],
