  "ingredients": [
    "20 ounce boneless, skinless chicken thighs",
    "salt and pepper (to taste)",
    "4 ounce cremini mushrooms (chopped)",
    "1 medium cauliflower (cored and chopped)",
    "8 ounce cream cheese",
    "2 tablespoon sour cream",
    "2 medium green onion (chopped)"
  ],
  "instructions": [
    {
      "text": "Pre-heat oven to 350 degrees Fahrenheit. Place the chicken thighs into a casserole dish and season with salt and pepper. Then, layer the mushrooms and cauliflower on top.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-mushroom-keto-casserole/#wprm-recipe-52663-step-0-0",
