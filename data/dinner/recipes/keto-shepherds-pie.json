  "ingredients": [
    "2 tablespoon butter",
    "16 ounce ground lamb",
    "1/2 medium yellow onion (chopped)",
    "3 teaspoon fresh garlic (minced)",
    "1/2 cup celery (chopped)",
    "salt and pepper (to taste)",
    "2 tablespoon tomato paste",
    "1 tablespoon worcestershire sauce",
    "1/2 cup chicken broth",
    "1/4 cup dry red wine",
    "1/2 teaspoon xanthan gum",
    "24 ounce cauliflower rice (cooked and drained)",
    "1 cup heavy cream",
    "1 cup cheddar cheese (shredded)",
    "1/4 cup parmesan cheese (grated)",
    "1 teaspoon dried thyme"
  ],
  "instructions": [
    {
      "text": "Preheat your oven to 350 degrees Fahrenheit. Heat up the butter in a large skillet, or until the butter stops foaming and sizzling.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-shepherds-pie/#wprm-recipe-53219-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/11/keto-low-carb-shepherds-pie-01.jpg"
    },
    {
      "text": "Add the ground lamb, onion, garlic, celery. Season with salt and pepper. Cook until the meat has browned, and the vegetables have softened, then add the tomato paste, Worcestershire, red wine, and chicken stock. Sprinkle the xanthan gum across the top then stir in.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-shepherds-pie/#wprm-recipe-53219-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/11/keto-low-carb-shepherds-pie-02.jpg"
    },
    {
      "text": "Add the cooked riced cauliflower, heavy whipping cream, cheddar cheese, Parmesan, thyme, salt, and pepper to a food processor. Blend until the cauliflower whips into a smooth puree.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-shepherds-pie/#wprm-recipe-53219-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/11/keto-low-carb-shepherds-pie-03.jpg"
    },
    {
      "text": "Add the meat mixture to a casserole dish, then spread the pureed cauliflower across the top.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-shepherds-pie/#wprm-recipe-53219-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/11/keto-low-carb-shepherds-pie-04.jpg"
    },
    {
      "text": "Bake the shepherd’s pie for 45 minutes, or until browned across the top. Allow to cool for 10 minutes before cutting and serving.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-shepherds-pie/#wprm-recipe-53219-step-0-4",
      "imageSource": null
    }
  ],
