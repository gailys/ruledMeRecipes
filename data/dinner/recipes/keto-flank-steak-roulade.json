  "ingredients": [
    "2 ounce walnuts",
    "24 ounce flank steak",
    "8 ounce spinach",
    "3 tablespoon avocado oil",
    "4 ounce onion (diced)",
    "3 teaspoon fresh garlic (sliced)",
    "1 tablespoon lemon juice",
    "salt and pepper (to taste)",
    "4 ounce feta cheese",
    "8 ounce cauliflower",
    "8 ounce broccoli",
    "3 tablespoon olive oil"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all the ingredients. Preheat the oven to 350F.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-flank-steak-roulade/#wprm-recipe-54061-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/12/Keto-Flank-Steak-Roulade-1.jpg"
    },
    {
      "text": "Roast the walnuts in the oven until they are fragrant, about 5 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-flank-steak-roulade/#wprm-recipe-54061-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/12/Keto-Flank-Steak-Roulade-2.jpg"
    },
    {
      "text": "In a skillet, add in the avocado oil, onion, and garlic. Heat until fragrant.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-flank-steak-roulade/#wprm-recipe-54061-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/12/Keto-Flank-Steak-Roulade-3.jpg"
    },
    {
      "text": "Add spinach into the skillet and cook until it gets wilty. Remove from heat and add in the lemon juice.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-flank-steak-roulade/#wprm-recipe-54061-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/12/Keto-Flank-Steak-Roulade-4.jpg"
    },
    {
      "text": "Toss the cauliflower and broccoli in olive oil.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-flank-steak-roulade/#wprm-recipe-54061-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/12/Keto-Flank-Steak-Roulade-5.jpg"
    },
    {
      "text": "Slice the flank steak in half and season it with salt and pepper.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-flank-steak-roulade/#wprm-recipe-54061-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/12/Keto-Flank-Steak-Roulade-6.jpg"
    },
    {
      "text": "Stuff the steak with the spinach mixture, walnuts, and feta. Rope and tie it with kitchen twine.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-flank-steak-roulade/#wprm-recipe-54061-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/12/Keto-Flank-Steak-Roulade-7.jpg"
    },
    {
      "text": "Turn the oven up to 375F. Add olive oil to a skillet then add the steak roulade. Bake in the oven for 30-40 minutes. Bake the cauliflower and broccoli on a baking sheet in the oven for 10-15 minutes or done to your liking.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-flank-steak-roulade/#wprm-recipe-54061-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/12/Keto-Flank-Steak-Roulade-8.jpg"
    },
    {
      "text": "Let the roulade cool for about 10 minutes before undoing the twine.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-flank-steak-roulade/#wprm-recipe-54061-step-0-8",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/12/Keto-Flank-Steak-Roulade-9.jpg"
    },
    {
      "text": "Cut and serve with the vegetables. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-flank-steak-roulade/#wprm-recipe-54061-step-0-9",
      "imageSource": null
    }
  ],
