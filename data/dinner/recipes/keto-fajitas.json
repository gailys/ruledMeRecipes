  "instructions": [
    {
      "text": "Measure out and prepare all of the ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-fajitas/#wprm-recipe-54645-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/05/Keto-Fajitas-1.jpg"
    },
    {
      "text": "Slice the peppers and the red onion.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-fajitas/#wprm-recipe-54645-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/05/Keto-Fajitas-2-2.jpg"
    },
    {
      "text": "In a slow cooker, add half of the vegetables then add in the chicken thighs.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-fajitas/#wprm-recipe-54645-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/05/Keto-Fajitas-3.jpg"
    },
    {
      "text": "Top with the canned tomatoes with jalapenos.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-fajitas/#wprm-recipe-54645-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/05/Keto-Fajitas-4.jpg"
    },
    {
      "text": "Add in the rest of the vegetables. Cook on high for 3 hours.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-fajitas/#wprm-recipe-54645-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/05/Keto-Fajitas-5.jpg"
    },
    {
      "text": "Shred the chicken.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-fajitas/#wprm-recipe-54645-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/05/Keto-Fajitas-6.jpg"
    },
    {
      "text": "Cook in the slow cooker for another hour on low.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-fajitas/#wprm-recipe-54645-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/05/Keto-Fajitas-7.jpg"
    },
    {
      "text": "When done, serve in bowls. Garnish with sour cream, Mexican-style shredded cheese, and avocado slices. Enjoy!",
