  "ingredients": [
    "3 tablespoon sesame seeds",
    "1 cup walnuts",
    "1 cup almonds",
    "1/2 cup fresh cilantro",
    "1/2 cup fresh parsley",
    "1/4 cup olive oil",
    "2 tablespoon lemon juice",
    "1 tablespoon fresh mint",
    "2 teaspoon cumin",
    "1 teaspoon nutritional yeast",
    "1 teaspoon dried oregano",
    "1 teaspoon fresh garlic (minced)",
    "1/2 teaspoon cayenne pepper",
    "1/2 teaspoon salt",
    "1/2 teaspoon black pepper"
  ],
  "instructions": [
    {
      "text": "Place the walnuts, almonds and sesame seeds in a bowl. Fill with water, then cover and chill in the refrigerator for 12 hours. Once complete, strain and rinse.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/vegetarian-keto-falafel/#wprm-recipe-59920-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/07/vegetarian-keto-falafel-step-01.jpg"
    },
    {
      "text": "Add cilantro, parsley, olive oil, lemon juice, mint leaves, cumin, nutritional yeast, oregano, garlic, cayenne pepper, salt and ground pepper to the bowl of a food processor. Pulse mixture until smooth.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/vegetarian-keto-falafel/#wprm-recipe-59920-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/07/vegetarian-keto-falafel-step-02.jpg"
    },
    {
      "text": "Add the soaked nut and seed mixture. Pulse until the nuts are the size of the sesame seeds.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/vegetarian-keto-falafel/#wprm-recipe-59920-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/07/vegetarian-keto-falafel-step-03.jpg"
    },
    {
      "text": "Using 2 tablespoons at a time, roll the dough into balls. Press and rotate as you go to get the mixture to stick together.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/vegetarian-keto-falafel/#wprm-recipe-59920-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/07/vegetarian-keto-falafel-step-04.jpg"
    },
    {
      "text": "Place the falafel on food dehydrator racks. Dehydrate at 110F for 10 hours, rotating halfway through. If you do not have a dehydrator, recipe can be cooked at the lowest temperature your oven will go (180F) for 3 hours, rotating halfway through.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/vegetarian-keto-falafel/#wprm-recipe-59920-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/07/vegetarian-keto-falafel-step-05.jpg"
    }
  ],
