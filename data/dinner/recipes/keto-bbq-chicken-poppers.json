  "ingredients": [
    "15 ounce boneless, skinless chicken thighs",
    "5 medium jalapeno pepper",
    "8 ounce cream cheese",
    "10 ounce bacon",
    "4 tablespoon low-carb bbq sauce",
    "3 ounce spinach",
    "1/2 medium red onion (chopped)"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all the ingredients. Preheat oven to 400F.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-bbq-chicken-poppers/#wprm-recipe-54025-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/11/BBQ-Chicken-Poppers-1.jpg"
    },
    {
      "text": "Wash the jalapenos and cut them lengthwise. Remove the seeds.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-bbq-chicken-poppers/#wprm-recipe-54025-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/11/BBQ-Chicken-Poppers-2.jpg"
    },
    {
      "text": "Spread the cream cheese inside the jalapeno peppers.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-bbq-chicken-poppers/#wprm-recipe-54025-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/11/BBQ-Chicken-Poppers-3.jpg"
    },
    {
      "text": "Cut a slit in the chicken (not all the way through) to be able to wrap the jalapeno peppers inside the chicken. Be sure to face the jalapeno poppers with the cream cheese facing up.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-bbq-chicken-poppers/#wprm-recipe-54025-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/11/BBQ-Chicken-Poppers-4.jpg"
    },
    {
      "text": "Now wrap the chicken thighs with bacon.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-bbq-chicken-poppers/#wprm-recipe-54025-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/11/BBQ-Chicken-Poppers-5.jpg"
    },
    {
      "text": "Oil a baking pan and set the chicken thighs inside the pan.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-bbq-chicken-poppers/#wprm-recipe-54025-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/11/BBQ-Chicken-Poppers-6.jpg"
    },
    {
      "text": "Using a brush, spread the low-carb BBQ sauce over the chicken. Bake in the oven for about 35 minutes or until internal temperature reaches 165F.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-bbq-chicken-poppers/#wprm-recipe-54025-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/11/BBQ-Chicken-Poppers-7.jpg"
    },
    {
      "text": "Serve with spinach and chopped onions. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-bbq-chicken-poppers/#wprm-recipe-54025-step-0-7",
      "imageSource": null
    }
