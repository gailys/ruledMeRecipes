  "ingredients": [
    "16 ounce green beans (washed and trimmed)",
    "2 tablespoon coconut oil",
    "salt and pepper (to taste)",
    "1 tablespoon sesame oil",
    "3 teaspoon fresh garlic (minced)",
    "2 tablespoon fresh ginger (grated or minced)",
    "16 ounce ground turkey",
    "4 tablespoon soy sauce",
    "2 tablespoon unseasoned rice vinegar",
    "1 tablespoon chili-garlic paste"
  ],
  "instructions": [
    {
      "text": "Gather and prep all of your ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-asian-turkey-green-bean-stir-fry/#wprm-recipe-57145-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/08/Keto-Asian-Turkey-Green-Bean-Stir-Fry-1.jpg"
    },
    {
      "text": "Add coconut oil to a pan over medium-high heat. Once hot, add in the green beans and season with salt and pepper to taste. Sautee green beans until cooked through but still crisp, stirring often, about 3-4 minutes. Remove from the pan, reserving any oil, and set aside.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-asian-turkey-green-bean-stir-fry/#wprm-recipe-57145-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/08/Keto-Asian-Turkey-Green-Bean-Stir-Fry-2.jpg"
    },
    {
      "text": "In the same pan, add in the sesame oil, garlic, and ginger over medium heat. Cook until garlic and ginger are fragrant, about 1 minute.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-asian-turkey-green-bean-stir-fry/#wprm-recipe-57145-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/08/Keto-Asian-Turkey-Green-Bean-Stir-Fry-3.jpg"
    },
    {
      "text": "Add in the ground turkey, breaking apart with a wooden spoon, and allow to lightly brown. Once turkey is beginning to brown, add in the soy sauce, rice vinegar, and chili garlic paste. Stir together well, allowing the sauce to reduce for 1-2 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-asian-turkey-green-bean-stir-fry/#wprm-recipe-57145-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/08/Keto-Asian-Turkey-Green-Bean-Stir-Fry-4.jpg"
    },
    {
      "text": "Add the green beans back in, allowing them to heat through.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-asian-turkey-green-bean-stir-fry/#wprm-recipe-57145-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/08/Keto-Asian-Turkey-Green-Bean-Stir-Fry-5.jpg"
    },
    {
      "text": "Remove from the pan and serve immediately. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-asian-turkey-green-bean-stir-fry/#wprm-recipe-57145-step-0-5",
      "imageSource": null
