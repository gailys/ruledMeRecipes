  "ingredients": [
    "1 teaspoon olive oil",
    "30 ounce salmon",
    "1 tablespoon lime zest",
    "1 tablespoon lime juice",
    "2 large lime (thinly sliced)",
    "1 teaspoon tequila",
    "1 teaspoon salt",
    "3 tablespoon mayonnaise",
    "1 large avocado",
    "1 teaspoon fresh garlic (minced)"
  ],
  "instructions": [
    {
      "text": "Mix the lime zest, lime juice, tequila, oil, and salt in a bowl.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/lime-margarita-grilled-salmon/#wprm-recipe-59200-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/08/lime-margarita-grilled-salmon-step-01.jpg"
    },
    {
      "text": "Spray the skin side of the fish with cooking spray. Place in an oven safe dish with the skin side down. Pour the marinade over the fish, then let it rest for 30 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/lime-margarita-grilled-salmon/#wprm-recipe-59200-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/08/lime-margarita-grilled-salmon-step-02.jpg"
    },
    {
      "text": "Fire up the grill, then spray it with cooking spray. Cook the skin side down for about 10-15 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/lime-margarita-grilled-salmon/#wprm-recipe-59200-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/08/lime-margarita-grilled-salmon-step-03.jpg"
    },
    {
      "text": "Mix the mayonnaise, avocado, and garlic in a food processor.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/lime-margarita-grilled-salmon/#wprm-recipe-59200-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/08/lime-margarita-grilled-salmon-step-04.jpg"
    },
    {
      "text": "Serve the salmon with the avocado mayo and lime slices.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/lime-margarita-grilled-salmon/#wprm-recipe-59200-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/08/lime-margarita-grilled-salmon-step-05.jpg"
