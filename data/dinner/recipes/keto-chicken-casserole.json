  "ingredients": [
    "3/4 cup heavy whipping cream",
    "4 ounce cream cheese",
    "3 tablespoon pesto",
    "1/2 medium lemon (juice of)",
    "salt and pepper (to taste)",
    "3 tablespoon butter",
    "32 ounce boneless, skinless chicken thighs (cut into pieces)",
    "1/2 medium yellow onion",
    "4 ounce cherry tomatoes (cut in half)",
    "16 ounce cauliflower",
    "7 ounce cheddar cheese (shredded)"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all the ingredients. Preheat oven to 400F.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-casserole/#wprm-recipe-53533-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/10/Keto-Chicken-Casserole-1.jpg"
    },
    {
      "text": "In a bowl, combine heavy whipping cream, cream cheese, pesto, and lemon juice. Stir until well combined, seasoning with salt and pepper to taste.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-casserole/#wprm-recipe-53533-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/10/Keto-Chicken-Casserole-2.jpg"
    },
    {
      "text": "In a frying pan over medium to high heat, melt the butter. Add the cut up chicken pieces to the pan and cook until they are golden brown in color.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-casserole/#wprm-recipe-53533-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/10/Keto-Chicken-Casserole-3.jpg"
    },
    {
      "text": "Put the cooked chicken in the bottom of a baking pan. Pour in the cream mixture on top of the chicken.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-casserole/#wprm-recipe-53533-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/10/Keto-Chicken-Casserole-4.jpg"
    },
    {
      "text": "Top this off with the yellow onion, cherry tomatoes, and cauliflower.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-casserole/#wprm-recipe-53533-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/10/Keto-Chicken-Casserole-5.jpg"
    },
    {
      "text": "Top all of this off with shredded cheddar cheese. Bake for 25-30 minutes or until cauliflower is fully cooked and cheese has melted.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-casserole/#wprm-recipe-53533-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/10/Keto-Chicken-Casserole-6.jpg"
    },
    {
      "text": "Serve and enjoy.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-casserole/#wprm-recipe-53533-step-0-6",
      "imageSource": null
    }
  ],
