  "ingredients": [
    "1 medium green bell pepper",
    "3 cup button mushrooms",
    "48 ounce boneless, skinless chicken thighs",
    "1 1/2 cup low-carb tomato sauce (such as Rao's)",
    "1/2 cup fresh tomatoes (sliced)",
    "2 teaspoon fresh garlic (minced)",
    "2 teaspoon ranch seasoning",
    "2 teaspoon paprika",
    "1 teaspoon crushed red pepper flakes",
    "1 teaspoon dried oregano",
    "1/3 cup hot sauce (such as Frank's)",
    "3 tablespoon butter"
  ],
  "instructions": [
    {
      "text": "Thinly slice the peppers and mushrooms.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/hearty-crock-pot-chicken/#wprm-recipe-50445-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/11/crockpot-chicken-stew-01.jpg"
    },
    {
      "text": "Add the chicken thighs, tomato sauce, sliced tomatoes, garlic, spices, and hot sauce to the slow cooker and set the heat to high.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/hearty-crock-pot-chicken/#wprm-recipe-50445-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/11/crockpot-chicken-stew-02.jpg"
    },
    {
      "text": "Add the sliced peppers and mushrooms and mix everything together well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/hearty-crock-pot-chicken/#wprm-recipe-50445-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/11/crockpot-chicken-stew-03.jpg"
    },
    {
      "text": "Let cook on high for 2 hours.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/hearty-crock-pot-chicken/#wprm-recipe-50445-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/11/crockpot-chicken-stew-04.jpg"
    },
    {
      "text": "Turn the heat down to low and give the ingredients a good stir. Let cook for another 3–5 hours.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/hearty-crock-pot-chicken/#wprm-recipe-50445-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/11/crockpot-chicken-stew-05.jpg"
    },
    {
      "text": "Add the butter and mix everything together. Let cook for 1 more hour without the lid on, to allow the sauce to reduce.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/hearty-crock-pot-chicken/#wprm-recipe-50445-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/11/crockpot-chicken-stew-06.jpg"
    },
    {
      "text": "Serve hot or keep in the fridge for later — this saves well and can be reheated in the microwave!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/hearty-crock-pot-chicken/#wprm-recipe-50445-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/11/crockpot-chicken-stew-07.jpg"
    }
  ],
