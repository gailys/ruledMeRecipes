  "ingredients": [
    "2 large portobello mushrooms",
    "1/2 whole rotisserie chicken",
    "1 cup cheddar cheese (shredded)",
    "1/4 cup low-carb bbq sauce",
    "1 tablespoon olive oil",
    "4 ounce coleslaw mix",
    "1 ounce mayonnaise",
    "1/2 tablespoon apple cider vinegar",
    "1/2 tablespoon lemon juice",
    "1/2 drop liquid stevia",
    "1/2 teaspoon celery seed",
    "salt and pepper (to taste)"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all the ingredients. Preheat oven to 400F and mix up the ingredients for the coleslaw.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-bbq-stuffed-mushrooms/#wprm-recipe-54045-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/11/BBQ-Chicken-Mushroom-Caps-1.jpg"
    },
    {
      "text": "Line a baking pan with parchment paper.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-bbq-stuffed-mushrooms/#wprm-recipe-54045-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/11/BBQ-Chicken-Mushroom-Caps-2.jpg"
    },
    {
      "text": "In a bowl with the shredded rotisserie chicken, add the low-carb BBQ sauce and shredded cheddar cheese. Mix until combined well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-bbq-stuffed-mushrooms/#wprm-recipe-54045-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/11/BBQ-Chicken-Mushroom-Caps-3.jpg"
    },
    {
      "text": "Break the stem off the portobello mushroom caps. Remove the black gills. Drizzle the mushroom caps with olive oil.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-bbq-stuffed-mushrooms/#wprm-recipe-54045-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/11/BBQ-Chicken-Mushroom-Caps-4.jpg"
    },
    {
      "text": "Using the rotisserie chicken mixture, spoon it into the mushroom caps.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-bbq-stuffed-mushrooms/#wprm-recipe-54045-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/11/BBQ-Chicken-Mushroom-Caps-5.jpg"
    },
    {
      "text": "Bake in the preheated oven for 30-40 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-bbq-stuffed-mushrooms/#wprm-recipe-54045-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/11/BBQ-Chicken-Mushroom-Caps-6.jpg"
    },
    {
      "text": "Serve the mushroom caps with coleslaw. Serve and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-bbq-stuffed-mushrooms/#wprm-recipe-54045-step-0-6",
      "imageSource": null
    }
