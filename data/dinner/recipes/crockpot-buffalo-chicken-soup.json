    "fatGrams": 61.5
  },
  "ingredients": [
    "24 ounce bone-in, skin-on chicken thighs (deboned)",
    "1 teaspoon onion powder",
    "1 teaspoon garlic powder",
    "1/2 teaspoon celery seed",
    "1/4 cup butter",
    "1/2 cup hot sauce",
    "3 cup beef broth",
    "1 cup heavy whipping cream",
    "2 ounce cream cheese",
    "1/4 teaspoon xanthan gum",
    "salt and pepper (to taste)"
  ],
  "instructions": [
    {
      "text": "Debone the chicken thighs (I find it easiest to do this with scissors). Cut or slice the chicken into chunks and drop them in the slow cooker.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/crockpot-buffalo-chicken-soup/#wprm-recipe-51491-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/11/img_9050.jpg"
    },
    {
      "text": "Add in the rest of the ingredients to the crockpot except for the cream, cheese, and xanthan gum. Set the slow cooker on low for 6 hours (or high for 3 hours) and let cook completely.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/crockpot-buffalo-chicken-soup/#wprm-recipe-51491-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/11/img_9053.jpg"
    },
    {
      "text": "Once everything is cooked, remove the chicken from the slow cooker and shred using a fork.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/crockpot-buffalo-chicken-soup/#wprm-recipe-51491-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/11/img_9223.jpg"
    },
    {
      "text": "Add the cream, cheese, and xanthan gum to the slow cooker. Using an immersion blender, mix the ingredients together until emulsified. This will help keep the soup from separating.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/crockpot-buffalo-chicken-soup/#wprm-recipe-51491-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/11/img_9229.jpg"
    },
    {
      "text": "Place the chicken back into the slow cooker and stir everything together. Season to taste with salt and pepper.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/crockpot-buffalo-chicken-soup/#wprm-recipe-51491-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/11/img_9241.jpg"
    },
    {
      "text": "Serve and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/crockpot-buffalo-chicken-soup/#wprm-recipe-51491-step-0-5",
      "imageSource": null
    }
  ],
