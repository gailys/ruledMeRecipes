  "ingredients": [
    "16 ounce ground pork",
    "16 ounce ground beef",
    "4 medium green onion (chopped)",
    "1 teaspoon salt",
    "1 teaspoon garlic powder",
    "1 teaspoon ground ginger",
    "3 medium bird's eye chile pepper (chopped)",
    "2 tablespoon soy sauce",
    "1/4 cup almond flour",
    "1 1/2 tablespoon olive oil",
    "1 1/2 tablespoon sesame oil",
    "6 tablespoon sesame seeds (optional)",
    "1/3 cup sugar free apricot preserves",
    "1/4 cup water",
    "1/4 teaspoon crushed red pepper flakes",
    "2 tablespoon lime juice"
  ],
  "instructions": [
    {
      "text": "Add ground pork, ground beef, spring onions, and red chili peppers to a large mixing bowl.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/thai-chili-lime-meatballs/#wprm-recipe-51061-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/05/IMG_1954.jpg"
    },
    {
      "text": "Mix everything together well, then add soy sauce, lime juice, salt, garlic powder, and ginger powder.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/thai-chili-lime-meatballs/#wprm-recipe-51061-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/05/IMG_1957.jpg"
    },
    {
      "text": "Mix everything together again and then add almond flour on top. Mix well until almond flour is absorbed into mixture.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/thai-chili-lime-meatballs/#wprm-recipe-51061-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/05/IMG_1958.jpg"
    },
    {
      "text": "Roll out the meatballs to the size of your preference.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/thai-chili-lime-meatballs/#wprm-recipe-51061-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/05/IMG_1964.jpg"
    },
    {
      "text": "Heat olive oil and sesame oil in a cast iron skillet over medium-high heat. Once the oil is hot, drop the meatballs in, making sure not to overcrowd the pan. The meat should sizzle when you drop it in.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/thai-chili-lime-meatballs/#wprm-recipe-51061-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/05/IMG_1967.jpg"
    },
    {
      "text": "Cover the pan with a lid and let cook for about 3 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/thai-chili-lime-meatballs/#wprm-recipe-51061-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/05/IMG_1970.jpg"
    },
    {
      "text": "Flip the meatballs over, cover, and cook for an additional 3 minutes or until cooked all the way through.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/thai-chili-lime-meatballs/#wprm-recipe-51061-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/05/IMG_1973.jpg"
    },
    {
      "text": "In a small pan, add sugar free apricot preserves, water, lime juice, and red pepper flakes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/thai-chili-lime-meatballs/#wprm-recipe-51061-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/05/IMG_1976.jpg"
    },
    {
      "text": "Bring sauce to a rolling boil and let reduce while stirring occasionally. Once the meatballs are cooked, add all of the pan drippings to the sauce and continue to reduce until you find the consistency you want. Pour over meatballs or serve on the side.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/thai-chili-lime-meatballs/#wprm-recipe-51061-step-0-8",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/05/IMG_1980.jpg"
    },
    {
      "text": "Optional – coat meatballs in sesame seeds and serve with a side of dipping sauce.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/thai-chili-lime-meatballs/#wprm-recipe-51061-step-0-9",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/05/ThaiLimeMeatballs.jpg"
    }
  ],
