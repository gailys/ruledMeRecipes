  "ingredients": [
    "1 tablespoon butter",
    "1 tablespoon coconut oil",
    "1 medium onion (diced)",
    "1 medium green bell pepper (diced)",
    "1 medium yellow bell pepper (diced)",
    "1 tablespoon fresh garlic (minced)",
    "16 ounce ground hot italian sausage",
    "16 ounce ground beef",
    "10 ounce canned tomatoes with jalapeno and cilantro (like Organic 365)",
    "1 teaspoon onion powder",
    "2 tablespoon chili powder",
    "2 tablespoon curry powder",
    "2 tablespoon cumin",
    "1 teaspoon salt",
    "1 teaspoon black pepper"
  ],
  "instructions": [
    {
      "text": "Grab a big pan and set to medium-high heat. Add the butter and coconut oil and let it melt.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/beanless-low-carb-chili-con-carne/#wprm-recipe-50405-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/11/keto-chili-con-carne-01.jpg"
    },
    {
      "text": "In the pan, add the onion, peppers, and minced garlic. Let them saute down, stirring often.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/beanless-low-carb-chili-con-carne/#wprm-recipe-50405-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/11/keto-chili-con-carne-02.jpg"
    },
    {
      "text": "Grab another pot, set to medium heat, then add the hot sausage and ground beef.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/beanless-low-carb-chili-con-carne/#wprm-recipe-50405-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/11/keto-chili-con-carne-03.jpg"
    },
    {
      "text": "Cook this until browned, stirring to break up and adding salt and pepper to taste.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/beanless-low-carb-chili-con-carne/#wprm-recipe-50405-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/11/keto-chili-con-carne-04.jpg"
    },
    {
      "text": "Add the onion, peppers, and garlic to the pot with the ground beef and sausage.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/beanless-low-carb-chili-con-carne/#wprm-recipe-50405-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/11/keto-chili-con-carne-05.jpg"
    },
    {
      "text": "Add canned tomato, onion powder, and chili powder.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/beanless-low-carb-chili-con-carne/#wprm-recipe-50405-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/11/keto-chili-con-carne-06.jpg"
    },
    {
      "text": "Let this cook for 20 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/beanless-low-carb-chili-con-carne/#wprm-recipe-50405-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/11/keto-chili-con-carne-07.jpg"
    },
    {
      "text": "Add curry powder and cumin and let cook for another 10 minutes, stirring often.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/beanless-low-carb-chili-con-carne/#wprm-recipe-50405-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/11/keto-chili-con-carne-08.jpg"
    },
    {
      "text": "Let simmer for 45 minutes to 2 hours, depending on how thick you want it to be.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/beanless-low-carb-chili-con-carne/#wprm-recipe-50405-step-0-8",
      "imageSource": null
