  "ingredients": [
    "1 tablespoon olive oil",
    "16 ounce boneless, skinless chicken thighs",
    "1/2 teaspoon garlic powder",
    "1/2 teaspoon onion powder",
    "salt and pepper (to taste)",
    "16 ounce broccoli (florets)",
    "3/4 cup chicken broth",
    "3/4 cup heavy cream",
    "1 tablespoon fresh dill"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all the ingredients. Season the chicken with garlic powder, salt, and pepper.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-broccoli-dill-sauce/#wprm-recipe-54179-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/03/Keto-Chicken-Broccoli-with-Dill-Sauce-1.jpg"
    },
    {
      "text": "In a frying pan over medium heat, add the olive oil and chicken and cook for about 6-8 minutes per side. Remove chicken from pan but keep warm.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-broccoli-dill-sauce/#wprm-recipe-54179-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/03/Keto-Chicken-Broccoli-with-Dill-Sauce-2.jpg"
    },
    {
      "text": "Add broccoli and the chicken broth to the same frying pan. Bring to a boil then reduce heat and let simmer covered for 4 - 5 minutes. Remove broccoli from pan but leave the broth. Keep broccoli warm.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-broccoli-dill-sauce/#wprm-recipe-54179-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/03/Keto-Chicken-Broccoli-with-Dill-Sauce-3.jpg"
    },
    {
      "text": "In a bowl, mix together heavy cream and fresh dill. Stir that into the frying pan with the chicken broth. Bring this to a boil and let the sauce thicken.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-broccoli-dill-sauce/#wprm-recipe-54179-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/03/Keto-Chicken-Broccoli-with-Dill-Sauce-4.jpg"
    },
    {
      "text": "Add the chicken into the pan and cover with lid. Cook on medium heat for 10 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-broccoli-dill-sauce/#wprm-recipe-54179-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/03/Keto-Chicken-Broccoli-with-Dill-Sauce-5.jpg"
    },
    {
      "text": "Serve the creamy chicken with the broccoli. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-broccoli-dill-sauce/#wprm-recipe-54179-step-0-5",
      "imageSource": null
    }
  ],
