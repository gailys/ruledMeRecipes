  "ingredients": [
    "2 tablespoon olive oil",
    "24 ounce ground beef",
    "1 medium red onion",
    "2 teaspoon fresh garlic (minced)",
    "1 teaspoon paprika",
    "1 medium red bell pepper (diced)",
    "14 ounce canned diced tomatoes",
    "1 tablespoon soy sauce",
    "1 tablespoon tomato paste",
    "2 whole bay leaf",
    "6 ounce spinach",
    "3 tablespoon fresh parsley (chopped, plus extra to serve)",
    "salt and pepper (to taste)",
    "2 cup beef broth",
    "1 teaspoon dried oregano",
    "7 ounce mozzarella cheese"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all the ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheesy-beef-spinach-casserole/#wprm-recipe-53877-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/05/Cheesy-Beef-Spinach-Casserole-1.jpg"
    },
    {
      "text": "Chop the onion and add olive oil to a frying pan.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheesy-beef-spinach-casserole/#wprm-recipe-53877-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/05/Cheesy-Beef-Spinach-Casserole-2.jpg"
    },
    {
      "text": "On medium to high heat, add the ground beef to the frying pan and cook for about 6 - 8 minutes or until cooked thoroughly.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheesy-beef-spinach-casserole/#wprm-recipe-53877-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/05/Cheesy-Beef-Spinach-Casserole-3.jpg"
    },
    {
      "text": "Add the onion, minced garlic, paprika, red bell pepper, canned diced tomatoes, soy sauce, and tomato paste to the beef. Simmer for 20 minutes on medium heat.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheesy-beef-spinach-casserole/#wprm-recipe-53877-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/05/Cheesy-Beef-Spinach-Casserole-5.jpg"
    },
    {
      "text": "Add the bay leaves, fresh parsley and beef stock. Reduce heat to low and cook for 10 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheesy-beef-spinach-casserole/#wprm-recipe-53877-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/05/Cheesy-Beef-Spinach-Casserole-6.jpg"
    },
    {
      "text": "Stir in the spinach until it is wilted. Preheat oven to 375F.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheesy-beef-spinach-casserole/#wprm-recipe-53877-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/05/Cheesy-Beef-Spinach-Casserole-7.jpg"
    },
    {
      "text": "Add mozzarella cheese to the top of the dish and put in the oven and bake for 5 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheesy-beef-spinach-casserole/#wprm-recipe-53877-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/05/Cheesy-Beef-Spinach-Casserole-8.jpg"
    },
    {
      "text": "Once the cheese has melted, remove from the oven and top with parsley and dried oregano.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheesy-beef-spinach-casserole/#wprm-recipe-53877-step-0-7",
      "imageSource": null
    }
