  "ingredients": [
    "cooking spray",
    "3 medium zucchini",
    "1 tablespoon butter",
    "1 medium onion (halved, sliced)",
    "1 teaspoon fresh garlic (crushed)",
    "1 tablespoon red wine vinegar",
    "1/2 cup heavy whipping cream",
    "4 ounce cream cheese",
    "8 ounce crab meat",
    "45 gram green onion (thinly sliced)",
    "2 teaspoon old bay seasoning",
    "1/2 teaspoon salt",
    "1/4 teaspoon black pepper",
    "1/2 cup mexican-style cheese blend (shredded)"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 375F. Grease a baking dish. Bring water to a simmer in the lower part of a steamer.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-crab-zucchini-casserole/#wprm-recipe-51991-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/11/crab-zucchini-casserole-01-1.jpg"
    },
    {
      "text": "Spiralize the zucchini on the widest ribbon setting, or slice very thinly. Sprinkle lightly with salt. Transfer the zucchini to the steamer basket, stretching the spirals to help the steam reach everywhere. Cover and steam until the zucchini is barely tender (about 5–7 minutes). Once cooked, remove the steamer basket and uncover. Place the steamer basket over a bowl to allow any excess moisture to drain.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-crab-zucchini-casserole/#wprm-recipe-51991-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/11/crab-zucchini-casserole-02.jpg"
    },
    {
      "text": "Heat a large skillet over medium heat and then add the butter. Once the butter stops foaming, add the onions and cook until softened and beginning to brown on the edges. Stir in the garlic and cook for 1 minute.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-crab-zucchini-casserole/#wprm-recipe-51991-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/11/crab-zucchini-casserole-03.jpg"
    },
    {
      "text": "Add the vinegar, stirring continuously and scraping up any browned bits, until the vinegar has almost completely evaporated. Pour in the cream and add the cream cheese in chunks. Continue stirring until the mixture is thickened and the cheese has melted.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-crab-zucchini-casserole/#wprm-recipe-51991-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/11/crab-zucchini-casserole-03-1.jpg"
    },
    {
      "text": "Stir in the crab meat and green onions.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-crab-zucchini-casserole/#wprm-recipe-51991-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/11/crab-zucchini-casserole-05.jpg"
    },
    {
      "text": "Stir in the Old Bay, salt, and pepper. Taste and adjust the seasonings, if necessary.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-crab-zucchini-casserole/#wprm-recipe-51991-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/11/crab-zucchini-casserole-06.jpg"
    },
    {
      "text": "Add the steamed zucchini to the pan and mix everything together.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-crab-zucchini-casserole/#wprm-recipe-51991-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/11/crab-zucchini-casserole-07.jpg"
    },
    {
      "text": "Transfer the mixture to the prepared baking dish and top with the shredded cheese.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-crab-zucchini-casserole/#wprm-recipe-51991-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/11/crab-zucchini-casserole-04.jpg"
    },
    {
      "text": "Bake for 20–25 minutes, or until the casserole is bubbling and the cheese is melted and beginning to brown.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-crab-zucchini-casserole/#wprm-recipe-51991-step-0-8",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/11/crab-zucchini-casserole-pin-02.jpg"
    },
    {
      "text": "Let cool for 5–10 minutes before serving.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-crab-zucchini-casserole/#wprm-recipe-51991-step-0-9",
      "imageSource": null
    }
  ],
