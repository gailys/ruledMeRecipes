  "ingredients": [
    "2 tablespoon olive oil",
    "4 ounce salmon (cubed into 2-inch pieces)",
    "50 gram carrot (chopped)",
    "119 gram orange bell pepper (chopped)",
    "20 gram shallot (diced)",
    "4 tablespoon soy sauce (or coconut aminos)",
    "2 tablespoon sesame oil",
    "2 tablespoon japanese seven-spice powder ((shachimi togarashi))",
    "588 gram cauliflower (riced)",
    "salt and pepper (to taste)"
  ],
  "instructions": [
    {
      "text": "In a medium-sized stock pot, heat up the olive oil over medium heat. Sauté the cubed salmon for about 5 minutes, stirring occasionally, until they have gone from pink to white.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/spicy-cauliflower-rice-salmon-medley/#wprm-recipe-52173-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/05/spicy-fried-cauliflower-step-4.jpg"
    },
    {
      "text": "Add the carrot, peppers, and shallots. Sauté for another 5 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/spicy-cauliflower-rice-salmon-medley/#wprm-recipe-52173-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/05/spicy-fried-cauliflower-step-6.jpg"
    },
    {
      "text": "Stir in the soy sauce and sesame oil, making sure to thoroughly coat the vegetables and fish. Season with the 7-spice powder and stir for 2–3 minutes, letting the fish soak up the soy and sesame.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/spicy-cauliflower-rice-salmon-medley/#wprm-recipe-52173-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/05/spicy-fried-cauliflower-step-7.jpg"
    },
    {
      "text": "Add the cauliflower rice and stir it in with a wooden spoon. Turn the heat up to medium-high and fry the cauliflower, stirring occasionally, until desired doneness. Season with salt and pepper to taste.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/spicy-cauliflower-rice-salmon-medley/#wprm-recipe-52173-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/05/spicy-fried-cauliflower-step-8.jpg"
    },
    {
      "text": "Serve and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/spicy-cauliflower-rice-salmon-medley/#wprm-recipe-52173-step-0-4",
