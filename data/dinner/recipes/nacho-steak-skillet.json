  "ingredients": [
    "24 ounce cauliflower",
    "1/3 cup coconut oil (melted)",
    "1 teaspoon chili powder",
    "1/2 teaspoon turmeric powder",
    "salt and pepper (to taste)",
    "8 ounce beef round tip steak (thinly sliced)",
    "1 tablespoon butter",
    "1 ounce cheddar cheese (shredded)",
    "1 ounce monterey jack cheese (shredded)",
    "30 gram canned jalapeno slices",
    "1/3 cup sour cream",
    "136 gram avocado meat (mashed)"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 400F. Remove the leaves and bottom stem from the cauliflower and slice it across the head to break it up into chip-like shapes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/nacho-steak-skillet/#wprm-recipe-52201-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/05/step1.jpg"
    },
    {
      "text": "In a large mixing bowl, whisk together the coconut oil, chili powder, and turmeric. Add the cauliflower and gently toss until evenly coated.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/nacho-steak-skillet/#wprm-recipe-52201-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/05/step2.jpg"
    },
    {
      "text": "Spread the cauliflower out on a baking sheet. Season well with salt and pepper. Roast for 20–25 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/nacho-steak-skillet/#wprm-recipe-52201-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/05/step3.jpg"
    },
    {
      "text": "While the cauliflower is roasting, get the rest of the toppings ready. Preheat a cast-iron skillet over medium-high heat. Liberally season both sides of the steak with salt and pepper. Add the butter to the skillet and let it melt. Once the butter stops foaming, lay the steak in the pan. Let sit (don't touch it!) until beginning to cook through. Flip it over briefly to cook the other side and then remove from the pan.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/nacho-steak-skillet/#wprm-recipe-52201-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/05/step4.jpg"
    },
    {
      "text": "Rest for 5–10 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/nacho-steak-skillet/#wprm-recipe-52201-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/05/step5.jpg"
    },
    {
      "text": "Once the cauliflower is done, remove it from the oven and transfer the florets to the cast-iron pan.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/nacho-steak-skillet/#wprm-recipe-52201-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/05/step6.jpg"
    },
    {
      "text": "Slice the steak into fork-sized strips.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/nacho-steak-skillet/#wprm-recipe-52201-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/05/step7.jpg"
    },
    {
      "text": "Top the cauliflower with the steak.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/nacho-steak-skillet/#wprm-recipe-52201-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/05/step8.jpg"
    },
    {
      "text": "Top the skillet with the shredded cheeses and jalapeño slices. Bake for another 5–10 minutes or until the cheese has melted.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/nacho-steak-skillet/#wprm-recipe-52201-step-0-8",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/05/step9-2.jpg"
    },
    {
      "text": "Serve with sour cream and guacamole.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/nacho-steak-skillet/#wprm-recipe-52201-step-0-9",
      "imageSource": null
    }
  ],
