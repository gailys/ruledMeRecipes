  "ingredients": [
    "24 ounce ground beef",
    "2 large egg yolk",
    "1 medium yellow onion (finely diced)",
    "2 teaspoon fresh garlic (minced)",
    "salt and pepper (to taste)",
    "2 tablespoon butter (for frying)",
    "1 cup heavy whipping cream",
    "16 ounce broccoli"
  ],
  "instructions": [
    {
      "text": "Prepare all the ingredients. Separate the eggs, trim the broccoli, chop the onion, and mince the garlic.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/garlic-burgers-with-cream-sauce-and-broccoli/#wprm-recipe-53513-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/09/Beef-Burgers-with-Cream-Sauce-and-Broccoli-1.jpg"
    },
    {
      "text": "In a bowl, mix together the beef, egg yolks, onion, minced garlic, and salt and pepper. Form the burgers into patties with your hands, one burger per serving.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/garlic-burgers-with-cream-sauce-and-broccoli/#wprm-recipe-53513-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/09/Beef-Burgers-with-Cream-Sauce-and-Broccoli-2.jpg"
    },
    {
      "text": "Add the butter into a pan on medium to high heat to let it start melting. Once hot, fry the burger patties in the butter until they are browned on both sides and cooked through. Take the burgers out of the pan, set aside, and keep warm. Leave any extra fat or browned bits in the pan.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/garlic-burgers-with-cream-sauce-and-broccoli/#wprm-recipe-53513-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/09/Beef-Burgers-with-Cream-Sauce-and-Broccoli-3.jpg"
    },
    {
      "text": "Add the heavy whipping cream to the same frying pan. Bring to a boil then let simmer on medium heat for 5 minutes. Keep on medium heat, reducing, until desired consistency is reached. Add salt and pepper to taste.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/garlic-burgers-with-cream-sauce-and-broccoli/#wprm-recipe-53513-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/09/Beef-Burgers-with-Cream-Sauce-and-Broccoli-4.jpg"
    },
    {
      "text": "Boil the broccoli for 2-4 minutes. Drain and allow the broccoli to steam until al dente.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/garlic-burgers-with-cream-sauce-and-broccoli/#wprm-recipe-53513-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/09/Beef-Burgers-with-Cream-Sauce-and-Broccoli-5.jpg"
    },
    {
      "text": "Plate the burgers with the cream sauce and broccoli.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/garlic-burgers-with-cream-sauce-and-broccoli/#wprm-recipe-53513-step-0-5",
      "imageSource": null
    }
