  "description": "This makes a total of 3 servings of 15-Minute Keto Lamb & Asparagus Stir Fry. Each serving comes out to be 516 calories, 40.2g fats, 6.2g net carbs, and 29.3g protein.",
  "servings": 3,
  "yield": [
    "3",
    "3 servings"
  ],
  "prepTime": "PT5M",
  "cookTime": "PT10M",
  "totalTime": "PT15M",
  "totalMinutes": 15,
