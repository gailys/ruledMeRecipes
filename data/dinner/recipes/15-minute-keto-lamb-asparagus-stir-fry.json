    "fatGrams": 40.2
  },
  "ingredients": [
    "1 tablespoon olive oil",
    "16 ounce ground lamb",
    "salt and pepper (to taste)",
    "1 tablespoon fresh garlic (minced)",
    "1 tablespoon fresh ginger (grated or minced)",
    "6 medium green onion (finely sliced)",
    "16 ounce asparagus spears (trimmed and sliced diagonal ~1/2 inch thick)",
    "1/2 medium lemon (zested)"
  ],
  "instructions": [
    {
      "text": "Gather and prep all of your ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/15-minute-keto-lamb-asparagus-stir-fry/#wprm-recipe-57406-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/11/15-Minute-Keto-Lamb-Asparagus-Stir-Fry-1.jpg"
    },
    {
      "text": "Add olive oil and garlic to a pan over medium heat. Cast-iron or heavy bottom pots work best due to heat transfer, but any pan will work.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/15-minute-keto-lamb-asparagus-stir-fry/#wprm-recipe-57406-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/11/15-Minute-Keto-Lamb-Asparagus-Stir-Fry-2.jpg"
    },
    {
      "text": "Once hot, add the lamb and press the meat into the bottom of the pan. Add the ginger and season with salt and pepper. Allow to cook without stirring, until the lamb is deeply browned at the bottom. About 5-7 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/15-minute-keto-lamb-asparagus-stir-fry/#wprm-recipe-57406-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/11/15-Minute-Keto-Lamb-Asparagus-Stir-Fry-3.jpg"
    },
    {
      "text": "Once lamb is browned well, break up the meat and stir in the green onion. Toss to combine.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/15-minute-keto-lamb-asparagus-stir-fry/#wprm-recipe-57406-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/11/15-Minute-Keto-Lamb-Asparagus-Stir-Fry-4.jpg"
    },
    {
      "text": "Add in the asparagus and lemon zest, then season with salt and pepper. Cook, stirring often, until asparagus is bright green and crisp but tender, about 3-4 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/15-minute-keto-lamb-asparagus-stir-fry/#wprm-recipe-57406-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/11/15-Minute-Keto-Lamb-Asparagus-Stir-Fry-6.jpg"
    },
    {
      "text": "Taste and season again if necessary. Serve immediately and enjoy! Optionally garnish with additional lemon if desired.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/15-minute-keto-lamb-asparagus-stir-fry/#wprm-recipe-57406-step-0-5",
      "imageSource": null
    }
  ],
