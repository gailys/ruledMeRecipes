  "ingredients": [
    "2 tablespoon olive oil",
    "24 ounce boneless, skinless chicken thighs",
    "salt and pepper (to taste)",
    "2 tablespoon butter",
    "1/3 cup onion (diced)",
    "3 teaspoon fresh garlic (minced)",
    "1/2 teaspoon crushed red pepper flakes",
    "1 cup heavy cream",
    "1 cup chicken broth",
    "2 tablespoon sun-dried tomatoes",
    "2 ounce cream cheese (softened)",
    "1/2 cup grated parmesan cheese",
    "8 ounce spinach"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all the ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/one-pan-keto-chicken-and-spinach/#wprm-recipe-54017-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/11/One-Pan-Keto-Chicken-and-Spinach-1.jpg"
    },
    {
      "text": "In a skillet over medium heat, add the oil and chicken thighs. Season with salt and pepper to taste. Cook until the chicken reaches an internal temp of 165F. Set aside.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/one-pan-keto-chicken-and-spinach/#wprm-recipe-54017-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/11/One-Pan-Keto-Chicken-and-Spinach-2.jpg"
    },
    {
      "text": "In the same skillet, add the butter, onion, garlic, and crushed red pepper flakes. Stir to combine well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/one-pan-keto-chicken-and-spinach/#wprm-recipe-54017-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/11/One-Pan-Keto-Chicken-and-Spinach-3.jpg"
    },
    {
      "text": "Then, add in the heavy cream, chicken broth, sun-dried tomatoes, and softened cream cheese. Stir to combine and let simmer for a few minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/one-pan-keto-chicken-and-spinach/#wprm-recipe-54017-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/11/One-Pan-Keto-Chicken-and-Spinach-4.jpg"
    },
    {
      "text": "Add in the grated parmesan cheese and spinach. Let this cook until the spinach starts to get wilty.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/one-pan-keto-chicken-and-spinach/#wprm-recipe-54017-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/11/One-Pan-Keto-Chicken-and-Spinach-5.jpg"
    },
    {
      "text": "Place the chicken thighs back into the pan to just get warm.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/one-pan-keto-chicken-and-spinach/#wprm-recipe-54017-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/11/One-Pan-Keto-Chicken-and-Spinach-6.jpg"
    },
    {
      "text": "Serve immediately and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/one-pan-keto-chicken-and-spinach/#wprm-recipe-54017-step-0-6",
      "imageSource": null
    }
  ],
