  "ingredients": [
    "3 tablespoon olive oil",
    "1/2 medium red onion (thinly sliced)",
    "2 small carrot (shredded)",
    "3 ounce celery (chopped)",
    "4 cup green cabbage (shredded)",
    "1 cup button mushrooms (sliced)",
    "2 tablespoon soy sauce",
    "salt and pepper (to taste)",
    "1 teaspoon sesame oil",
    "1 medium green onion (chopped for garnish)",
    "1 teaspoon sesame seeds (for garnish)"
  ],
  "instructions": [
    {
      "text": "Heat a large skillet that has a fitted lid, then add half the olive oil. Cook the onion, carrots, and celery until they soften.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/vegan-egg-roll-in-a-bowl/#wprm-recipe-59690-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/08/vegan-egg-roll-in-a-bowl-step-01.jpg"
    },
    {
      "text": "Add the cabbage, mushrooms, soy sauce, salt, and pepper. Drizzle in a little water and remaining olive oil. It will sizzle and steam; use it to loosen up any brown bits on the bottom of the pan.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/vegan-egg-roll-in-a-bowl/#wprm-recipe-59690-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/08/vegan-egg-roll-in-a-bowl-step-02.jpg"
    },
    {
      "text": "Lower the heat and cover skillet with the lid. Cook for about 15 minutes or until the vegetables become tender. Remove from heat and mix in the sesame oil, so the flavor doesn't cook out.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/vegan-egg-roll-in-a-bowl/#wprm-recipe-59690-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/08/vegan-egg-roll-in-a-bowl-step-03.jpg"
    },
    {
      "text": "Check the seasoning and add more salt and pepper if needed. Garnish with chopped green onions and sesame seeds to serve.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/vegan-egg-roll-in-a-bowl/#wprm-recipe-59690-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/08/vegan-egg-roll-in-a-bowl-step-04.jpg"
    }
