  "ingredients": [
    "20 ounce cooked chicken",
    "7 ounce cherry tomatoes (sliced)",
    "8 ounce fresh mozzarella cheese",
    "2 tablespoon pesto",
    "1/2 cup sour cream",
    "1/4 cup mayonnaise",
    "2 ounce parmesan cheese",
    "salt and pepper (to taste)",
    "7 ounce leafy greens",
    "1 tablespoon apple cider vinegar",
    "4 tablespoon olive oil"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all the ingredients. Preheat oven to 400F.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-caprese-casserole/#wprm-recipe-53609-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/12/Keto-Chicken-Caprese-Casserole-1.jpg"
    },
    {
      "text": "Shred the chicken using a knife.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-caprese-casserole/#wprm-recipe-53609-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/12/Keto-Chicken-Caprese-Casserole-2.jpg"
    },
    {
      "text": "Cut the mozzarella cheese into small pieces. Put the shredded chicken, cherry tomatoes, and mozzarella cheese into a baking dish.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-caprese-casserole/#wprm-recipe-53609-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/12/Keto-Chicken-Caprese-Casserole-3.jpg"
    },
    {
      "text": "In a bowl, combine pesto, sour cream, mayonnaise, and half of the parmesan cheese. Stir until well combined. Add salt and pepper to taste.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-caprese-casserole/#wprm-recipe-53609-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/12/Keto-Chicken-Caprese-Casserole-4.jpg"
    },
    {
      "text": "Add this mixture to the baking dish and mix in the chicken, tomatoes, and mozzarella cheese. Top with the remaining parmesan cheese. Bake in the oven for 20 minutes or until golden brown.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-caprese-casserole/#wprm-recipe-53609-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/12/Keto-Chicken-Caprese-Casserole-5.jpg"
    },
    {
      "text": "While it's baking, toss the leafy greens with apple cider vinegar and plate, drizzling olive oil over the top.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-caprese-casserole/#wprm-recipe-53609-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/12/Keto-Chicken-Caprese-Casserole-6.jpg"
    },
    {
      "text": "Plate the casserole alongside the leafy greens and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-caprese-casserole/#wprm-recipe-53609-step-0-6",
      "imageSource": null
    }
  ],
