  "ingredients": [
    "2 tablespoon soy sauce",
    "5 teaspoon fresh garlic (minced)",
    "1 tablespoon fresh ginger (grated or minced)",
    "2 teaspoon chili-garlic paste",
    "1 tablespoon allulose",
    "2 tablespoon avocado oil",
    "1 medium yellow onion (sliced)",
    "16 ounce ground turkey",
    "salt",
    "1 medium carrot (grated)",
    "1 medium red bell pepper (sliced)",
    "5 ounce red cabbage (finely chopped)",
    "4 medium green onion (sliced)"
  ],
  "instructions": [
    {
      "text": "Gather and prep all of your ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/easy-keto-turkey-stir-fry/#wprm-recipe-57129-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/08/Easy-Keto-Turkey-Stir-Fry-1.jpg"
    },
    {
      "text": "Mix together the stir-fry sauce by combining all of the ingredients in a bowl. Set aside.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/easy-keto-turkey-stir-fry/#wprm-recipe-57129-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/08/Easy-Keto-Turkey-Stir-Fry-2.jpg"
    },
    {
      "text": "Heat the avocado oil in a pan over medium-high heat. Once hot, add in the onion and cook until soft, about 2 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/easy-keto-turkey-stir-fry/#wprm-recipe-57129-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/08/Easy-Keto-Turkey-Stir-Fry-4.jpg"
    },
    {
      "text": "Add in the ground turkey and break up the meat with a wooden spoon. Season lightly with salt.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/easy-keto-turkey-stir-fry/#wprm-recipe-57129-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/08/Easy-Keto-Turkey-Stir-Fry-5.jpg"
    },
    {
      "text": "Once turkey is starting to brown, add in the carrot, bell pepper, and red cabbage. Cook until softened, about 3-4 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/easy-keto-turkey-stir-fry/#wprm-recipe-57129-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/08/Easy-Keto-Turkey-Stir-Fry-6.jpg"
    },
    {
      "text": "Add in your stir fry sauce and mix together well. Allow the sauce to thicken, while stirring, about 2-3 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/easy-keto-turkey-stir-fry/#wprm-recipe-57129-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/08/Easy-Keto-Turkey-Stir-Fry-7.jpg"
    },
    {
      "text": "Top with green onion, then serve immediately. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/easy-keto-turkey-stir-fry/#wprm-recipe-57129-step-0-6",
      "imageSource": null
    }
