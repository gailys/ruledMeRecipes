  "ingredients": [
    "3 medium zucchini",
    "2 tablespoon olive oil (divided)",
    "12 ounce boneless, skinless chicken breast",
    "salt and pepper (to taste)",
    "1 teaspoon italian seasoning",
    "2 teaspoon fresh garlic (minced)",
    "3/4 cup heavy cream",
    "4 ounce cream cheese",
    "1/2 cup parmesan cheese (plus more for serving)",
    "6 ounce baby spinach"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all the ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-alfredo-zoodles/#wprm-recipe-53873-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/05/Keto-Chicken-Alfredo-Zoodles-1.jpg"
    },
    {
      "text": "Using a vegetable peeler, peel the zucchini lengthwise.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-alfredo-zoodles/#wprm-recipe-53873-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/05/Keto-Chicken-Alfredo-Zoodles-2.jpg"
    },
    {
      "text": "Heat oil in a frying pan over medium to high heat. Season the chicken with Italian seasoning and salt and pepper. Cook both sides of the chicken until thoroughly cooked.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-alfredo-zoodles/#wprm-recipe-53873-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/05/Keto-Chicken-Alfredo-Zoodles-3.jpg"
    },
    {
      "text": "Remove the chicken from heat and cut into thin strips.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-alfredo-zoodles/#wprm-recipe-53873-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/05/Keto-Chicken-Alfredo-Zoodles-4.jpg"
    },
    {
      "text": "Add the rest of the olive oil to the frying pan along with the minced garlic. Fry for about 30 seconds.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-alfredo-zoodles/#wprm-recipe-53873-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/05/Keto-Chicken-Alfredo-Zoodles-5.jpg"
    },
    {
      "text": "Add heavy cream and cream cheese. Stir constantly until the cream cheese is melted. Add parmesan cheese and salt and pepper. Stir and simmer for 4 - 5 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-alfredo-zoodles/#wprm-recipe-53873-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/05/Keto-Chicken-Alfredo-Zoodles-6.jpg"
    },
    {
      "text": "Add the sliced chicken, zucchini peels, and top with parsley.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-alfredo-zoodles/#wprm-recipe-53873-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/05/Keto-Chicken-Alfredo-Zoodles-7.jpg"
    },
    {
      "text": "Plate and serve!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-alfredo-zoodles/#wprm-recipe-53873-step-0-7",
