  "ingredients": [
    "24 ounce boneless, skinless chicken thighs",
    "salt and pepper (to taste)",
    "1 teaspoon onion powder",
    "2 teaspoon italian seasoning",
    "3 tablespoon butter",
    "5 teaspoon fresh garlic (minced)",
    "1/2 cup chicken broth",
    "1 tablespoon lemon juice",
    "1/2 cup heavy cream",
    "12 ounce asparagus spears (trimmed and chopped)"
  ],
  "instructions": [
    {
      "text": "Gather and prep all of your ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/one-pan-chicken-asparagus-with-garlic-sauce/#wprm-recipe-57292-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/09/One-Pan-Chicken-Asparagus-with-Garlic-Sauce-1.jpg"
    },
    {
      "text": "Season chicken with salt, pepper, onion powder, and Italian seasoning on both sides.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/one-pan-chicken-asparagus-with-garlic-sauce/#wprm-recipe-57292-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/09/One-Pan-Chicken-Asparagus-with-Garlic-Sauce-2.jpg"
    },
    {
      "text": "In a pan over medium heat, add butter and garlic. Let garlic cook for 30 seconds until fragrant.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/one-pan-chicken-asparagus-with-garlic-sauce/#wprm-recipe-57292-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/09/One-Pan-Chicken-Asparagus-with-Garlic-Sauce-3.jpg"
    },
    {
      "text": "Once garlic is fragrant, add chicken and stir together. Sear chicken for 2-3 minutes on both sides.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/one-pan-chicken-asparagus-with-garlic-sauce/#wprm-recipe-57292-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/09/One-Pan-Chicken-Asparagus-with-Garlic-Sauce-4.jpg"
    },
    {
      "text": "Once chicken is seared, add in the broth, lemon juice, and cream. Lightly stir and bring to a boil.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/one-pan-chicken-asparagus-with-garlic-sauce/#wprm-recipe-57292-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/09/One-Pan-Chicken-Asparagus-with-Garlic-Sauce-5.jpg"
    },
    {
      "text": "Once liquid is boiling, reduce heat to medium-low and add in the asparagus. Season with additional salt and pepper if desired.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/one-pan-chicken-asparagus-with-garlic-sauce/#wprm-recipe-57292-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/09/One-Pan-Chicken-Asparagus-with-Garlic-Sauce-8.jpg"
    },
    {
      "text": "Allow asparagus to cook through while sauce reduces, stirring occasionally. About 8-10 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/one-pan-chicken-asparagus-with-garlic-sauce/#wprm-recipe-57292-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/09/One-Pan-Chicken-Asparagus-with-Garlic-Sauce-9.jpg"
    },
    {
      "text": "Serve while hot, scraping out any excess sauce from the pan. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/one-pan-chicken-asparagus-with-garlic-sauce/#wprm-recipe-57292-step-0-7",
      "imageSource": null
    }
  ],
