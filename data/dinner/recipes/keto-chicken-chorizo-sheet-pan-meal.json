  "ingredients": [
    "1/2 medium onion (diced)",
    "1 medium red bell pepper (diced)",
    "5 ounce chorizo sausage (peeled + diced)",
    "1/2 teaspoon paprika",
    "1/2 teaspoon onion powder",
    "1/2 teaspoon cumin",
    "1/2 teaspoon dried thyme",
    "salt and pepper (to taste)",
    "2 tablespoon olive oil",
    "1 tablespoon lemon juice",
    "12 ounce chicken tenderloins",
    "1 teaspoon paprika",
    "1/4 teaspoon cumin",
    "salt and pepper (to taste)",
    "1 tablespoon olive oil",
    "12 ounce asparagus spears (trim ends)",
    "2 teaspoon fresh garlic (finely diced)",
    "2 tablespoon lemon juice",
    "2 tablespoon olive oil",
    "salt and pepper"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all the ingredients. Preheat oven to 410F.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-chorizo-sheet-pan-meal/#wprm-recipe-53869-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/06/Chicken-Chorizo-Sheet-Pan-Meal-1.jpg"
    },
    {
      "text": "In a bowl, add the onion, red peppers, diced chorizo, paprika, onion powder, cumin powder, dried thyme, and salt and pepper.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-chorizo-sheet-pan-meal/#wprm-recipe-53869-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/06/Chicken-Chorizo-Sheet-Pan-Meal-3.jpg"
    },
    {
      "text": "Spread this mixture on a sheet pan.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-chorizo-sheet-pan-meal/#wprm-recipe-53869-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/06/Chicken-Chorizo-Sheet-Pan-Meal-5.jpg"
    },
    {
      "text": "Add the diced chicken tenderloins to the same bowl along with the paprika, cumin, salt and pepper and olive oil. Use your hands or a spoon to get the seasoning to stick to the chicken.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-chorizo-sheet-pan-meal/#wprm-recipe-53869-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/06/Chicken-Chorizo-Sheet-Pan-Meal-2.jpg"
    },
    {
      "text": "Add the seasoned chicken pieces to the pan. Cook in the oven for about 10 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-chorizo-sheet-pan-meal/#wprm-recipe-53869-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/06/Chicken-Chorizo-Sheet-Pan-Meal-6.jpg"
    },
    {
      "text": "While the chicken and chorizo is cooking in the oven, season the asparagus with garlic, lemon juice, olive oil, and salt and pepper.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-chorizo-sheet-pan-meal/#wprm-recipe-53869-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/06/Chicken-Chorizo-Sheet-Pan-Meal-4.jpg"
    },
    {
      "text": "Once the 10 minutes is up, add the seasoned asparagus to the pan and put back in the oven for another 10 minutes. Be sure to flip over the chicken and chorizo pieces to get it cooked on the other side.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-chorizo-sheet-pan-meal/#wprm-recipe-53869-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/06/Chicken-Chorizo-Sheet-Pan-Meal-7.jpg"
    },
    {
      "text": "Season with salt and pepper to taste. Plate and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-chorizo-sheet-pan-meal/#wprm-recipe-53869-step-0-7",
      "imageSource": null
