  "ingredients": [
    "24 ounce button mushrooms",
    "16 ounce chicken tenderloins",
    "1/2 teaspoon dried basil",
    "1/2 teaspoon dried oregano",
    "1/4 teaspoon dried thyme",
    "3 teaspoon fresh garlic (lightly chopped)",
    "2 whole bay leaf",
    "1 cup chicken broth",
    "salt and pepper",
    "2 tablespoon butter",
    "1/4 cup heavy whipping cream",
    "1/4 cup fresh basil (chopped)",
    "8 slice cooked bacon (crumbled)"
  ],
  "instructions": [
    {
      "text": "Wash all of the mushrooms. I like to take the stems off of the larger ones, but I also include them. Cut all of the chicken tenders into bite size pieces.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/herb-chicken-mushroom-stew/#wprm-recipe-52377-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/11/herbed-mushroom-chicken-00.jpg"
    },
    {
      "text": "Place the mushrooms into the slow cooker.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/herb-chicken-mushroom-stew/#wprm-recipe-52377-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/11/herbed-mushroom-chicken-01.jpg"
    },
    {
      "text": "Add the chicken, basil, oregano, thyme, garlic, bay leaves, and chicken broth. Season well with salt and pepper. Cover and cook for 3-4 hours on the low setting.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/herb-chicken-mushroom-stew/#wprm-recipe-52377-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/11/herbed-mushroom-chicken-03.jpg"
    },
    {
      "text": "Mix in the two tablespoons of butter and heavy whipping cream. Taste and add additional salt and pepper if needed.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/herb-chicken-mushroom-stew/#wprm-recipe-52377-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/11/herbed-mushroom-chicken-04.jpg"
    },
    {
      "text": "Serve with crumbled bacon and parsley.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/herb-chicken-mushroom-stew/#wprm-recipe-52377-step-0-4",
      "imageSource": null
