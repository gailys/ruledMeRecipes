  },
  "ingredients": [
    "4 ounce bacon",
    "16 ounce cauliflower",
    "2/3 cup sour cream",
    "8 ounce cheddar cheese (shredded)",
    "2 tablespoon fresh chives",
    "2 teaspoon fresh garlic (minced)",
    "salt and pepper (to taste)"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all the ingredients. Preheat oven to 375F.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/bacon-loaded-cauliflower-casserole/#wprm-recipe-53581-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/11/Loaded-Cauliflower-Casserole-1.jpg"
    },
    {
      "text": "Chop the bacon into small pieces. Fry in a pan over medium-high heat until crispy. Set aside, reserving the bacon fat.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/bacon-loaded-cauliflower-casserole/#wprm-recipe-53581-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/11/Loaded-Cauliflower-Casserole-2.jpg"
    },
    {
      "text": "Bring a pot of salted water to a boil. Add the cauliflower into the boiling water, breaking into smaller pieces as you place them into the pot. Boil until fork-tender. When done, drain completely.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/bacon-loaded-cauliflower-casserole/#wprm-recipe-53581-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/11/Loaded-Cauliflower-Casserole-3.jpg"
    },
    {
      "text": "Chop the cooked cauliflower into smaller pieces. In a bowl, combine the chopped cauliflower, sour cream, and minced garlic. Then, mix in about half of the cheese, half of the bacon fat, and half of the chives. Season with salt and pepper to taste.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/bacon-loaded-cauliflower-casserole/#wprm-recipe-53581-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/11/Loaded-Cauliflower-Casserole-4.jpg"
    },
    {
      "text": "Add this mixture to a baking pan and top it off with the remaining cheddar cheese. Bake in the oven for 10-15 minutes or until the cheese has melted.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/bacon-loaded-cauliflower-casserole/#wprm-recipe-53581-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/11/Loaded-Cauliflower-Casserole-5.jpg"
    },
    {
      "text": "Top with bacon, remaining bacon fat, remaining chives, and season with additional salt and pepper if desired. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/bacon-loaded-cauliflower-casserole/#wprm-recipe-53581-step-0-5",
      "imageSource": null
    }
  ],
