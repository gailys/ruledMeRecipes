  "ingredients": [
    "12 ounce boneless, skinless chicken breast",
    "1/3 cup almond flour",
    "salt and pepper (to taste)",
    "3 tablespoon butter",
    "1/2 cup chicken broth",
    "4 teaspoon fresh garlic (minced)",
    "1 tablespoon fresh thyme",
    "400 gram cauliflower (riced)",
    "4 tablespoon heavy cream",
    "2 tablespoon lemon juice"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all the ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-creamy-lemon-chicken/#wprm-recipe-54009-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/10/Creamy-Lemon-Chicken-with-Cauliflower-1.jpg"
    },
    {
      "text": "Slice the chicken breasts lengthwise to get skinny chicken breasts.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-creamy-lemon-chicken/#wprm-recipe-54009-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/10/Creamy-Lemon-Chicken-with-Cauliflower-2.jpg"
    },
    {
      "text": "Coat the chicken breasts in almond flour and season with salt and pepper.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-creamy-lemon-chicken/#wprm-recipe-54009-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/10/Creamy-Lemon-Chicken-with-Cauliflower-3.jpg"
    },
    {
      "text": "Over medium heat, in a skillet add the chicken breasts over the butter. Cook the chicken on both sides for 3 - 5 minutes. When done, remove the chicken from the skillet and keep warm.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-creamy-lemon-chicken/#wprm-recipe-54009-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/10/Creamy-Lemon-Chicken-with-Cauliflower-4.jpg"
    },
    {
      "text": "In the same skillet on simmer, add the chicken broth, minced garlic, fresh thyme, and riced cauliflower. Stir together until combined well. Leave this to simmer for about 5 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-creamy-lemon-chicken/#wprm-recipe-54009-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/10/Creamy-Lemon-Chicken-with-Cauliflower-5.jpg"
    },
    {
      "text": "Take the skillet off of the burner and stir in the heavy cream and lemon juice.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-creamy-lemon-chicken/#wprm-recipe-54009-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/10/Creamy-Lemon-Chicken-with-Cauliflower-6.jpg"
    },
    {
      "text": "Place the skillet back on the burner and add back in the chicken to warm it up a bit.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-creamy-lemon-chicken/#wprm-recipe-54009-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/10/Creamy-Lemon-Chicken-with-Cauliflower-7.jpg"
    },
    {
      "text": "Top the chicken with lemon slices. Serve and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-creamy-lemon-chicken/#wprm-recipe-54009-step-0-7",
      "imageSource": null
