  "ingredients": [
    "1 medium leek",
    "1 medium yellow onion",
    "16 ounce broccoli",
    "8 ounce cauliflower",
    "16 ounce pork sausage (precooked)",
    "4 tablespoon butter (for frying)",
    "2 tablespoon dijon mustard",
    "3/4 cup sour cream",
    "3 ounce cream cheese",
    "5 ounce cheddar cheese (shredded)",
    "2 teaspoon fresh thyme",
    "salt and pepper (to taste)"
  ],
  "instructions": [
    {
      "text": "Measure and prepare all the ingredients. Preheat oven to 400F.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/sausage-broccoli-cauliflower-gratin/#wprm-recipe-53625-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/12/Broccoli-and-Cauliflower-Gratin-with-Sausage-1.jpg"
    },
    {
      "text": "Chop the leek and onion into fine pieces. Chop the broccoli and cauliflower into small florets. Slice the sausage into small bite sized pieces.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/sausage-broccoli-cauliflower-gratin/#wprm-recipe-53625-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/12/Broccoli-and-Cauliflower-Gratin-with-Sausage-2.jpg"
    },
    {
      "text": "Add most of the butter to a pan and cook the leek, onion, broccoli, and cauliflower over medium-high heat. Add the remaining butter and sausages in another pan and fry until cooked thoroughly.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/sausage-broccoli-cauliflower-gratin/#wprm-recipe-53625-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/12/Broccoli-and-Cauliflower-Gratin-with-Sausage-3.jpg"
    },
    {
      "text": "Add the vegetables in a baking dish.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/sausage-broccoli-cauliflower-gratin/#wprm-recipe-53625-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/12/Broccoli-and-Cauliflower-Gratin-with-Sausage-4.jpg"
    },
    {
      "text": "In a bowl, combine the mustard, sour cream, and cream cheese. Stir until combined well. Add this mixture on top of the vegetables in the baking dish.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/sausage-broccoli-cauliflower-gratin/#wprm-recipe-53625-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/12/Broccoli-and-Cauliflower-Gratin-with-Sausage-5.jpg"
    },
    {
      "text": "Top with the sausages, cheddar cheese, fresh thyme, salt and pepper.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/sausage-broccoli-cauliflower-gratin/#wprm-recipe-53625-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/12/Broccoli-and-Cauliflower-Gratin-with-Sausage-6.jpg"
    },
    {
      "text": "Bake in the oven for 15 minutes or until cheese is golden brown.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/sausage-broccoli-cauliflower-gratin/#wprm-recipe-53625-step-0-6",
      "imageSource": null
