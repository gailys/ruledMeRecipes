  "ingredients": [
    "1 medium lemon",
    "2 tablespoon olive oil (divided)",
    "16 ounce asparagus spears",
    "salt and pepper (to taste)",
    "24 ounce salmon fillets with skin",
    "2 teaspoon fresh garlic (minced)",
    "2 tablespoon old bay seasoning"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all the ingredients. Preheat oven to 450F. Wash and trim the ends of the asparagus spears.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-lemony-salmon-asparagus-sheet-pan-meal/#wprm-recipe-54005-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/10/Lemony-Asparagus-Salmon-Sheet-Pan-Meal-1.jpg"
    },
    {
      "text": "In a bowl, make the lemon oil by combining half the olive oil and juice and zest of lemon.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-lemony-salmon-asparagus-sheet-pan-meal/#wprm-recipe-54005-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/10/Lemony-Asparagus-Salmon-Sheet-Pan-Meal-2.jpg"
    },
    {
      "text": "Toss the asparagus spears in a bowl with the other half of the olive oil and salt and pepper.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-lemony-salmon-asparagus-sheet-pan-meal/#wprm-recipe-54005-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/10/Lemony-Asparagus-Salmon-Sheet-Pan-Meal-3.jpg"
    },
    {
      "text": "Spread the asparagus on the baking sheet. Place the asparagus sheet in the oven for 5 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-lemony-salmon-asparagus-sheet-pan-meal/#wprm-recipe-54005-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/10/Lemony-Asparagus-Salmon-Sheet-Pan-Meal-4.jpg"
    },
    {
      "text": "Brush both sides of the salmon filets with olive oil, minced garlic, old bay seasoning, and season with salt and pepper.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-lemony-salmon-asparagus-sheet-pan-meal/#wprm-recipe-54005-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/10/Lemony-Asparagus-Salmon-Sheet-Pan-Meal-5.jpg"
    },
    {
      "text": "Situate the salmon filets on the baking sheet with the asparagus. Bake in the oven for 5 - 7 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-lemony-salmon-asparagus-sheet-pan-meal/#wprm-recipe-54005-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/10/Lemony-Asparagus-Salmon-Sheet-Pan-Meal-6.jpg"
    },
    {
      "text": "Flip and put back in the oven for another 5 - 7 minutes or until done to your liking.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-lemony-salmon-asparagus-sheet-pan-meal/#wprm-recipe-54005-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/10/Lemony-Asparagus-Salmon-Sheet-Pan-Meal-7.jpg"
    },
    {
      "text": "Drizzle the lemon oil over the salmon filets.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-lemony-salmon-asparagus-sheet-pan-meal/#wprm-recipe-54005-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/10/Lemony-Asparagus-Salmon-Sheet-Pan-Meal-8.jpg"
    },
    {
      "text": "Serve with slices of lemon and add extra lemon oil as desired.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-lemony-salmon-asparagus-sheet-pan-meal/#wprm-recipe-54005-step-0-8",
      "imageSource": null
    }
  ],
