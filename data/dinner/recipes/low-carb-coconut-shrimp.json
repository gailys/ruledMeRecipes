  "language": "en",
  "description": "This makes a total of 3 servings of Low-Carb Coconut Shrimp. Each serving comes out to be 363 calories, 20g fats, 7.6g net carbs, and 35.5g protein.",
  "servings": 3,
  "yield": [
    "3",
    "3 servings"
  ],
  "prepTime": "PT15M",
  "cookTime": "PT15M",
  "totalTime": "PT30M",
  "totalMinutes": 30,
  "nutrition": {
    "@type": "NutritionInformation",
