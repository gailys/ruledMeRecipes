  "ingredients": [
    "2 tablespoon olive oil",
    "1/2 medium onion (diced)",
    "2 medium jalapeno pepper (diced)",
    "6 teaspoon fresh garlic (minced)",
    "32 ounce ground beef (85/15)",
    "1/4 cup low-carb bbq sauce",
    "2 large egg",
    "4 ounce pork rinds (crushed)",
    "2 cup cheddar cheese (shredded)",
    "1/4 cup heavy cream",
    "1 tablespoon italian seasoning",
    "2 teaspoon smoked paprika",
    "salt and pepper (to taste)",
    "12 ounce spring mix",
    "6 tablespoon olive oil",
    "4 tablespoon apple cider vinegar",
    "salt and pepper (to taste)"
  ],
  "instructions": [
    {
      "text": "Gather and prep all ingredients. Pre-heat oven to 350F.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-bbq-cheeseburger-meatloaf/#wprm-recipe-54857-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/08/Keto-BBQ-Cheeseburger-Meatloaf-1.jpg"
    },
    {
      "text": "In a pan over medium heat, add olive oil, onion, garlic, and jalapeno. Saute for a few minutes until fragrant and soft.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-bbq-cheeseburger-meatloaf/#wprm-recipe-54857-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/08/Keto-BBQ-Cheeseburger-Meatloaf-2.jpg"
    },
    {
      "text": "In a bowl, add all of the meatloaf ingredients. Season with salt and pepper to taste.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-bbq-cheeseburger-meatloaf/#wprm-recipe-54857-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/08/Keto-BBQ-Cheeseburger-Meatloaf-3.jpg"
    },
    {
      "text": "Using your hands, mix the ingredients until fully combined.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-bbq-cheeseburger-meatloaf/#wprm-recipe-54857-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/08/Keto-BBQ-Cheeseburger-Meatloaf-4.jpg"
    },
    {
      "text": "Press the meatloaf mixture into a loaf pan or dish that fits the mix. Bake for 50-60 minutes or until the internal temperature reaches 155F.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-bbq-cheeseburger-meatloaf/#wprm-recipe-54857-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/08/Keto-BBQ-Cheeseburger-Meatloaf-5.jpg"
    },
    {
      "text": "While meatloaf is cooking, whisk together the olive oil and apple cider vinegar until combined. You can also shake in a mason jar. Dress salad and season with salt and pepper to taste. Serve with meatloaf and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-bbq-cheeseburger-meatloaf/#wprm-recipe-54857-step-0-5",
      "imageSource": null
    }
  ],
