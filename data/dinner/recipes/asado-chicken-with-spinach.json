  },
  "ingredients": [
    "16 ounce boneless, skinless chicken thighs",
    "1/4 cup chicken broth",
    "1/4 cup lemon juice (plus more )",
    "1/4 cup olive oil",
    "1 tablespoon smoked paprika",
    "2 teaspoon cumin",
    "2 teaspoon oregano",
    "1/2 teaspoon onion powder",
    "4 teaspoon fresh garlic (minced + divided)",
    "6 cup spinach",
    "1/2 teaspoon crushed red pepper flakes",
    "salt and pepper (to taste)"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all the ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/asado-chicken-with-spinach/#wprm-recipe-54163-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/02/Asado-Chicken-with-Spinach-1.jpg"
    },
    {
      "text": "In a bowl, mix together the chicken stock, lemon juice, olive oil, smoked paprika, cumin, oregano, onion powder, and half of the minced garlic.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/asado-chicken-with-spinach/#wprm-recipe-54163-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/02/Asado-Chicken-with-Spinach-2.jpg"
    },
    {
      "text": "Add the chicken thighs into the bowl with this marinade. Make sure all of the chicken gets coated with this mixture. Cover the bowl and let this sit in the refrigerator for at least 30 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/asado-chicken-with-spinach/#wprm-recipe-54163-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/02/Asado-Chicken-with-Spinach-3.jpg"
    },
    {
      "text": "While the chicken is soaking up the marinade, add olive oil to to a frying pan over medium heat. Add in the other half of the minced garlic and the spinach. Sautee for 2 - 4 minutes. Season with salt and pepper and crushed red pepper flakes. Set this aside when done.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/asado-chicken-with-spinach/#wprm-recipe-54163-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/02/Asado-Chicken-with-Spinach-4.jpg"
    },
    {
      "text": "In the same frying pan, add olive oil and cook up the marinated chicken thighs over medium heat. Save the extra marinade! Cook for about 10 - 12 minutes or until internal temperature reaches 165F.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/asado-chicken-with-spinach/#wprm-recipe-54163-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/02/Asado-Chicken-with-Spinach-5.jpg"
    },
    {
      "text": "Over low heat, cook the extra marinade in the same frying pan for about 2 - 3 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/asado-chicken-with-spinach/#wprm-recipe-54163-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/02/Asado-Chicken-with-Spinach-6.jpg"
    },
    {
      "text": "Serve the chicken thighs with the sauteed spinach, lemon slices, and extra marinade. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/asado-chicken-with-spinach/#wprm-recipe-54163-step-0-6",
      "imageSource": null
    }
  ],
