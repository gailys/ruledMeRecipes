  "ingredients": [
    "2 tablespoon butter",
    "1 1/2 tablespoon almond flour",
    "1/4 teaspoon salt",
    "1/3 cup unsweetened almond milk",
    "2 teaspoon dijon mustard",
    "1/2 cup cheddar cheese (shredded)",
    "3 tablespoon parmesan cheese (grated)",
    "3 large egg"
  ],
  "instructions": [
    {
      "text": "Preheat your oven to 350 degrees Fahrenheit. Grease the insides of the ramekins you’ll be using.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheese-souffle/#wprm-recipe-53191-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/10/keto-cheese-souffle-01.jpg"
    },
    {
      "text": "In a saucepan over medium-low heat, melt the butter. Stir in the almond flour and salt, until well combined. It should thicken a little, but not as much as a higher carb roux. Whisk in the almond milk and mustard, then continue to simmer for 5 minutes or until the mixture has thickened a bit more.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheese-souffle/#wprm-recipe-53191-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/10/keto-cheese-souffle-02.jpg"
    },
    {
      "text": "Remove from the heat then mix in the cheddar cheese and about 2/3 of the Parmesan cheese. Whisk in the egg yolks, taking care not to curdle them.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheese-souffle/#wprm-recipe-53191-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/10/keto-cheese-souffle-03.jpg"
    },
    {
      "text": "Beat the egg whites with a mixer until stiff peaks form. Gently fold into the egg and cheese mixture.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheese-souffle/#wprm-recipe-53191-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/10/keto-cheese-souffle-04.jpg"
    },
    {
      "text": "Divide the souffle batter among the ramekins then top with the remaining Parmesan cheese.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheese-souffle/#wprm-recipe-53191-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/10/keto-cheese-souffle-05.jpg"
    },
    {
      "text": "Transfer the ramekins to the oven then bake for 15-20 minutes or until puffy and browned. Serve immediately.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheese-souffle/#wprm-recipe-53191-step-0-5",
      "imageSource": null
    }
  ],
