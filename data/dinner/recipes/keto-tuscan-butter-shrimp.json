  "ingredients": [
    "2 tablespoon olive oil",
    "16 ounce shrimp (peeled + de-veined + tails removed)",
    "salt and pepper (to taste)",
    "4 tablespoon butter",
    "3 teaspoon fresh garlic (minced)",
    "6 ounce cherry tomatoes",
    "8 ounce broccoli",
    "3 cup baby spinach",
    "1/2 cup heavy cream",
    "1/4 cup grated parmesan cheese",
    "1/4 cup fresh basil (thinly sliced)",
    "1 medium lemon (sliced, for garnish)"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all the ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-tuscan-butter-shrimp/#wprm-recipe-53997-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/10/Tuscan-Butter-Shrimp-1.jpg"
    },
    {
      "text": "Over medium to high heat, in a skillet add the olive oil. Toss the shrimp in the skillet and season with salt and pepper. Cook until opaque then remove from skillet.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-tuscan-butter-shrimp/#wprm-recipe-53997-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/10/Tuscan-Butter-Shrimp-2.jpg"
    },
    {
      "text": "Melt the butter in the skillet over medium heat. Once the butter has melted, stir in the garlic and cook for 1-2 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-tuscan-butter-shrimp/#wprm-recipe-53997-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/10/Tuscan-Butter-Shrimp-3.jpg"
    },
    {
      "text": "Add in the cherry tomatoes and broccoli. Season with salt and pepper.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-tuscan-butter-shrimp/#wprm-recipe-53997-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/10/Tuscan-Butter-Shrimp-4.jpg"
    },
    {
      "text": "Add in the spinach and let cook until it starts to become wilty.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-tuscan-butter-shrimp/#wprm-recipe-53997-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/10/Tuscan-Butter-Shrimp-5.jpg"
    },
    {
      "text": "Add in the heavy cream, grated Parmesan and basil. Stir to combine well. Turn to low heat and let simmer to allow the sauce to thicken.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-tuscan-butter-shrimp/#wprm-recipe-53997-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/10/Tuscan-Butter-Shrimp-6.jpg"
    },
    {
      "text": "Stir in the shrimp with the other ingredients to reheat them.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-tuscan-butter-shrimp/#wprm-recipe-53997-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/10/Tuscan-Butter-Shrimp-7.jpg"
    },
    {
      "text": "Garnish with basil. Serve immediately and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-tuscan-butter-shrimp/#wprm-recipe-53997-step-0-7",
      "imageSource": null
    }
  ],
