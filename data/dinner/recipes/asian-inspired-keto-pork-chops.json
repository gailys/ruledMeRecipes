  "ingredients": [
    "740 gram boneless pork chops",
    "4 teaspoon fresh garlic (halved)",
    "1/2 teaspoon peppercorns",
    "1 whole star anise",
    "5 gram lemongrass (peeled and diced)",
    "1 tablespoon fish sauce",
    "1 1/2 teaspoon soy sauce (or coconut aminos)",
    "1 teaspoon sesame oil",
    "1/2 teaspoon chinese five-spice powder",
    "1 tablespoon almond flour",
    "1/2 tablespoon chili paste (like sambal oelek)",
    "1/2 tablespoon low-carb ketchup"
  ],
  "instructions": [
    {
      "text": "Half your garlic cloves and set them aside.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/asian-inspired-keto-pork-chops/#wprm-recipe-50409-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/11/asian-pork-chops-5.jpg"
    },
    {
      "text": "Grind the peppercorns and star anise to a fine powder in a blender or using a mortar and pestle. Add the lemongrass and garlic, and pound or blend until a puree forms. Add the fish sauce, soy sauce, sesame oil, and five-spice powder and mix well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/asian-inspired-keto-pork-chops/#wprm-recipe-50409-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/11/asian-pork-chops-6.jpg"
    },
    {
      "text": "Place the pork chops on a flat work surface and, using a rolling pin wrapped in wax paper, pound to 1/2-inch thick. Put the pork chops on a tray, add the marinade, and turn to coat. Cover and marinate at room temperature for 1-2 hours.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/asian-inspired-keto-pork-chops/#wprm-recipe-50409-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/11/asian-pork-chops-8.jpg"
    },
    {
      "text": "Heat a pan to high and lightly coat your pork chops with almond flour. Add the chops to the pan and let them sear on both sides, turning once. This should take about 2 minutes on each side, until a golden brown crust is formed.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/asian-inspired-keto-pork-chops/#wprm-recipe-50409-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/11/asian-pork-chops-9.jpg"
    },
    {
      "text": "Transfer to a cutting board and cut each chop into several strips. To create a sauce, stir together the Sambal chili paste and sugar-free ketchup. Easy and delicious! Serve with Crisp Garlic Parmesan Green Beans or Low Carb Mashed Potatoes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/asian-inspired-keto-pork-chops/#wprm-recipe-50409-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/11/zporkchops-5.jpg"
    }
  ],
