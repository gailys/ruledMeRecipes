  "ingredients": [
    "24 ounce boneless pork chops (thinly cut)",
    "salt and pepper (to taste)",
    "1 tablespoon olive oil",
    "4 tablespoon butter",
    "2 tablespoon capers",
    "1 medium yellow bell pepper (sliced)",
    "1 cup chicken broth",
    "2 tablespoon lemon juice",
    "12 ounce cherry tomatoes",
    "2 tablespoon fresh parsley (chopped)"
  ],
  "instructions": [
    {
      "text": "Gather and prep all of your ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pork-scallopini/#wprm-recipe-57980-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2025/07/Keto-Scallopini-1.jpg"
    },
    {
      "text": "Heat olive oil in a pan over medium-high heat. Season pork with salt and pepper on both sides. Once pan is hot, add pork and cook until browned on both sides, about 90 seconds per side. Remove from the pan and cover with foil to keep warm.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pork-scallopini/#wprm-recipe-57980-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2025/07/Keto-Scallopini-2.jpg"
    },
    {
      "text": "Reduce heat to medium and add in the butter, capers, and yellow bell pepper. Cook until bell pepper is softened and capers are sizzling.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pork-scallopini/#wprm-recipe-57980-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2025/07/Keto-Scallopini-3.jpg"
    },
    {
      "text": "Add in the chicken broth and lemon juice, scraping the bottom of the pan to deglaze. Bring to a boil and reduce by half, stirring occasionally.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pork-scallopini/#wprm-recipe-57980-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2025/07/Keto-Scallopini-4.jpg"
    },
    {
      "text": "Once sauce has reduced, add in the tomatoes and cook until softened and slightly blistered.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pork-scallopini/#wprm-recipe-57980-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2025/07/Keto-Scallopini-5.jpg"
    },
    {
      "text": "Plate the pork and pour the sauce over the top. Garnish with fresh parsley and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pork-scallopini/#wprm-recipe-57980-step-0-5",
      "imageSource": null
    }
  ],
