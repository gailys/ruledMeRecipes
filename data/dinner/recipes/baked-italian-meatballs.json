  "ingredients": [
    "16 ounce ground beef",
    "1 teaspoon dried oregano",
    "1 teaspoon dried thyme",
    "salt and pepper",
    "28 ounce canned whole tomatoes",
    "1/2 cup red onion (diced)",
    "2 teaspoon fresh garlic (minced)",
    "1 tablespoon tomato paste",
    "1/2 cup mozzarella cheese (shredded)",
    "1/4 cup fresh basil (for garnish)"
  ],
  "instructions": [
    {
      "text": "Preheat the oven to 375F. In a large bowl mix together the ground beef, oregano, and thyme and season with salt and pepper.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/baked-italian-meatballs/#wprm-recipe-52317-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/09/baked-italian-meatballs-01.jpg"
    },
    {
      "text": "Divide the beef mixture and form golf ball-sized meatballs.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/baked-italian-meatballs/#wprm-recipe-52317-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/09/baked-italian-meatballs-02.jpg"
    },
    {
      "text": "Over medium heat fry the meatballs for around 5 minutes, until they are brown all over. Remove the meatballs from the pan.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/baked-italian-meatballs/#wprm-recipe-52317-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/09/baked-italian-meatballs-03.jpg"
    },
    {
      "text": "Reserve 1 tablespoon of the cooking juices in the pan and add the whole peeled tomatoes, onion, garlic and tomato paste. Break down the tomatoes into small chunks and mix the sauce well. Simmer for 10 minutes, until the sauce has thickened.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/baked-italian-meatballs/#wprm-recipe-52317-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/09/baked-italian-meatballs-04.jpg"
    },
    {
      "text": "Arrange the meatballs in a baking dish and top with the tomato sauce.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/baked-italian-meatballs/#wprm-recipe-52317-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/09/baked-italian-meatballs-05.jpg"
    },
    {
      "text": "Break the mozzarella into small chunks and distribute evenly over the top of the dish. Cover the dish with aluminum foil and bake in the preheated oven for 20 minutes. Remove the foil and bake for around 5 more minutes, until the cheese has browned.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/baked-italian-meatballs/#wprm-recipe-52317-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/09/baked-italian-meatballs-06.jpg"
    },
    {
      "text": "Garnish with fresh basil and serve with sautéed leafy greens or salad.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/baked-italian-meatballs/#wprm-recipe-52317-step-0-6",
      "imageSource": null
    }
  ],
