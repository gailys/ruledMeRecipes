  "ingredients": [
    "1 medium yellow bell pepper",
    "2 medium red bell pepper",
    "salt and pepper (to taste)",
    "16 ounce boneless, skinless chicken breast (cooked + shredded)",
    "2 cup cheddar cheese (shredded + divided)",
    "3 tablespoon mayonnaise",
    "1/2 cup hot sauce",
    "3 tablespoon blue cheese",
    "15 ounce romaine lettuce"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all the ingredients. Preheat oven to 375F.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-buffalo-chicken-stuffed-peppers/#wprm-recipe-54037-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/11/Buffalo-Chicken-Stuffed-Peppers-1.jpg"
    },
    {
      "text": "Cut the peppers into halves and take the seeds out.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-buffalo-chicken-stuffed-peppers/#wprm-recipe-54037-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/11/Buffalo-Chicken-Stuffed-Peppers-2.jpg"
    },
    {
      "text": "Place the halved peppers into a baking dish and bake in the oven for about 10 minutes. Season with salt and pepper to taste.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-buffalo-chicken-stuffed-peppers/#wprm-recipe-54037-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/11/Buffalo-Chicken-Stuffed-Peppers-3.jpg"
    },
    {
      "text": "With the cooked shredded chicken in a bowl, add half of the shredded cheddar cheese.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-buffalo-chicken-stuffed-peppers/#wprm-recipe-54037-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/11/Buffalo-Chicken-Stuffed-Peppers-4.jpg"
    },
    {
      "text": "Then add the mayonnaise and hot sauce. Stir to combine well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-buffalo-chicken-stuffed-peppers/#wprm-recipe-54037-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/11/Buffalo-Chicken-Stuffed-Peppers-5.jpg"
    },
    {
      "text": "Spoon in the seasoned shredded chicken into each of the bell pepper name. Top with the remaining shredded cheddar cheese.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-buffalo-chicken-stuffed-peppers/#wprm-recipe-54037-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/11/Buffalo-Chicken-Stuffed-Peppers-6.jpg"
    },
    {
      "text": "Cover with aluminum foil.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-buffalo-chicken-stuffed-peppers/#wprm-recipe-54037-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/11/Buffalo-Chicken-Stuffed-Peppers-7.jpg"
    },
    {
      "text": "Bake in the oven for 15-20 minutes or until the filling is golden brown.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-buffalo-chicken-stuffed-peppers/#wprm-recipe-54037-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/11/Buffalo-Chicken-Stuffed-Peppers-8.jpg"
    },
    {
      "text": "Garnish with blue cheese and serve with a side salad. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-buffalo-chicken-stuffed-peppers/#wprm-recipe-54037-step-0-8",
      "imageSource": null
    }
