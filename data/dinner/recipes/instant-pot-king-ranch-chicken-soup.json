    },
    {
      "text": "Whisk in the coconut flour and cook for a few minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/instant-pot-king-ranch-chicken-soup/#wprm-recipe-52766-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/10/instant-pot-king-ranch-chicken-soup-02.jpg"
    },
    {
      "text": "Stir in the chicken broth, then add chili powder, ground cumin, garlic powder, salt, and pepper.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/instant-pot-king-ranch-chicken-soup/#wprm-recipe-52766-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/10/instant-pot-king-ranch-chicken-soup-05.jpg"
    },
    {
      "text": "Place the chicken breasts into the pot.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/instant-pot-king-ranch-chicken-soup/#wprm-recipe-52766-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/10/instant-pot-king-ranch-chicken-soup-06.jpg"
    },
    {
      "text": "Add the canned tomatoes with green chilies, along with the jalapeno.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/instant-pot-king-ranch-chicken-soup/#wprm-recipe-52766-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/10/instant-pot-king-ranch-chicken-soup-08.jpg"
    },
    {
      "text": "Seal the Instant Pot, then pressure cook for 15 minutes. Once it's finished, do a manual release.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/instant-pot-king-ranch-chicken-soup/#wprm-recipe-52766-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/10/instant-pot-king-ranch-chicken-soup-09.jpg"
