  "ingredients": [
    "6 tablespoon butter (divided)",
    "1/2 medium red onion (diced)",
    "4 teaspoon fresh garlic (minced)",
    "2 tablespoon red wine vinegar",
    "14 ounce pork sausage (smoked + thinly sliced)",
    "480 gram green cabbage (cored + sliced)",
    "1 tablespoon dijon mustard",
    "1 teaspoon paprika",
    "salt and pepper (to taste)",
    "1/2 teaspoon crushed red pepper flakes",
    "1/4 cup fresh parsley (roughly chopped)"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all the ingredients. Cut up the smoked sausage.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cabbage-sausage-skillet/#wprm-recipe-53753-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/03/Cabbage-Sausage-Skillet-1.jpg"
    },
    {
      "text": "In a frying pan over medium to high heat, add half of the butter and onion. Fry until the onion is translucent about 3-4 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cabbage-sausage-skillet/#wprm-recipe-53753-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/03/Cabbage-Sausage-Skillet-2.jpg"
    },
    {
      "text": "Add minced garlic and stir. Then, add red wine vinegar and mix until combined well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cabbage-sausage-skillet/#wprm-recipe-53753-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/03/Cabbage-Sausage-Skillet-3.jpg"
    },
    {
      "text": "Move the onion to the sides of the pan and add the sausage to the middle. Cook about 3-4 minutes per side.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cabbage-sausage-skillet/#wprm-recipe-53753-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/03/Cabbage-Sausage-Skillet-4.jpg"
    },
    {
      "text": "Add the other half of the butter and mustard to the pan along with cabbage. Top it off with paprika, salt and pepper, and crushed red pepper flakes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cabbage-sausage-skillet/#wprm-recipe-53753-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/03/Cabbage-Sausage-Skillet-5.jpg"
    },
    {
      "text": "Stir well and cook for another 10 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cabbage-sausage-skillet/#wprm-recipe-53753-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/03/Cabbage-Sausage-Skillet-6.jpg"
    },
    {
      "text": "Garnish with fresh parsley.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cabbage-sausage-skillet/#wprm-recipe-53753-step-0-6",
      "imageSource": null
    }
  ],
