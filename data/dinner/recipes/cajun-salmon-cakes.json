  "ingredients": [
    "12 ounce canned pink salmon",
    "1/2 cup grated parmesan cheese (divided)",
    "3/4 cup pork rinds (Crushed And Divided)",
    "1/2 cup mayonnaise",
    "2 tablespoon dijon mustard",
    "2 tablespoon lemon juice",
    "2 tablespoon fresh parsley (chopped)",
    "1 tablespoon cajun seasoning",
    "2 large egg (lightly beaten)",
    "2 tablespoon olive oil"
  ],
  "instructions": [
    {
      "text": "In a large bowl combine the drained salmon, half the Parmesan cheese, half the ground pork rinds, mayonnaise, Dijon mustard, lemon juice, parsley and Cajun seasoning.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cajun-salmon-cakes/#wprm-recipe-52603-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/06/cajun-salmon-cakes-02.jpg"
    },
    {
      "text": "Stir in the lightly beaten eggs until well combined.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cajun-salmon-cakes/#wprm-recipe-52603-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/06/cajun-salmon-cakes-03.jpg"
    },
    {
      "text": "Gently form into equal sized patties (mixture will be fairly wet). Set aside.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cajun-salmon-cakes/#wprm-recipe-52603-step-0-2",
      "imageSource": null
    },
    {
      "text": "On a separate large plate combine the remaining Parmesan cheese and ground pork rinds. Spread into an even layer. Coat each side of the patties in the cheese mixture.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cajun-salmon-cakes/#wprm-recipe-52603-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/06/cajun-salmon-cakes-05.jpg"
    },
    {
      "text": "Heat the olive oil in a large skillet. Fry the patties in the hot oil on both sides until crispy, about 5 minutes per side.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cajun-salmon-cakes/#wprm-recipe-52603-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/06/cajun-salmon-cakes-06.jpg"
    },
    {
      "text": "Remove from the pan and place on paper towel to drain any excess oil.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cajun-salmon-cakes/#wprm-recipe-52603-step-0-5",
      "imageSource": null
    }
