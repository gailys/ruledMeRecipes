  "ingredients": [
    "135 gram broccoli (chopped)",
    "24 ounce ground beef",
    "2 teaspoon salt",
    "1 tablespoon black pepper",
    "2 teaspoon fresh garlic",
    "2 teaspoon fresh ginger (minced)",
    "2 tablespoon soy sauce (or coconut aminos)",
    "1 tablespoon chinese five-spice powder",
    "2 teaspoon cumin",
    "1 teaspoon cayenne pepper",
    "1/2 teaspoon onion powder",
    "12 ounce low-carb beer (or 1/2 cup dry red wine)",
    "150 gram cremini mushrooms (sliced)",
    "75 gram spinach",
    "3 tablespoon low-carb ketchup"
  ],
  "instructions": [
    {
      "text": "Chop the broccoli florets into very small, bite-sized chunks.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/drunken-five-spice-beef/#wprm-recipe-50937-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_4770.jpg"
    },
    {
      "text": "Heat a cast-iron skillet over high heat. Once hot, add the ground beef and season with salt and pepper.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/drunken-five-spice-beef/#wprm-recipe-50937-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_4774.jpg"
    },
    {
      "text": "Cook the ground beef until browned. Push it to one side and add the minced garlic and ginger. Let cook for about a minute.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/drunken-five-spice-beef/#wprm-recipe-50937-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_4775.jpg"
    },
    {
      "text": "Give everything a good stir and then add the broccoli.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/drunken-five-spice-beef/#wprm-recipe-50937-step-0-3",
      "imageSource": null
    },
    {
      "text": "Once the broccoli is cooked a little, add the soy sauce, five-spice powder, cumin, cayenne pepper, and onion powder. Mix well to combine.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/drunken-five-spice-beef/#wprm-recipe-50937-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_4780.jpg"
    },
    {
      "text": "Pour in the Coors Light (or other low-carb beer or the red wine, if using).",
      "group": "",
      "sourceUrl": "https://www.ruled.me/drunken-five-spice-beef/#wprm-recipe-50937-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_4784.jpg"
    },
    {
      "text": "Once cooked down a little, add the mushrooms and stir them in well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/drunken-five-spice-beef/#wprm-recipe-50937-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_4787.jpg"
    },
    {
      "text": "As the mushrooms soak up the excess juices, add the spinach and let it wilt down.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/drunken-five-spice-beef/#wprm-recipe-50937-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_4790.jpg"
    },
    {
      "text": "Once the spinach has wilted, add the ketchup and mix everything together well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/drunken-five-spice-beef/#wprm-recipe-50937-step-0-8",
      "imageSource": null
    },
    {
      "text": "Serve and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/drunken-five-spice-beef/#wprm-recipe-50937-step-0-9",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/DrunkenFiveSpiceBeef.jpg"
    }
  ],
