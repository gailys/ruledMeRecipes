  ],
  "instructions": [
    {
      "text": "Rinse the asparagus and cut the bottoms of the spears off.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/one-pan-keto-salmon-and-asparagus/#wprm-recipe-53357-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/05/salmon-and-asparagus-02.jpg"
    },
    {
      "text": "Heat half of the butter in a pan (that can fit the asparagus and salmon) over medium heat.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/one-pan-keto-salmon-and-asparagus/#wprm-recipe-53357-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/05/salmon-and-asparagus-03.jpg"
    },
    {
      "text": "Fry the asparagus for 4-5 minutes until cooked but not soft. Season with salt and pepper.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/one-pan-keto-salmon-and-asparagus/#wprm-recipe-53357-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/05/salmon-and-asparagus-04.jpg"
    },
    {
      "text": "Add the remaining butter to the pan, then add the salmon. Season with salt and pepper. Cook the salmon on both sides until cooked through. Stir the asparagus occasionally.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/one-pan-keto-salmon-and-asparagus/#wprm-recipe-53357-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/05/salmon-and-asparagus-05.jpg"
    },
    {
      "text": "Serve in a bowl with the pan drippings. Squeeze lemon over salmon and asparagus.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/one-pan-keto-salmon-and-asparagus/#wprm-recipe-53357-step-0-4",
      "imageSource": null
