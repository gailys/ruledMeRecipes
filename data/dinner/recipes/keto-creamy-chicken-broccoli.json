  "ingredients": [
    "16 ounce boneless, skinless chicken thighs",
    "3 tablespoon olive oil",
    "1 teaspoon italian seasoning",
    "1/4 teaspoon crushed red pepper flakes (optional)",
    "salt and pepper (to taste)",
    "3 teaspoon fresh garlic (minced)",
    "1/4 cup sun-dried tomatoes (chopped)",
    "10 ounce broccoli (florets)",
    "1/2 cup mozzarella cheese",
    "4 ounce cream cheese",
    "1/3 cup chicken broth"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all the ingredients. Chop the chicken into cubes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-creamy-chicken-broccoli/#wprm-recipe-53913-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/06/Creamy-Chicken-Broccoli-1.jpg"
    },
    {
      "text": "Add the chicken to a bowl and season with Italian seasoning, crushed red pepper flakes, and salt and pepper. Toss to coat the chicken with all the seasonings.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-creamy-chicken-broccoli/#wprm-recipe-53913-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/06/Creamy-Chicken-Broccoli-2.jpg"
    },
    {
      "text": "In a frying pan, add the olive oil and the seasoned chicken. Cook over medium high heat until internal temperature reaches 165F.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-creamy-chicken-broccoli/#wprm-recipe-53913-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/06/Creamy-Chicken-Broccoli-3.jpg"
    },
    {
      "text": "Add the minced garlic and cook for 1 - 2 minutes. Then add the broccoli and chopped sun-dried tomatoes. Stir and cook for 2 - 3 minutes or until broccoli starts to turn soft.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-creamy-chicken-broccoli/#wprm-recipe-53913-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/06/Creamy-Chicken-Broccoli-4.jpg"
    },
    {
      "text": "Add the mozzarella cheese and cream cheese. Heat until the cheese starts to melt.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-creamy-chicken-broccoli/#wprm-recipe-53913-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/06/Creamy-Chicken-Broccoli-5.jpg"
    },
    {
      "text": "Once the cheese has melted, add the chicken broth and stir to combine.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-creamy-chicken-broccoli/#wprm-recipe-53913-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/06/Creamy-Chicken-Broccoli-6.jpg"
    },
    {
      "text": "Serve and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-creamy-chicken-broccoli/#wprm-recipe-53913-step-0-6",
      "imageSource": null
    }
  ],
