  "ingredients": [
    "9 ounce broccolini",
    "3 tablespoon olive oil",
    "1 teaspoon fresh garlic (minced)",
    "1 tablespoon capers",
    "6 1/2 ounce canned tuna",
    "2 tablespoon mayonnaise",
    "4 tablespoon heavy cream",
    "1 medium lemon (juice of)",
    "salt and pepper (to taste)"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all the ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-tuna-with-broccolini/#wprm-recipe-54049-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/12/Keto-Creamy-Tuna-with-Broccolini-1.jpg"
    },
    {
      "text": "In a saucepan over medium heat, add olive oil, minced garlic, and the capers. Stir until fragrant.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-tuna-with-broccolini/#wprm-recipe-54049-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/12/Keto-Creamy-Tuna-with-Broccolini-2.jpg"
    },
    {
      "text": "Place the broccoli in a pan with boiling water and cook for 4-7 minutes. Set aside, but keep warm.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-tuna-with-broccolini/#wprm-recipe-54049-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/12/Keto-Creamy-Tuna-with-Broccolini-3.jpg"
    },
    {
      "text": "Lower the heat and add in the mayonnaise, heavy cream, and tuna.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-tuna-with-broccolini/#wprm-recipe-54049-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/12/Keto-Creamy-Tuna-with-Broccolini-4.jpg"
    },
    {
      "text": "Stir to combine well while being sure to break the tuna up. Let heat until it becomes thick, about 2-4 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-tuna-with-broccolini/#wprm-recipe-54049-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/12/Keto-Creamy-Tuna-with-Broccolini-5.jpg"
    },
    {
      "text": "Serve the tuna with the broccolini. Season with salt and pepper and a fresh squeeze of a lemon. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-tuna-with-broccolini/#wprm-recipe-54049-step-0-5",
      "imageSource": null
    }
  ],
