  "ingredients": [
    "16 ounce boneless, skinless chicken breast",
    "salt and pepper (to taste)",
    "3 ounce deli-sliced black forest ham",
    "2 ounce fresh mozzarella cheese (sliced)",
    "2 ounce mozzarella cheese (grated)",
    "4 teaspoon dijon mustard",
    "1/4 cup pork rinds (crushed)",
    "1 teaspoon garlic and herb seasoning",
    "8 ounce button mushrooms (sliced)",
    "8 ounce asparagus spears (trimmed)",
    "8 ounce cherry tomatoes",
    "2 tablespoon olive oil",
    "1 tablespoon red wine vinegar",
    "1 teaspoon fresh garlic (minced)",
    "1/4 teaspoon salt",
    "1/8 teaspoon black pepper"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 425F. Move your oven rack to the middle position.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/ham-and-mozzarella-hasselback-chicken/#wprm-recipe-59080-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/08/ham-and-mozzarella-hasselback-chicken-step-01.jpg"
    },
    {
      "text": "Mix the olive oil, red wine vinegar, garlic, salt, and pepper. Add to a bowl with the mushrooms, asparagus, and cherry tomatoes and toss together.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/ham-and-mozzarella-hasselback-chicken/#wprm-recipe-59080-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/08/ham-and-mozzarella-hasselback-chicken-step-02.jpg"
    },
    {
      "text": "Season the chicken with salt and pepper on both sides. Make six deep cuts into each chicken breast. Stuff the cuts with the ham and cheese slices, then smear the mustard on top.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/ham-and-mozzarella-hasselback-chicken/#wprm-recipe-59080-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/08/ham-and-mozzarella-hasselback-chicken-step-03.jpg"
    },
    {
      "text": "Top the chicken with the shredded cheese and pork rinds. Place on a sheet pan with the marinated vegetables.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/ham-and-mozzarella-hasselback-chicken/#wprm-recipe-59080-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/08/ham-and-mozzarella-hasselback-chicken-step-04.jpg"
    },
    {
      "text": "Lightly season the vegetables and the top of the Hasselback chicken. Bake for 25-30 minutes or until the chicken is completely cooked through.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/ham-and-mozzarella-hasselback-chicken/#wprm-recipe-59080-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/08/ham-and-mozzarella-hasselback-chicken-step-05.jpg"
    },
    {
      "text": "Divide the food up into four servings, and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/ham-and-mozzarella-hasselback-chicken/#wprm-recipe-59080-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/08/ham-and-mozzarella-hasselback-chicken-step-06.jpg"
    }
  ],
