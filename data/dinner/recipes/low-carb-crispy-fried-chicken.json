  },
  "ingredients": [
    "1/2 cup pork rinds (BBQ flavor, crushed)",
    "12 ounce boneless, skinless chicken breast (sliced in half)",
    "1/3 cup parmesan cheese (shredded)",
    "1 teaspoon black pepper",
    "1 large egg",
    "1 1/2 tablespoon olive oil",
    "1 tablespoon coconut oil"
  ],
  "instructions": [
    {
      "text": "Crush up the pork rinds in a Ziploc bag. Use BBQ-flavored pork rinds for a great punch of flavor.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-crispy-fried-chicken/#wprm-recipe-50521-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/12/crispy-fried-chicken-2.jpg"
    },
    {
      "text": "In a bowl, mix the crushed pork rinds, parmesan, and pepper together well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-crispy-fried-chicken/#wprm-recipe-50521-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/12/crispy-fried-chicken-4.jpg"
    },
    {
      "text": "In a separate bowl, crack the egg and whisk well. Dip each piece of chicken into the egg mixture and then the pork rind crumb mixture. Do this twice for each piece to get a nice crust.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-crispy-fried-chicken/#wprm-recipe-50521-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/12/crispy-fried-chicken-4a.jpg"
    },
    {
      "text": "Heat up the olive oil and coconut oil in a pan over medium-high heat. Once hot, place the chicken in the pan. Let it sit a while without touching, almost until burning, to ensure the crust gets nice and crisp.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-crispy-fried-chicken/#wprm-recipe-50521-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/12/crispy-fried-chicken-4b.jpg"
    },
    {
      "text": "Once the crust is browned, flip over and cook on the other side. Once browned, flip the chicken back over.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-crispy-fried-chicken/#wprm-recipe-50521-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/12/crispy-fried-chicken-4c.jpg"
    },
    {
      "text": "Turn the heat down to the lowest setting and let the chicken cook for about 6–7 minutes per side (depending on thickness of the chicken breast).",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-crispy-fried-chicken/#wprm-recipe-50521-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/12/crispy-fried-chicken-5.jpg"
    },
    {
      "text": "Serve and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-crispy-fried-chicken/#wprm-recipe-50521-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/12/crispy-fried-chicken-15.jpg"
    }
  ],
