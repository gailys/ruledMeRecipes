  "ingredients": [
    "14 ounce extra firm tofu",
    "5 tablespoon peanut butter",
    "2 tablespoon coconut aminos",
    "2 tablespoon sesame oil",
    "1 tablespoon lime juice",
    "1 teaspoon chili powder",
    "1 tablespoon stevia/erythritol blend",
    "1 tablespoon coconut oil",
    "1 small red bell pepper (diced)",
    "5 whole butter lettuce leaf",
    "1 tablespoon peanuts (crushed)",
    "2 small green onion (chopped)"
  ],
  "instructions": [
    {
      "text": "Pre-heat the skillet on stove. Slice the extra firm tofu into approximately 1-inch cubes and pat dry with a towel.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/spicy-peanut-tofu-lettuce-cups/#wprm-recipe-52946-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/02/keto-vegan-peanut-tofu-lettuce-cups-01.jpg"
    },
    {
      "text": "In a mixing bowl combine the natural peanut butter, liquid aminos, sesame oil, chili powder, lime juice, and sweetener. Stir well until smooth.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/spicy-peanut-tofu-lettuce-cups/#wprm-recipe-52946-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/02/keto-vegan-peanut-tofu-lettuce-cups-02.jpg"
    },
    {
      "text": "Melt the coconut oil in skillet. Place the tofu cubes and diced red bell pepper into the skillet. Sauté the tofu and red pepper until the edges of the tofu begin to brown slightly.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/spicy-peanut-tofu-lettuce-cups/#wprm-recipe-52946-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/02/keto-vegan-peanut-tofu-lettuce-cups-04.jpg"
    },
    {
      "text": "Add half of the peanut sauce to the tofu and stir to coat, cooking on medium heat for about 1-2 minutes. Once the sauce begins to thicken and crisp on the tofu, remove from heat.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/spicy-peanut-tofu-lettuce-cups/#wprm-recipe-52946-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/02/keto-vegan-peanut-tofu-lettuce-cups-05.jpg"
    },
    {
      "text": "Place the skillet ingredients on top of the butter lettuce leaves.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/spicy-peanut-tofu-lettuce-cups/#wprm-recipe-52946-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/02/keto-vegan-peanut-tofu-lettuce-cups-06.jpg"
    },
    {
      "text": "Top with the remaining sauce and garnish with crushed peanuts and green onion.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/spicy-peanut-tofu-lettuce-cups/#wprm-recipe-52946-step-0-5",
      "imageSource": null
    }
  ],
