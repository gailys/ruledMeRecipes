  "ingredients": [
    "12 ounce wild alaskan cod",
    "6 ounce asparagus spears (trimmed)",
    "4 ounce cherry tomatoes (on the vine)",
    "2 teaspoon fresh garlic (sliced)",
    "4 tablespoon olive oil",
    "salt and pepper (to taste)",
    "1 tablespoon capers (drained)",
    "1/2 teaspoon dried thyme",
    "1/2 teaspoon crushed red pepper flakes",
    "1/2 medium lemon (zest and juice)"
  ],
  "instructions": [
    {
      "text": "Gather and prep all of your ingredients. Pre-heat oven to 400F.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/easy-mediterranean-cod-and-asparagus/#wprm-recipe-57276-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/09/Easy-Mediterranean-Cod-and-Asparagus-1.jpg"
    },
    {
      "text": "Line a baking dish with parchment paper, then add the tomatoes. Top with sliced garlic and drizzle with half of the olive oil. Season with salt to taste. Place in the oven and reduce heat to 350F. Bake for 15 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/easy-mediterranean-cod-and-asparagus/#wprm-recipe-57276-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/09/Easy-Mediterranean-Cod-and-Asparagus-2.jpg"
    },
    {
      "text": "After 15 minutes, remove the dish from the oven. Place the fish on top of the tomatoes. Season with salt and pepper, thyme, red pepper flakes, and lemon zest.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/easy-mediterranean-cod-and-asparagus/#wprm-recipe-57276-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/09/Easy-Mediterranean-Cod-and-Asparagus-3.jpg"
    },
    {
      "text": "Scatter the capers over the top of the fish, then place the asparagus to the sides. Season asparagus with salt and pepper.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/easy-mediterranean-cod-and-asparagus/#wprm-recipe-57276-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/09/Easy-Mediterranean-Cod-and-Asparagus-5.jpg"
    },
    {
      "text": "Bake for an additional 10-15 minutes, or until just cooked through. Squeeze of lemon juice over the fish.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/easy-mediterranean-cod-and-asparagus/#wprm-recipe-57276-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/09/Easy-Mediterranean-Cod-and-Asparagus-6.jpg"
    },
    {
      "text": "Serve with additional lemon slices if desired. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/easy-mediterranean-cod-and-asparagus/#wprm-recipe-57276-step-0-5",
      "imageSource": null
    }
  ],
