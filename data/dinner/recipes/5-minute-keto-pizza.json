  "ingredients": [
    "2 tablespoon parmesan cheese",
    "1 tablespoon psyllium husk powder",
    "1/2 teaspoon italian seasoning",
    "salt (to taste)",
    "2 large egg",
    "2 teaspoon lard (or oil with a high smoke point)",
    "3 tablespoon low-carb tomato sauce (such as Rao's)",
    "1 1/2 ounce mozzarella cheese (grated)",
    "1 tablespoon fresh basil (chopped)"
  ],
  "instructions": [
    {
      "text": "In a bowl or container that can fit an immersion blender, measure out the parmesan, psyllium husk, Italian seasoning, and salt.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/5-minute-keto-pizza/#wprm-recipe-51685-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/05/img_3476.jpg"
    },
    {
      "text": "Add the eggs and combine with an immersion blender. Continue blending for about 30 seconds to allow the psyllium husk to absorb some of the liquid.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/5-minute-keto-pizza/#wprm-recipe-51685-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/05/img_3480.jpg"
    },
    {
      "text": "Heat the lard in a pan over medium-high heat. Once very hot, spoon the mixture into the pan and spread it out into a circle shape.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/5-minute-keto-pizza/#wprm-recipe-51685-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/05/img_3491.jpg"
    },
    {
      "text": "Once the edges have started to set and look slightly brown, flip the crust to the other side. Set the oven broiler to high.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/5-minute-keto-pizza/#wprm-recipe-51685-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/05/img_3494.jpg"
    },
    {
      "text": "Cook on the opposite side for 30–60 seconds, and remove from the heat. Spread the tomato sauce evenly over the pizza crust.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/5-minute-keto-pizza/#wprm-recipe-51685-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/05/img_3498.jpg"
    },
    {
      "text": "Add the cheese and place the pizza in the oven to broil. Leave the oven door cracked to keep an eye on it. Once bubbling, remove from the oven.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/5-minute-keto-pizza/#wprm-recipe-51685-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/05/img_3504.jpg"
    },
    {
      "text": "Serve with some freshly chopped basil for garnish. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/5-minute-keto-pizza/#wprm-recipe-51685-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/05/5minutepizzalong.jpg"
    }
  ],
