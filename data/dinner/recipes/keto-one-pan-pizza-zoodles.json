  "ingredients": [
    "2 medium zucchini (spiralized)",
    "3 tablespoon olive oil (divided)",
    "salt and pepper (to taste)",
    "1 cup low-carb tomato sauce (Rao's brand)",
    "4 ounce pepperoni (divided)",
    "1 cup shredded mozzarella (divided )",
    "4 tablespoon fresh basil (chopped)"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all the ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-one-pan-pizza-zoodles/#wprm-recipe-53949-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/09/One-Pan-Pizza-Zoodles-1.jpg"
    },
    {
      "text": "Put zucchini into a container with paper towels above and below the zucchini. Put something heavy over the top of the paper towels. Let sit for 60 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-one-pan-pizza-zoodles/#wprm-recipe-53949-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/09/One-Pan-Pizza-Zoodles-2.jpg"
    },
    {
      "text": "Sautee zucchini over medium heat in half of the olive oil, then drain excess water. Pat dry.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-one-pan-pizza-zoodles/#wprm-recipe-53949-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/09/One-Pan-Pizza-Zoodles-3.jpg"
    },
    {
      "text": "Sautee again in the rest of the olive oil. Season with salt and pepper.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-one-pan-pizza-zoodles/#wprm-recipe-53949-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/09/One-Pan-Pizza-Zoodles-4.jpg"
    },
    {
      "text": "Add the tomato sauce and freshly chopped basil. Stir well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-one-pan-pizza-zoodles/#wprm-recipe-53949-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/09/One-Pan-Pizza-Zoodles-5.jpg"
    },
    {
      "text": "Add in a quarter of the pepperoni slices.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-one-pan-pizza-zoodles/#wprm-recipe-53949-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/09/One-Pan-Pizza-Zoodles-6.jpg"
    },
    {
      "text": "Add in a quarter of the mozzarella cheese. Cook until the cheese starts to melt.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-one-pan-pizza-zoodles/#wprm-recipe-53949-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/09/One-Pan-Pizza-Zoodles-7.jpg"
    },
    {
      "text": "Add the rest of the mozzarella cheese and pepperoni slices. Cover with lid until the cheese is melted.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-one-pan-pizza-zoodles/#wprm-recipe-53949-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/09/One-Pan-Pizza-Zoodles-8.jpg"
    },
    {
      "text": "Sprinkle with extra basil if desired. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-one-pan-pizza-zoodles/#wprm-recipe-53949-step-0-8",
      "imageSource": null
    }
  ],
