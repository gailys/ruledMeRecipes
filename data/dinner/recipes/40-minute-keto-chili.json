  "ingredients": [
    "2/3 medium onion",
    "2 medium green bell pepper",
    "32 ounce ground beef (85/15)",
    "salt and pepper (to taste)",
    "1 tablespoon olive oil",
    "1 tablespoon cumin",
    "1 1/2 tablespoon chili powder",
    "1 teaspoon garlic powder",
    "2 teaspoon cayenne pepper",
    "8 cup spinach",
    "1 cup low-carb tomato sauce (such as Rao's)"
  ],
  "instructions": [
    {
      "text": "Chop the onion and bell peppers.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/40-minute-keto-chili/#wprm-recipe-50429-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/11/1-ChopVegetables.jpg"
    },
    {
      "text": "Place the ground beef in a pot over medium-high heat. Season with salt and pepper.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/40-minute-keto-chili/#wprm-recipe-50429-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/11/2-BrownGroundBeef.jpg"
    },
    {
      "text": "While the ground beef is browning, sauté the vegetables in olive oil over medium-high heat, seasoning with salt and pepper. Stir occasionally while the beef is cooking.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/40-minute-keto-chili/#wprm-recipe-50429-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/11/3-SauteeVegetablesinPan.jpg"
    },
    {
      "text": "Add the cumin, chili powder, garlic powder, and cayenne pepper to the ground beef and mix well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/40-minute-keto-chili/#wprm-recipe-50429-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/11/4-AddSpicestoBeefandMix.jpg"
    },
    {
      "text": "Once browned, add the spinach to the pot. Let steam for 2–3 minutes and then stir it in. Reduce the heat of the pan with peppers and onions to low and let cook until softened.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/40-minute-keto-chili/#wprm-recipe-50429-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/11/6-AddSpinachtoPanandWilt.jpg"
    },
    {
      "text": "Measure out the low-carb tomato sauce and add it to the meat mixture, stirring well. Reduce the heat to medium-low and let cook for 10 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/40-minute-keto-chili/#wprm-recipe-50429-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/11/7-StirinTomatoSauceandCook.jpg"
    },
    {
      "text": "Finally, add the cooked vegetables to the pan and mix well. Let cook for a few more minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/40-minute-keto-chili/#wprm-recipe-50429-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/11/9-StirinVegetablesandServe.jpg"
    },
    {
      "text": "Serve hot!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/40-minute-keto-chili/#wprm-recipe-50429-step-0-7",
      "imageSource": null
    }
  ],
