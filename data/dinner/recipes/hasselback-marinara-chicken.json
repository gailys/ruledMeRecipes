  "ingredients": [
    "4 ounce cream cheese",
    "1/3 cup mozzarella cheese (shredded)",
    "10 ounce frozen spinach (thawed and drained)",
    "816 gram boneless, skinless chicken breast",
    "salt and pepper (to taste)",
    "1 tablespoon olive oil",
    "2/3 cup low-carb tomato sauce (such as Rao's)",
    "3 ounce fresh mozzarella cheese (sliced)"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 400F. Place the cream cheese, mozzarella, and spinach in a microwave-safe bowl. Heat for about 2 minutes, or until the cheeses are soft and melted. Mix to combine and add salt and pepper to taste.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/hasselback-marinara-chicken/#wprm-recipe-52135-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/03/IMG_1101.jpg"
    },
    {
      "text": "Cut several horizontal slices across each chicken breast, cutting as deeply as possible without slicing all the way through the chicken. Season with salt and pepper.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/hasselback-marinara-chicken/#wprm-recipe-52135-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/03/IMG_1120.jpg"
    },
    {
      "text": "Stuff each piece of chicken with the cheese filling.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/hasselback-marinara-chicken/#wprm-recipe-52135-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/03/IMG_1121.jpg"
    },
    {
      "text": "Brush the olive oil over the bare chicken tops. Cook for 25 minutes, or until the chicken reaches 165F. Remove from oven.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/hasselback-marinara-chicken/#wprm-recipe-52135-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/03/IMG_1130.jpg"
    },
    {
      "text": "Turn on the broiler and top the chicken with tomato sauce and fresh mozzarella.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/hasselback-marinara-chicken/#wprm-recipe-52135-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/03/IMG_1138.jpg"
    },
    {
      "text": "Broil for 5 minutes, or until the cheese is melted and beginning to brown. Remove from the oven and serve.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/hasselback-marinara-chicken/#wprm-recipe-52135-step-0-5",
      "imageSource": null
    }
