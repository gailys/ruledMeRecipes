  "ingredients": [
    "1/4 cup soy sauce (or coconut aminos)",
    "2 tablespoon unseasoned rice vinegar",
    "2 tablespoon fish sauce",
    "24 ounce flanken-cut short ribs",
    "1 teaspoon ground ginger",
    "1/2 teaspoon fresh garlic (minced)",
    "1/2 teaspoon onion powder",
    "1/2 teaspoon crushed red pepper flakes",
    "1/2 teaspoon sesame seeds",
    "1/4 teaspoon cardamom",
    "1 tablespoon salt"
  ],
  "instructions": [
    {
      "text": "Mix together the soy sauce, rice vinegar, and fish sauce.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/asian-grilled-keto-short-ribs/#wprm-recipe-51769-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/07/img_9742.jpg"
    },
    {
      "text": "Place the short ribs in a casserole dish or other container with raised edges. Pour the marinade over the ribs and let sit for at least 45–60 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/asian-grilled-keto-short-ribs/#wprm-recipe-51769-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/07/img_9748.jpg"
    },
    {
      "text": "Combine the spice rub ingredients together.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/asian-grilled-keto-short-ribs/#wprm-recipe-51769-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/07/img_9770.jpg"
    },
    {
      "text": "Empty the marinade from the casserole dish and rub the spice mixture evenly over both sides of the ribs.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/asian-grilled-keto-short-ribs/#wprm-recipe-51769-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/07/img_9774.jpg"
    },
    {
      "text": "Heat up the grill and grill the ribs up! Cook for about 3–5 minutes per side, depending on the thickness.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/asian-grilled-keto-short-ribs/#wprm-recipe-51769-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/07/img_9786.jpg"
    },
    {
      "text": "Serve with vegetables or side dish of choice.",
