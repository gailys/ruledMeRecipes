  "ingredients": [
    "1 tablespoon butter (salted)",
    "16 ounce shrimp (raw, peeled and deveined)",
    "4 ounce cream cheese (cubed)",
    "1/2 cup whole milk",
    "1 tablespoon garlic powder",
    "1 teaspoon dried basil",
    "1 teaspoon salt",
    "1/2 cup parmesan cheese (shredded)",
    "5 whole sun-dried tomatoes (cut into strips)",
    "1/4 cup baby kale"
  ],
  "instructions": [
    {
      "text": "Melt butter in a large skillet over medium heat.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/one-pot-shrimp-alfredo/#wprm-recipe-52305-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/07/one-pot-shrimp-alfredo-01.jpg"
    },
    {
      "text": "Add the shrimp to the skillet and reduce heat to medium-low.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/one-pot-shrimp-alfredo/#wprm-recipe-52305-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/07/one-pot-shrimp-alfredo-02.jpg"
    },
    {
      "text": "Turn the shrimp after about 30 seconds and cook the other side until they are only slightly pink. This is important, because the sauce will continue to cook the shrimp once it is added. If you overcook the shrimp, it will become tough and rubbery!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/one-pot-shrimp-alfredo/#wprm-recipe-52305-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/07/one-pot-shrimp-alfredo-03.jpg"
    },
    {
      "text": "Add cream cheese cubes to the shrimp pan.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/one-pot-shrimp-alfredo/#wprm-recipe-52305-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/07/one-pot-shrimp-alfredo-04.jpg"
    },
    {
      "text": "Pour milk into the pan and increase heat to medium. Stir frequently until the cream cheese has melted into the milk and no lumps are present.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/one-pot-shrimp-alfredo/#wprm-recipe-52305-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/07/one-pot-shrimp-alfredo-05.jpg"
    },
    {
      "text": "Sprinkle the garlic, basil, and salt into the pan and stir well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/one-pot-shrimp-alfredo/#wprm-recipe-52305-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/07/one-pot-shrimp-alfredo-06.jpg"
    },
    {
      "text": "Dump in the Parmesan cheese and stir to combine. Let simmer until the sauce begins to thicken.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/one-pot-shrimp-alfredo/#wprm-recipe-52305-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/07/one-pot-shrimp-alfredo-07.jpg"
    },
    {
      "text": "Complete the dish by folding in sun-dried tomatoes and baby kale or spinach.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/one-pot-shrimp-alfredo/#wprm-recipe-52305-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/07/one-pot-shrimp-alfredo-08.jpg"
    },
    {
      "text": "Remove from heat and serve hot!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/one-pot-shrimp-alfredo/#wprm-recipe-52305-step-0-8",
      "imageSource": null
    }
  ],
