  "ingredients": [
    "48 ounce corned beef",
    "1/2 medium onion (chopped)",
    "1 medium carrot (chopped)",
    "3 medium celery (chopped)",
    "4 teaspoon fresh garlic (chopped)",
    "1/2 medium green cabbage (chopped in quarters)",
    "3 cup water",
    "1 medium bay leaf",
    "1 tablespoon apple cider vinegar",
    "salt and pepper (to taste)",
    "8 tablespoon olive oil (for garnish)"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all of the ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-uncured-corned-beef/#wprm-recipe-54559-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/01/Keto-Uncured-Corned-Beef-1.jpg"
    },
    {
      "text": "Chop the onion and celery on a cutting board.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-uncured-corned-beef/#wprm-recipe-54559-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/01/Keto-Uncured-Corned-Beef-2.jpg"
    },
    {
      "text": "Chop up the carrots.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-uncured-corned-beef/#wprm-recipe-54559-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/01/Keto-Uncured-Corned-Beef-3.jpg"
    },
    {
      "text": "Place corned beef in a crock pot along with chopped garlic, bay leaf, and apple cider vinegar. Pour water on top of the beef.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-uncured-corned-beef/#wprm-recipe-54559-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/01/Keto-Uncured-Corned-Beef-4.jpg"
    },
    {
      "text": "Add in the chopped celery, onion, and carrots. Cover with a lid and and let cook on low for 6 to 8 hours.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-uncured-corned-beef/#wprm-recipe-54559-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/01/Keto-Uncured-Corned-Beef-5.jpg"
    },
    {
      "text": "30 minutes before you want to eat, add in the green cabbage.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-uncured-corned-beef/#wprm-recipe-54559-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/01/Keto-Uncured-Corned-Beef-6.jpg"
    },
    {
      "text": "30 minutes later, remove and plate the vegetables. Cut the beef.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-uncured-corned-beef/#wprm-recipe-54559-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/01/Keto-Uncured-Corned-Beef-7.jpg"
