  "ingredients": [
    "20 ounce ground beef (80/20)",
    "1 large egg",
    "1 1/2 teaspoon cumin",
    "1/2 teaspoon garlic powder",
    "2 teaspoon dried oregano",
    "1 1/2 teaspoon salt",
    "1/2 teaspoon black pepper",
    "1/2 medium red bell pepper",
    "3 medium green onion",
    "1 medium jalapeno pepper",
    "1/4 cup fresh cilantro",
    "2 tablespoon olive oil",
    "4 ounce cheddar cheese (shredded)"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 350 degrees Fahrenheit. Cut the stems off the red pepper and jalapeno. Scrape out the seeds if you do not like things spicy. Add the red pepper, green onion, jalapeno, cilantro, and olive oil to a food processor. Pulse until you have a finely diced mixture.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/tex-mex-casserole/#wprm-recipe-53215-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/11/keto-tex-mex-casserole-01.jpg"
    },
    {
      "text": "In a mixing bowl, combine casserole ingredients with the food processor ingredients. Mix well with your hands then press into a casserole dish.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/tex-mex-casserole/#wprm-recipe-53215-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/11/keto-tex-mex-casserole-03.jpg"
    },
    {
      "text": "Sprinkle cheddar cheese over the top.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/tex-mex-casserole/#wprm-recipe-53215-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/11/keto-tex-mex-casserole-04.jpg"
    },
    {
      "text": "Bake for 30 minutes, then broil for another 5 minutes to brown the cheese on top. Allow to cool for 10 minutes before serving.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/tex-mex-casserole/#wprm-recipe-53215-step-0-3",
      "imageSource": null
    }
  ],
