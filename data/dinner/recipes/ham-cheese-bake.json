  "ingredients": [
    "24 ounce frozen cauliflower (chopped)",
    "2 cup cooked ham (chopped)",
    "2 1/2 cup sharp cheddar cheese (shredded)",
    "1/2 cup sour cream",
    "1 1/2 cup heavy whipping cream",
    "1/2 teaspoon black pepper",
    "1/2 teaspoon garlic powder",
    "1 cup mozzarella cheese (cubed)"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 375F. Grease a casserole dish. Empty the frozen cauliflower into a medium-sized pot and cover with boiled water. Cook for 8–10 minutes or until easily mashable.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/ham-cheese-bake/#wprm-recipe-50725-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/01/DSC_1498.jpg"
    },
    {
      "text": "Once tender, drain the cauliflower and return to the pot. Mash with a fork or potato masher until the desired consistency is reached.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/ham-cheese-bake/#wprm-recipe-50725-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/01/DSC_1522.jpg"
    },
    {
      "text": "Spread the mashed cauliflower into the greased casserole dish and top with the chopped ham.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/ham-cheese-bake/#wprm-recipe-50725-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/01/DSC_1531.jpg"
    },
    {
      "text": "In a saucepan over medium heat, combine the cheddar cheese, sour cream, heavy whipping cream, and seasonings until the cheese is slightly melted, stirring frequently to keep the mixture from burning on the bottom.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/ham-cheese-bake/#wprm-recipe-50725-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/01/DSC_1526.jpg"
    },
    {
      "text": "Once the cheese sauce is melted, remove from the heat and pour it over the ham and cauliflower. Top with the cubed mozzarella.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/ham-cheese-bake/#wprm-recipe-50725-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/01/DSC_1533.jpg"
    },
    {
      "text": "Bake for 35–45 minutes, or until the cheese on top has browned.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/ham-cheese-bake/#wprm-recipe-50725-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/01/DSC_1535.jpg"
    },
    {
      "text": "Remove from the oven and let cool for about 10 minutes before serving. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/ham-cheese-bake/#wprm-recipe-50725-step-0-6",
      "imageSource": null
    }
  ],
