  "ingredients": [
    "1/2 teaspoon smoked paprika",
    "1/2 teaspoon garlic powder",
    "1/4 teaspoon onion powder",
    "salt and pepper (to taste)",
    "2 tablespoon olive oil (divided)",
    "6 ounce salmon",
    "1 tablespoon soy sauce (or coconut aminos)",
    "4 ounce broccoli (cut into florets)"
  ],
  "instructions": [
    {
      "text": "Gather and prep all of your ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-air-fryer-salmon-broccoli-bites/#wprm-recipe-56950-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/06/Keto-Air-Fryer-Salmon-Broccoli-Bites-1.jpg"
    },
    {
      "text": "Combine dry spices in a bowl and mix together.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-air-fryer-salmon-broccoli-bites/#wprm-recipe-56950-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/06/Keto-Air-Fryer-Salmon-Broccoli-Bites-2.jpg"
    },
    {
      "text": "Slice the salmon into bite-size chunks.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-air-fryer-salmon-broccoli-bites/#wprm-recipe-56950-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/06/Keto-Air-Fryer-Salmon-Broccoli-Bites-3.jpg"
    },
    {
      "text": "Add the salmon, spice mixture, soy sauce, and half of the olive oil into a bag and marinade salmon for at least 30 minutes, but preferably overnight.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-air-fryer-salmon-broccoli-bites/#wprm-recipe-56950-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/06/Keto-Air-Fryer-Salmon-Broccoli-Bites-4.jpg"
    },
    {
      "text": "Once ready to cook, toss the broccoli florets in the remaining olive oil and season with salt and pepper. Place into the air fryer and cook for 400F for 5-6 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-air-fryer-salmon-broccoli-bites/#wprm-recipe-56950-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/06/Keto-Air-Fryer-Salmon-Broccoli-Bites-5.jpg"
    },
    {
      "text": "Stir the broccoli, then add in the salmon chunks and continue to cook for an additional 6-7 minutes, or until salmon is cooked through.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-air-fryer-salmon-broccoli-bites/#wprm-recipe-56950-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/06/Keto-Air-Fryer-Salmon-Broccoli-Bites-6.jpg"
    },
    {
      "text": "Serve immediately and optionally garnish with some lemon. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-air-fryer-salmon-broccoli-bites/#wprm-recipe-56950-step-0-6",
      "imageSource": null
    }
  ],
