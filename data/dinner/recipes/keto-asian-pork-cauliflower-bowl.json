  "ingredients": [
    "400 gram cauliflower",
    "2 tablespoon avocado oil",
    "salt and pepper (to taste)",
    "400 gram ground pork",
    "3 teaspoon fresh garlic (minced)",
    "1 medium red chile",
    "3 tablespoon fresh ginger (grated)",
    "3 tablespoon lime juice",
    "2 tablespoon soy sauce",
    "1/4 cup fresh cilantro (chopped)",
    "1/2 medium cucumber",
    "2 tablespoon fresh mint (chopped)",
    "1 medium green onion (diced)",
    "2 tablespoon olive oil"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all the ingredients. Chop the chile pepper.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-asian-pork-cauliflower-bowl/#wprm-recipe-53853-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/05/Asian-Pork-Cauliflower-Bowl-1.jpg"
    },
    {
      "text": "Put the cauliflower in a food processor and chop it until it is the consistency of rice.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-asian-pork-cauliflower-bowl/#wprm-recipe-53853-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/05/Asian-Pork-Cauliflower-Bowl-2.jpg"
    },
    {
      "text": "Add avocado oil to a frying pan and add the riced cauliflower. Cook on medium heat for 6-8 minutes. Add salt and pepper to taste. Remove from pan and keep warm.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-asian-pork-cauliflower-bowl/#wprm-recipe-53853-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/05/Asian-Pork-Cauliflower-Bowl-3.jpg"
    },
    {
      "text": "Cook the ground pork in the same pan on medium to high heat until it is thoroughly cooked, about 7-8 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-asian-pork-cauliflower-bowl/#wprm-recipe-53853-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/05/Asian-Pork-Cauliflower-Bowl-4.jpg"
    },
    {
      "text": "Add minced garlic, chile pepper, and ginger to the pan. Stir together well and cook for 30 seconds to 1 minute. Then, remove from heat.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-asian-pork-cauliflower-bowl/#wprm-recipe-53853-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/05/Asian-Pork-Cauliflower-Bowl-5.jpg"
    },
    {
      "text": "Add half the lime juice and half the soy sauce. Add the cilantro and stir until combined well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-asian-pork-cauliflower-bowl/#wprm-recipe-53853-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/05/Asian-Pork-Cauliflower-Bowl-6.jpg"
    },
    {
      "text": "Add the other half of the lime juice and soy sauce in a bowl. Mix together and set aside.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-asian-pork-cauliflower-bowl/#wprm-recipe-53853-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/05/Asian-Pork-Cauliflower-Bowl-7.jpg"
    },
    {
      "text": "Using a peeler, shave the cucumber. This will leave the cucumber in ribbons. Place the cucumber ribbons on a plate.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-asian-pork-cauliflower-bowl/#wprm-recipe-53853-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/05/Asian-Pork-Cauliflower-Bowl-8.jpg"
    },
    {
      "text": "Take the bowl with lime juice and soy sauce and pour this over the cucumber ribbons. Add the chopped mint and toss to combine.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-asian-pork-cauliflower-bowl/#wprm-recipe-53853-step-0-8",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/05/Asian-Pork-Cauliflower-Bowl-9.jpg"
    },
    {
      "text": "Serve the cucumbers with the seasoned ground pork.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-asian-pork-cauliflower-bowl/#wprm-recipe-53853-step-0-9",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/05/Asian-Pork-Cauliflower-Bowl-10.jpg"
    },
    {
      "text": "Top with chopped green onion and mint. Drizzle with olive oil as needed.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-asian-pork-cauliflower-bowl/#wprm-recipe-53853-step-0-10",
      "imageSource": null
    }
  ],
