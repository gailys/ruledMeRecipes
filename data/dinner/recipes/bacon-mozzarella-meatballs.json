  "ingredients": [
    "1/3 cup pork rinds (crushed)",
    "4 ounce bacon",
    "24 ounce ground beef",
    "1 cup mozzarella cheese (grated)",
    "1 teaspoon black pepper",
    "2 teaspoon fresh garlic (minced)",
    "1/2 teaspoon onion powder",
    "1/2 teaspoon kosher salt",
    "2 large egg",
    "3/4 cup pesto"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 350F. Add the pork rinds to a food processor and pulse until completely crushed.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/bacon-mozzarella-meatballs/#wprm-recipe-50673-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/12/Meatball_Trio-1-4.jpg"
    },
    {
      "text": "Chop the bacon into small pieces and add them to a large mixing bowl.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/bacon-mozzarella-meatballs/#wprm-recipe-50673-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/12/Bacon_and_Mozzarella-1.jpg"
    },
    {
      "text": "Add in the ground beef, crushed pork rinds, and mozzarella cheese.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/bacon-mozzarella-meatballs/#wprm-recipe-50673-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/12/Bacon_and_Mozzarella-2.jpg"
    },
    {
      "text": "Measure out the pepper, garlic, onion powder, salt, and eggs. Add them to the ground beef mixture — this is where the fun begins.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/bacon-mozzarella-meatballs/#wprm-recipe-50673-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/12/Bacon_and_Mozzarella-5.jpg"
    },
    {
      "text": "Knead everything together well by hand. It's a bit messy, but well worth it!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/bacon-mozzarella-meatballs/#wprm-recipe-50673-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/12/Bacon_and_Mozzarella-6.jpg"
    },
    {
      "text": "Roll the mixture into evenly-sized meatballs and place them on a foil-lined baking tray. Spread the meatballs out evenly to ensure proper cooking and keep them from sticking together.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/bacon-mozzarella-meatballs/#wprm-recipe-50673-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/12/Bacon_and_Mozzarella-7.jpg"
    },
    {
      "text": "Bake for 40–45 minutes, depending on the size of the meatballs.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/bacon-mozzarella-meatballs/#wprm-recipe-50673-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/12/Bacon_and_Mozzarella-8.jpg"
    },
    {
      "text": "Let them cool for 5 minutes or so, then remove them from the grease filled tray.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/bacon-mozzarella-meatballs/#wprm-recipe-50673-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/12/Bacon_and_Mozzarella-9-3.jpg"
    },
    {
      "text": "Serve with pesto sauce dolloped over each meatball.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/bacon-mozzarella-meatballs/#wprm-recipe-50673-step-0-8",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/12/Bacon_and_Mozzarella-11.jpg"
    }
  ],
