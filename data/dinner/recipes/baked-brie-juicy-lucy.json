    "fatGrams": 50.12
  },
  "ingredients": [
    "½ pound ground chuck",
    "2 slices low carb focaccia bread",
    "1 1.5-ounce wedge brie",
    "1 slice cheddar cheese",
    "1 teaspoon salt",
    "1 teaspoon Worcestershire",
    "½ teaspoon Mrs. Dash Table Blend",
    "¼ teaspoon ground black pepper",
    "¼ teaspoon garlic powder"
  ],
  "instructions": [
    {
      "text": "Preheat your oven to 450F on convection bake.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/baked-brie-juicy-lucy/#wprm-recipe-50713-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/01/baked-brie-juicy-lucy03.jpg"
    },
    {
      "text": "Mix your spices with your ground beef.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/baked-brie-juicy-lucy/#wprm-recipe-50713-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/01/baked-brie-juicy-lucy04.jpg"
    },
    {
      "text": "Tear a small piece off of the ground beef to save as the \"top\".",
      "group": "",
      "sourceUrl": "https://www.ruled.me/baked-brie-juicy-lucy/#wprm-recipe-50713-step-0-2",
      "imageSource": null
    },
    {
      "text": "Form your beef into a patty and use your knuckle you push a hole in the middle.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/baked-brie-juicy-lucy/#wprm-recipe-50713-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/01/baked-brie-juicy-lucy07.jpg"
    },
    {
      "text": "Add your sliced brie to the middle of the burger. Add the rest of your ground beef and seal it into a complete patty.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/baked-brie-juicy-lucy/#wprm-recipe-50713-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/01/baked-brie-juicy-lucy09.jpg"
    },
    {
      "text": "Put the patty on top of a cooling rack, on top of a baking sheet with salt on it. This soaks up the grease and stops it from smoking.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/baked-brie-juicy-lucy/#wprm-recipe-50713-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/01/baked-brie-juicy-lucy11.jpg"
    },
    {
      "text": "Bake on convection for 12-15 minutes. 12 minutes will result in rare, 15 minutes being medium. I prefer to stick around 14 minutes to give a slightly above medium-rare cook.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/baked-brie-juicy-lucy/#wprm-recipe-50713-step-0-6",
      "imageSource": null
    }
  ],
