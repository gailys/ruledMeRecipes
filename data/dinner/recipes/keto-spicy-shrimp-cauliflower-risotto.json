  "ingredients": [
    "4 cup cauliflower rice",
    "2 tablespoon butter",
    "3 tablespoon cream cheese",
    "1 cup white cheddar cheese",
    "1/4 cup parmesan cheese",
    "salt and pepper (to taste)",
    "2 teaspoon fresh garlic (minced)",
    "16 ounce shrimp (peeled + de-veined)",
    "1 teaspoon cajun seasoning",
    "1 teaspoon paprika",
    "1 teaspoon fresh garlic (minced)",
    "2 teaspoon butter",
    "1/2 cup cremini mushrooms",
    "1 1/2 tablespoon spinach"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all the ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-spicy-shrimp-cauliflower-risotto/#wprm-recipe-54119-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/02/Spicy-Shrimp-with-Cauliflower-Risotto-1.jpg"
    },
    {
      "text": "In a frying pan over medium heat add the butter and cauliflower rice. Stir and let cook for about 5-8 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-spicy-shrimp-cauliflower-risotto/#wprm-recipe-54119-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/02/Spicy-Shrimp-with-Cauliflower-Risotto-2.jpg"
    },
    {
      "text": "Add in the cream cheese, white cheddar cheese, and parmesan cheese. Turn the heat down to low-medium and stir. Season with salt and pepper to taste.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-spicy-shrimp-cauliflower-risotto/#wprm-recipe-54119-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/02/Spicy-Shrimp-with-Cauliflower-Risotto-3.jpg"
    },
    {
      "text": "On a plate, season the shrimp with cajun seasoning and paprika. Cook the shrimp in a frying pan for about 2-4 minutes on each side or until they turn light pink in color.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-spicy-shrimp-cauliflower-risotto/#wprm-recipe-54119-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/02/Spicy-Shrimp-with-Cauliflower-Risotto-4.jpg"
    },
    {
      "text": "In a frying pan over medium heat, add in the minced garlic and the cremini mushrooms. Sautee for 2-4 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-spicy-shrimp-cauliflower-risotto/#wprm-recipe-54119-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/02/Spicy-Shrimp-with-Cauliflower-Risotto-5.jpg"
    },
    {
      "text": "Stir in the spinach and cook until it starts to get wilty.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-spicy-shrimp-cauliflower-risotto/#wprm-recipe-54119-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/02/Spicy-Shrimp-with-Cauliflower-Risotto-6.jpg"
    },
    {
      "text": "Serve the spicy shrimp with the cauliflower risotto and spinach mushroom mix. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-spicy-shrimp-cauliflower-risotto/#wprm-recipe-54119-step-0-6",
      "imageSource": null
    }
  ],
