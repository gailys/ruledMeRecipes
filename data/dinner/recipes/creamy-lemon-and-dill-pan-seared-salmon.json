  "ingredients": [
    "2 tablespoon olive oil",
    "18 ounce salmon (3 fillets)",
    "2 teaspoon fresh garlic (minced)",
    "1 cup heavy whipping cream",
    "1 ounce cream cheese",
    "2 tablespoon capers",
    "1 tablespoon lemon juice",
    "2 teaspoon fresh dill",
    "2 tablespoon grated parmesan cheese",
    "salt (to taste)"
  ],
  "instructions": [
    {
      "text": "Heat olive oil in a large skillet on medium-high heat. Once the skillet is hot, add the fresh salmon, searing each side for about five minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-lemon-and-dill-pan-seared-salmon/#wprm-recipe-52667-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/07/seared-salmon-with-creamy-lemon-dill-sauce-01.jpg"
    },
    {
      "text": "Once the salmon is cooked through, remove and set aside, covered, while you prepare the sauce.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-lemon-and-dill-pan-seared-salmon/#wprm-recipe-52667-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/07/seared-salmon-with-creamy-lemon-dill-sauce-02.jpg"
    },
    {
      "text": "In the same pan, saute minced garlic over medium heat until fragrant.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-lemon-and-dill-pan-seared-salmon/#wprm-recipe-52667-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/07/seared-salmon-with-creamy-lemon-dill-sauce-03.jpg"
    },
    {
      "text": "Add the heavy cream, cream cheese, lemon juice, and capers to the pan.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-lemon-and-dill-pan-seared-salmon/#wprm-recipe-52667-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/07/seared-salmon-with-creamy-lemon-dill-sauce-04.jpg"
    },
    {
      "text": "Bring to a light simmer, stirring frequently until it begins to thicken.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-lemon-and-dill-pan-seared-salmon/#wprm-recipe-52667-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/07/seared-salmon-with-creamy-lemon-dill-sauce-05.jpg"
    },
    {
      "text": "Once the sauce begins to thicken, add the salmon back to the pan and brush or spoon the cream sauce over the fillets.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-lemon-and-dill-pan-seared-salmon/#wprm-recipe-52667-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/07/seared-salmon-with-creamy-lemon-dill-sauce-06.jpg"
    },
    {
      "text": "Reduce heat to medium low, and cook briefly to reheat the salmon.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-lemon-and-dill-pan-seared-salmon/#wprm-recipe-52667-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/07/seared-salmon-with-creamy-lemon-dill-sauce-07.jpg"
    },
    {
      "text": "Garnish with the fresh dill and grated Parmesan cheese. Season with salt to taste.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-lemon-and-dill-pan-seared-salmon/#wprm-recipe-52667-step-0-7",
      "imageSource": null
    }
  ],
