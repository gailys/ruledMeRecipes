  "ingredients": [
    "16 ounce boneless, skinless chicken breast",
    "1/4 cup pesto",
    "1 tablespoon olive oil",
    "2 teaspoon lemon zest",
    "1 teaspoon fresh garlic",
    "1 teaspoon salt",
    "1 teaspoon black pepper",
    "150 gram halloumi cheese",
    "2 tablespoon olive oil (for frying)"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 450F. Pat the chicken breasts dry with paper towels.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chicken-pesto-roulade/#wprm-recipe-50857-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/02/chicken-pesto-roulade-04.jpg"
    },
    {
      "text": "Pound the chicken breasts with the flat side of a meat hammer until about 1/8\" thick.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chicken-pesto-roulade/#wprm-recipe-50857-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/02/chicken-pesto-roulade-05.jpg"
    },
    {
      "text": "Combine the pesto and olive oil in a bowl. Spread the pesto over the chicken breasts and add the lemon zest, garlic, salt, and black pepper.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chicken-pesto-roulade/#wprm-recipe-50857-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/02/chicken-pesto-roulade-01.jpg"
    },
    {
      "text": "Chop the halloumi cheese into small pieces and spread them out over the chicken.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chicken-pesto-roulade/#wprm-recipe-50857-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/02/chicken-pesto-roulade-11.jpg"
    },
    {
      "text": "Roll up the chicken and secure with toothpicks or butcher's twine.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chicken-pesto-roulade/#wprm-recipe-50857-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/02/chicken-pesto-roulade-13.jpg"
    },
    {
      "text": "Bring the remaining olive oil (for frying) to its smoking point in a cast-iron skillet.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chicken-pesto-roulade/#wprm-recipe-50857-step-0-5",
      "imageSource": null
    },
    {
      "text": "Add the chicken to the pan and cook evenly to get a nice sear on all sides.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chicken-pesto-roulade/#wprm-recipe-50857-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/02/chicken-pesto-roulade-14.jpg"
    },
    {
      "text": "Place the skillet in the oven for 6–7 minutes to allow the chicken to cook through.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chicken-pesto-roulade/#wprm-recipe-50857-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/02/chicken-pesto-roulade-16.jpg"
    },
    {
      "text": "Once cooked and the juices run clear, remove from the oven and let rest for 5–6 minutes before serving.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chicken-pesto-roulade/#wprm-recipe-50857-step-0-8",
      "imageSource": null
    }
  ],
