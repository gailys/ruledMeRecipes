  "ingredients": [
    "2 tablespoon butter",
    "4 ounce cream cheese",
    "4 tablespoon ranch dressing",
    "20 ounce cauliflower rice",
    "1/2 cup cheddar cheese (shredded)",
    "24 ounce boneless, skinless chicken thighs",
    "1 tablespoon olive oil",
    "salt and pepper (to taste)"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all ingredients. Preheat oven to 375F.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheesy-ranch-chicken-cauliflower-rice/#wprm-recipe-53673-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/01/Cheese-Ranch-Chicken-with-Cauliflower-Rice-1.jpg"
    },
    {
      "text": "In a microwave safe bowl, combine butter, cream cheese, and half the ranch dressing. Put in microwave for about 1 minute or until melted.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheesy-ranch-chicken-cauliflower-rice/#wprm-recipe-53673-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/01/Cheese-Ranch-Chicken-with-Cauliflower-Rice-2.png"
    },
    {
      "text": "Add the cauliflower rice and shredded cheddar cheese to the melted mixture. Season with salt and pepper to taste.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheesy-ranch-chicken-cauliflower-rice/#wprm-recipe-53673-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/01/Cheese-Ranch-Chicken-with-Cauliflower-Rice-3.jpg"
    },
    {
      "text": "Transfer the cauliflower rice mixture into a baking dish, and spread flat using a spatula.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheesy-ranch-chicken-cauliflower-rice/#wprm-recipe-53673-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/01/Cheese-Ranch-Chicken-with-Cauliflower-Rice-4.jpg"
    },
    {
      "text": "Rub the rest of the ranch dressing onto the chicken along with salt and pepper to taste. Place the seasoned chicken in the baking dish.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheesy-ranch-chicken-cauliflower-rice/#wprm-recipe-53673-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/01/Cheese-Ranch-Chicken-with-Cauliflower-Rice-5.jpg"
    },
    {
      "text": "Drizzle with olive oil.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheesy-ranch-chicken-cauliflower-rice/#wprm-recipe-53673-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/01/Cheese-Ranch-Chicken-with-Cauliflower-Rice-6.jpg"
    },
    {
      "text": "Bake in the oven for 40-45 minutes or until the chicken is cooked and reaches an internal temperature of 165F.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheesy-ranch-chicken-cauliflower-rice/#wprm-recipe-53673-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/01/Cheese-Ranch-Chicken-with-Cauliflower-Rice-7.jpg"
    },
    {
      "text": "Let cool for a few minutes before serving. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheesy-ranch-chicken-cauliflower-rice/#wprm-recipe-53673-step-0-7",
      "imageSource": null
    }
