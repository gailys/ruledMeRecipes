  "ingredients": [
    "5 cup cauliflower (florets)",
    "3 tablespoon curry powder",
    "1 teaspoon garlic powder",
    "1/2 teaspoon cumin",
    "1 teaspoon paprika",
    "1/3 teaspoon salt",
    "4 tablespoon olive oil",
    "3/4 cup red onion (diced)",
    "3 ounce carrot (chopped)",
    "4 cup vegetable broth",
    "1 cup unsweetened almond milk",
    "1/2 teaspoon crushed red pepper flakes",
    "3 cup kale (chopped)",
    "salt and pepper (To taste)"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 400°F. Gather ingredients together.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cauliflower-and-kale-curry-soup/#wprm-recipe-59670-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/10/cauliflower-and-kale-curry-soup-step-01.jpg"
    },
    {
      "text": "Add the cauliflower, curry powder, garlic, cumin, paprika, salt, and most of the olive oil to a bowl. Toss to coat the cauliflower evenly.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cauliflower-and-kale-curry-soup/#wprm-recipe-59670-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/10/cauliflower-and-kale-curry-soup-step-02.jpg"
    },
    {
      "text": "Spread the cauliflower out on a baking sheet. Roast for 25 minutes or until tender, but still quite firm. Take out of the oven and allow to cool.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cauliflower-and-kale-curry-soup/#wprm-recipe-59670-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/10/cauliflower-and-kale-curry-soup-step-03.jpg"
    },
    {
      "text": "Once cooled, chop the cauliflower in a food processor until it has a rice-like consistency.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cauliflower-and-kale-curry-soup/#wprm-recipe-59670-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/10/cauliflower-and-kale-curry-soup-step-04.jpg"
    },
    {
      "text": "In a large stock pot add the remaining oil, the onions, and the minced garlic. Cook until the onions begin to soften.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cauliflower-and-kale-curry-soup/#wprm-recipe-59670-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/10/cauliflower-and-kale-curry-soup-step-05.jpg"
    },
    {
      "text": "Add the broth, almond milk, vegetables, and red chili pepper flakes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cauliflower-and-kale-curry-soup/#wprm-recipe-59670-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/10/cauliflower-and-kale-curry-soup-step-06.jpg"
    },
    {
      "text": "Bring the soup to a boil, then turn down and simmer for 20 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cauliflower-and-kale-curry-soup/#wprm-recipe-59670-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/10/cauliflower-and-kale-curry-soup-step-07.jpg"
    },
    {
      "text": "Season with salt and pepper to serve.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cauliflower-and-kale-curry-soup/#wprm-recipe-59670-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/10/cauliflower-and-kale-curry-soup-step-08.jpg"
    }
  ],
