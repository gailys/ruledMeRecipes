  "ingredients": [
    "12 ounce chorizo sausage",
    "1/2 cup onion",
    "1 1/2 cup green cabbage (shredded)",
    "1 1/2 cup red cabbage (shredded)",
    "2 tablespoon coconut oil",
    "2 ounce colby jack cheese (deli slices)",
    "2 tablespoon fresh cilantro (chopped)"
  ],
  "instructions": [
    {
      "text": "Remove casings from sausages and rough chop. Chop onion and shred cabbage, if not using pre-shredded cabbage.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/spicy-sausage-cabbage-skillet-melt/#wprm-recipe-51983-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/12/spicy-sausage-cabbage-skillet-melt-step-01.jpg"
    },
    {
      "text": "Melt coconut oil in a large skillet and add onion and cabbage. Cook over medium-high heat until the vegetables begin to become tender, about 8 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/spicy-sausage-cabbage-skillet-melt/#wprm-recipe-51983-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/12/spicy-sausage-cabbage-skillet-melt-step-02.jpg"
    },
    {
      "text": "Add sausage, stirring to mix it into the cabbage and onions. Cook 8 minutes more.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/spicy-sausage-cabbage-skillet-melt/#wprm-recipe-51983-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/12/spicy-sausage-cabbage-skillet-melt-step-03.jpg"
    },
    {
      "text": "Add the cheese on top and cover the skillet.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/spicy-sausage-cabbage-skillet-melt/#wprm-recipe-51983-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/12/spicy-sausage-cabbage-skillet-melt-step-04.jpg"
    },
    {
      "text": "Turn off the heat and wait 5 minutes while the cheese melts into the cabbage and vegetables.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/spicy-sausage-cabbage-skillet-melt/#wprm-recipe-51983-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/12/spicy-sausage-cabbage-skillet-melt-step-05.jpg"
    },
    {
      "text": "Remove the lid from the skillet and stir. Top with cilantro and serve immediately right from the skillet.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/spicy-sausage-cabbage-skillet-melt/#wprm-recipe-51983-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2016/12/spicy-sausage-cabbage-skillet-melt-step-06.jpg"
    }
  ],
