  "ingredients": [
    "3 ounce boneless, skinless chicken thighs",
    "1 teaspoon curry powder",
    "salt and pepper (to taste)",
    "1 teaspoon soy sauce (or coconut aminos)",
    "1/2 teaspoon oyster sauce",
    "1/8 teaspoon white pepper",
    "15 gram green onion",
    "1 teaspoon fresh garlic",
    "3 ounce zucchini",
    "1 tablespoon butter",
    "1 tablespoon coconut oil",
    "1 large egg",
    "1 ounce mung bean sprouts",
    "2 medium bird's eye chile pepper (chopped)",
    "1 teaspoon lime juice"
  ],
  "instructions": [
    {
      "text": "Season the chicken with curry powder, salt, and pepper. Set aside.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/thai-chicken-zoodles/#wprm-recipe-51547-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/01/thaichickenzoodles-1.jpg"
    },
    {
      "text": "Combine the soy sauce, oyster sauce, and white pepper to create the sauce.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/thai-chicken-zoodles/#wprm-recipe-51547-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/01/thaichickenzoodles-2.jpg"
    },
    {
      "text": "Chop the green onion and garlic finely, and make zoodles out of the zucchini — I use a spiralizer for this.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/thai-chicken-zoodles/#wprm-recipe-51547-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/01/thaichickenzoodles-3.jpg"
    },
    {
      "text": "Sauté the seasoned chicken in butter until browned. When done, slice into bite-sized pieces.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/thai-chicken-zoodles/#wprm-recipe-51547-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/01/thaichickenzoodles-4.jpg"
    },
    {
      "text": "In the same pan, melt the coconut oil over high heat. Sauté the chopped green onion until fragrant.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/thai-chicken-zoodles/#wprm-recipe-51547-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/01/thaichickenzoodles-5.jpg"
    },
    {
      "text": "Add the chopped garlic and again sauté until fragrant.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/thai-chicken-zoodles/#wprm-recipe-51547-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/01/thaichickenzoodles-6.jpg"
    },
    {
      "text": "Crack the egg into the pan and scramble. Sauté until lightly browned.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/thai-chicken-zoodles/#wprm-recipe-51547-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/01/thaichickenzoodles-7.jpg"
    },
    {
      "text": "Add the bean sprouts and zoodles. Mix everything together well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/thai-chicken-zoodles/#wprm-recipe-51547-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/01/thaichickenzoodles-8.jpg"
    },
    {
      "text": "Add in the sauce and stir to coat everything evenly. Reduce the sauce until there is little liquid left.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/thai-chicken-zoodles/#wprm-recipe-51547-step-0-8",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/01/thaichickenzoodles-9.jpg"
    },
    {
      "text": "Add in the fried chicken pieces and stir.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/thai-chicken-zoodles/#wprm-recipe-51547-step-0-9",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/01/thaichickenzoodles-10.jpg"
    },
    {
      "text": "Garnish with a few chopped red chiles and squeeze the lime juice on top. Serve while hot!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/thai-chicken-zoodles/#wprm-recipe-51547-step-0-10",
      "imageSource": null
    }
  ],
