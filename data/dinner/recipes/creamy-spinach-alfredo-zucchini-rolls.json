  },
  "ingredients": [
    "2 medium zucchini",
    "1 1/2 cup ricotta cheese",
    "1 cup grated parmesan cheese (divided)",
    "2 teaspoon dried basil",
    "1 medium egg",
    "4 tablespoon butter",
    "2 teaspoon fresh garlic (minced)",
    "1 cup heavy whipping cream",
    "1/2 cup baby spinach (chopped)",
    "5 ounce sun-dried tomatoes"
  ],
  "instructions": [
    {
      "text": "Pre-heat oven to 350 degrees. Coat casserole dish with non-stick spray. Prepare the zucchini rolls by slicing each medium zucchini from end to end using a wide vegetable peeler. You will need 20 slices to fill a small casserole dish.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-spinach-alfredo-zucchini-rolls/#wprm-recipe-52910-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/02/creamy-spinach-alfredo-lasagna-rolls-01.jpg"
    },
    {
      "text": "Prepare the filling by mixing the ricotta, half of the Parmesan cheese, basil, spinach, and egg in a large bowl. Scoop the filling into a pastry bag or large plastic bag and set aside.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-spinach-alfredo-zucchini-rolls/#wprm-recipe-52910-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/02/creamy-spinach-alfredo-lasagna-rolls-02.jpg"
    },
    {
      "text": "Pre-heat a pan on the stove. Heat the butter, garlic, and cream in a small saucepan over medium heat. Stir in the remaining Parmesan cheese until the sauce thickens. Remove the sauce from the heat.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-spinach-alfredo-zucchini-rolls/#wprm-recipe-52910-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/02/creamy-spinach-alfredo-lasagna-rolls-05.jpg"
    },
    {
      "text": "Ladle a third of the sauce into the bottom of the casserole dish.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-spinach-alfredo-zucchini-rolls/#wprm-recipe-52910-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/02/creamy-spinach-alfredo-lasagna-rolls-04.jpg"
    },
    {
      "text": "Cut the tip of the piping bag or plastic bag. Squeeze a strip of filling onto each of the zucchini noodle strips.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-spinach-alfredo-zucchini-rolls/#wprm-recipe-52910-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/02/creamy-spinach-alfredo-lasagna-rolls-06.jpg"
    },
    {
      "text": "Roll each strip gently, being careful not to squeeze the filling out.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-spinach-alfredo-zucchini-rolls/#wprm-recipe-52910-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/02/creamy-spinach-alfredo-lasagna-rolls-07.jpg"
    },
    {
      "text": "Place each zucchini roll into the casserole dish spiral side down into the sauce.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-spinach-alfredo-zucchini-rolls/#wprm-recipe-52910-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/02/creamy-spinach-alfredo-lasagna-rolls-08.jpg"
    },
    {
      "text": "Stir the sundried tomatoes into the remaining sauce. Spoon the sauce over the rolls.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-spinach-alfredo-zucchini-rolls/#wprm-recipe-52910-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/02/creamy-spinach-alfredo-lasagna-rolls-09.jpg"
    },
    {
      "text": "Cover with foil and bake for 25-30 minutes, until the top of the sauce is brown and bubbling. Remove from oven and cool to serve.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-spinach-alfredo-zucchini-rolls/#wprm-recipe-52910-step-0-8",
      "imageSource": null
    }
  ],
