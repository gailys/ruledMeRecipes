  "ingredients": [
    "20 ounce ground chicken",
    "1/3 cup grated parmesan cheese",
    "1 large egg",
    "1/4 cup pesto",
    "1/4 cup sun-dried tomatoes (chopped and oil drained)",
    "2 teaspoon fresh garlic (minced)",
    "1/2 medium red onion (diced)",
    "salt and pepper (to taste)",
    "1 tablespoon olive oil",
    "16 ounce broccoli (cut into florets)",
    "4 tablespoon olive oil",
    "salt and pepper (to taste)",
    "1 teaspoon garlic powder",
    "1 teaspoon onion powder"
  ],
  "instructions": [
    {
      "text": "Gather and prep all of your ingredients. Pre-heat oven to 400F.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/sheet-pan-chicken-tuscan-meatballs-broccoli/#wprm-recipe-57472-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/12/Air-Fryer-Chicken-Tuscan-Meatballs-1.jpg"
    },
    {
      "text": "Add all of the ingredients for the meatballs in a large bowl. If your pesto is oily, you can skip adding the olive oil.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/sheet-pan-chicken-tuscan-meatballs-broccoli/#wprm-recipe-57472-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/12/Air-Fryer-Chicken-Tuscan-Meatballs-2.jpg"
    },
    {
      "text": "Using your hands, toss the ingredients to combine. Try not to overwork the mixture. Allow to rest for 5-10 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/sheet-pan-chicken-tuscan-meatballs-broccoli/#wprm-recipe-57472-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/12/Air-Fryer-Chicken-Tuscan-Meatballs-3.jpg"
    },
    {
      "text": "While the meatball mixture is resting, prepare the broccoli. Combine the broccoli, olive oil, onion, garlic, and salt and pepper to taste. Toss well in a bowl, or add to a plastic bag and shake until well coated.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/sheet-pan-chicken-tuscan-meatballs-broccoli/#wprm-recipe-57472-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/12/Air-Fryer-Chicken-Tuscan-Meatballs-4.jpg"
    },
    {
      "text": "Form the meatballs by scooping the mixture with a spoon, packing into your palm, and rolling into a ball. Meatballs should be a little larger than golf balls. Space the meatballs evenly on a baking sheet lined with parchment paper. Sprinkle the broccoli between the meatballs.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/sheet-pan-chicken-tuscan-meatballs-broccoli/#wprm-recipe-57472-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/12/Air-Fryer-Chicken-Tuscan-Meatballs-5.jpg"
    },
    {
      "text": "Bake for 23-26 minutes, or until meatballs are cooked through and broccoli is well roasted.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/sheet-pan-chicken-tuscan-meatballs-broccoli/#wprm-recipe-57472-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/12/Air-Fryer-Chicken-Tuscan-Meatballs-6.jpg"
    },
    {
      "text": "Serve immediately and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/sheet-pan-chicken-tuscan-meatballs-broccoli/#wprm-recipe-57472-step-0-6",
      "imageSource": null
