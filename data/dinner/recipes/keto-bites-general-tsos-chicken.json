    "recipeInstructions": [
      {
        "@type": "HowToStep",
        "text": "Preheat oven to 325F. Place about half a bag of pork rinds in the food processor.",
        "name": "Preheat oven to 325F. Place about half a bag of pork rinds in the food processor.",
        "url": "https://www.ruled.me/keto-bites-general-tsos-chicken/#wprm-recipe-50649-step-0-0",
        "image": "https://www.ruled.me/wp-content/uploads/2013/12/general_tso_chicken-33.jpg"
      },
      {
        "@type": "HowToStep",
        "text": "Pulse them until they are a fine and ground powder. Measure and grind more if needed to equal amount called for.",
