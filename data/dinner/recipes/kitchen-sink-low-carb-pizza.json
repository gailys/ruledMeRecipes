  "featuredImage": "images/18502ec9920da84b973c0189.jpg",
  "rawRecipe": {
    "@type": "Recipe",
    "name": "\"Kitchen Sink\" Low Carb Pizza",
    "author": {
      "@type": "Person",
      "name": "Craig Clarke",
      "url": "https://www.ruled.me/about-us/#craig-clarke"
    },
    "description": "This makes a total of 8 servings of &quot;Kitchen Sink&quot; Low Carb Pizza. Each serving comes out to be 306 calories, 23.3g fats, 2.8g net carbs, and 20.3g protein.",
    "datePublished": "2013-12-15T01:40:19+00:00",
    "image": [
      "https://www.ruled.me/wp-content/uploads/2013/12/20131214_160940.jpg"
    ],
    "recipeYield": [
      "8",
      "8 servings"
    ],
    "prepTime": "PT15M",
    "cookTime": "PT35M",
    "totalTime": "PT50M",
    "recipeIngredient": [
      "2 1/4 cup mozzarella cheese",
      "3/4 cup almond flour",
      "2 tablespoon parmesan cheese",
      "1 tablespoon italian seasoning",
      "2 tablespoon cream cheese (softened)",
      "1 large egg",
      "4 ounce bacon",
      "8 ounce canned chicken breast",
      "9 tablespoon creamed spinach dip",
      "1/2 teaspoon salt"
    ],
    "recipeInstructions": [
      {
        "@type": "HowToStep",
        "text": "In a bowl, put 2/3 of the mozzarella cheese.",
        "name": "In a bowl, put 2/3 of the mozzarella cheese.",
        "url": "https://www.ruled.me/kitchen-sink-low-carb-pizza/#wprm-recipe-50581-step-0-0",
        "image": "https://www.ruled.me/wp-content/uploads/2013/12/20131214_150821.jpg"
      },
      {
        "@type": "HowToStep",
        "text": "Measure out the almond flour, then combine the Parmesan cheese and Italian seasoning with it and mix well.",
        "name": "Measure out the almond flour, then combine the Parmesan cheese and Italian seasoning with it and mix well.",
        "url": "https://www.ruled.me/kitchen-sink-low-carb-pizza/#wprm-recipe-50581-step-0-1",
        "image": "https://www.ruled.me/wp-content/uploads/2013/12/20131214_151536.jpg"
      },
      {
        "@type": "HowToStep",
        "text": "In a small ramekin put the cream cheese and egg, so that it's ready.",
        "name": "In a small ramekin put the cream cheese and egg, so that it's ready.",
        "url": "https://www.ruled.me/kitchen-sink-low-carb-pizza/#wprm-recipe-50581-step-0-2",
        "image": "https://www.ruled.me/wp-content/uploads/2013/12/20131214_151530.jpg"
      },
      {
        "@type": "HowToStep",
        "text": "Microwave the mozzarella cheese for about 45 seconds, until it is gooey and melted.",
        "name": "Microwave the mozzarella cheese for about 45 seconds, until it is gooey and melted.",
        "url": "https://www.ruled.me/kitchen-sink-low-carb-pizza/#wprm-recipe-50581-step-0-3",
        "image": "https://www.ruled.me/wp-content/uploads/2013/12/20131214_152212.jpg"
      },
      {
        "@type": "HowToStep",
        "text": "Combine all of dough ingredients in a large bowl and mix them together well.",
        "name": "Combine all of dough ingredients in a large bowl and mix them together well.",
        "url": "https://www.ruled.me/kitchen-sink-low-carb-pizza/#wprm-recipe-50581-step-0-4",
        "image": "https://www.ruled.me/wp-content/uploads/2013/12/20131214_152309.jpg"
      },
      {
        "@type": "HowToStep",
        "text": "Keep kneading the dough together until you can form a ball. Add more almond flour if needed. Warning: This gets messy.",
        "name": "Keep kneading the dough together until you can form a ball. Add more almond flour if needed. Warning: This gets messy.",
        "url": "https://www.ruled.me/kitchen-sink-low-carb-pizza/#wprm-recipe-50581-step-0-5",
        "image": "https://www.ruled.me/wp-content/uploads/2013/12/20131214_152608.jpg"
      },
      {
        "@type": "HowToStep",
        "text": "Spread the dough onto your pre-greased baking sheet. I use these silpats, so that I don't have to use grease. I only got them the other day and I have to say I wish I had bought them a long time ago. I don't even know how I put anything in the oven without them.",
        "name": "Spread the dough onto your pre-greased baking sheet. I use these silpats, so that I don't have to use grease. I only got them the other day and I have to say I wish I had bought them a long time ago. I don't even know how I put anything in the oven without them.",
        "url": "https://www.ruled.me/kitchen-sink-low-carb-pizza/#wprm-recipe-50581-step-0-6",
        "image": "https://www.ruled.me/wp-content/uploads/2013/12/20131214_153108.jpg"
      },
      {
        "@type": "HowToStep",
        "text": "Put the pizza dough in the oven and let it bake for 5 minutes.",
        "name": "Put the pizza dough in the oven and let it bake for 5 minutes.",
        "url": "https://www.ruled.me/kitchen-sink-low-carb-pizza/#wprm-recipe-50581-step-0-7",
        "image": "https://www.ruled.me/wp-content/uploads/2013/12/20131214_153513.jpg"
      },
      {
        "@type": "HowToStep",
        "text": "Once the pizza crust is browned on the top, take it out of the oven - it's time to flip it.",
        "name": "Once the pizza crust is browned on the top, take it out of the oven - it's time to flip it.",
        "url": "https://www.ruled.me/kitchen-sink-low-carb-pizza/#wprm-recipe-50581-step-0-8",
        "image": "https://www.ruled.me/wp-content/uploads/2013/12/20131214_154147.jpg"
      },
      {
        "@type": "HowToStep",
        "text": "I use a second silpat and put it over the top, flipping it around. It makes it really easy. If you use a spatula or some other small tool, the crust will fall apart.",
        "name": "I use a second silpat and put it over the top, flipping it around. It makes it really easy. If you use a spatula or some other small tool, the crust will fall apart.",
        "url": "https://www.ruled.me/kitchen-sink-low-carb-pizza/#wprm-recipe-50581-step-0-9",
        "image": "https://www.ruled.me/wp-content/uploads/2013/12/20131214_154358.jpg"
      },
      {
        "@type": "HowToStep",
        "text": "It should look white on the bottom, still uncooked. It needs to go back in the oven for 5 more minutes.",
        "name": "It should look white on the bottom, still uncooked. It needs to go back in the oven for 5 more minutes.",
        "url": "https://www.ruled.me/kitchen-sink-low-carb-pizza/#wprm-recipe-50581-step-0-10",
        "image": "https://www.ruled.me/wp-content/uploads/2013/12/20131214_154428.jpg"
      },
      {
        "@type": "HowToStep",
        "text": "Once that side is browned, remove it from the oven.",
        "name": "Once that side is browned, remove it from the oven.",
        "url": "https://www.ruled.me/kitchen-sink-low-carb-pizza/#wprm-recipe-50581-step-0-11",
        "image": "https://www.ruled.me/wp-content/uploads/2013/12/20131214_154821.jpg"
      },
      {
        "@type": "HowToStep",
        "text": "We'e ready to top this thing! Let's make sure you have the toppings ready.",
        "name": "We'e ready to top this thing! Let's make sure you have the toppings ready.",
        "url": "https://www.ruled.me/kitchen-sink-low-carb-pizza/#wprm-recipe-50581-step-0-12",
        "image": "https://www.ruled.me/wp-content/uploads/2013/12/20131214_154958.jpg"
      },
      {
        "@type": "HowToStep",
        "text": "Before putting this in the oven, I get started on my bacon. Cut your bacon into small pieces and put them in a pan to fry.",
        "name": "Before putting this in the oven, I get started on my bacon. Cut your bacon into small pieces and put them in a pan to fry.",
        "url": "https://www.ruled.me/kitchen-sink-low-carb-pizza/#wprm-recipe-50581-step-0-13",
        "image": "https://www.ruled.me/wp-content/uploads/2013/12/20131214_150759.jpg"
      },
      {
        "@type": "HowToStep",
        "text": "Once the bacon is done, remove it from the pan while saving the grease. Lay the bacon on some paper towels to crisp up and drain excess grease.",
        "name": "Once the bacon is done, remove it from the pan while saving the grease. Lay the bacon on some paper towels to crisp up and drain excess grease.",
        "url": "https://www.ruled.me/kitchen-sink-low-carb-pizza/#wprm-recipe-50581-step-0-14",
        "image": "https://www.ruled.me/wp-content/uploads/2013/12/20131214_151229.jpg"
      },
      {
        "@type": "HowToStep",
        "text": "In the same pan, let the grease get hot.",
        "name": "In the same pan, let the grease get hot.",
        "url": "https://www.ruled.me/kitchen-sink-low-carb-pizza/#wprm-recipe-50581-step-0-15",
        "image": "https://www.ruled.me/wp-content/uploads/2013/12/20131214_151514.jpg"
      },
      {
        "@type": "HowToStep",
        "text": "Drop the canned chicken into the pan and let it fry.",
        "name": "Drop the canned chicken into the pan and let it fry.",
        "url": "https://www.ruled.me/kitchen-sink-low-carb-pizza/#wprm-recipe-50581-step-0-16",
        "image": "https://www.ruled.me/wp-content/uploads/2013/12/20131214_151724.jpg"
      },
      {
        "@type": "HowToStep",
        "text": "Measure out the spinach dip.",
        "name": "Measure out the spinach dip.",
        "url": "https://www.ruled.me/kitchen-sink-low-carb-pizza/#wprm-recipe-50581-step-0-17",
        "image": "https://www.ruled.me/wp-content/uploads/2013/12/20131214_152020.jpg"
      },
      {
        "@type": "HowToStep",
        "text": "Once the chicken is done cooking, mix the creamed spinach dip into it. Make sure every small piece of chicken is coated.",
        "name": "Once the chicken is done cooking, mix the creamed spinach dip into it. Make sure every small piece of chicken is coated.",
        "url": "https://www.ruled.me/kitchen-sink-low-carb-pizza/#wprm-recipe-50581-step-0-18",
        "image": "https://www.ruled.me/wp-content/uploads/2013/12/20131214_153343.jpg"
      },
      {
        "@type": "HowToStep",
        "text": "Add the chicken mixture to the top of the pizza, making sure that it is spread out evenly.",
        "name": "Add the chicken mixture to the top of the pizza, making sure that it is spread out evenly.",
        "url": "https://www.ruled.me/kitchen-sink-low-carb-pizza/#wprm-recipe-50581-step-0-19",
        "image": "https://www.ruled.me/wp-content/uploads/2013/12/20131214_155241.jpg"
      },
      {
        "@type": "HowToStep",
        "text": "Put the remaining cheese on top.",
        "name": "Put the remaining cheese on top.",
        "url": "https://www.ruled.me/kitchen-sink-low-carb-pizza/#wprm-recipe-50581-step-0-20",
        "image": "https://www.ruled.me/wp-content/uploads/2013/12/20131214_155352.jpg"
      },
      {
        "@type": "HowToStep",
        "text": "Add some bacon bits on top, but save some for when it's finished.",
        "name": "Add some bacon bits on top, but save some for when it's finished.",
        "url": "https://www.ruled.me/kitchen-sink-low-carb-pizza/#wprm-recipe-50581-step-0-21",
        "image": "https://www.ruled.me/wp-content/uploads/2013/12/20131214_155456.jpg"
      },
      {
        "@type": "HowToStep",
        "text": "Put it back into the oven, under the broiler, for 5 more minutes..",
        "name": "Put it back into the oven, under the broiler, for 5 more minutes..",
        "url": "https://www.ruled.me/kitchen-sink-low-carb-pizza/#wprm-recipe-50581-step-0-22",
        "image": "https://www.ruled.me/wp-content/uploads/2013/12/20131214_155825.jpg"
      },
      {
        "@type": "HowToStep",
        "text": "When you see the cheese starting to brown and the bacon on the verge of burning, take it out.",
        "name": "When you see the cheese starting to brown and the bacon on the verge of burning, take it out.",
        "url": "https://www.ruled.me/kitchen-sink-low-carb-pizza/#wprm-recipe-50581-step-0-23",
        "image": "https://www.ruled.me/wp-content/uploads/2013/12/20131214_160002.jpg"
      },
      {
        "@type": "HowToStep",
        "text": "Let it cool for 10 minutes.",
        "name": "Let it cool for 10 minutes.",
        "url": "https://www.ruled.me/kitchen-sink-low-carb-pizza/#wprm-recipe-50581-step-0-24",
        "image": "https://www.ruled.me/wp-content/uploads/2013/12/20131214_160025.jpg"
      },
      {
        "@type": "HowToStep",
        "text": "Slice into serving pieces and enjoy!",
        "name": "Slice into serving pieces and enjoy!",
        "url": "https://www.ruled.me/kitchen-sink-low-carb-pizza/#wprm-recipe-50581-step-0-25",
        "image": "https://www.ruled.me/wp-content/uploads/2013/12/20131214_160954.jpg"
      }
    ],
