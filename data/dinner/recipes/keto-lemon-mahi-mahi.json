  "instructions": [
    {
      "text": "Measure out and prepare all the ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-lemon-mahi-mahi/#wprm-recipe-53937-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/08/Lemon-Mahi-Mahi-1.jpg"
    },
    {
      "text": "Use quarter of the butter and olive oil and add to the frying pan. Fry the fish on medium heat and season with salt and pepper. Cook the fish until golden brown on both sides. Remove from heat.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-lemon-mahi-mahi/#wprm-recipe-53937-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/08/Lemon-Mahi-Mahi-2.jpg"
    },
    {
      "text": "Using another quarter of the butter and olive oil, cook the asparagus spears until tender. Remove from pan and set aside.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-lemon-mahi-mahi/#wprm-recipe-53937-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/08/Lemon-Mahi-Mahi-3.jpg"
    },
    {
      "text": "Use the rest of the butter and olive oil in the pan. Add the minced garlic and crushed red pepper flakes and sautee for 30 seconds. Add in the lemon slices, lemon zest + juice, and chopped parsley. Sautee for 30 seconds.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-lemon-mahi-mahi/#wprm-recipe-53937-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/08/Lemon-Mahi-Mahi-4.jpg"
    },
    {
      "text": "Add the mahi mahi and asparagus spears back into the pan. Stir well to combine the lemon butter sauce on top of the asparagus and fish.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-lemon-mahi-mahi/#wprm-recipe-53937-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/08/Lemon-Mahi-Mahi-5.jpg"
    },
    {
      "text": "Serve and enjoy!",
