  "description": "This makes a total of 4 servings of Miso Salmon. Each serving comes out to be 349 calories, 17.8g fats, 3.3g net carbs, and 32.9g protein.",
  "servings": 4,
  "yield": [
    "4",
    "4 servings"
  ],
  "prepTime": "PT60M",
  "cookTime": "PT30M",
  "totalTime": "PT90M",
  "totalMinutes": 90,
  "nutrition": {
    "@type": "NutritionInformation",
    "calories": "349 kcal",
