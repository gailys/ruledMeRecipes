  "ingredients": [
    "1 teaspoon coconut oil",
    "1/2 cup unsweetened toasted coconut flakes",
    "2 cup cauliflower (cut into florets)",
    "salt and pepper (to taste)",
    "1 teaspoon coconut oil",
    "2 teaspoon fresh garlic (minced)",
    "1/4 medium red onion (diced)",
    "1 1/4 cup canned coconut milk",
    "12 ounce cooked shrimp",
    "1 tablespoon lime juice",
    "3 tablespoon fresh cilantro (chopped)",
    "2 tablespoon crushed red pepper flakes"
  ],
  "instructions": [
    {
      "text": "Preheat non-stick skillet to prepare cauliflower rice. Heat coconut oil listed in cauliflower rice ingredient list and sauté the unsweetened coconut flakes to slightly brown, being careful not to burn.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cilantro-lime-shrimp-with-crispy-coconut-caulirice/#wprm-recipe-52806-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/12/cilantro-lime-shrimp-w-crispy-coconut-caulirice-01.jpg"
    },
    {
      "text": "Place cauliflower florets in a food processor or blender, and pulse until the pieces resemble rice.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cilantro-lime-shrimp-with-crispy-coconut-caulirice/#wprm-recipe-52806-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/12/cilantro-lime-shrimp-w-crispy-coconut-caulirice-02.jpg"
    },
    {
      "text": "Stir riced cauliflower into skillet with coconut flakes. Sauté ingredients until riced cauliflower is softened, but not mushy. Don’t add extra liquid; let the caulirice cook in the coconut oil that is left from toasting coconut. Season with a little salt and pepper, if desired. Remove from pan and place in a covered container until ready to serve.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cilantro-lime-shrimp-with-crispy-coconut-caulirice/#wprm-recipe-52806-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/12/cilantro-lime-shrimp-w-crispy-coconut-caulirice-03.jpg"
    },
    {
      "text": "In the same pan, sauté the coconut oil listed in shrimp ingredient list, garlic, and onion until fragrant.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cilantro-lime-shrimp-with-crispy-coconut-caulirice/#wprm-recipe-52806-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/12/cilantro-lime-shrimp-w-crispy-coconut-caulirice-04.jpg"
    },
    {
      "text": "Stir in coconut milk and bring to a simmer, allowing the sauce to reduce for 5 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cilantro-lime-shrimp-with-crispy-coconut-caulirice/#wprm-recipe-52806-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/12/cilantro-lime-shrimp-w-crispy-coconut-caulirice-05.jpg"
    },
    {
      "text": "Place the shrimp in an even layer in the coconut sauce and cook on medium-low until the shrimp is soft and warmed through. This should take 3-5 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cilantro-lime-shrimp-with-crispy-coconut-caulirice/#wprm-recipe-52806-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/12/cilantro-lime-shrimp-w-crispy-coconut-caulirice-06.jpg"
    },
    {
      "text": "Gently stir in lime juice and cilantro. Top the shrimp with crushed red pepper.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cilantro-lime-shrimp-with-crispy-coconut-caulirice/#wprm-recipe-52806-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/12/cilantro-lime-shrimp-w-crispy-coconut-caulirice-07.jpg"
    },
    {
      "text": "Place shrimp on top of cauliflower rice, then drizzle the shrimp and rice with the coconut milk sauce.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cilantro-lime-shrimp-with-crispy-coconut-caulirice/#wprm-recipe-52806-step-0-7",
      "imageSource": null
    }
  ],
