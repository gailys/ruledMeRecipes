  "ingredients": [
    "16 ounce hot italian sausage",
    "1 medium onion (chopped)",
    "3 teaspoon fresh garlic (minced)",
    "1 teaspoon dried oregano",
    "1/4 cup sun-dried tomatoes (drained + chopped)",
    "salt and pepper (to taste)",
    "6 cup chicken broth",
    "6 ounce kale (stripped + chopped)",
    "3/4 cup heavy whipping cream",
    "1/4 cup grated parmesan cheese (for garnish)",
    "2 tablespoon fresh parsley (for garnish)"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all of the ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-instant-pot-tuscan-soup/#wprm-recipe-54227-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/03/Keto-Instant-Pot-Tuscan-Soup-1.jpg"
    },
    {
      "text": "Set the Instant Pot to sautee mode. Place in the hot Italian sausage. Break up the sausages with a spoon. Let this cook for about 3 - 6 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-instant-pot-tuscan-soup/#wprm-recipe-54227-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/03/Keto-Instant-Pot-Tuscan-Soup-2.jpg"
    },
    {
      "text": "Add in the onion, garlic, and oregano. Stir to combine well for about 3 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-instant-pot-tuscan-soup/#wprm-recipe-54227-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/03/Keto-Instant-Pot-Tuscan-Soup-3.jpg"
    },
    {
      "text": "Add in the chicken broth, sun-dried tomatoes, salt, and pepper. Stir to combine well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-instant-pot-tuscan-soup/#wprm-recipe-54227-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/03/Keto-Instant-Pot-Tuscan-Soup-4.jpg"
    },
    {
      "text": "On the Instant Pot, select manual, change pressure to high, and set timer for 5 minutes. After the 5 minutes is up, do a quick release.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-instant-pot-tuscan-soup/#wprm-recipe-54227-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/03/Keto-Instant-Pot-Tuscan-Soup-5.jpg"
    },
    {
      "text": "Turn back to saute mode, and add in the kale. Stir this until it starts to look wilty.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-instant-pot-tuscan-soup/#wprm-recipe-54227-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/03/Keto-Instant-Pot-Tuscan-Soup-6.jpg"
    },
    {
      "text": "Add in the heavy cream and stir to combine well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-instant-pot-tuscan-soup/#wprm-recipe-54227-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/03/Keto-Instant-Pot-Tuscan-Soup-7.jpg"
    },
    {
      "text": "Garnish with grated parmesan and fresh parsley. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-instant-pot-tuscan-soup/#wprm-recipe-54227-step-0-7",
      "imageSource": null
    }
