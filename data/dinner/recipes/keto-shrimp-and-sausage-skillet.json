  "ingredients": [
    "8 ounce shrimp (peeled and de-veined)",
    "2 teaspoon old bay seasoning",
    "3 tablespoon olive oil",
    "1/2 medium yellow onion (diced)",
    "1 medium red bell pepper (diced)",
    "1/2 medium green bell pepper (diced)",
    "12 ounce pork sausage (chopped)",
    "1 medium zucchini (chopped)",
    "2 teaspoon fresh garlic (diced)",
    "1/4 cup chicken stock",
    "salt and pepper (to taste)",
    "1/2 teaspoon crushed red pepper flakes",
    "3 tablespoon fresh parsley (chopped)"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all the ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-shrimp-and-sausage-skillet/#wprm-recipe-53793-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/03/Shrimp-and-Sausage-Skillet-1.jpg"
    },
    {
      "text": "In a bowl, toss the shrimp in the old bay seasoning.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-shrimp-and-sausage-skillet/#wprm-recipe-53793-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/03/Shrimp-and-Sausage-Skillet-2.jpg"
    },
    {
      "text": "In a frying pan over medium to high heat, add the olive oil and heat. Add the shrimp and cook for about 3-4 minutes on both sides. When cooked, remove from pan and set aside.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-shrimp-and-sausage-skillet/#wprm-recipe-53793-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/03/Shrimp-and-Sausage-Skillet-3.jpg"
    },
    {
      "text": "In the same pan, cook the onion, red bell pepper, and green bell pepper for about 2-3 minutes or until translucent.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-shrimp-and-sausage-skillet/#wprm-recipe-53793-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/03/Shrimp-and-Sausage-Skillet-4.jpg"
    },
    {
      "text": "Add the chopped sausage and diced zucchini to the frying pan with the onion and peppers. Cook for 2-3 minutes or until sausage is cooked through.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-shrimp-and-sausage-skillet/#wprm-recipe-53793-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/03/Shrimp-and-Sausage-Skillet-5.jpg"
    },
    {
      "text": "Add the cooked shrimp to the pan as well as the fresh garlic. Cook for 1-2 minutes, stirring it all together.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-shrimp-and-sausage-skillet/#wprm-recipe-53793-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/03/Shrimp-and-Sausage-Skillet-6.jpg"
    },
    {
      "text": "Pour chicken stock into the frying pan and stir well until everything is combined well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-shrimp-and-sausage-skillet/#wprm-recipe-53793-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/03/Shrimp-and-Sausage-Skillet-7.jpg"
    },
    {
      "text": "Season with crushed red pepper flakes and salt and pepper. Turn off the stovetop and add fresh parsley on top for serving.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-shrimp-and-sausage-skillet/#wprm-recipe-53793-step-0-7",
      "imageSource": null
    }
