  "ingredients": [
    "400 gram cauliflower (riced)",
    "1 medium zucchini (diced)",
    "1/4 cup avocado oil",
    "1 tablespoon turmeric powder",
    "2 teaspoon cumin",
    "1 teaspoon onion powder",
    "1/2 teaspoon garlic powder",
    "1/2 teaspoon black pepper",
    "500 gram ground chicken",
    "3 ounce fresh cilantro"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all of the ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-golden-chicken-rice-skillet/#wprm-recipe-54303-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/05/Keto-Golden-Chicken-Rice-Skillet-1.jpg"
    },
    {
      "text": "Cut the cauliflower into florets and then put it in a food processor until it is the size and consistency of rice.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-golden-chicken-rice-skillet/#wprm-recipe-54303-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/05/Keto-Golden-Chicken-Rice-Skillet-2.jpg"
    },
    {
      "text": "Dice the zucchini.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-golden-chicken-rice-skillet/#wprm-recipe-54303-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/05/Keto-Golden-Chicken-Rice-Skillet-3.jpg"
    },
    {
      "text": "In a frying pan over medium heat, add avocado oil, turmeric powder, cumin powder, onion powder, garlic powder, and black pepper. Stir this all together for about 30 seconds.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-golden-chicken-rice-skillet/#wprm-recipe-54303-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/05/Keto-Golden-Chicken-Rice-Skillet-4.jpg"
    },
    {
      "text": "Add in the ground chicken and let cook for 6 - 8 minutes or until the internal temp reaches 165F.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-golden-chicken-rice-skillet/#wprm-recipe-54303-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/05/Keto-Golden-Chicken-Rice-Skillet-5.jpg"
    },
    {
      "text": "Stir in the diced zucchini and let cook for 5 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-golden-chicken-rice-skillet/#wprm-recipe-54303-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/05/Keto-Golden-Chicken-Rice-Skillet-6.jpg"
    },
    {
      "text": "Add in the riced cauliflower. Stir to combine. Let sit covered on medium heat for 5 - 8 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-golden-chicken-rice-skillet/#wprm-recipe-54303-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/05/Keto-Golden-Chicken-Rice-Skillet-7.jpg"
    },
    {
      "text": "Garnish with chopped cilantro. Serve and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-golden-chicken-rice-skillet/#wprm-recipe-54303-step-0-7",
      "imageSource": null
    }
