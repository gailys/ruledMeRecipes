  "ingredients": [
    "16 ounce ground beef",
    "3 tablespoon olive oil (divided)",
    "1/2 medium yellow onion (minced)",
    "600 gram cauliflower rice",
    "1 teaspoon garlic powder",
    "1 teaspoon onion powder",
    "1 teaspoon paprika",
    "1/2 teaspoon chili powder",
    "1 teaspoon cumin",
    "1/4 cup beef broth",
    "12 ounce canned tomatoes with green chiles (drained)",
    "2 cup monterey jack cheese (shredded)",
    "salt and pepper (to taste)",
    "1/2 medium red bell pepper",
    "1 medium jalapeno pepper",
    "1 medium avocado (diced)",
    "1/4 medium red onion (minced)",
    "1/4 cup fresh cilantro (chopped)",
    "1 medium lime (sliced)"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all the ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-beefy-burrito-bowl/#wprm-recipe-53757-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/03/Beefy-Burrito-Bowl-1.jpg"
    },
    {
      "text": "In a frying pan on medium to high heat, add half the olive oil and onion. Fry until translucent.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-beefy-burrito-bowl/#wprm-recipe-53757-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/03/Beefy-Burrito-Bowl-2.jpg"
    },
    {
      "text": "Add in the ground beef and cook until brown. When cooked, remove from frying pan and set aside.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-beefy-burrito-bowl/#wprm-recipe-53757-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/03/Beefy-Burrito-Bowl-3.jpg"
    },
    {
      "text": "In the same pan, add the other half of olive oil and cauliflower rice. Cook for 2-3 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-beefy-burrito-bowl/#wprm-recipe-53757-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/03/Beefy-Burrito-Bowl-4.jpg"
    },
    {
      "text": "Add in the garlic powder, onion powder, paprika, chili powder, and cumin. Stir until mixed well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-beefy-burrito-bowl/#wprm-recipe-53757-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/03/Beefy-Burrito-Bowl-5.jpg"
    },
    {
      "text": "Add the beef broth and canned tomatoes. Stir and bring to a simmer.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-beefy-burrito-bowl/#wprm-recipe-53757-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/03/Beefy-Burrito-Bowl-6.jpg"
    },
    {
      "text": "Add in the onion and cooked beef back into the frying pan. Stir together.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-beefy-burrito-bowl/#wprm-recipe-53757-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/03/Beefy-Burrito-Bowl-7.jpg"
    },
    {
      "text": "Add the monterey jack cheese and let it cook like this (no stirring) for 2-3 minutes to allow the cheese to melt.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-beefy-burrito-bowl/#wprm-recipe-53757-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/03/Beefy-Burrito-Bowl-8.jpg"
    },
    {
      "text": "Garnish with red bell pepper, jalapenos, avocado, onion, fresh cilantro, and a sliced lime. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-beefy-burrito-bowl/#wprm-recipe-53757-step-0-8",
      "imageSource": null
    }
  ],
