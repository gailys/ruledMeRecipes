  },
  "ingredients": [
    "5 gram lemongrass",
    "1 tablespoon fresh ginger",
    "1 medium fresh green chile",
    "2 medium shallot",
    "2 teaspoon fresh garlic",
    "2 tablespoon coconut oil",
    "2 teaspoon turmeric powder",
    "21 ounce bone-in, skin-on chicken drumsticks",
    "1/2 cup canned coconut milk",
    "1/2 cup water",
    "1/2 teaspoon salt",
    "1 tablespoon fresh cilantro (chopped)"
  ],
  "instructions": [
    {
      "text": "Bruise the lemongrass. (Lightly crush it with a pestle or meat mallet.) This will help release its aroma while cooking.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-chicken-curry/#wprm-recipe-51583-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/02/5-1.jpg"
    },
    {
      "text": "Using a food processor or pestle and mortar, combine the ginger, green chile, shallots, and garlic into a paste.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-chicken-curry/#wprm-recipe-51583-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/02/5-2.jpg"
    },
    {
      "text": "Melt the coconut oil in a preheated pot over medium heat. Once hot, add in the crushed ingredients and sauté.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-chicken-curry/#wprm-recipe-51583-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/02/5-3.jpg"
    },
    {
      "text": "After 3–4 minutes, add the turmeric powder and smashed lemongrass and sauté once again.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-chicken-curry/#wprm-recipe-51583-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/02/5-4.jpg"
    },
    {
      "text": "Add in the chicken meat and mix well with the sautéed ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-chicken-curry/#wprm-recipe-51583-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/02/5-5.jpg"
    },
    {
      "text": "Once the meat is coated, pour in the coconut milk and water.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-chicken-curry/#wprm-recipe-51583-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/02/5-6.jpg"
    },
    {
      "text": "Add salt and cover the pot. Let everything cook for about 20 minutes or until the desired thickness is reached and the chicken is cooked through.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-chicken-curry/#wprm-recipe-51583-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/02/5-7.jpg"
    },
    {
      "text": "Garnish with chopped cilantro and serve!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-chicken-curry/#wprm-recipe-51583-step-0-7",
      "imageSource": null
    }
  ],
