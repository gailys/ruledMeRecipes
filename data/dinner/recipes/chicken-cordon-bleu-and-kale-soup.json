  "ingredients": [
    "6 slice cooked bacon",
    "2 cup heavy whipping cream",
    "1 tablespoon butter",
    "6 ounce cream cheese",
    "2 cup chicken broth",
    "2 cup swiss cheese (shredded)",
    "1 cup cooked ham (cubed)",
    "6 ounce cooked chicken (Chopped or pulled)",
    "2 cup kale (chopped)"
  ],
  "instructions": [
    {
      "text": "Fry bacon over medium-low heat until crisp. Roughly chop the bacon and set aside, reserving about ¼ to garnish the soup.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chicken-cordon-bleu-and-kale-soup/#wprm-recipe-52778-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/11/keto-chicken-cordon-beu-n-kale-soup-01.jpg"
    },
    {
      "text": "In a large soup pot, heat heavy cream, butter, and cream cheese over medium until everything is melted and blended well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chicken-cordon-bleu-and-kale-soup/#wprm-recipe-52778-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/11/keto-chicken-cordon-beu-n-kale-soup-02.jpg"
    },
    {
      "text": "Pour chicken stock into the pot and bring to a simmer.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chicken-cordon-bleu-and-kale-soup/#wprm-recipe-52778-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/11/keto-chicken-cordon-beu-n-kale-soup-03.jpg"
    },
    {
      "text": "Add the shredded swiss cheese to the soup base and stir until it’s completely melted.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chicken-cordon-bleu-and-kale-soup/#wprm-recipe-52778-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/11/keto-chicken-cordon-beu-n-kale-soup-04.jpg"
    },
    {
      "text": "Mix in the cubed ham, chicken and ¾ of the bacon and bring the soup back to a simmer.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chicken-cordon-bleu-and-kale-soup/#wprm-recipe-52778-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/11/keto-chicken-cordon-beu-n-kale-soup-06.jpg"
    },
    {
      "text": "Stir in the kale and cook with the lid off for about 10 minutes or until the leaves begin to soften.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chicken-cordon-bleu-and-kale-soup/#wprm-recipe-52778-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/11/keto-chicken-cordon-beu-n-kale-soup-08.jpg"
    },
    {
      "text": "Serve hot with the remaining crumbled bacon on top!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chicken-cordon-bleu-and-kale-soup/#wprm-recipe-52778-step-0-6",
      "imageSource": null
    }
  ],
