  "ingredients": [
    "1/3 cup heavy whipping cream",
    "1/3 cup parmesan cheese",
    "1 cup mozzarella cheese (shredded)",
    "1 cup cherry tomatoes (halved)",
    "1/4 cup fresh basil (chopped)",
    "1/4 teaspoon salt",
    "1/8 teaspoon black pepper",
    "crushed red pepper flakes (to taste)",
    "1 medium cauliflower (cut into florets)",
    "1 cup low-carb tomato sauce"
  ],
  "instructions": [
    {
      "text": "Preheat your oven to 425F, and move your oven rack to the middle position. Grease a casserole dish with olive oil.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cheesy-caprese-cauliflower-casserole/#wprm-recipe-58980-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/08/cheesy-caprese-cauliflower-casserole-step-01.jpg"
    },
    {
      "text": "Spread the cauliflower florets out on a baking sheet. Drizzle a little olive oil on top then season with salt and pepper. Roast for 30 minutes, turning the florets once.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cheesy-caprese-cauliflower-casserole/#wprm-recipe-58980-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/08/cheesy-caprese-cauliflower-casserole-step-02.jpg"
    },
    {
      "text": "Heat the tomato sauce in a saucepan over low heat. Add the heavy cream, Parmesan, red pepper flakes, salt, and pepper. Mix together.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cheesy-caprese-cauliflower-casserole/#wprm-recipe-58980-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/08/cheesy-caprese-cauliflower-casserole-step-03.jpg"
    },
    {
      "text": "Remove the sauce from the heat then fold in the cauliflower.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cheesy-caprese-cauliflower-casserole/#wprm-recipe-58980-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/08/cheesy-caprese-cauliflower-casserole-step-04.jpg"
    },
    {
      "text": "Mix in half of the mozzarella, half of the cherry tomatoes, and some of the chopped basil.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cheesy-caprese-cauliflower-casserole/#wprm-recipe-58980-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/08/cheesy-caprese-cauliflower-casserole-step-05.jpg"
    },
    {
      "text": "Transfer everything to the casserole dish. Top with the rest of mozzarella and tomatoes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cheesy-caprese-cauliflower-casserole/#wprm-recipe-58980-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/08/cheesy-caprese-cauliflower-casserole-step-06.jpg"
    },
    {
      "text": "Lower the oven temperature to 350F. Bake the casserole for 30 minutes, then broil for another 2-3 minutes to brown the cheese on top. Allow the casserole to rest for about 5 minutes before serving with the fresh basil.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cheesy-caprese-cauliflower-casserole/#wprm-recipe-58980-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/08/cheesy-caprese-cauliflower-casserole-step-07.jpg"
    }
  ],
