  "instructions": [
    {
      "text": "Measure out and prepare all the ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-burrito-bowl/#wprm-recipe-53885-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/06/Chicken-Burrito-Bowl-1.jpg"
    },
    {
      "text": "In a frying pan, add half the olive oil and minced onion and fry on medium heat until translucent.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-burrito-bowl/#wprm-recipe-53885-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/06/Chicken-Burrito-Bowl-2.jpg"
    },
    {
      "text": "Rinse the cauliflower and chop it until riced in a food processor.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-burrito-bowl/#wprm-recipe-53885-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/06/Chicken-Burrito-Bowl-3.jpg"
    },
    {
      "text": "Add the ground chicken to the pan and cook until chicken is cooked thoroughly and starts to brown. Then remove from heat.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-burrito-bowl/#wprm-recipe-53885-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/06/Chicken-Burrito-Bowl-4.jpg"
    },
    {
      "text": "Add the other half of the olive oil to the pan and add the riced cauliflower. Fry on medium heat for about 2 - 3 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-burrito-bowl/#wprm-recipe-53885-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/06/Chicken-Burrito-Bowl-5.jpg"
    },
    {
      "text": "Add in the seasonings: garlic powder, onion powder, paprika, chili powder, and cumin. Stir together well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-burrito-bowl/#wprm-recipe-53885-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/06/Chicken-Burrito-Bowl-6.jpg"
    },
    {
      "text": "Add in the drained diced tomatoes and chicken broth. Stir to combine well and heat for 1 - 3 minutes. Bring this to a simmer and let the cauliflower absorb all the juices.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-burrito-bowl/#wprm-recipe-53885-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/06/Chicken-Burrito-Bowl-7.jpg"
    },
    {
      "text": "Put the chicken that you set aside back into the frying pan. Stir well to combine.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-burrito-bowl/#wprm-recipe-53885-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/06/Chicken-Burrito-Bowl-8.jpg"
    },
    {
      "text": "Top with monterey jack cheese. Let this sit on the stove for 1 - 3 minutes, covered, so the cheese can melt.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-burrito-bowl/#wprm-recipe-53885-step-0-8",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/06/Chicken-Burrito-Bowl-9.jpg"
    },
    {
      "text": "Serve and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-burrito-bowl/#wprm-recipe-53885-step-0-9",
      "imageSource": null
    }
  ],
