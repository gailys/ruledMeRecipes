  "ingredients": [
    "24 ounce ground beef",
    "2 tablespoon taco seasoning",
    "1 tablespoon chili powder",
    "2 tablespoon tomato paste",
    "1/2 cup water",
    "2/3 cup coconut flour",
    "1/3 cup almond flour",
    "1 tablespoon stevia/erythritol blend",
    "2 teaspoon baking powder",
    "1/4 teaspoon xanthan gum",
    "4 large egg",
    "6 tablespoon butter (melted)",
    "3/4 cup unsweetened almond milk",
    "1 cup cheddar cheese (shredded)"
  ],
  "instructions": [
    {
      "text": "Gather ingredients and preheat oven to 325F. Heat an oven safe skillet over medium heat.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-tamale-pie/#wprm-recipe-59360-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/09/keto-tamale-pie-step-01.jpg"
    },
    {
      "text": "Brown the ground beef until mostly cooked through. Stir in the taco seasoning and chili powder.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-tamale-pie/#wprm-recipe-59360-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/09/keto-tamale-pie-step-02.jpg"
    },
    {
      "text": "Mix the tomato paste and water together in a small bowl. Pour this over the beef. Sprinkle cheese over the top evenly.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-tamale-pie/#wprm-recipe-59360-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/09/keto-tamale-pie-step-03.jpg"
    },
    {
      "text": "In a large mixing bowl, whisk the coconut flour, almond flour, sweetener, baking powder, xanthan gum, and salt together. Stir in the eggs, butter, and almond milk. The batter will be thick.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-tamale-pie/#wprm-recipe-59360-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/09/keto-tamale-pie-step-04.jpg"
    },
    {
      "text": "Add the batter to the top of the beef mixture in spoonfuls. Use a knife to spread it to the edges.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-tamale-pie/#wprm-recipe-59360-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/09/keto-tamale-pie-step-05.jpg"
    },
    {
      "text": "Bake for 45 minutes or until the edges are brown and the top is firm. Let cool for 10 minutes before serving.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-tamale-pie/#wprm-recipe-59360-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/09/keto-tamale-pie-step-06.jpg"
    }
  ],
