  "ingredients": [
    "24 ounce boneless, skinless chicken thighs",
    "salt and pepper (to taste)",
    "2 tablespoon butter",
    "3 ounce pesto",
    "1 1/4 cup heavy whipping cream",
    "3 ounce green olive",
    "5 ounce feta cheese (diced)",
    "1 teaspoon fresh garlic (minced)",
    "5 ounce leafy greens",
    "4 tablespoon olive oil",
    "salt and pepper (to taste)"
  ],
  "instructions": [
    {
      "text": "Preheat your oven to 400F. Cut the chicken down into small pieces. Season with salt and pepper.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pesto-chicken-feta-and-olive-casserole/#wprm-recipe-53139-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/09/keto-pesto-chicken-casserole-01.jpg"
    },
    {
      "text": "Add the butter to a large skillet. Heat up the skillet until the butter is hot, then pan-fry the chicken pieces until golden brown. You may need to cook the chicken in batches.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pesto-chicken-feta-and-olive-casserole/#wprm-recipe-53139-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/09/keto-pesto-chicken-casserole-04.jpg"
    },
    {
      "text": "Mix the pesto and heavy cream together in a bowl to create the sauce.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pesto-chicken-feta-and-olive-casserole/#wprm-recipe-53139-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/09/keto-pesto-chicken-casserole-02.jpg"
    },
    {
      "text": "Add the chicken, olives, feta, garlic, and pesto sauce to a casserole bowl. Mix together well then bake for 30 minutes or until heated through and browned around the edges.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pesto-chicken-feta-and-olive-casserole/#wprm-recipe-53139-step-0-3",
      "imageSource": null
    }
