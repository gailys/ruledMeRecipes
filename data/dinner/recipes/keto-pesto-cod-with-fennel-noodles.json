    "fatGrams": 18.4
  },
  "ingredients": [
    "2 medium fennel",
    "2 tablespoon avocado oil",
    "16 ounce wild alaskan cod",
    "1/2 cup pesto",
    "salt and pepper (to taste)"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all the ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pesto-cod-with-fennel-noodles/#wprm-recipe-54111-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/01/Pesto-Cod-with-Fennel-Noodles-1.jpg"
    },
    {
      "text": "Trim the stalks off the fennel. Cut the fennel bulbs in half lengthwise then again. Cut out the hard core and remove any bad layers from the outside. Save the top parts of the fennel for garnish.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pesto-cod-with-fennel-noodles/#wprm-recipe-54111-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/01/Pesto-Cod-with-Fennel-Noodles-2.jpg"
    },
    {
      "text": "Place the cut up fennel in a food processor with a slicing blade and chop until rough. These will be your \"noodles.\"",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pesto-cod-with-fennel-noodles/#wprm-recipe-54111-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/01/Pesto-Cod-with-Fennel-Noodles-3.jpg"
    },
    {
      "text": "In a frying pan over medium heat, add the avocado oil and fennel noodles. Cook for 2-4 minutes. Remove from the pan and set aside.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pesto-cod-with-fennel-noodles/#wprm-recipe-54111-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/01/Pesto-Cod-with-Fennel-Noodles-4.jpg"
    },
    {
      "text": "In a separate pan, cook the cod for 3-4 minutes on one side, flip, then spoon half of the pesto between the cod fillets and let it cook for another 3-4 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pesto-cod-with-fennel-noodles/#wprm-recipe-54111-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/01/Pesto-Cod-with-Fennel-Noodles-5.jpg"
    },
    {
      "text": "Spoon the rest of the pesto on top of the cooked fennel noodles.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pesto-cod-with-fennel-noodles/#wprm-recipe-54111-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/01/Pesto-Cod-with-Fennel-Noodles-6.jpg"
    },
    {
      "text": "Serve the pesto flavored fennel noodles underneath the pesto cod filets. Season with salt as needed and top with the top parts of the fennel. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-pesto-cod-with-fennel-noodles/#wprm-recipe-54111-step-0-6",
      "imageSource": null
    }
  ],
