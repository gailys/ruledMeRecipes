  "ingredients": [
    "10 large egg",
    "3 tablespoon yellow mustard",
    "2 teaspoon garlic and herb seasoning",
    "1/2 cup heavy whipping cream",
    "1/2 cup low-carb tomato sauce (like rao's)",
    "8 1/2 ounce cooked chicken (diced)",
    "12 ounce frozen broccoli (florets)",
    "1/2 cup parmesan cheese (grated)",
    "1 teaspoon dried parsley",
    "1 cup sharp cheddar cheese (shredded)"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 350F. In a large mixing bowl, whisk together the eggs.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/savory-italian-egg-bake/#wprm-recipe-52091-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/02/Step-1-2.jpg"
    },
    {
      "text": "Whisk in the mustard, garlic and herb seasoning, and heavy whipping cream.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/savory-italian-egg-bake/#wprm-recipe-52091-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/02/Step-2-2.jpg"
    },
    {
      "text": "When that’s blended well, slowly whisk in the tomato sauce until it’s no longer lumpy. Add in the diced chicken and broccoli florets.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/savory-italian-egg-bake/#wprm-recipe-52091-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/02/Step-3-2.jpg"
    },
    {
      "text": "Grease a casserole dish or a large baking pan, then pour in the Italian bake.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/savory-italian-egg-bake/#wprm-recipe-52091-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/02/Step-4-1.jpg"
    },
    {
      "text": "Sprinkle Parmesan cheese and parsley flakes on top of the Italian bake. Bake for 30-40 or until the top looks like a crust.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/savory-italian-egg-bake/#wprm-recipe-52091-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/02/Step-5-2.jpg"
    },
    {
      "text": "Before serving, top the Italian bake with some extra sharp cheese. You could also use any other cheese that you like, such as mozzarella or pepper jack.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/savory-italian-egg-bake/#wprm-recipe-52091-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/02/Italian-Bake-620x900.jpg"
    }
