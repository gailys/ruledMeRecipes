    },
    {
      "text": "Turn the Instant Pot off. Remove the meat from the Instant Pot.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/instant-pot-no-noodle-keto-lasagna/#wprm-recipe-53088-step-0-2",
