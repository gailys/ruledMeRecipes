  "ingredients": [
    "16 ounce ground turkey",
    "16 ounce ground hot italian sausage",
    "1 cup shredded mozzarella",
    "1/3 cup parmesan cheese (grated)",
    "1 medium zucchini (shredded and strained)",
    "1 large egg",
    "1 teaspoon garlic powder",
    "1 teaspoon onion powder",
    "2 teaspoon dried basil",
    "salt and pepper (to taste)",
    "1 cup low-carb tomato sauce",
    "6 ounce shredded mozzarella",
    "6 ounce kale (roughly chopped)"
  ],
  "instructions": [
    {
      "text": "Gather and prep all ingredients. Grate zucchini and press into strainer to remove as much moisture as you can. Pre-heat oven to 400F.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-meatball-parm-kale-casserole/#wprm-recipe-57854-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2025/05/Keto-Meatball-Casserole-1.jpg"
    },
    {
      "text": "Combine all of the ingredients for the meatballs.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-meatball-parm-kale-casserole/#wprm-recipe-57854-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2025/05/Keto-Meatball-Casserole-2.jpg"
    },
    {
      "text": "Lightly mix together until just combined, don't overmix if possible.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-meatball-parm-kale-casserole/#wprm-recipe-57854-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2025/05/Keto-Meatball-Casserole-3.jpg"
    },
    {
      "text": "Roll meatballs into golf ball sized balls and place into a casserole dish.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-meatball-parm-kale-casserole/#wprm-recipe-57854-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2025/05/Keto-Meatball-Casserole-4.jpg"
    },
    {
      "text": "Bake for 25-30 minutes or until meatballs are almost cooked through. Drain excess moisture if needed.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-meatball-parm-kale-casserole/#wprm-recipe-57854-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2025/05/Keto-Meatball-Casserole-5.jpg"
    },
    {
      "text": "Lay kale around the meatballs, then top meatballs with sauce and cheese. Bake again for 10-12 minutes or until cheese is melted.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-meatball-parm-kale-casserole/#wprm-recipe-57854-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2025/05/Keto-Meatball-Casserole-6.jpg"
    },
    {
      "text": "Optionally broil for 2-3 minutes to crisp up the cheese. Serve immediately and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-meatball-parm-kale-casserole/#wprm-recipe-57854-step-0-6",
      "imageSource": null
    }
