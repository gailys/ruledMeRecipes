  "ingredients": [
    "1 tablespoon olive oil",
    "32 ounce pork sausage",
    "1 medium green bell pepper",
    "10 ounce canned tomatoes with jalapeno",
    "10 ounce spinach",
    "1 teaspoon onion powder",
    "1 tablespoon chili powder",
    "1 tablespoon cumin",
    "1 teaspoon garlic powder",
    "1 teaspoon italian seasoning",
    "3/4 teaspoon kosher salt",
    "4 cup beef broth"
  ],
  "instructions": [
    {
      "text": "Heat olive oil in a large pot over medium heat. Once hot, add sausage to the pan.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-sausage-and-pepper-soup/#wprm-recipe-51603-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/02/img_6088.jpg"
    },
    {
      "text": "Once the sausage is seared on one side, mix it together to allow it to cook slightly.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-sausage-and-pepper-soup/#wprm-recipe-51603-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/02/img_6092.jpg"
    },
    {
      "text": "While the sausage cooks, slice the green pepper.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-sausage-and-pepper-soup/#wprm-recipe-51603-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/02/img_6094.jpg"
    },
    {
      "text": "Add the peppers to the pot, then stir everything together well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-sausage-and-pepper-soup/#wprm-recipe-51603-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/02/img_6097.jpg"
    },
    {
      "text": "Add the canned tomatoes and jalapeños and stir once more.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-sausage-and-pepper-soup/#wprm-recipe-51603-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/02/img_6102.jpg"
    },
    {
      "text": "Add the spinach on top of everything and place the lid on the pot.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-sausage-and-pepper-soup/#wprm-recipe-51603-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/02/img_6104.jpg"
    },
    {
      "text": "Cook until the spinach is wilted, about 6–7 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-sausage-and-pepper-soup/#wprm-recipe-51603-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/02/img_6105.jpg"
    },
    {
      "text": "Meanwhile, measure out all the spices with the kosher salt and get the beef stock ready.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-sausage-and-pepper-soup/#wprm-recipe-51603-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/02/img_6110.jpg"
    },
    {
      "text": "Once the spinach is wilted, mix it into the sausage. Next, add in the spices and mix again. Finally, add the broth and stir.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-sausage-and-pepper-soup/#wprm-recipe-51603-step-0-8",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/02/img_6116.jpg"
    },
    {
      "text": "Cover and cook for 30 minutes, reducing the heat to medium-low.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-sausage-and-pepper-soup/#wprm-recipe-51603-step-0-9",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/02/img_6119.jpg"
    },
    {
      "text": "Remove the lid from the pan and let simmer for 15 minutes longer. Serve and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-sausage-and-pepper-soup/#wprm-recipe-51603-step-0-10",
      "imageSource": null
    }
  ],
