  "ingredients": [
    "4 slice bacon",
    "200 gram green cabbage",
    "2 tablespoon olive oil",
    "10 ounce boneless, skinless chicken thighs",
    "salt and pepper (to taste)",
    "1 teaspoon dried parsley",
    "3/4 teaspoon dried dill",
    "1/2 teaspoon garlic powder",
    "1/2 teaspoon onion powder",
    "3/4 cup shredded mozzarella",
    "2 tablespoon fresh chives (chopped)"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all the ingredients. Season chicken with salt and pepper.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheesy-bacon-ranch-chicken/#wprm-recipe-54183-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/02/Keto-Cheeesy-Bacon-Ranch-Chicken-1.jpg"
    },
    {
      "text": "Cook bacon in a frying pan until crispy. Remove bacon from pan and de-grease over paper towels.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheesy-bacon-ranch-chicken/#wprm-recipe-54183-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/02/Keto-Cheeesy-Bacon-Ranch-Chicken-2.jpg"
    },
    {
      "text": "Cook the cabbage in the same frying pan with the bacon fat in it. Season with salt and pepper. Cook for about 10 minutes or until soft.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheesy-bacon-ranch-chicken/#wprm-recipe-54183-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/02/Keto-Cheeesy-Bacon-Ranch-Chicken-3.jpg"
    },
    {
      "text": "In a frying pan over medium heat, cook the chicken until golden brown, about 8 minutes per side.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheesy-bacon-ranch-chicken/#wprm-recipe-54183-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/02/Keto-Cheeesy-Bacon-Ranch-Chicken-4.jpg"
    },
    {
      "text": "Season the chicken with parsley, dill, garlic powder, onion powder, and shredded mozzarella. Remove from heat once the mozzarella cheese has melted.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheesy-bacon-ranch-chicken/#wprm-recipe-54183-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/02/Keto-Cheeesy-Bacon-Ranch-Chicken-5.jpg"
    },
    {
      "text": "Chop the bacon slices into bite size pieces. Top the chicken with chives and the bacon.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheesy-bacon-ranch-chicken/#wprm-recipe-54183-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/02/Keto-Cheeesy-Bacon-Ranch-Chicken-6.jpg"
    },
    {
      "text": "Serve the chicken over the cabbage. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheesy-bacon-ranch-chicken/#wprm-recipe-54183-step-0-6",
      "imageSource": null
    }
  ],
