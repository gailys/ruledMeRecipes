  "ingredients": [
    "16 ounce spaghetti squash",
    "1 tablespoon olive oil",
    "salt and pepper (to taste)",
    "4 slice bacon (chopped)",
    "16 ounce ground beef",
    "2 teaspoon fresh garlic (minced)",
    "salt and pepper (to taste)",
    "3 tablespoon low-carb ketchup",
    "2 teaspoon worcestershire sauce",
    "6 ounce cheddar cheese (shredded)"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all of the ingredients. Preheat oven to 400F.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheeseburger-casserole/#wprm-recipe-54447-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/09/Keto-Cheeseburger-Casserole-1.jpg"
    },
    {
      "text": "Slice the spaghetti squash in half and remove the seeds.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheeseburger-casserole/#wprm-recipe-54447-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/09/Keto-Cheeseburger-Casserole-2.jpg"
    },
    {
      "text": "Line a baking sheet with parchment paper and place the spaghetti squash onto the baking sheet. Brush the squash with olive oil on both sides and season with salt and pepper. Bake in the oven for 40 minutes with the skin facing up.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheeseburger-casserole/#wprm-recipe-54447-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/09/Keto-Cheeseburger-Casserole-3.jpg"
    },
    {
      "text": "In a frying pan over medium heat, add the chopped bacon and cook to your liking. Once done, transfer to a paper towel lined plate to remove excess grease.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheeseburger-casserole/#wprm-recipe-54447-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/09/Keto-Cheeseburger-Casserole-4.jpg"
    },
    {
      "text": "Add the ground beef into the same pan as the bacon was in. Break up the beef and cook until there's almost no pink.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheeseburger-casserole/#wprm-recipe-54447-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/09/Keto-Cheeseburger-Casserole-5.jpg"
    },
    {
      "text": "Add in the minced garlic, salt, and pepper. Stir to combine and cook until there is no more pink.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheeseburger-casserole/#wprm-recipe-54447-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/09/Keto-Cheeseburger-Casserole-6.jpg"
    },
    {
      "text": "Add the ketchup and Worcestershire sauce into the ground beef. Once the spaghetti squash is done, scoop the squash from the skin and place it into the pan. Stir to combine well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheeseburger-casserole/#wprm-recipe-54447-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/09/Keto-Cheeseburger-Casserole-7.jpg"
    },
    {
      "text": "Layer the top with shredded cheddar cheese. Cover the frying pan and let sit on low for about 5 minutes or until the cheese is melted.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheeseburger-casserole/#wprm-recipe-54447-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/09/Keto-Cheeseburger-Casserole-8.jpg"
    },
    {
      "text": "Garnish with the chopped bacon. Serve and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheeseburger-casserole/#wprm-recipe-54447-step-0-8",
      "imageSource": null
    }
  ],
