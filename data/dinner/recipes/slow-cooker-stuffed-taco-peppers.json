  "ingredients": [
    "6 small red bell pepper",
    "1 cup cauliflower rice",
    "500 gram ground turkey",
    "1 cup monterey jack cheese (shredded)",
    "1 teaspoon garlic powder",
    "1 teaspoon chili powder",
    "1 1/2 tablespoon olive oil",
    "1 cup water",
    "salt and pepper (To taste)"
  ],
  "instructions": [
    {
      "text": "Begin by cutting the stems off your peppers.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/slow-cooker-stuffed-taco-peppers/#wprm-recipe-52655-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/07/stuffed-taco-peppers05.jpg"
    },
    {
      "text": "Scoop out the seeds on the inside, leaving a hollow shell. Try not to pierce the pepper during this process. You want all the yummy juice to stay inside!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/slow-cooker-stuffed-taco-peppers/#wprm-recipe-52655-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/07/stuffed-taco-peppers06.jpg"
    },
    {
      "text": "In a bowl, mix together the minced turkey and spices, including salt and pepper.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/slow-cooker-stuffed-taco-peppers/#wprm-recipe-52655-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/07/stuffed-taco-peppers08.jpg"
    },
    {
      "text": "Stir in the cauliflower.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/slow-cooker-stuffed-taco-peppers/#wprm-recipe-52655-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/07/stuffed-taco-peppers10.jpg"
    },
    {
      "text": "Mix in the Monterey Jack cheese.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/slow-cooker-stuffed-taco-peppers/#wprm-recipe-52655-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/07/stuffed-taco-peppers12.jpg"
    },
    {
      "text": "Scoop up some of the turkey mixture and pack it into each pepper shell, distributing the mix evenly.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/slow-cooker-stuffed-taco-peppers/#wprm-recipe-52655-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/07/stuffed-taco-peppers13.jpg"
    },
    {
      "text": "Pour a cup of water into the bottom of the crockpot, then carefully stand the peppers up inside.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/slow-cooker-stuffed-taco-peppers/#wprm-recipe-52655-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/07/stuffed-taco-peppers14.jpg"
    },
    {
      "text": "Cook on high for 4 hours or low for 8. Top with a little extra cheese 10 minutes before they are done.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/slow-cooker-stuffed-taco-peppers/#wprm-recipe-52655-step-0-7",
      "imageSource": null
    }
  ],
