  "ingredients": [
    "3 medium avocado (halved)",
    "50 gram mushrooms (chopped)",
    "1 medium green onion (diced)",
    "10 whole cherry tomatoes (chopped)",
    "45 gram goat cheese (crumbled)",
    "1 tablespoon olive oil",
    "1 tablespoon liquid smoke",
    "1/2 teaspoon paprika",
    "3 tablespoon balsamic vinegar"
  ],
  "instructions": [
    {
      "text": "Preheat a frying pan over medium heat. Add mushrooms, green onions, and tomatoes to a mixing bowl.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/balsamic-avocado-bowls/#wprm-recipe-52906-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/02/balsamic-avocado-bowls-03.jpg"
    },
    {
      "text": "Heat the olive oil, liquid smoke, and paprika in the pan.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/balsamic-avocado-bowls/#wprm-recipe-52906-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/02/balsamic-avocado-bowls-04.jpg"
    },
    {
      "text": "Add in the goat cheese.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/balsamic-avocado-bowls/#wprm-recipe-52906-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/02/balsamic-avocado-bowls-06.jpg"
    },
    {
      "text": "Sauté until the cheese is nicely browned.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/balsamic-avocado-bowls/#wprm-recipe-52906-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/02/balsamic-avocado-bowls-07.jpg"
    },
    {
      "text": "Remove the pan from the stove. Add goat cheese to the mixing bowl and mix together.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/balsamic-avocado-bowls/#wprm-recipe-52906-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/02/balsamic-avocado-bowls-08.jpg"
    },
    {
      "text": "Scoop out a small portion of flesh from inside the avocado halves to create enough room for the filling. Set aside the scooped out avocado.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/balsamic-avocado-bowls/#wprm-recipe-52906-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/02/balsamic-avocado-bowls-10.jpg"
    },
    {
      "text": "Spoon the salad mix into the avocado shells. Garnish with the scooped out avocado. Pour a half teaspoon of balsamic vinegar onto each.",
