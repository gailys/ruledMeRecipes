  "ingredients": [
    "16 ounce boneless, skinless chicken thighs",
    "1 ounce butter",
    "8 ounce bacon",
    "4 ounce cherry tomatoes",
    "10 ounce romaine lettuce",
    "salt and pepper (to taste)",
    "3/4 cup mayonnaise",
    "1/2 tablespoon garlic powder"
  ],
  "instructions": [
    {
      "text": "Mix the mayonnaise and garlic powder together then set aside.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-blt-salad-with-chicken/#wprm-recipe-58778-step-0-0",
