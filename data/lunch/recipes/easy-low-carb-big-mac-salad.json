  },
  "ingredients": [
    "1/2 cup mayonnaise",
    "1 1/2 tablespoon yellow mustard",
    "1 tablespoon unsweetened dill pickle relish",
    "1 teaspoon apple cider vinegar",
    "1 teaspoon garlic powder",
    "1 teaspoon onion powder",
    "1/2 teaspoon paprika",
    "16 ounce ground beef (93/7)",
    "salt and pepper (to taste)",
    "9 ounce spring mix",
    "1/2 cup cheddar cheese (shredded)",
    "1/4 cup white onion (chopped)",
    "1/4 cup dill pickle (chopped)"
  ],
  "instructions": [
    {
      "text": "Gather and prep all of your ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/easy-low-carb-big-mac-salad/#wprm-recipe-57456-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/11/Low-Carb-Big-Mac-Salad-1.jpg"
    },
    {
      "text": "Combine all of the ingredients for the Big Mac dressing in a container. Stir together well and set aside.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/easy-low-carb-big-mac-salad/#wprm-recipe-57456-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/11/Low-Carb-Big-Mac-Salad-2.jpg"
    },
    {
      "text": "Cook the ground beef over medium heat, seasoning with salt and pepper to taste. Once browned, drain any excess grease into the salad dressing and stir together well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/easy-low-carb-big-mac-salad/#wprm-recipe-57456-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/11/Low-Carb-Big-Mac-Salad-3.jpg"
    },
    {
      "text": "Assemble the salad base by adding spring mix, half of the cheddar cheese, onion, and chopped pickle to a large bowl.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/easy-low-carb-big-mac-salad/#wprm-recipe-57456-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/11/Low-Carb-Big-Mac-Salad-4.jpg"
    },
    {
      "text": "Add in the ground beef, then lightly toss to evenly mix together.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/easy-low-carb-big-mac-salad/#wprm-recipe-57456-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/11/Low-Carb-Big-Mac-Salad-5.jpg"
    },
    {
      "text": "Top with the Big Mac sauce and toss again to evenly coat all ingredients if desired. If saving for leftovers, store the salad dressing separately until ready to eat.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/easy-low-carb-big-mac-salad/#wprm-recipe-57456-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/11/Low-Carb-Big-Mac-Salad-6.jpg"
    },
    {
      "text": "Top with remaining cheddar cheese. Serve and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/easy-low-carb-big-mac-salad/#wprm-recipe-57456-step-0-6",
      "imageSource": null
    }
  ],
