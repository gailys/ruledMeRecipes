  "ingredients": [
    "1/4 cup olive oil",
    "1/2 medium yellow onion (diced)",
    "16 ounce mushrooms (sliced)",
    "2 cup chicken broth",
    "9 ounce frozen spinach (defrosted)",
    "1/2 cup heavy cream (divided)",
    "salt and pepper (to taste)",
    "1/2 cup parmesan cheese"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all the ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-spinach-mushroom-soup/#wprm-recipe-54139-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/02/Spinach-Mushroom-Soup-1.jpg"
    },
    {
      "text": "In a large pot, add the olive oil and heat over medium heat.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-spinach-mushroom-soup/#wprm-recipe-54139-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/02/Spinach-Mushroom-Soup-2.jpg"
    },
    {
      "text": "Add the diced yellow onion, stir, and let cook for 7-9 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-spinach-mushroom-soup/#wprm-recipe-54139-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/02/Spinach-Mushroom-Soup-3.jpg"
    },
    {
      "text": "Add in the mushrooms to the pot. Stir these with the onion and olive oil for about 4-5 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-spinach-mushroom-soup/#wprm-recipe-54139-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/02/Spinach-Mushroom-Soup-4.jpg"
    },
    {
      "text": "Add in the chicken stock and the defrosted spinach. Don't add the liquid from defrosting the spinach to the pot. Bring the soup to a boil then simmer for at least 10 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-spinach-mushroom-soup/#wprm-recipe-54139-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/02/Spinach-Mushroom-Soup-5.jpg"
    },
    {
      "text": "Remove from heat and stir in half of the heavy cream. Let the soup cool.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-spinach-mushroom-soup/#wprm-recipe-54139-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/02/Spinach-Mushroom-Soup-6.jpg"
    },
    {
      "text": "Pour the soup into a blender and blend until smooth.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-spinach-mushroom-soup/#wprm-recipe-54139-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/02/Spinach-Mushroom-Soup-7.jpg"
    },
    {
      "text": "Serve the spinach mushroom soup with the other half of the cream drizzled on top and parmesan cheese. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-spinach-mushroom-soup/#wprm-recipe-54139-step-0-7",
      "imageSource": null
    }
  ],
