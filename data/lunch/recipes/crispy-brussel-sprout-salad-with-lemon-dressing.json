  "ingredients": [
    "1 tablespoon olive oil",
    "1 teaspoon chili paste",
    "2 ounce pecans",
    "1 ounce pumpkin seeds",
    "1 ounce sunflower seeds",
    "1/2 teaspoon cumin",
    "salt (to taste)",
    "16 ounce brussels sprouts",
    "1/2 cup olive oil",
    "1 medium lemon (juice and zest)",
    "salt and pepper (to taste)"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all the ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/crispy-brussel-sprout-salad-with-lemon-dressing/#wprm-recipe-53545-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/10/Crispy-Brussel-Salad-1.jpg"
    },
    {
      "text": "In a frying pan on low to medium heat, heat up the olive oil and the chili paste.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/crispy-brussel-sprout-salad-with-lemon-dressing/#wprm-recipe-53545-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/10/Crispy-Brussel-Salad-2.jpg"
    },
    {
      "text": "Add the pecans to the hot frying pan and stir well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/crispy-brussel-sprout-salad-with-lemon-dressing/#wprm-recipe-53545-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/10/Crispy-Brussel-Salad-3.jpg"
    },
    {
      "text": "Stir in the pumpkin and sunflower seeds. Season with cumin and salt. Saute for a few minutes, stirring occasionally, until the pecans and seeds are lightly roasted and smells aromatic.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/crispy-brussel-sprout-salad-with-lemon-dressing/#wprm-recipe-53545-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/10/Crispy-Brussel-Salad-4.jpg"
    },
    {
      "text": "Rinse the Brussels sprouts and shave them by cutting them into thin slices with a sharp knife. Place them in a bowl.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/crispy-brussel-sprout-salad-with-lemon-dressing/#wprm-recipe-53545-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/10/Crispy-Brussel-Salad-5.jpg"
    },
    {
      "text": "Make the lemon dressing by combining olive oil, lemon juice and zest, and salt and pepper to taste. Pour this over the brussel sprouts in the bowl and let this marinate for 10 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/crispy-brussel-sprout-salad-with-lemon-dressing/#wprm-recipe-53545-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/10/Crispy-Brussel-Salad-6.jpg"
    },
    {
      "text": "Prior to serving, add in the pecan and seed mixture and toss to combine.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/crispy-brussel-sprout-salad-with-lemon-dressing/#wprm-recipe-53545-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/10/Crispy-Brussel-Salad-7.jpg"
    },
    {
      "text": "Top off with additional salt and pepper if desired. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/crispy-brussel-sprout-salad-with-lemon-dressing/#wprm-recipe-53545-step-0-7",
      "imageSource": null
    }
