  "ingredients": [
    "1 1/2 ounce spinach",
    "1 tablespoon mayonnaise",
    "1 teaspoon chili-garlic paste",
    "1 cup cauliflower rice",
    "2 teaspoon olive oil",
    "1/2 teaspoon unseasoned rice vinegar",
    "8 ounce ground pork",
    "salt and pepper (to taste)",
    "1/4 teaspoon crushed red pepper flakes",
    "1/4 teaspoon cumin",
    "1/2 teaspoon garlic powder",
    "1/4 teaspoon onion powder",
    "1/4 teaspoon fish sauce",
    "1/2 cup coleslaw mix",
    "2 tablespoon fresh cilantro (chopped)"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all the ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-bahn-mi-rice-bowl/#wprm-recipe-54159-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/02/Bahn-Mi-Rice-Bowl-1.jpg"
    },
    {
      "text": "Put the spinach in containers.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-bahn-mi-rice-bowl/#wprm-recipe-54159-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/02/Bahn-Mi-Rice-Bowl-2.jpg"
    },
    {
      "text": "In a bowl, combine the mayonnaise and the chili-garlic paste. Mix together well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-bahn-mi-rice-bowl/#wprm-recipe-54159-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/02/Bahn-Mi-Rice-Bowl-3.jpg"
    },
    {
      "text": "In a frying pan over medium heat, add in the olive oil, unseasoned rice vinegar, and cauliflower rice. Cook for 5 - 6 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-bahn-mi-rice-bowl/#wprm-recipe-54159-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/02/Bahn-Mi-Rice-Bowl-4.jpg"
    },
    {
      "text": "Place the cooked cauliflower rice into the containers with the spinach.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-bahn-mi-rice-bowl/#wprm-recipe-54159-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/02/Bahn-Mi-Rice-Bowl-5.jpg"
    },
    {
      "text": "Clean out the frying pan and add the ground pork, salt and pepper, crushed red pepper flakes, cumin, garlic powder, onion powder, and fish sauce. Mix all together and cook for 8 - 12 minutes or until there's no more pink.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-bahn-mi-rice-bowl/#wprm-recipe-54159-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/02/Bahn-Mi-Rice-Bowl-6.jpg"
    },
    {
      "text": "Put the seasoned ground pork in the containers with coleslaw mix, chopped cilantro, and the spicy mayo. Serve and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-bahn-mi-rice-bowl/#wprm-recipe-54159-step-0-6",
      "imageSource": null
    }
