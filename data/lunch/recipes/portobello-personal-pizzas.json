  "ingredients": [
    "4 large portobello mushrooms",
    "6 tablespoon olive oil",
    "salt and pepper (to taste)",
    "1 medium fresh tomatoes",
    "1/4 cup fresh basil",
    "1 1/2 ounce pepperoni",
    "4 ounce mozzarella cheese (cubed)"
  ],
  "instructions": [
    {
      "text": "Prep the mushrooms by removing the stems.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/portobello-personal-pizzas/#wprm-recipe-51133-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/05/IMG_4563.jpg"
    },
    {
      "text": "Scrape out all of the innards and dig into the flesh to get the mushrooms quite thin on the bottom (about 1/2\").",
      "group": "",
      "sourceUrl": "https://www.ruled.me/portobello-personal-pizzas/#wprm-recipe-51133-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/05/IMG_4572.jpg"
    },
    {
      "text": "Set the oven to broil on high and rub the insides of each mushroom with half of the olive oil. Season with salt and pepper to taste.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/portobello-personal-pizzas/#wprm-recipe-51133-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/05/IMG_4579.jpg"
    },
    {
      "text": "Broil for about 4–5 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/portobello-personal-pizzas/#wprm-recipe-51133-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/05/IMG_4584.jpg"
    },
    {
      "text": "Flip the mushrooms over and rub with the remaining olive oil. Season with salt and pepper to taste. Broil for another 3–4 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/portobello-personal-pizzas/#wprm-recipe-51133-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/05/IMG_4597.jpg"
    },
    {
      "text": "Thinly slice the tomato and chop the basil into long, thin strips.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/portobello-personal-pizzas/#wprm-recipe-51133-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/05/IMG_4592.jpg"
    },
    {
      "text": "Flip the mushroom caps back over and fill them with the tomato slices and basil.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/portobello-personal-pizzas/#wprm-recipe-51133-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/05/IMG_4598.jpg"
    },
    {
      "text": "Distribute the pepperoni evenly over the mushrooms and top with fresh cubes of mozzarella cheese.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/portobello-personal-pizzas/#wprm-recipe-51133-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/05/IMG_4607.jpg"
    },
    {
      "text": "Broil again for 2–4 minutes, or until the cheese is melted and beginning to brown.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/portobello-personal-pizzas/#wprm-recipe-51133-step-0-8",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/05/IMG_4616.jpg"
    },
    {
      "text": "Serve and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/portobello-personal-pizzas/#wprm-recipe-51133-step-0-9",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/05/PortobelloPersonalPizzaLong.jpg"
    }
  ],
