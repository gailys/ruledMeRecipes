  "ingredients": [
    "1 cup cooked chicken (cubed)",
    "2 1/2 teaspoon cajun seasoning",
    "2 tablespoon butter",
    "1 small onion (diced)",
    "50 gram celery (chopped)",
    "1 medium green bell pepper (diced)",
    "3 teaspoon fresh garlic (diced)",
    "1 teaspoon worcestershire sauce",
    "1 teaspoon onion powder",
    "16 ounce cooked ham (cubed)",
    "8 ounce chicken sausage",
    "15 ounce canned diced tomatoes",
    "28 ounce beef broth",
    "3 cup water",
    "1 whole chicken bouillon cube"
  ],
  "instructions": [
    {
      "text": "Coat the cubed chicken with 1/5 of the Cajun seasoning. Heat the butter in a large soup pot then brown the chicken. Remove the chicken and set aside.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-jambalaya-soup/#wprm-recipe-59102-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/10/keto-jambalaya-soup-step-01.jpg"
    },
    {
      "text": "Saute the onion, celery, green pepper, and garlic until they are tender. Add a little more oil if necessary.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-jambalaya-soup/#wprm-recipe-59102-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/10/keto-jambalaya-soup-step-02.jpg"
    },
    {
      "text": "Add the ham and sausage then cook for several minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-jambalaya-soup/#wprm-recipe-59102-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/10/keto-jambalaya-soup-step-03.jpg"
    },
    {
      "text": "Add all of the remaining ingredients, except for the chicken. Bring the soup to a boil, then cover and simmer for 20 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-jambalaya-soup/#wprm-recipe-59102-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/10/keto-jambalaya-soup-step-04.jpg"
    },
    {
      "text": "Add the chicken last, then cook until the meat is heated through before serving.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-jambalaya-soup/#wprm-recipe-59102-step-0-4",
