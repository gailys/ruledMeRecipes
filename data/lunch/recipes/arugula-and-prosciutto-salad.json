  "ingredients": [
    "2 cup arugula",
    "3 slice prosciutto",
    "1/4 cup onion (chopped)",
    "1/4 cup mushrooms (chopped)",
    "2 tablespoon olive oil",
    "1/8 cup blue cheese (crumbled (15 g))",
    "2 tablespoon low-carb maple syrup"
  ],
  "instructions": [
    {
      "text": "n a skillet over medium heat, preheat half of the olive oil. Lay the prosciutto slices in the pan and cook until nice and crispy.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/arugula-and-prosciutto-salad/#wprm-recipe-52978-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/04/arugula-and-prosciutto-salad-01.jpg"
    },
    {
      "text": "Drop in your mushrooms and onions, sautéing for 3-5 minutes or until the mushrooms have browned.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/arugula-and-prosciutto-salad/#wprm-recipe-52978-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/04/arugula-and-prosciutto-salad-02.jpg"
    },
    {
      "text": "In a smaller bowl or measuring cup, stir together the remaining olive oil and sugar-free maple syrup.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/arugula-and-prosciutto-salad/#wprm-recipe-52978-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/04/arugula-and-prosciutto-salad-04.jpg"
    },
    {
      "text": "Place the arugula into a bowl.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/arugula-and-prosciutto-salad/#wprm-recipe-52978-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/04/arugula-and-prosciutto-salad-05.jpg"
    },
    {
      "text": "Top your arugula with the prosciutto, mushrooms, onions, and blue cheese.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/arugula-and-prosciutto-salad/#wprm-recipe-52978-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/04/arugula-and-prosciutto-salad-06.jpg"
    },
    {
      "text": "Pour on the maple dressing then toss the salad to serve.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/arugula-and-prosciutto-salad/#wprm-recipe-52978-step-0-5",
      "imageSource": null
