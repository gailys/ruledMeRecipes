  "ingredients": [
    "1 teaspoon butter",
    "1 ounce celery (diced)",
    "1 tablespoon onion (diced)",
    "2 tablespoon mayonnaise",
    "1 teaspoon old bay seasoning",
    "1/2 teaspoon garlic powder",
    "salt and pepper (to taste)",
    "2 large egg",
    "1/2 cup parmesan cheese (shredded)",
    "8 ounce crab meat (canned, drained)",
    "4 large portobello mushrooms",
    "1 tablespoon almond flour",
    "2 tablespoon parmesan cheese (shredded)",
    "1 tablespoon fresh parsley (chopped)"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 350F.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/crab-cake-stuffed-mushrooms/#wprm-recipe-52730-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/09/crab-cake-stuffed-portobello-mushrooms-01.jpg"
    },
    {
      "text": "Sauté celery and onion in butter on medium low heat until the onions become translucent and the celery softens.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/crab-cake-stuffed-mushrooms/#wprm-recipe-52730-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/09/crab-cake-stuffed-portobello-mushrooms-02.jpg"
    },
    {
      "text": "Remove from heat and in a small bowl combine the sautéed celery and onion with the mayonnaise and seasonings.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/crab-cake-stuffed-mushrooms/#wprm-recipe-52730-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/09/crab-cake-stuffed-portobello-mushrooms-03.jpg"
    },
    {
      "text": "Stir in the eggs and parmesan cheese until the mixture is combined.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/crab-cake-stuffed-mushrooms/#wprm-recipe-52730-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/09/crab-cake-stuffed-portobello-mushrooms-04.jpg"
    },
    {
      "text": "Fold in flaked crab meat. Set aside.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/crab-cake-stuffed-mushrooms/#wprm-recipe-52730-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/09/crab-cake-stuffed-portobello-mushrooms-05.jpg"
    },
    {
      "text": "Clean the mushroom caps by removing the stems and gently scraping the inner layer with a spoon.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/crab-cake-stuffed-mushrooms/#wprm-recipe-52730-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/09/crab-cake-stuffed-portobello-mushrooms-06.jpg"
    },
    {
      "text": "Arrange each mushroom cap in a small, high sided baking dish and fill with the crab mixture.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/crab-cake-stuffed-mushrooms/#wprm-recipe-52730-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/09/crab-cake-stuffed-portobello-mushrooms-07.jpg"
    },
    {
      "text": "Combine the almond meal and parmesan cheese from the topping ingredient list and sprinkle over the caps. Cover with foil and bake for 30 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/crab-cake-stuffed-mushrooms/#wprm-recipe-52730-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/09/crab-cake-stuffed-portobello-mushrooms-09.jpg"
    },
    {
      "text": "Remove from oven and garnish with chopped parsley before serving.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/crab-cake-stuffed-mushrooms/#wprm-recipe-52730-step-0-8",
      "imageSource": null
    }
