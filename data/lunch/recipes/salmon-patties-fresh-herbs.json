  "ingredients": [
    "14 3/4 ounce canned pink salmon",
    "2 tablespoon fresh chives (chopped)",
    "1/4 cup fresh dill (chopped)",
    "1/4 cup parmesan cheese (grated)",
    "4 ounce pork rinds (crushed)",
    "2 large egg",
    "1 teaspoon lemon zest",
    "salt and pepper (to taste)",
    "1/2 cup almond flour",
    "2 tablespoon olive oil"
  ],
  "instructions": [
    {
      "text": "Open and drain the cans of pink salmon and add the fish to a large mixing bowl.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/salmon-patties-fresh-herbs/#wprm-recipe-52147-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/03/IMG_0871.jpg"
    },
    {
      "text": "Add the chives, dill, parmesan, crushed pork rinds, eggs, lemon zest, salt, and pepper. Mix thoroughly.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/salmon-patties-fresh-herbs/#wprm-recipe-52147-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/03/IMG_0876.jpg"
    },
    {
      "text": "Form the salmon into 3-oz. balls.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/salmon-patties-fresh-herbs/#wprm-recipe-52147-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/03/IMG_0886.jpg"
    },
    {
      "text": "Spread the almond flour out on a plate. Carefully flatten each salmon patty and gently coat it in the almond flour.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/salmon-patties-fresh-herbs/#wprm-recipe-52147-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/03/IMG_0887.jpg"
    },
    {
      "text": "Heat up the olive oil in a skillet over medium-high heat. Fry the patties for a few minutes on each side, until golden and cooked through.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/salmon-patties-fresh-herbs/#wprm-recipe-52147-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/03/IMG_0895.jpg"
    },
    {
      "text": "Serve and enjoy!",
