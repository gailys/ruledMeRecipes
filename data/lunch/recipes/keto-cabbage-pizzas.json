  "ingredients": [
    "1 tablespoon olive oil",
    "28 ounce green cabbage",
    "2 tablespoon whole grain mustard",
    "8 ounce corned beef",
    "4 ounce cheddar cheese",
    "1/4 cup green onion (chopped)",
    "salt and pepper (to taste)"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all the ingredients. Preheat oven to 450F.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cabbage-pizzas/#wprm-recipe-54171-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/02/Keto-Cabbage-Pizzas-1.jpg"
    },
    {
      "text": "Line a baking sheet with parchment paper.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cabbage-pizzas/#wprm-recipe-54171-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/02/Keto-Cabbage-Pizzas-2.jpg"
    },
    {
      "text": "Slice the cabbage in half then into smaller slices, making the \"dough\" of the pizza. Drizzle with olive oil and season with salt and pepper. Roast these in the oven for 15 - 20 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cabbage-pizzas/#wprm-recipe-54171-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/02/Keto-Cabbage-Pizzas-3.jpg"
    },
    {
      "text": "Chop up the green onions and the corned beef.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cabbage-pizzas/#wprm-recipe-54171-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/02/Keto-Cabbage-Pizzas-4.jpg"
    },
    {
      "text": "Once the cabbage is ready to take out of the oven, smear the whole grain mustard onto the cabbage pieces. Top with corned beef and shredded cheddar cheese. Bake in the oven for about 5 minutes just until the cheese is melted.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cabbage-pizzas/#wprm-recipe-54171-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/02/Keto-Cabbage-Pizzas-5.jpg"
    },
    {
      "text": "Garnish with green onions. Serve and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cabbage-pizzas/#wprm-recipe-54171-step-0-5",
      "imageSource": null
    }
  ],
