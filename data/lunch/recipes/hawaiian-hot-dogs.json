  "ingredients": [
    "2 cup mozzarella cheese (shredded)",
    "3/4 cup almond flour",
    "1/2 cup fresh pineapple chunks",
    "2 ounce ham (diced)",
    "6 ounce cooked bacon (chopped)",
    "6 tablespoon sriracha mayonnaise (like sarayo)",
    "20 ounce jumbo beef hot dogs (such as Applegate)"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 350F. In a non-stick pan over medium heat, melt the mozzarella cheese and stir in the almond flour to form a dough.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/hawaiian-hot-dogs/#wprm-recipe-52301-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/07/hawaiian-hot-dogs-01.jpg"
    },
    {
      "text": "Place the dough between two pieces of parchment paper and roll until flat.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/hawaiian-hot-dogs/#wprm-recipe-52301-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/07/hawaiian-hot-dogs-03.jpg"
    },
    {
      "text": "Cut the dough into circles large enough to fit your hot dogs.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/hawaiian-hot-dogs/#wprm-recipe-52301-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/07/hawaiian-hot-dogs-04.jpg"
    },
    {
      "text": "Place the dough circles on a baking sheet lined with parchment paper. Bake for 10 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/hawaiian-hot-dogs/#wprm-recipe-52301-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/07/hawaiian-hot-dogs-05.jpg"
    },
    {
      "text": "Place a hot dog in the middle and wrap the bread around it. Top with sriracha mayo, pineapple, ham, and bacon. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/hawaiian-hot-dogs/#wprm-recipe-52301-step-0-4",
      "imageSource": null
    }
