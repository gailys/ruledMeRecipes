  ],
  "instructions": [
    {
      "text": "Preheat oven to 375F. Start by slices of bacon into quarter-pieces, so you have 24 quarter-slices of bacon. Place a little smokie on top of the slice of bacon.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/bbq-bacon-wrapped-smokies/#wprm-recipe-51559-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/01/img_2400.jpg"
    },
    {
      "text": "Roll the little smokies up in the bacon so that there is a small amount of overlap and stick a toothpick into them.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/bbq-bacon-wrapped-smokies/#wprm-recipe-51559-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/01/img_2403.jpg"
    },
    {
      "text": "Set on a cookie sheet covered with foil and bake for 25 minutes. After 25 minutes, baste little smokies with BBQ sauce and bake for another 10-12 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/bbq-bacon-wrapped-smokies/#wprm-recipe-51559-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/01/img_2418.jpg"
    },
    {
      "text": "Remove from the oven and let cool slightly, then serve.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/bbq-bacon-wrapped-smokies/#wprm-recipe-51559-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/01/img_2443.jpg"
