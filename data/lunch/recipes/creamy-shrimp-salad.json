  "ingredients": [
    "6 whole boston lettuce leaves",
    "300 gram shrimp (peeled)",
    "1 1/2 tablespoon olive oil",
    "1/2 cup celery (chopped)",
    "1 medium green onion (chopped)",
    "4 tablespoon mayonnaise",
    "1 tablespoon heavy whipping cream",
    "1/2 teaspoon dried dill",
    "1/2 teaspoon dried parsley",
    "1/4 teaspoon paprika",
    "1 teaspoon lemon juice"
  ],
  "instructions": [
    {
      "text": "In a pan, heat up the olive oil over medium heat. Add the shrimp and sauté for 3-5 minutes or until cooked through.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-shrimp-salad/#wprm-recipe-52938-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/03/creamy-shrimp-salad-01.jpg"
    },
    {
      "text": "In a salad bowl, whisk together the mayonnaise, cream, dill, parsley, paprika, and lemon juice.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-shrimp-salad/#wprm-recipe-52938-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/03/creamy-shrimp-salad-02.jpg"
    },
    {
      "text": "Add the cooked shrimp to the salad bowl along with the celery and green onions.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-shrimp-salad/#wprm-recipe-52938-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/03/creamy-shrimp-salad-03.jpg"
    },
    {
      "text": "Mix the shrimp and vegetables until coated with the dressing.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-shrimp-salad/#wprm-recipe-52938-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/03/creamy-shrimp-salad-04.jpg"
    },
    {
      "text": "Divide the lettuce into individual servings and top with the salad.",
