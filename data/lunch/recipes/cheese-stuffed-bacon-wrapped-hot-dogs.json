  "ingredients": [
    "10 ounce beef hot dogs",
    "2 ounce cheddar cheese",
    "12 ounce bacon",
    "1/2 teaspoon garlic powder",
    "1/2 teaspoon onion powder",
    "salt and pepper (to taste)"
  ],
  "instructions": [
    {
      "text": "Preheat oven to 400F. Make a slit in all of the hot dogs to make room for the cheese.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cheese-stuffed-bacon-wrapped-hot-dogs/#wprm-recipe-51693-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/05/img_4727.jpg"
    },
    {
      "text": "Slice the cheddar cheese into small, long rectangles and stuff them into the hot dogs.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cheese-stuffed-bacon-wrapped-hot-dogs/#wprm-recipe-51693-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/05/img_4731.jpg"
    },
    {
      "text": "Start by tightly wrapping one slice of bacon around a hot dog.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cheese-stuffed-bacon-wrapped-hot-dogs/#wprm-recipe-51693-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/05/img_4735.jpg"
    },
    {
      "text": "Continue tightly wrapping a second slice of bacon around the hot dog, slightly overlapping the first slice.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cheese-stuffed-bacon-wrapped-hot-dogs/#wprm-recipe-51693-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/05/img_4740.jpg"
    },
    {
      "text": "Poke toothpicks through each side to secure the bacon in place.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cheese-stuffed-bacon-wrapped-hot-dogs/#wprm-recipe-51693-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/05/img_4750.jpg"
    },
    {
      "text": "Place on a cookie sheet with a wire rack on top. Season with garlic powder, onion powder, and salt and pepper to taste.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cheese-stuffed-bacon-wrapped-hot-dogs/#wprm-recipe-51693-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/05/img_4758.jpg"
    },
    {
      "text": "Bake for 35–40 minutes, or until the bacon is crispy. Optional: Broil the bacon for a few minutes to get it even crispier!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cheese-stuffed-bacon-wrapped-hot-dogs/#wprm-recipe-51693-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2015/05/img_4763.jpg"
    },
    {
      "text": "Serve up with some delicious creamed spinach!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cheese-stuffed-bacon-wrapped-hot-dogs/#wprm-recipe-51693-step-0-7",
      "imageSource": null
    }
  ],
