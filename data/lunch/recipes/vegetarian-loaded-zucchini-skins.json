  "ingredients": [
    "3 large mexican squash",
    "1 teaspoon salt",
    "3 medium cremini mushrooms (diced)",
    "1 teaspoon olive oil",
    "2 teaspoon smoked paprika",
    "1 tablespoon worcestershire sauce",
    "1/2 teaspoon salt",
    "2 ounce pepper jack cheese (shredded)",
    "2 ounce cheddar cheese (shredded)",
    "3 tablespoon sour cream",
    "2 tablespoon fresh chives (chopped)"
  ],
  "instructions": [
    {
      "text": "Heat oven to 375°F. Prepare the squash by washing well, removing the ends and slicing into halves.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/vegetarian-loaded-zucchini-skins/#wprm-recipe-52499-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/01/vegetarian-loaded-zucchini-skins-01.jpg"
    },
    {
      "text": "Using a spoon, carefully scrape the seeds from each zucchini half and discard.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/vegetarian-loaded-zucchini-skins/#wprm-recipe-52499-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/01/vegetarian-loaded-zucchini-skins-02.jpg"
    },
    {
      "text": "Sprinkle the zucchini skins with salt and let sit to draw out some of the water. Pat dry.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/vegetarian-loaded-zucchini-skins/#wprm-recipe-52499-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/01/vegetarian-loaded-zucchini-skins-03.jpg"
    },
    {
      "text": "Drizzle the diced mushrooms with oil, smoked paprika, salt, and Worcestershire, then toss to coat.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/vegetarian-loaded-zucchini-skins/#wprm-recipe-52499-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/01/vegetarian-loaded-zucchini-skins-04.jpg"
    },
    {
      "text": "Arrange the zucchini and mushrooms on a baking sheet and roast for 8-10 minutes or until the mushrooms begin to brown and sizzle.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/vegetarian-loaded-zucchini-skins/#wprm-recipe-52499-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/01/vegetarian-loaded-zucchini-skins-05.jpg"
    },
    {
      "text": "Remove the zucchini from the oven and top with the roasted mushrooms and shredded pepper jack and cheddar cheese.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/vegetarian-loaded-zucchini-skins/#wprm-recipe-52499-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/01/vegetarian-loaded-zucchini-skins-06.jpg"
    },
    {
      "text": "Bake for 5-10 minutes or until the cheese is melted and bubbling.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/vegetarian-loaded-zucchini-skins/#wprm-recipe-52499-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/01/vegetarian-loaded-zucchini-skins-08.jpg"
    },
    {
      "text": "Top with sour cream and chives.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/vegetarian-loaded-zucchini-skins/#wprm-recipe-52499-step-0-7",
      "imageSource": null
    }
  ],
