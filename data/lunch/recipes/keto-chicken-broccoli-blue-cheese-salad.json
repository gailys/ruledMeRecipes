  "ingredients": [
    "12 ounce boneless, skinless chicken breast",
    "1 tablespoon olive oil",
    "salt and pepper (to taste)",
    "12 ounce broccoli (cut into small florets)",
    "4 ounce celery (diced)",
    "5 ounce blue cheese (crumbled)",
    "1/4 cup mayonnaise",
    "1/3 cup sour cream",
    "1 tablespoon apple cider vinegar",
    "1/2 teaspoon garlic powder",
    "1/4 teaspoon onion powder"
  ],
  "instructions": [
    {
      "text": "Gather and prep all of your ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-broccoli-blue-cheese-salad/#wprm-recipe-57159-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/08/Keto-Chicken-Broccoli-Blue-Cheese-Salad-1.jpg"
    },
    {
      "text": "Season chicken with salt and pepper, then add olive oil to a pan over medium heat. Once hot, add in the chicken and brown on both sides and cook through. About 7-8 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-broccoli-blue-cheese-salad/#wprm-recipe-57159-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/08/Keto-Chicken-Broccoli-Blue-Cheese-Salad-2.jpg"
    },
    {
      "text": "Once chicken is cooked, cut into cubes and set aside.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-broccoli-blue-cheese-salad/#wprm-recipe-57159-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/08/Keto-Chicken-Broccoli-Blue-Cheese-Salad-3.jpg"
    },
    {
      "text": "Steam broccoli using your preferred method until cooked, but crisp.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-broccoli-blue-cheese-salad/#wprm-recipe-57159-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/08/Keto-Chicken-Broccoli-Blue-Cheese-Salad-4.jpg"
    },
    {
      "text": "Combine the remaining ingredients in a bowl and stir together well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-broccoli-blue-cheese-salad/#wprm-recipe-57159-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/08/Keto-Chicken-Broccoli-Blue-Cheese-Salad-5.jpg"
    },
    {
      "text": "Gently fold in the chicken and broccoli until coated in dressing. Taste and season with additional salt and pepper if needed.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-broccoli-blue-cheese-salad/#wprm-recipe-57159-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/08/Keto-Chicken-Broccoli-Blue-Cheese-Salad-6.jpg"
    },
    {
      "text": "Serve immediately or store to use as needed. Enjoy!",
