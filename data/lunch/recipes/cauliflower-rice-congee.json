  "ingredients": [
    "2 tablespoon coconut oil",
    "1/2 medium shallot (diced)",
    "2 teaspoon fresh garlic (minced)",
    "2 tablespoon fresh ginger (sliced)",
    "8 ounce bone-in, skin-on chicken thighs",
    "2 cup cauliflower rice",
    "4 cup chicken broth",
    "1/4 cup fish sauce",
    "1 tablespoon lime juice",
    "1 teaspoon xanthan gum",
    "salt and pepper (to taste)"
  ],
  "instructions": [
    {
      "text": "Preheat a pot over medium heat, then add the coconut oil. When melted, add shallots, garlic, and ginger. Sauté until aromatic.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cauliflower-rice-congee/#wprm-recipe-52838-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/12/cauliflower-rice-congee-01.jpg"
    },
    {
      "text": "Add the chicken thighs to pot and sear both sides.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cauliflower-rice-congee/#wprm-recipe-52838-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/12/cauliflower-rice-congee-02.jpg"
    },
    {
      "text": "Add cauliflower rice to the pot.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cauliflower-rice-congee/#wprm-recipe-52838-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/12/cauliflower-rice-congee-03.jpg"
    },
    {
      "text": "Stir cauliflower to combine with shallots, garlic, ginger, and chicken. Cook until lightly toasted.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cauliflower-rice-congee/#wprm-recipe-52838-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/12/cauliflower-rice-congee-04.jpg"
    },
    {
      "text": "Add stock to the pot and bring to a boil.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cauliflower-rice-congee/#wprm-recipe-52838-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/12/cauliflower-rice-congee-05.jpg"
    },
    {
      "text": "Lower heat to a simmer and cook until liquid is reduced, approximately 10 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cauliflower-rice-congee/#wprm-recipe-52838-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/12/cauliflower-rice-congee-07.jpg"
    },
    {
      "text": "Flavor soup with fish sauce and citrus. Add salt and pepper to taste.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cauliflower-rice-congee/#wprm-recipe-52838-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/12/cauliflower-rice-congee-06.jpg"
    },
    {
      "text": "Slowly add xanthan gum to the soup, whisking continuously to completely blend.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cauliflower-rice-congee/#wprm-recipe-52838-step-0-7",
      "imageSource": null
    },
    {
      "text": "Continue to cook over low heat until the congee has thickened to desired consistency. Serve congee hot. Add optional toppings to taste.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cauliflower-rice-congee/#wprm-recipe-52838-step-0-8",
      "imageSource": null
    }
