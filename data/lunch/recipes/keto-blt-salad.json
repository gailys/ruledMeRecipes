  "ingredients": [
    "500 gram iceberg lettuce",
    "6 slice bacon",
    "3 small fresh tomatoes (diced)",
    "1/4 cup green onion (sliced)",
    "1/2 cup cheddar cheese (shredded)",
    "6 tablespoon mayonnaise",
    "3 tablespoon sour cream",
    "1 teaspoon garlic powder",
    "1/2 teaspoon dried parsley",
    "1/2 teaspoon paprika",
    "1/2 tablespoon apple cider vinegar",
    "1/2 teaspoon fresh dill",
    "2 tablespoon water"
  ],
  "instructions": [
    {
      "text": "In a pan, cook your bacon on medium.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-blt-salad/#wprm-recipe-52992-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/04/keto-blt-salad01.jpg"
    },
    {
      "text": "While your bacon cooks, place your iceberg lettuce, tomatoes, & green onions into a salad bowl.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-blt-salad/#wprm-recipe-52992-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/04/keto-blt-salad03.jpg"
    },
    {
      "text": "In a smaller bowl, mix together your dressing ingredients, add water for desired consistency.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-blt-salad/#wprm-recipe-52992-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/04/keto-blt-salad05.jpg"
    },
    {
      "text": "Chop up the cooked bacon and add it into the salad bowl and toss.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-blt-salad/#wprm-recipe-52992-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/04/keto-blt-salad06.jpg"
    },
    {
      "text": "Serve and top with cheddar cheese & dressing.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-blt-salad/#wprm-recipe-52992-step-0-4",
      "imageSource": null
    }
  ],
