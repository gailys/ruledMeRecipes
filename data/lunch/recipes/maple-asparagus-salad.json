  "ingredients": [
    "14 ounce asparagus spears",
    "1 cup cherry tomatoes (halved)",
    "1 cup walnuts (chopped)",
    "1 cup feta cheese (crumbled)",
    "ice water (in a large bowl)",
    "3 tablespoon olive oil",
    "3 tablespoon balsamic vinegar",
    "2 tablespoon low-carb maple syrup"
  ],
  "instructions": [
    {
      "text": "Pre-heat a large pot on the stove. Bring the pot to a boil.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/maple-asparagus-salad/#wprm-recipe-52934-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/02/maple-asparagus-salad-01.jpg"
    },
    {
      "text": "Drop the asparagus spears into the boiling water. Cook for 4 minutes. Turn the asparagus spears over ensure they are evenly cooked. Cook for another 4 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/maple-asparagus-salad/#wprm-recipe-52934-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/02/maple-asparagus-salad-02.jpg"
    },
    {
      "text": "Place the tomato halves, chopped walnuts, and crumbled feta into a salad bowl.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/maple-asparagus-salad/#wprm-recipe-52934-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/02/maple-asparagus-salad-03.jpg"
    },
    {
      "text": "In a separate smaller bowl, mix together the olive oil, balsamic vinegar, and sugar-free maple syrup.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/maple-asparagus-salad/#wprm-recipe-52934-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/02/maple-asparagus-salad-07.jpg"
    },
    {
      "text": "Once the asparagus is done, immediately place the spears into the bowl of ice water. Leave for 5 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/maple-asparagus-salad/#wprm-recipe-52934-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/02/maple-asparagus-salad-04.jpg"
    },
    {
      "text": "Place the asparagus spears onto paper towels and pat dry. Chop the asparagus spears into smaller pieces.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/maple-asparagus-salad/#wprm-recipe-52934-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/02/maple-asparagus-salad-05.jpg"
    },
    {
      "text": "Add the asparagus pieces into the salad bowl mix. Pour the salad dressing mix onto the salad. Toss the salad to ensure the ingredients are evenly coated.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/maple-asparagus-salad/#wprm-recipe-52934-step-0-6",
      "imageSource": null
    }
  ],
