  "ingredients": [
    "1/3 medium zucchini",
    "3 tablespoon low-carb tomato sauce (such as Rao's)",
    "2 tablespoon ricotta cheese",
    "3 ounce mozzarella cheese"
  ],
  "instructions": [
    {
      "text": "Slice the zucchini into paper-thin rounds using a very sharp knife or mandolin.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-mug-lasagna/#wprm-recipe-52161-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/05/IMG_2019.jpg"
    },
    {
      "text": "Spoon one-third of the tomato sauce over the bottom of a mug or small dish.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-mug-lasagna/#wprm-recipe-52161-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/05/IMG_2027.jpg"
    },
    {
      "text": "Layer some of the zucchini on top.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-mug-lasagna/#wprm-recipe-52161-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/05/IMG_2028.jpg"
    },
    {
      "text": "Carefully spread over half of the ricotta, then repeat with a second layer.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-mug-lasagna/#wprm-recipe-52161-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/05/IMG_2029.jpg"
    },
    {
      "text": "Top with any leftover zucchini and the last third of the sauce.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-mug-lasagna/#wprm-recipe-52161-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/05/IMG_2032.jpg"
    },
    {
      "text": "Top with the mozzarella.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-mug-lasagna/#wprm-recipe-52161-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/05/IMG_2033.jpg"
    },
    {
      "text": "Microwave for 3-4 minutes, depending on the microwave. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-mug-lasagna/#wprm-recipe-52161-step-0-6",
      "imageSource": null
    }
  ],
