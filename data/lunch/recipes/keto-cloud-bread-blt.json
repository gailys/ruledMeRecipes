  "ingredients": [
    "3 large egg",
    "4 1/4 ounce cream cheese (softened)",
    "salt (to taste)",
    "1/2 tablespoon psyllium husk powder",
    "1/2 teaspoon baking powder",
    "1/4 teaspoon cream of tartar",
    "8 tablespoon mayonnaise",
    "5 ounce cooked bacon",
    "2 ounce romaine lettuce",
    "1 large fresh tomatoes (thinly sliced)"
  ],
  "instructions": [
    {
      "text": "Preheat your oven to 300F. Separate the eggs into whites and yolks.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cloud-bread-blt/#wprm-recipe-53155-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/09/keto-blt-cloud-bread-01.jpg"
    },
    {
      "text": "Add salt and cream of tartar to the egg whites. Whip until very stiff with a hand mixer.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cloud-bread-blt/#wprm-recipe-53155-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/09/keto-blt-cloud-bread-02.jpg"
    },
    {
      "text": "Mix the cream cheese, egg yolks, and psyllium husk powder together.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cloud-bread-blt/#wprm-recipe-53155-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/09/keto-blt-cloud-bread-03.jpg"
    },
    {
      "text": "Gently fold the egg whites into the egg yolks. Don’t over mix or the whites will lose their whip.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cloud-bread-blt/#wprm-recipe-53155-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/09/keto-blt-cloud-bread-04.jpg"
    },
    {
      "text": "Add some parchment paper to a baking sheet. Shape the batter into 8 rounds then bake for 25 minutes, or until golden.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cloud-bread-blt/#wprm-recipe-53155-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/09/keto-blt-cloud-bread-05.jpg"
    },
    {
      "text": "Turn the cloud bread pieces over so their tops face down. Spread 1 tablespoon across each.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cloud-bread-blt/#wprm-recipe-53155-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/09/keto-blt-cloud-bread-06.jpg"
    }
  ],
