  "ingredients": [
    "2 ounce deli-sliced roast beef",
    "1 tablespoon sour cream",
    "1 1/2 tablespoon canned green chile (diced)",
    "1 1/2 ounce pepper jack cheese (shredded)",
    "1/2 teaspoon smoked paprika (for garnish)"
  ],
  "instructions": [
    {
      "text": "Layer one third of the roast beef in the bottom of your dish. I like to tear the roast beef up into smaller pieces.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/monterey-mug-melt/#wprm-recipe-52269-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/07/monterey-mug-melt-01.jpg"
    },
    {
      "text": "Carefully spread out half the sour cream.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/monterey-mug-melt/#wprm-recipe-52269-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/07/monterey-mug-melt-02.jpg"
    },
    {
      "text": "Layer 1/3 of the pepper jack cheese. Top with 1/3 of the green chile.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/monterey-mug-melt/#wprm-recipe-52269-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/07/monterey-mug-melt-03.jpg"
    },
    {
      "text": "Finish it off with a layer of remaining roast beef, remaining cheese, and the remainder of the green chile. Microwave for 1-2 minutes or until the cheese is melted. Sprinkle with a little smoked paprika if you like.",
      "group": "",
