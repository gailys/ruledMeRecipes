  "ingredients": [
    "1 tablespoon butter",
    "salt and pepper (to taste)",
    "4 ounce ribeye steak",
    "4 ounce mushrooms (quartered)",
    "teaspoon fresh garlic (minced)",
    "3 tablespoon chicken broth",
    "1 1/2 ounce cream cheese",
    "1/4 teaspoon worcestershire sauce",
    "1/4 teaspoon black pepper (for the sauce)",
    "1 teaspoon fresh parsley (minced)"
  ],
  "instructions": [
    {
      "text": "Preheat a skillet over medium-high heat. Add half of the butter to the pan. Sprinkle salt and pepper over the steak then pan sear and set aside.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/steak-with-keto-mushroom-stroganoff/#wprm-recipe-53060-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/06/keto-steak-w-mushrooms-stroganoff-03.jpg"
    },
    {
      "text": "Add the rest of the butter to the pan, then once the butter has become hot add the mushrooms. Cook until softened.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/steak-with-keto-mushroom-stroganoff/#wprm-recipe-53060-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/06/keto-steak-w-mushrooms-stroganoff-02.jpg"
    },
    {
      "text": "Turn the heat down to low, then add the garlic and continue cooking for about a minute. Pour in the chicken stock and use a wooden spoon to scrape the brown bits off the bottom of the pan.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/steak-with-keto-mushroom-stroganoff/#wprm-recipe-53060-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/06/keto-steak-w-mushrooms-stroganoff-07.jpg"
    },
    {
      "text": "Mix in the cream cheese, Worcestershire, and black pepper. Stir together until the cheese melts into the sauce.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/steak-with-keto-mushroom-stroganoff/#wprm-recipe-53060-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/06/keto-steak-w-mushrooms-stroganoff-09.jpg"
    },
    {
      "text": "Plate the steak, then top with the mushroom stroganoff and garnish with parsley.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/steak-with-keto-mushroom-stroganoff/#wprm-recipe-53060-step-0-4",
      "imageSource": null
