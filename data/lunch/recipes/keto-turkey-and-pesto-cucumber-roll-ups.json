  "ingredients": [
    "2 medium cucumber",
    "1/4 cup pesto",
    "6 slice mozzarella cheese",
    "6 ounce cooked turkey (deli sliced)",
    "1 medium red bell pepper (julienned)",
    "1/2 cup spinach (shredded)",
    "salt and pepper (to taste)"
  ],
  "instructions": [
    {
      "text": "Slice the cucumbers lengthwise on a mandolin, creating slices that are about 2mm thick. You can also use a vegetable peeler.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-turkey-and-pesto-cucumber-roll-ups/#wprm-recipe-59964-step-0-0",
