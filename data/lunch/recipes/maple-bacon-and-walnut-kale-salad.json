  "ingredients": [
    "4 slice bacon",
    "2 cup kale",
    "1/4 cup red onion",
    "1/2 cup walnuts",
    "2 teaspoon erythritol",
    "1/2 teaspoon maple extract",
    "1 tablespoon lemon juice"
  ],
  "instructions": [
    {
      "text": "Pre-heat a pan on the stove for the bacon. Cook bacon for desired crispness. Remove bacon from pan onto a plate to cool. Reserve the bacon fat in the pan to cook the walnuts. Keep the stove burner on medium heat.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/maple-bacon-and-walnut-kale-salad/#wprm-recipe-52930-step-0-0",
