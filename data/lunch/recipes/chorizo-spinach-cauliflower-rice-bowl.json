  "ingredients": [
    "1 tablespoon olive oil",
    "2 ounce spinach",
    "salt and pepper (to taste)",
    "1/4 teaspoon onion powder",
    "1/4 teaspoon garlic powder",
    "1/4 teaspoon paprika",
    "3 ounce chorizo sausage",
    "100 gram cauliflower rice",
