  "instructions": [
    {
      "text": "Measure out and prepare all of the ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chorizo-spinach-cauliflower-rice-bowl/#wprm-recipe-54287-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/05/Chorizo-Spinach-Cauliflower-Rice-Bowl-1.jpg"
    },
    {
      "text": "Add the olive oil to a frying pan over medium heat. Stir in the spinach.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chorizo-spinach-cauliflower-rice-bowl/#wprm-recipe-54287-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/05/Chorizo-Spinach-Cauliflower-Rice-Bowl-2.jpg"
    },
    {
      "text": "Add in the onion powder, garlic powder, paprika, salt, and pepper. Stir together until the spinach starts to wilt.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chorizo-spinach-cauliflower-rice-bowl/#wprm-recipe-54287-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/05/Chorizo-Spinach-Cauliflower-Rice-Bowl-3.jpg"
    },
    {
      "text": "Add the spinach into a bowl.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chorizo-spinach-cauliflower-rice-bowl/#wprm-recipe-54287-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/05/Chorizo-Spinach-Cauliflower-Rice-Bowl-4.jpg"
    },
    {
      "text": "Using the same frying pan, add in the chorizo and let cook for 5 - 7 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chorizo-spinach-cauliflower-rice-bowl/#wprm-recipe-54287-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/05/Chorizo-Spinach-Cauliflower-Rice-Bowl-5.jpg"
    },
    {
      "text": "Add the cauliflower rice to the frying pan. Let the chorizo and cauliflower rice cook for another 4 - 6 minutes or until golden brown in color.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chorizo-spinach-cauliflower-rice-bowl/#wprm-recipe-54287-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/05/Chorizo-Spinach-Cauliflower-Rice-Bowl-6.jpg"
    },
    {
      "text": "Add the chorizo and cauliflower rice to the same bowl as the spinach. Garnish with chopped cilantro. Enjoy!",
