  "ingredients": [
    "16 ounce romaine lettuce",
    "1/4 cup olive oil (divided)",
    "3 ounce prosciutto",
    "3 ounce manchego cheese",
    "1/2 medium lemon (juice)",
    "2 tablespoon mayonnaise",
    "salt and pepper (to taste)"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all the ingredients. Preheat the grill for about 20 minutes on low heat.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/prosciutto-manchego-grilled-salad/#wprm-recipe-53613-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/12/Proscuitto-and-Manchego-Cheese-Grilled-Salad-1.jpg"
    },
    {
      "text": "Cut the lettuce head in half. Brush both sides of the lettuce with half the olive oil.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/prosciutto-manchego-grilled-salad/#wprm-recipe-53613-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/12/Proscuitto-and-Manchego-Cheese-Grilled-Salad-2.jpg"
    },
    {
      "text": "Place lettuce on the grill and grill for a few minutes on each side while leaving the grill lid open. Grill until the outer leaves are charred.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/prosciutto-manchego-grilled-salad/#wprm-recipe-53613-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/12/Proscuitto-and-Manchego-Cheese-Grilled-Salad-3.jpg"
    },
    {
      "text": "Shave the manchego cheese with a vegetable peeler or sharp knife. Chop the lettuce and prosciutto up into bite-sized pieces.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/prosciutto-manchego-grilled-salad/#wprm-recipe-53613-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/12/Proscuitto-and-Manchego-Cheese-Grilled-Salad-4.jpg"
    },
    {
      "text": "In a bowl, combine the lettuce pieces with the rest of the olive oil, mayonnaise, and lemon juice. Toss to combine.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/prosciutto-manchego-grilled-salad/#wprm-recipe-53613-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/12/Proscuitto-and-Manchego-Cheese-Grilled-Salad-5.jpg"
    },
    {
      "text": "Top the salad off with the prosciutto and manchego. Season with salt and pepper.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/prosciutto-manchego-grilled-salad/#wprm-recipe-53613-step-0-5",
      "imageSource": null
