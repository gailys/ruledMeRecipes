  "ingredients": [
    "2 large egg",
    "8 ounce asparagus spears",
    "1 tablespoon olive oil",
    "8 ounce fresh tuna",
    "4 ounce spring mix",
    "2 ounce cherry tomatoes",
    "1/2 medium red onion",
    "2 tablespoon walnuts (chopped)",
    "salt and pepper (to taste)",
    "1/2 cup mayonnaise",
    "2 tablespoon water",
    "2 teaspoon garlic powder",
    "salt and pepper (to taste)"
  ],
  "instructions": [
    {
      "text": "In a bowl, put together mayonnaise, water, garlic powder, and salt and pepper to make the dressing. Stir until combined well and set aside.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/grilled-tuna-salad-with-garlic-dressing/#wprm-recipe-53497-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/09/Grilled-Tuna-Salad-2.jpg"
    },
    {
      "text": "Boil the eggs for about 8-10 minutes. When cooled, peel and slice in half.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/grilled-tuna-salad-with-garlic-dressing/#wprm-recipe-53497-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/09/Grilled-Tuna-Salad-3.jpg"
    },
    {
      "text": "Wash and cut the asparagus into equal lengths. Fry the asparagus in a pan by itself.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/grilled-tuna-salad-with-garlic-dressing/#wprm-recipe-53497-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/09/Grilled-Tuna-Salad-4.jpg"
    },
    {
      "text": "Equally pour the olive oil on both sides of the fresh tuna and fry for 3-5 minutes on both sides. Season the tuna with salt and pepper, to taste.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/grilled-tuna-salad-with-garlic-dressing/#wprm-recipe-53497-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/09/Grilled-Tuna-Salad-5.jpg"
    },
    {
      "text": "On a plate, place the leafy greens, cherry tomatoes (cut in half), onion, and eggs.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/grilled-tuna-salad-with-garlic-dressing/#wprm-recipe-53497-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/09/Grilled-Tuna-Salad-6.jpg"
    },
    {
      "text": "Cut the grilled tuna into slices and place on top. Pour the dressing on top of the salad and sprinkle the chopped walnuts on top of that.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/grilled-tuna-salad-with-garlic-dressing/#wprm-recipe-53497-step-0-5",
      "imageSource": null
