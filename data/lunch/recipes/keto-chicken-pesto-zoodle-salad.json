  "instructions": [
    {
      "text": "Gather and prep all of your ingredients. Pat the zoodles with paper towels to remove excess moisture.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-pesto-zoodle-salad/#wprm-recipe-57909-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2025/06/Keto-Chicken-Pesto-Zoodle-Salad-1.jpg"
    },
    {
      "text": "Place the chicken in a pot and fill it with water until the chicken is just covered. Bring to a boil and cook the chicken through.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-pesto-zoodle-salad/#wprm-recipe-57909-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2025/06/Keto-Chicken-Pesto-Zoodle-Salad-2.jpg"
    },
    {
      "text": "Remove the chicken from the water and shred it with a fork. Set aside.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-pesto-zoodle-salad/#wprm-recipe-57909-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2025/06/Keto-Chicken-Pesto-Zoodle-Salad-3.jpg"
    },
    {
      "text": "Place the zoodles in a bowl and toss with the pesto.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-pesto-zoodle-salad/#wprm-recipe-57909-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2025/06/Keto-Chicken-Pesto-Zoodle-Salad-4.jpg"
    },
    {
      "text": "Add in the chicken, cherry tomatoes, and feta cheese. Lightly toss.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-pesto-zoodle-salad/#wprm-recipe-57909-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2025/06/Keto-Chicken-Pesto-Zoodle-Salad-5.jpg"
    },
    {
      "text": "Add in the olive oil and toss again, tasting and seasoning with salt and pepper if desired.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-chicken-pesto-zoodle-salad/#wprm-recipe-57909-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2025/06/Keto-Chicken-Pesto-Zoodle-Salad-6.jpg"
    },
    {
      "text": "Serve immediately and enjoy!",
