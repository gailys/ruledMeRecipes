  ],
  "instructions": [
    {
      "text": "Gather and prep all of your ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-smoked-salmon-cucumber-rolls/#wprm-recipe-57249-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/09/Smoked-Salmon-Cucumber-Roll-1.jpg"
    },
    {
      "text": "Thinly slice the cucumber using a vegetable peeler or mandolin. Generally the thinner the slices, the better the roll will hold together.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-smoked-salmon-cucumber-rolls/#wprm-recipe-57249-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/09/Smoked-Salmon-Cucumber-Roll-2.jpg"
    },
    {
      "text": "Lay the cucumber slices on a cutting board to create the roll, then slice the ends of the cucumber to make a uniform shape. If needed, blot the cucumber with paper towels to remove any excess moisture.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-smoked-salmon-cucumber-rolls/#wprm-recipe-57249-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/09/Smoked-Salmon-Cucumber-Roll-3.jpg"
    },
    {
      "text": "Transfer the cucumber to plastic wrap over a bamboo rolling mat or a kitchen towel.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-smoked-salmon-cucumber-rolls/#wprm-recipe-57249-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/09/Smoked-Salmon-Cucumber-Roll-4.jpg"
    },
    {
      "text": "Layer the avocado, salmon, and cream cheese onto one side of the cucumber sheet. Sprinkle with the everything bagel seasoning.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-smoked-salmon-cucumber-rolls/#wprm-recipe-57249-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/09/Smoked-Salmon-Cucumber-Roll-5.jpg"
    },
    {
      "text": "Lift the edge of the mat or towel, and roll by applying firm pressure. Continue to roll, pulling the plastic wrap away as you go.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-smoked-salmon-cucumber-rolls/#wprm-recipe-57249-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/09/Smoked-Salmon-Cucumber-Roll-6.jpg"
    },
    {
      "text": "Slice into individual pieces using a sharp knife. Garnish with additional seasoning if desired and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-smoked-salmon-cucumber-rolls/#wprm-recipe-57249-step-0-6",
      "imageSource": null
    }
  ],
