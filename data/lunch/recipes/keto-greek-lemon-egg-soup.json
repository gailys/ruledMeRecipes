  "ingredients": [
    "16 ounce boneless, skinless chicken thighs",
    "4 cup chicken broth",
    "1 cube chicken bouillon cube",
    "1 whole bay leaf",
    "12 ounce cauliflower rice",
    "5 tablespoon butter",
    "4 teaspoon fresh garlic (minced)",
    "4 large egg",
    "1 medium lemon (juice and zest)",
    "1 tablespoon fresh dill (chopped)",
    "salt and pepper (to taste)"
  ],
  "instructions": [
    {
      "text": "Gather and prep all ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-greek-lemon-egg-soup/#wprm-recipe-54785-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/08/Greek-Lemon-Egg-Soup-1.jpg"
    },
    {
      "text": "Add chicken thighs, broth, bouillon cube, bay leaf, and salt and pepper to taste into a pot. Bring the broth to a boil, then reduce and let simmer for 12 minutes. Once the chicken is cooked through, remove it from the pot and set aside.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-greek-lemon-egg-soup/#wprm-recipe-54785-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/08/Greek-Lemon-Egg-Soup-2.jpg"
    },
    {
      "text": "Add cauliflower and butter to the pot and bring to a boil again.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-greek-lemon-egg-soup/#wprm-recipe-54785-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/08/Greek-Lemon-Egg-Soup-3.jpg"
    },
    {
      "text": "While the soup is heating up, beat the eggs and lemon juice in a bowl until mixed well. Season with salt and pepper to taste.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-greek-lemon-egg-soup/#wprm-recipe-54785-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/08/Greek-Lemon-Egg-Soup-4.jpg"
    },
    {
      "text": "Add a bowlful of soup into the eggs while slowly whisking to temper them.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-greek-lemon-egg-soup/#wprm-recipe-54785-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/08/Greek-Lemon-Egg-Soup-5.jpg"
    },
    {
      "text": "Remove the soup from the heat, then add egg mixture into the soup while stirring continuously. Return soup to the heat and softly simmer for 2-3 minutes. Do not let the soup boil as this will curdle the eggs.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-greek-lemon-egg-soup/#wprm-recipe-54785-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/08/Greek-Lemon-Egg-Soup-6.jpg"
    },
    {
      "text": "Mix the soup with a hand blender until smooth and all ingredients incorporated. Return chicken back into the soup to warm through.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-greek-lemon-egg-soup/#wprm-recipe-54785-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/08/Greek-Lemon-Egg-Soup-7.jpg"
    },
    {
      "text": "Serve while hot, garnishing with chopped dill and lemon zest.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-greek-lemon-egg-soup/#wprm-recipe-54785-step-0-7",
      "imageSource": null
    }
  ],
