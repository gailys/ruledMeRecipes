  "ingredients": [
    "8 slices bacon (chopped)",
    "4 cups roasted broccoli",
    "½ large onion (chopped)",
    "2 cups shredded cheddar cheese",
    "2 cups chicken broth",
    "2 cups calorie countdown*",
    "¼ cup shredded Parmesan cheese",
    "2 tablespoons butter",
    "2 tablespoons coconut flour",
    "½ cup heavy cream",
    "2 teaspoons minced garlic",
    "½ teaspoon salt",
    "¼ teaspoon cayenne pepper"
  ],
  "instructions": [
    {
      "text": "Cook bacon over medium heat in a large pot. Chop ½ onion while bacon cooks.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-broccoli-cheddar-bacon-chowder/#wprm-recipe-50621-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/12/low-carb-broccoli-cheddar-bacon-chowder-03.jpg"
    },
    {
      "text": "Remove bacon and let dry on paper towel. Remove all but 3 tbsp grease from pot.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-broccoli-cheddar-bacon-chowder/#wprm-recipe-50621-step-0-1",
      "imageSource": null
    },
    {
      "text": "Add butter to grease. Then sautee onions and garlic for 4-5 minutes",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-broccoli-cheddar-bacon-chowder/#wprm-recipe-50621-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/12/low-carb-broccoli-cheddar-bacon-chowder-04.jpg"
    },
    {
      "text": "Add coconut flour after onions become translucent, cook for 1 minute.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-broccoli-cheddar-bacon-chowder/#wprm-recipe-50621-step-0-3",
      "imageSource": null
    },
    {
      "text": "Measure out cream and milk together. Add mixture to pot ¼ at a time until it begins to bubble. Stir well and reduce heat to medium low.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-broccoli-cheddar-bacon-chowder/#wprm-recipe-50621-step-0-4",
      "imageSource": null
    },
    {
      "text": "Add cheddar and parmesan cheese and mix well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-broccoli-cheddar-bacon-chowder/#wprm-recipe-50621-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/12/low-carb-broccoli-cheddar-bacon-chowder-05.jpg"
    },
    {
      "text": "Simmer for 2-3 minutes, add broccoli, and simmer for 2-3 minutes more.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-broccoli-cheddar-bacon-chowder/#wprm-recipe-50621-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/12/low-carb-broccoli-cheddar-bacon-chowder-06.jpg"
    },
    {
      "text": "Add bacon and allow to simmer for 5 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-broccoli-cheddar-bacon-chowder/#wprm-recipe-50621-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/12/low-carb-broccoli-cheddar-bacon-chowder-07.jpg"
    },
    {
      "text": "Blend everything with immersion blender until chunky, then add broth, cayenne pepper, and stir again.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-broccoli-cheddar-bacon-chowder/#wprm-recipe-50621-step-0-8",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2013/12/low-carb-broccoli-cheddar-bacon-chowder-09.jpg"
    },
    {
      "text": "Let simmer for 20-30 more minutes, making sure to stir every 5 minutes. Serve and enjoy.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-broccoli-cheddar-bacon-chowder/#wprm-recipe-50621-step-0-9",
      "imageSource": null
    }
  ],
