  "ingredients": [
    "4 tablespoon coconut flour",
    "3 tablespoon flaxseed meal",
    "1 teaspoon italian seasoning",
    "1 1/4 cup monterey jack cheese (shredded)",
    "1 large egg",
    "2 ounce italian dry salami",
    "2 ounce provolone cheese",
    "1 ounce spinach",
    "1/4 cup italian hot pepper (sliced)",
    "1 teaspoon olive oil",
    "1 large egg yolk"
  ],
  "instructions": [
    {
      "text": "Preheat the oven to 400F. Combine the coconut flour, flax seed meal, and seasoning together in a small bowl. In a larger mixing bowl, melt the Monterey Jack cheese in a microwave for about a minute or until the shreds are fully melted together.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/italian-cheesy-bread-bake/#wprm-recipe-52185-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/06/italian-cheesy-bread-bake-01.jpg"
    },
    {
      "text": "Let the melted cheese stand for about a minute then add the whole egg. Combine the egg and cheese together.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/italian-cheesy-bread-bake/#wprm-recipe-52185-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/06/italian-cheesy-bread-bake-03.jpg"
    },
    {
      "text": "Add the dry mix to the cheese and mix together until the cheese takes up all of the flours.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/italian-cheesy-bread-bake/#wprm-recipe-52185-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/06/italian-cheesy-bread-bake-06.jpg"
    },
    {
      "text": "Spread out a piece of parchment paper then turn the cheese dough out on top of it. Place another sheet of paper on top then use a rolling pin to spread out. You want it to be longer on one side. It should be wide enough for the fillings and the braid on the other.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/italian-cheesy-bread-bake/#wprm-recipe-52185-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/06/italian-cheesy-bread-bake-07.jpg"
    },
    {
      "text": "Lay out the salami and cheese.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/italian-cheesy-bread-bake/#wprm-recipe-52185-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/06/italian-cheesy-bread-bake-09.jpg"
    },
    {
      "text": "Tear up the spinach leaves then set those on top. Spread out the mild pepper rings, then drizzle the teaspoon of olive oil on top.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/italian-cheesy-bread-bake/#wprm-recipe-52185-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/06/italian-cheesy-bread-bake-10.jpg"
    },
    {
      "text": "Use a knife or pizza cutter to cut the sides of the dough into diagonal strips. Fold up the ends of the dough, then braid the strips over the top.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/italian-cheesy-bread-bake/#wprm-recipe-52185-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/06/italian-cheesy-bread-bake-11.jpg"
    },
    {
      "text": "Whisk the egg yolk, then brush it across the top. Bake for 15-20 minutes until the braid is golden brown.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/italian-cheesy-bread-bake/#wprm-recipe-52185-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/06/italian-cheesy-bread-bake-12.jpg"
    },
    {
      "text": "Slice into serving sized pieces and enjoy.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/italian-cheesy-bread-bake/#wprm-recipe-52185-step-0-8",
      "imageSource": null
    }
  ],
