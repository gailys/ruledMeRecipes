  "ingredients": [
    "4 teaspoon fresh garlic (peeled)",
    "3 cup cherry tomatoes",
    "2 tablespoon avocado oil",
    "4 ounce fresh mozzarella cheese",
    "1 tablespoon pesto",
    "1 tablespoon brine (reserved from mozzarella)",
    "4 cup baby spinach",
    "1/4 cup fresh basil"
  ],
  "instructions": [
    {
      "text": "Heat oven to 400°F and prepare a baking sheet with foil. Spread out the peeled garlic cloves and grape tomatoes evenly.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/oven-roasted-caprese-salad/#wprm-recipe-52313-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/07/oven-roasted-caprese-salad-01.jpg"
    },
    {
      "text": "Drizzle avocado oil over the tomatoes and mix to coat. Bake for 20-30 minutes or until the juices are released and the tops become slightly brown.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/oven-roasted-caprese-salad/#wprm-recipe-52313-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/07/oven-roasted-caprese-salad-02.jpg"
    },
    {
      "text": "Drain the liquid from the mozzarella, reserving some to mix with the pesto. You want the pesto to be a consistency you can drizzle.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/oven-roasted-caprese-salad/#wprm-recipe-52313-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/07/oven-roasted-caprese-salad-03.jpg"
    },
    {
      "text": "Remove the tomatoes from the oven and put the spinach in a large serving bowl.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/oven-roasted-caprese-salad/#wprm-recipe-52313-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/07/oven-roasted-caprese-salad-04.jpg"
    },
    {
      "text": "Top the spinach with warm tomatoes and roasted garlic and drizzle with pesto sauce.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/oven-roasted-caprese-salad/#wprm-recipe-52313-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/07/oven-roasted-caprese-salad-05.jpg"
    },
    {
      "text": "Add mozzarella balls and garnish with fresh torn basil leaves.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/oven-roasted-caprese-salad/#wprm-recipe-52313-step-0-5",
      "imageSource": null
    }
