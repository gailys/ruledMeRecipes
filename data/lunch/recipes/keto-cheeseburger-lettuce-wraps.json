  "ingredients": [
    "6 ounce bacon (chopped)",
    "4 ounce cremini mushrooms (sliced)",
    "16 ounce ground beef",
    "1/2 teaspoon salt",
    "1/4 teaspoon black pepper",
    "4 ounce cheddar cheese (shredded)",
    "8 ounce iceberg lettuce leaves",
    "4 ounce cherry tomatoes"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all the ingredients. Wash and dry your lettuce leaves.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheeseburger-lettuce-wraps/#wprm-recipe-53809-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/04/Cheeseburger-Lettuce-Wraps-1.jpg"
    },
    {
      "text": "Cook the bacon in a frying pan over medium to high heat for 10-15 minutes. Once cooked thoroughly, remove the bacon from the pan.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheeseburger-lettuce-wraps/#wprm-recipe-53809-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/04/Cheeseburger-Lettuce-Wraps-2.jpg"
    },
    {
      "text": "Cook the mushrooms in the bacon fat for 6-7 minutes. Once the mushrooms are nice and brown, remove them from the pan.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheeseburger-lettuce-wraps/#wprm-recipe-53809-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/04/Cheeseburger-Lettuce-Wraps-3.jpg"
    },
    {
      "text": "Brown the meat in the frying pan for about 7-10 minutes. Season with salt and pepper.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheeseburger-lettuce-wraps/#wprm-recipe-53809-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/04/Cheeseburger-Lettuce-Wraps-4.jpg"
    },
    {
      "text": "Lay out your lettuce leaves and add the meat, mushrooms, bacon, tomatoes, and shredded cheddar cheese.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheeseburger-lettuce-wraps/#wprm-recipe-53809-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2021/04/Cheeseburger-Lettuce-Wraps-5.jpg"
    },
    {
      "text": "Serve and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-cheeseburger-lettuce-wraps/#wprm-recipe-53809-step-0-5",
      "imageSource": null
    }
