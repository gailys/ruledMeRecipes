  "ingredients": [
    "4 ounce canned sardines (drained)",
    "1 1/2 tablespoon olive oil",
    "1 teaspoon fresh garlic (minced)",
    "2 ounce cherry tomatoes (halved)",
    "1 tablespoon capers (drained)",
    "1 medium zucchini (spiralized)",
    "1/2 medium lemon (juice and zest)",
    "salt and pepper (to taste)",
    "1 tablespoon fresh parsley (chopped)"
  ],
  "instructions": [
    {
      "text": "Gather and prep all of your ingredients. Season zucchini with salt and pepper and place in a bowl with paper towels above and below. Place a can of soup on the top to allow some moisture to be released.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-sardine-zoodles-with-tomato-capers/#wprm-recipe-57079-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/08/Keto-Sardine-Zoodles-with-Tomato-Capers-1.jpg"
    },
    {
      "text": "Add olive oil and garlic to a cold pan over medium heat. If available, use oil from the canned sardines.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-sardine-zoodles-with-tomato-capers/#wprm-recipe-57079-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/08/Keto-Sardine-Zoodles-with-Tomato-Capers-2.jpg"
    },
    {
      "text": "Once garlic is fragrant (about 1-2 minutes), add in the capers and sliced tomatoes. Stir and cook for another minute.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-sardine-zoodles-with-tomato-capers/#wprm-recipe-57079-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/08/Keto-Sardine-Zoodles-with-Tomato-Capers-3.jpg"
    },
    {
      "text": "Add in the canned cardines and cook for another 1-2 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-sardine-zoodles-with-tomato-capers/#wprm-recipe-57079-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/08/Keto-Sardine-Zoodles-with-Tomato-Capers-4.jpg"
    },
    {
      "text": "Add in the spiralized zucchini and lemon zest, then stir gently, folding the ingredients over the zoodles.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-sardine-zoodles-with-tomato-capers/#wprm-recipe-57079-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/08/Keto-Sardine-Zoodles-with-Tomato-Capers-5.jpg"
    },
    {
      "text": "Season with salt and pepper if needed, then serve immediately. Garnish with fresh parsley and freshly squeezed lemon juice. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-sardine-zoodles-with-tomato-capers/#wprm-recipe-57079-step-0-5",
      "imageSource": null
    }
  ],
