  "ingredients": [
    "300 gram cauliflower",
    "30 gram green onion",
    "2 teaspoon fresh thyme",
    "1 cup collard greens",
    "1 cup mozzarella cheese (shredded)",
    "1/3 cup parmesan cheese (grated)",
    "2 large egg",
    "1 tablespoon sesame seeds",
    "1 tablespoon olive oil",
    "1 teaspoon garlic powder",
    "1/2 teaspoon salt",
    "1/2 teaspoon black pepper"
  ],
  "instructions": [
    {
      "text": "Prep the cauliflower, green onion, and thyme by cutting the cauliflower into florets, slicing the green onion finely, and removing the thyme leaves from the stems before chopping.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cheesy-thyme-waffles/#wprm-recipe-51017-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/04/IMG_8888.jpg"
    },
    {
      "text": "In a food processor, rice the cauliflower by pulsing it to form a crumbly texture that resembles rice.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cheesy-thyme-waffles/#wprm-recipe-51017-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/04/IMG_8896.jpg"
    },
    {
      "text": "Add the green onion, thyme, and collard greens to the mixture and continue pulsing until well combined.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cheesy-thyme-waffles/#wprm-recipe-51017-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/04/IMG_8899.jpg"
    },
    {
      "text": "Scoop the mixture out into a large mixing bowl.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cheesy-thyme-waffles/#wprm-recipe-51017-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/04/IMG_8901.jpg"
    },
    {
      "text": "Add the mozzarella, parmesan, eggs, sesame seeds, olive oil, garlic powder, salt, and pepper.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cheesy-thyme-waffles/#wprm-recipe-51017-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/04/IMG_8902.jpg"
    },
    {
      "text": "Mix everything well to form a loose batter.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cheesy-thyme-waffles/#wprm-recipe-51017-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/04/IMG_8906.jpg"
    },
    {
      "text": "Heat up your waffle iron and spoon the mixture in evenly.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cheesy-thyme-waffles/#wprm-recipe-51017-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/04/IMG_89084.jpg"
    },
    {
      "text": "Follow the manufacturer's instructions for cooking.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cheesy-thyme-waffles/#wprm-recipe-51017-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/04/IMG_8916.jpg"
    },
    {
      "text": "Remove and serve hot!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cheesy-thyme-waffles/#wprm-recipe-51017-step-0-8",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/04/CauliWaffle4.jpg"
    }
  ],
