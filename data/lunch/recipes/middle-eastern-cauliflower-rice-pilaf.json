  "ingredients": [
    "16 ounce ground beef",
    "4 cup cauliflower rice",
    "1/2 teaspoon salt",
    "1/4 teaspoon black pepper",
    "1/2 teaspoon ground cinnamon",
    "1 tablespoon olive oil",
    "1/2 cup pine nuts"
  ],
  "instructions": [
    {
      "text": "Preheat a large saute pan over medium-high heat. Add the oil, then the meat and the spices and cook until brown, stirring often to crumble the meat.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/middle-eastern-cauliflower-rice-pilaf/#wprm-recipe-59398-step-0-0",
