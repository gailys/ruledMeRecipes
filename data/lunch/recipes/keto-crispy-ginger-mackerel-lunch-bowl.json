  "ingredients": [
    "1 tablespoon fresh ginger (grated)",
    "1 tablespoon lemon juice",
    "3 tablespoon olive oil",
    "1 tablespoon coconut aminos",
    "salt and pepper",
    "16 ounce boneless mackerel fillets",
    "1 ounce almonds",
    "1 1/2 cup broccoli",
    "1 tablespoon butter",
    "1/2 small yellow onion",
    "1/3 cup red bell pepper (diced)",
    "2 whole sun-dried tomatoes (chopped)",
    "4 tablespoon avocado (mashed)"
  ],
  "instructions": [
    {
      "text": "Preheat the oven to 400 °F. Line a baking tray with parchment paper or foil. Mix together the grated ginger, lemon juice, olive oil, coconut aminos, and some salt and pepper. Rub half of the marinade on the mackerel fillets.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-crispy-ginger-mackerel-lunch-bowl/#wprm-recipe-53084-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/07/crispy-ginger-mackerel-keto-lunch-bowl-02.jpg"
    },
    {
      "text": "Lay the fillets onto the baking tray with the skin side facing up. Roast for 12-15 minutes or until the skin is crispy.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-crispy-ginger-mackerel-lunch-bowl/#wprm-recipe-53084-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/07/crispy-ginger-mackerel-keto-lunch-bowl-03.jpg"
    },
    {
      "text": "Spread the almonds out on a separate baking sheet. Roast for 5-6 minutes or until they brown. Take out of the oven and cool before chopping.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-crispy-ginger-mackerel-lunch-bowl/#wprm-recipe-53084-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/07/crispy-ginger-mackerel-keto-lunch-bowl-04.jpg"
    },
    {
      "text": "Lightly steam the broccoli until it’s started to soften but isn’t mushy. Roughly chop it up.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-crispy-ginger-mackerel-lunch-bowl/#wprm-recipe-53084-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/07/crispy-ginger-mackerel-keto-lunch-bowl-05.jpg"
    },
    {
      "text": "Preheat a pan over medium heat, then add the butter and allow it to melt. Fry the onions and peppers until they are soft.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-crispy-ginger-mackerel-lunch-bowl/#wprm-recipe-53084-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/07/crispy-ginger-mackerel-keto-lunch-bowl-06.jpg"
    },
    {
      "text": "Add the broccoli and sun-dried tomatoes, then continue cooking until warmed through.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-crispy-ginger-mackerel-lunch-bowl/#wprm-recipe-53084-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/07/crispy-ginger-mackerel-keto-lunch-bowl-07.jpg"
    },
    {
      "text": "Turn off the heat then mix in the rest of the dressing and roasted almonds. Serve with the avocado.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-crispy-ginger-mackerel-lunch-bowl/#wprm-recipe-53084-step-0-6",
      "imageSource": null
    }
  ],
