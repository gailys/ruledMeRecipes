  "ingredients": [
    "1 teaspoon garlic powder",
    "1/4 teaspoon dried basil",
    "2 tablespoon butter (melted)",
    "458 gram baby eggplant (ends removed and cubed)",
    "3/4 cup mozzarella cheese (shredded)"
  ],
  "instructions": [
    {
      "text": "Heat oven to 375F. Combine the garlic powder and dried basil and add to melted butter.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/garlic-herb-monkey-bread/#wprm-recipe-51241-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/09/low-carb-garlic-n-herb-monkey-bread-01.jpg"
    },
    {
      "text": "Layer 7-10 cubes of eggplant in the bottom of each mini bundt pan.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/garlic-herb-monkey-bread/#wprm-recipe-51241-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/09/low-carb-garlic-n-herb-monkey-bread-03.jpg"
    },
    {
      "text": "Sprinkle a layer of mozzarella cheese over each layer of eggplant and drizzle with about 1 teaspoon of the butter garlic mixture. Don’t worry about being precise as it will all bake together!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/garlic-herb-monkey-bread/#wprm-recipe-51241-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/09/low-carb-garlic-n-herb-monkey-bread-04.jpg"
    },
    {
      "text": "Follow with another layer of eggplant, then cheese, and any remaining garlic butter.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/garlic-herb-monkey-bread/#wprm-recipe-51241-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/09/low-carb-garlic-n-herb-monkey-bread-05.jpg"
    },
    {
      "text": "Top with the remaining cheese and bake for about 20 minutes or until cheese is brown.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/garlic-herb-monkey-bread/#wprm-recipe-51241-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/09/low-carb-garlic-n-herb-monkey-bread-07.jpg"
    },
    {
      "text": "Let cool for 5 minutes before removing from the pans. Serve warm with low-carb marinara sauce!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/garlic-herb-monkey-bread/#wprm-recipe-51241-step-0-5",
      "imageSource": null
    }
  ],
