  "ingredients": [
    "3 tablespoon almond flour",
    "1 tablespoon mayonnaise",
    "1 large egg",
    "salt and pepper (to taste)",
    "75 gram canned tuna",
    "1 tablespoon mayonnaise",
    "2 tablespoon celery (diced)",
    "salt and pepper (to taste)",
    "1 ounce cheddar cheese"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all the ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-tuna-melt-waffles/#wprm-recipe-54135-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/02/Tuna-Melt-Waffles-1.jpg"
    },
    {
      "text": "In a bowl, whisk together the ingredients for the waffles. Using a waffle maker, make the waffles.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-tuna-melt-waffles/#wprm-recipe-54135-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/02/Tuna-Melt-Waffles-2.jpg"
    },
    {
      "text": "In another bowl, mix together the tuna ingredients: tuna mayonnaise, celery, and salt and pepper.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-tuna-melt-waffles/#wprm-recipe-54135-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/02/Tuna-Melt-Waffles-3.jpg"
    },
    {
      "text": "Heat a frying pan over medium heat.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-tuna-melt-waffles/#wprm-recipe-54135-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/02/Tuna-Melt-Waffles-4.jpg"
    },
    {
      "text": "Add one of the waffles, top with the tuna, and the cheddar cheese.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-tuna-melt-waffles/#wprm-recipe-54135-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/02/Tuna-Melt-Waffles-5.jpg"
    },
    {
      "text": "Top with the other waffle and flip. Leave it on the heat until the cheese has melted.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-tuna-melt-waffles/#wprm-recipe-54135-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/02/Tuna-Melt-Waffles-6.jpg"
    },
    {
