      "sourceUrl": "https://www.ruled.me/keto-mediterranean-sardine-salad/#wprm-recipe-56881-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/06/Keto-Mediterranean-Sardine-Salad-2.jpg"
    },
