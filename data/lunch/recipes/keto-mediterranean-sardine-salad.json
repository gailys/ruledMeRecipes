  "ingredients": [
    "3 ounce mixed greens",
    "4 ounce canned sardines (drained (reserve the oil))",
    "1/4 medium red onion (diced)",
    "1/2 medium red bell pepper (diced)",
    "1 ounce cherry tomatoes (sliced)",
    "1 ounce black olives (sliced)",
    "2 tablespoon olive oil (reserved from sardines)",
    "1 tablespoon dijon mustard",
    "1 tablespoon apple cider vinegar"
  ],
  "instructions": [
    {
      "text": "Gather and prep all of your ingredients.",
      "group": "",
