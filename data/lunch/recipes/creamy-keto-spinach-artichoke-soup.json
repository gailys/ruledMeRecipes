  "ingredients": [
    "12 ounce boneless, skinless chicken thighs",
    "1 tablespoon olive oil",
    "8 ounce canned artichoke hearts (drained)",
    "10 ounce frozen spinach (thawed and drained)",
    "1/2 medium yellow onion (diced)",
    "3 teaspoon fresh garlic (minced)",
    "2 1/2 cup chicken broth",
    "1/2 medium lemon (juice and zest)",
    "1/2 cup heavy cream",
    "6 ounce cream cheese",
    "2 ounce parmesan cheese (grated)",
    "salt and pepper (to taste)"
  ],
  "instructions": [
    {
      "text": "Gather and prep all of your ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-keto-spinach-artichoke-soup/#wprm-recipe-57028-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/08/Creamy-Keto-Spinach-Artichoke-Soup-1.jpg"
    },
    {
      "text": "Add olive oil to pot over medium-low heat. Season chicken thighs with salt and pepper, then cook until done through.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-keto-spinach-artichoke-soup/#wprm-recipe-57028-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/08/Creamy-Keto-Spinach-Artichoke-Soup-2.jpg"
    },
    {
      "text": "Remove chicken from the pot, reserving any excess oil in the bottom. Shred chicken with 2 forks, then set aside.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-keto-spinach-artichoke-soup/#wprm-recipe-57028-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/08/Creamy-Keto-Spinach-Artichoke-Soup-3.jpg"
    },
    {
      "text": "Bring the pot to medium heat, then add the onion. Cook until fragrant, about 2-3 minutes. Once onion is fragrant, add the garlic and cook until soft, about 1 more minute.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-keto-spinach-artichoke-soup/#wprm-recipe-57028-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/08/Creamy-Keto-Spinach-Artichoke-Soup-4.jpg"
    },
    {
      "text": "Add in the chicken broth, spinach, artichoke hearts, lemon juice, and lemon zest. Bring to a simmer.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-keto-spinach-artichoke-soup/#wprm-recipe-57028-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/08/Creamy-Keto-Spinach-Artichoke-Soup-6.jpg"
    },
    {
      "text": "Once soup is simmering, reduce heat to low and then add in the cream, cream cheese, and grated parmesan cheese. Stir through slowly until all cheese has melted and incorporated into the soup.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-keto-spinach-artichoke-soup/#wprm-recipe-57028-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/08/Creamy-Keto-Spinach-Artichoke-Soup-7.jpg"
    },
    {
      "text": "Add shredded chicken back into the pot and stir, allowing it to heat through.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-keto-spinach-artichoke-soup/#wprm-recipe-57028-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/08/Creamy-Keto-Spinach-Artichoke-Soup-8.jpg"
    },
    {
      "text": "Season with salt and pepper to taste, then serve while hot. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/creamy-keto-spinach-artichoke-soup/#wprm-recipe-57028-step-0-7",
      "imageSource": null
    }
  ],
