  "ingredients": [
    "1/2 cup cheddar cheese (shredded)",
    "1/2 cup mozzarella cheese (shredded)",
    "1/2 cup rotisserie chicken (shredded)",
    "1 tablespoon mayonnaise",
    "1 tablespoon red onion (diced)",
    "1/4 medium red bell pepper (diced)",
    "1/4 teaspoon onion powder",
    "salt and pepper (to taste)"
  ],
  "instructions": [
    {
      "text": "Gather and prep all ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cheese-crusted-keto-quesadillas/#wprm-recipe-54889-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/08/Cheese-Crusted-Keto-Quesadillas-1.jpg"
    },
    {
      "text": "Mix together the chicken, mayonnaise, onion powder, red onion, bell pepper, and salt and pepper to taste.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cheese-crusted-keto-quesadillas/#wprm-recipe-54889-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/08/Cheese-Crusted-Keto-Quesadillas-2.jpg"
    },
    {
      "text": "Mix the 2 cheeses together in a bowl.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cheese-crusted-keto-quesadillas/#wprm-recipe-54889-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/08/Cheese-Crusted-Keto-Quesadillas-3.jpg"
    },
    {
      "text": "In a non-stick pan over medium heat, add half of the cheese mixture, forming a circle. Allow to melt and crisp on the bottom. Remove from the pan and repeat with the other half of the cheese to form your \"tortillas\".",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cheese-crusted-keto-quesadillas/#wprm-recipe-54889-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/08/Cheese-Crusted-Keto-Quesadillas-4.jpg"
    },
    {
      "text": "Spoon the chicken mixture on top of one of the cheese \"tortillas\", then cover with the other cheese \"tortilla\" to form the quesadilla.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cheese-crusted-keto-quesadillas/#wprm-recipe-54889-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2023/08/Cheese-Crusted-Keto-Quesadillas-5.jpg"
    },
    {
      "text": "Slice and serve. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cheese-crusted-keto-quesadillas/#wprm-recipe-54889-step-0-5",
      "imageSource": null
    }
