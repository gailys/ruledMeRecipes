  "ingredients": [
    "56 ounce corned beef",
    "1 tablespoon erythritol",
    "2 teaspoon kosher salt",
    "1 teaspoon black peppercorns",
    "1 teaspoon mustard seeds",
    "1 whole bay leaf (crushed)",
    "1/2 teaspoon crushed red pepper flakes",
    "1/4 cup brewed coffee",
    "1/4 cup dry white wine",
    "2 teaspoon worcestershire sauce",
    "1 tablespoon whole grain mustard",
    "1 tablespoon olive oil",
    "1/4 teaspoon ground cloves",
    "1/4 teaspoon ground allspice",
    "15 large savoy cabbage leaves",
    "1 medium onion (sliced)",
    "1 medium lemon"
  ],
  "instructions": [
    {
      "text": "Add the corned beef to the slow cooker and rub with erythritol, salt, peppercorns, mustard seeds, crushed bay leaf, and red pepper flakes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-corned-beef-cabbage-rolls/#wprm-recipe-50969-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_6198.jpg"
    },
    {
      "text": "Add the coffee and white wine. Rub the beef with Worcestershire sauce, whole grain mustard, olive oil, cloves, and allspice.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-corned-beef-cabbage-rolls/#wprm-recipe-50969-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_6207.jpg"
    },
    {
      "text": "Cover the slow cooker and cook on low for 6 hours.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-corned-beef-cabbage-rolls/#wprm-recipe-50969-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_6220.jpg"
    },
    {
      "text": "Once the corned beef is almost ready, peel off some cabbage leaves and season with salt and pepper.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-corned-beef-cabbage-rolls/#wprm-recipe-50969-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_6227.jpg"
    },
    {
      "text": "Bring a pot of water to a boil, then add in the cabbage leaves and cook for 3–4 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-corned-beef-cabbage-rolls/#wprm-recipe-50969-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_6238.jpg"
    },
    {
      "text": "Blanch the cabbage leaves by submerging them in ice water for another 3–4 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-corned-beef-cabbage-rolls/#wprm-recipe-50969-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_6239.jpg"
    },
    {
      "text": "Dry the leaves off and set aside.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-corned-beef-cabbage-rolls/#wprm-recipe-50969-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_6247.jpg"
    },
    {
      "text": "In the same pot of water, add the sliced onion and bring to a boil again. Let cook until tender.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-corned-beef-cabbage-rolls/#wprm-recipe-50969-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_6254.jpg"
    },
    {
      "text": "Remove the meat from the slow cooker and let rest a few moments, then slice.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-corned-beef-cabbage-rolls/#wprm-recipe-50969-step-0-8",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/CornedBeefSlices.jpg"
    },
    {
      "text": "Create the cabbage rolls by placing the meat and onions on top of a cabbage leaf and rolling it up.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-corned-beef-cabbage-rolls/#wprm-recipe-50969-step-0-9",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/IMG_6269.jpg"
    },
    {
      "text": "Serve with a squeeze of fresh lemon juice!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-corned-beef-cabbage-rolls/#wprm-recipe-50969-step-0-10",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2014/03/CornedBeefCabbage.jpg"
    }
  ],
