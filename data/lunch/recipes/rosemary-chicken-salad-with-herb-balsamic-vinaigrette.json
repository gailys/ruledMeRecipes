  "instructions": [
    {
      "text": "Finely chop the rosemary. One half will be used to make the vinaigrette while the other half will season the chicken.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/rosemary-chicken-salad-with-herb-balsamic-vinaigrette/#wprm-recipe-52635-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/06/lemon-herb-chicken-salad-w-creamy-rosemary-vinegarette-01.jpg"
    },
    {
      "text": "Make the vinaigrette by combining the larger amount of oil, vinegar, garlic paste, mayonnaise and 1/2 the chopped rosemary in a jar with a lid.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/rosemary-chicken-salad-with-herb-balsamic-vinaigrette/#wprm-recipe-52635-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/06/lemon-herb-chicken-salad-w-creamy-rosemary-vinegarette-02.jpg"
    },
    {
      "text": "Seal the jar and shake vigorously to combine. Set aside while you prepare the chicken.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/rosemary-chicken-salad-with-herb-balsamic-vinaigrette/#wprm-recipe-52635-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/06/lemon-herb-chicken-salad-w-creamy-rosemary-vinegarette-03.jpg"
    },
    {
      "text": "Sprinkle the chicken with the remaining rosemary and a pinch of salt and pepper.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/rosemary-chicken-salad-with-herb-balsamic-vinaigrette/#wprm-recipe-52635-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/06/lemon-herb-chicken-salad-w-creamy-rosemary-vinegarette-04.jpg"
    },
    {
      "text": "Heat the smaller amount of olive oil in a skillet to medium heat and cook the chicken for about 20 minutes, turning halfway through. Make sure the chicken is cooked to an internal temperature of 165°F.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/rosemary-chicken-salad-with-herb-balsamic-vinaigrette/#wprm-recipe-52635-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/06/lemon-herb-chicken-salad-w-creamy-rosemary-vinegarette-05.jpg"
    },
    {
      "text": "Set the chicken aside to rest.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/rosemary-chicken-salad-with-herb-balsamic-vinaigrette/#wprm-recipe-52635-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/06/lemon-herb-chicken-salad-w-creamy-rosemary-vinegarette-06.jpg"
    },
    {
      "text": "Assemble the salad on a large platter or in individual bowls with a base of spring greens followed by the cherry tomatoes, sliced onion, and avocado.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/rosemary-chicken-salad-with-herb-balsamic-vinaigrette/#wprm-recipe-52635-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/06/lemon-herb-chicken-salad-w-creamy-rosemary-vinegarette-08.jpg"
    },
    {
      "text": "Slice the chicken and place on top of the platter of salad or evenly distribute to individual bowls of salad. Sprinkle with Parmesan and drizzle with dressing.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/rosemary-chicken-salad-with-herb-balsamic-vinaigrette/#wprm-recipe-52635-step-0-7",
