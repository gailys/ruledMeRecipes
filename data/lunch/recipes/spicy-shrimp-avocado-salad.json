  "ingredients": [
    "2 medium avocado",
    "1/2 medium lime (juice)",
    "5 ounce cucumber",
    "2 ounce baby spinach",
    "2 ounce cherry tomatoes (sliced )",
    "3 tablespoon olive oil (for frying)",
    "1 teaspoon fresh garlic (minced)",
    "1 tablespoon chili paste",
    "10 ounce shrimp (peeled)",
    "1/4 cup olive oil",
    "1 tablespoon fresh ginger (minced)",
    "1/2 medium lime (juice)",
    "1/2 tablespoon soy sauce (or coconut aminos)",
    "1 teaspoon fresh garlic (minced)",
    "salt and pepper (to taste)"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all the ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/spicy-shrimp-avocado-salad/#wprm-recipe-53597-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/12/Spicy-Shrimp-Salad-1.jpg"
    },
    {
      "text": "Cut up the avocado into slices and discard the pit. Squeeze lime juice over the avocado. Slice the cucumbers.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/spicy-shrimp-avocado-salad/#wprm-recipe-53597-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/12/Spicy-Shrimp-Salad-2.jpg"
    },
    {
      "text": "Plate the spinach, avocado slices, cucumbers slices, and cherry tomatoes. Season with salt and pepper to taste.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/spicy-shrimp-avocado-salad/#wprm-recipe-53597-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/12/Spicy-Shrimp-Salad-3.jpg"
    },
    {
      "text": "In a frying pan, add the olive oil, garlic, and chili paste. Add in the shrimp and fry for a few minutes each on both sides.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/spicy-shrimp-avocado-salad/#wprm-recipe-53597-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/12/Spicy-Shrimp-Salad-4.jpg"
    },
    {
      "text": "Add the cooked shrimp to the top of the salad.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/spicy-shrimp-avocado-salad/#wprm-recipe-53597-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/12/Spicy-Shrimp-Salad-5.jpg"
    },
    {
      "text": "Combine ingredients for the dressing: olive oil, ginger, lime juice, soy sauce, and garlic in a bowl and blend together using an immersion blender.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/spicy-shrimp-avocado-salad/#wprm-recipe-53597-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/12/Spicy-Shrimp-Salad-6.png"
    },
    {
      "text": "Top the salad with the ginger dressing.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/spicy-shrimp-avocado-salad/#wprm-recipe-53597-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/12/Spicy-Shrimp-Salad-7.jpg"
