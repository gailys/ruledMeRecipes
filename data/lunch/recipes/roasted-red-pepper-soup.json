  "ingredients": [
    "4 medium roasted red pepper",
    "1/4 cup onion (diced)",
    "salt and pepper (to taste)",
    "1 teaspoon crushed red pepper flakes",
    "1 teaspoon fresh garlic (minced)",
    "1 cup heavy whipping cream",
    "1/4 cup olive oil",
    "1/2 teaspoon xanthan gum",
    "4 tablespoon parmesan cheese (shredded)"
  ],
  "instructions": [
    {
      "text": "Toss the whole roasted and peeled peppers, without the liquid from the jar (if using premade), into a blender and puree until it becomes a thick sauce.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/roasted-red-pepper-soup/#wprm-recipe-52567-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/05/roasted-red-pepper-soup-01.jpg"
    },
    {
      "text": "Add in the onions, salt, pepper, and chili flakes, then puree again.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/roasted-red-pepper-soup/#wprm-recipe-52567-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/05/roasted-red-pepper-soup-04.jpg"
    },
    {
      "text": "In a stovetop pan over medium heat, warm up the garlic.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/roasted-red-pepper-soup/#wprm-recipe-52567-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/05/roasted-red-pepper-soup-05.jpg"
    },
    {
      "text": "Pour in your pepper/chili mix and bring to a boil.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/roasted-red-pepper-soup/#wprm-recipe-52567-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/05/roasted-red-pepper-soup-06.jpg"
    },
    {
      "text": "Whisk in the heavy cream and again bring to a boil.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/roasted-red-pepper-soup/#wprm-recipe-52567-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/05/roasted-red-pepper-soup-08.jpg"
    },
    {
      "text": "In a separate bowl, stir together the olive oil and xanthan gum.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/roasted-red-pepper-soup/#wprm-recipe-52567-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/05/roasted-red-pepper-soup-09.jpg"
    },
    {
      "text": "Quickly pour the xanthan gum into the soup. Stir and the soup should begin to thicken.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/roasted-red-pepper-soup/#wprm-recipe-52567-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/05/roasted-red-pepper-soup-10.jpg"
    },
    {
      "text": "Bring to a final boil.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/roasted-red-pepper-soup/#wprm-recipe-52567-step-0-7",
      "imageSource": null
    },
    {
      "text": "Top with some Parmesan cheese and serve!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/roasted-red-pepper-soup/#wprm-recipe-52567-step-0-8",
      "imageSource": null
    }
  ],
