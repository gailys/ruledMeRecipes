  "ingredients": [
    "2 tablespoon sour cream",
    "2 tablespoon mayonnaise",
    "1/2 teaspoon garlic powder",
    "1/2 teaspoon onion powder",
    "1 teaspoon dried parsley",
    "1 tablespoon whole milk",
    "3 large hard-boiled egg",
    "4 ounce cheddar cheese",
    "3 cup romaine lettuce",
    "1/2 cup cherry tomatoes",
    "1 cup cucumber (diced)",
    "1 tablespoon dijon mustard"
  ],
  "instructions": [
    {
      "text": "Prepare the dressing by mixing the sour cream, mayonnaise, and dried herbs until combined.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/vegetarian-keto-club-salad/#wprm-recipe-52385-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/11/vegetarian-keto-cobb-salad-01.jpg"
    },
    {
      "text": "Add one tablespoon of milk and mix. If the dressing seems too thick, add another tablespoon of milk. Don’t forget to add another tablespoon of milk to the final macro count, if you do!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/vegetarian-keto-club-salad/#wprm-recipe-52385-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/11/vegetarian-keto-cobb-salad-03.jpg"
    },
    {
      "text": "Layer your salad with the fresh veggies, cheese, and sliced egg. Add a spoonful of Dijon mustard in the center.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/vegetarian-keto-club-salad/#wprm-recipe-52385-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2017/11/vegetarian-keto-cobb-salad-04.jpg"
    },
    {
      "text": "Drizzle with the prepared dressing, about 2 tablespoons for one serving, then toss to coat.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/vegetarian-keto-club-salad/#wprm-recipe-52385-step-0-3",
