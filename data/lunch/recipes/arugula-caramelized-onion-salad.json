  "ingredients": [
    "2 tablespoon butter",
    "1 medium onion (chopped)",
    "1 teaspoon stevia/erythritol blend",
    "3 cup arugula",
    "1/4 cup mixed greens",
    "1/8 cup slivered almonds",
    "1/4 cup feta cheese (crumbled)",
    "3 tablespoon olive oil",
    "2 tablespoon balsamic vinegar",
    "salt and pepper (to taste)"
  ],
  "instructions": [
    {
      "text": "Preheat pan on the stove over medium heat. Melt butter in pan.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/arugula-caramelized-onion-salad/#wprm-recipe-52818-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/12/arugula-andcaramelized-onion-salad-01.jpg"
    },
    {
      "text": "Add onions and sweetener to the pan.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/arugula-caramelized-onion-salad/#wprm-recipe-52818-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/12/arugula-andcaramelized-onion-salad-02-1.jpg"
    },
    {
      "text": "Cook onions, stirring occasionally, until they begin to brown and soften.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/arugula-caramelized-onion-salad/#wprm-recipe-52818-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/12/arugula-andcaramelized-onion-salad-03.jpg"
    },
    {
      "text": "Remove pan from stove and let cool.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/arugula-caramelized-onion-salad/#wprm-recipe-52818-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/12/arugula-andcaramelized-onion-salad-06.jpg"
    },
    {
      "text": "Combine mixed greens, baby arugula, slivered almonds, and crumbled feta in a salad bowl.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/arugula-caramelized-onion-salad/#wprm-recipe-52818-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/12/arugula-andcaramelized-onion-salad-05.jpg"
    },
    {
      "text": "Place caramelized onions on top of salad mix.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/arugula-caramelized-onion-salad/#wprm-recipe-52818-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/12/arugula-andcaramelized-onion-salad-07.jpg"
    },
    {
      "text": "In a separate bowl, whisk balsamic vinegar and olive oil together.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/arugula-caramelized-onion-salad/#wprm-recipe-52818-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/12/arugula-andcaramelized-onion-salad-08.jpg"
    },
    {
      "text": "Pour vinegar and oil salad dressing on top of salad and onions. Add salt and pepper to taste.",
