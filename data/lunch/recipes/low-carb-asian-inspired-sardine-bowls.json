  "ingredients": [
    "8 ounce canned sardines (drained)",
    "1/2 medium yellow onion (chopped)",
    "2 medium bird's eye chile pepper (diced)",
    "2 teaspoon fresh garlic (minced)",
    "2 teaspoon sesame oil",
    "1 tablespoon soy sauce",
    "2 teaspoon fish sauce",
    "1 tablespoon avocado oil",
    "8 ounce cauliflower rice",
    "1 teaspoon avocado oil",
    "2 large egg"
  ],
  "instructions": [
    {
      "text": "Gather and prep all of your ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-asian-inspired-sardine-bowls/#wprm-recipe-56856-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/06/Low-Carb-Asian-Inspired-Sardine-Bowls-1.jpg"
    },
    {
      "text": "Combine the sardines, garlic, yellow onion, and birds eye chili.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-asian-inspired-sardine-bowls/#wprm-recipe-56856-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/06/Low-Carb-Asian-Inspired-Sardine-Bowls-2.jpg"
    },
    {
      "text": "Heat sesame oil in a saucepan over medium heat, then add in the sardine mixture once hot.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-asian-inspired-sardine-bowls/#wprm-recipe-56856-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/06/Low-Carb-Asian-Inspired-Sardine-Bowls-3.jpg"
    },
    {
      "text": "Add in the soy sauce and fish sauce to the sardine mixture. Allow to cook for a few minutes, stirring occasionally.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-asian-inspired-sardine-bowls/#wprm-recipe-56856-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/06/Low-Carb-Asian-Inspired-Sardine-Bowls-4.jpg"
    },
    {
      "text": "In a separate non-stick pan, add avocado oil and cauliflower rice on high heat. Cook until moisture is removed from the cauliflower, stirring frequently. About 5-6 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-asian-inspired-sardine-bowls/#wprm-recipe-56856-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/06/Low-Carb-Asian-Inspired-Sardine-Bowls-5.jpg"
    },
    {
      "text": "Plate up the sardines and cauliflower rice and set aside.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-asian-inspired-sardine-bowls/#wprm-recipe-56856-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/06/Low-Carb-Asian-Inspired-Sardine-Bowls-6.jpg"
    },
    {
      "text": "In the pan the cauliflower was in, add in the last amount of avocado oil, then add eggs and cook sunny side up. About 45-60 seconds. Season with salt.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-asian-inspired-sardine-bowls/#wprm-recipe-56856-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/06/Low-Carb-Asian-Inspired-Sardine-Bowls-7.jpg"
    },
    {
      "text": "Add the egg over the sardine bowl, then optionally garnish with chopped cilantro. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-asian-inspired-sardine-bowls/#wprm-recipe-56856-step-0-7",
      "imageSource": null
    }
  ],
