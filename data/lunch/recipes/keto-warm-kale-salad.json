  "ingredients": [
    "2 tablespoon butter",
    "4 ounce kale",
    "2 ounce feta cheese",
    "salt and pepper (to taste)",
    "4 tablespoon heavy cream",
    "1 tablespoon mayonnaise",
    "1 teaspoon dijon mustard",
    "1/2 teaspoon fresh garlic (minced)"
  ],
  "instructions": [
    {
      "text": "Blend the heavy cream, mayonnaise, dijon mustard, and garlic together until smooth. Set aside.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-warm-kale-salad/#wprm-recipe-53325-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/04/warm-kale-salad-02.jpg"
    },
    {
      "text": "Rinse the kale and chop into bite-size pieces. Discard the stem.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-warm-kale-salad/#wprm-recipe-53325-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/04/warm-kale-salad-03.jpg"
    },
    {
      "text": "Add the butter to a pan over medium heat. Once hot, add the kale to the pan and quickly cook until dark brown color comes out. About 1-2 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-warm-kale-salad/#wprm-recipe-53325-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/04/warm-kale-salad-04.jpg"
    },
    {
      "text": "Place cooked kale into a bowl. Top with feta cheese and dressing. Season with salt and pepper to taste.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-warm-kale-salad/#wprm-recipe-53325-step-0-3",
      "imageSource": null
    }
