  "ingredients": [
    "1 tablespoon capers",
    "2 ounce canned tuna",
    "1 teaspoon fresh garlic (minced)",
    "2 tablespoon fresh basil (chopped)",
    "1 tablespoon lemon juice",
    "2 tablespoon olive oil",
    "4 tablespoon mayonnaise",
    "1/2 teaspoon dried parsley",
    "salt and pepper (to taste)",
    "8 ounce boneless, skinless chicken breast",
    "salt and pepper (to taste)",
    "water",
    "4 ounce spring mix"
  ],
  "instructions": [
    {
      "text": "Add all of the tonnato sauce ingredients to a bowl and blend together using an immersion blender. A food processor can also work. Set aside in the refrigerator.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/easy-keto-chicken-tonnato/#wprm-recipe-60124-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/10/easy-keto-chicken-tonnato-step-01.jpg"
    },
    {
      "text": "Add the chicken breast to a pot with enough water to cover it. Season with salt and pepper. Bring the water to a boil, discarding any scum on the top of the water.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/easy-keto-chicken-tonnato/#wprm-recipe-60124-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/10/easy-keto-chicken-tonnato-step-02.jpg"
    },
    {
      "text": "Let the chicken simmer for about 15 minutes or until fully cooked through.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/easy-keto-chicken-tonnato/#wprm-recipe-60124-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/10/easy-keto-chicken-tonnato-step-03.jpg"
    },
    {
      "text": "Allow the chicken breast to cool for 5-10 minutes, then slice.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/easy-keto-chicken-tonnato/#wprm-recipe-60124-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/10/easy-keto-chicken-tonnato-step-04.jpg"
    },
    {
      "text": "Prepare the salad by plating the spring mix, chicken, and tonnato sauce.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/easy-keto-chicken-tonnato/#wprm-recipe-60124-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/10/easy-keto-chicken-tonnato-step-05.jpg"
