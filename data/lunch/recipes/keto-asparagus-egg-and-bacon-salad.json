  "ingredients": [
    "16 ounce asparagus spears",
    "3 ounce bacon",
    "2 large hard-boiled egg (chopped)",
    "2 tablespoon avocado oil",
    "2 tablespoon red wine vinegar",
    "1 tablespoon dijon mustard",
    "1 teaspoon fresh garlic (minced)",
    "1/2 teaspoon crushed red pepper flakes",
    "salt and pepper (to taste)"
  ],
  "instructions": [
    {
      "text": "Trim the asparagus, then chop into 1-2 inch segments.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-asparagus-egg-and-bacon-salad/#wprm-recipe-53311-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/04/asparagus-bacon-egg-salad-01.jpg"
    },
    {
      "text": "Bring a pot of salted water to boil. Add the asparagus into the pot and boil for 3-4 minutes. Use a slotted spoon to remove the asparagus from the boiling water and transfer to a bowl filled with ice water to stop the cooking process.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-asparagus-egg-and-bacon-salad/#wprm-recipe-53311-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/04/asparagus-bacon-egg-salad-03.jpg"
    },
    {
      "text": "Chop the bacon into small pieces and then cook in a pan over medium heat until rendered and crisp.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-asparagus-egg-and-bacon-salad/#wprm-recipe-53311-step-0-2",
      "imageSource": null
    },
    {
      "text": "Add all of the dressing ingredients into a bowl along with the bacon fat from the pan that you cooked the bacon in. Whisk together vigorously to combine. Season with salt and pepper.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-asparagus-egg-and-bacon-salad/#wprm-recipe-53311-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/04/asparagus-bacon-egg-salad-04.jpg"
    },
    {
      "text": "Assemble the salad by combining the asparagus, bacon, chopped hard-boiled eggs, and dressing. Mix together and serve.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-asparagus-egg-and-bacon-salad/#wprm-recipe-53311-step-0-4",
      "imageSource": null
    }
