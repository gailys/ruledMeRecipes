  "ingredients": [
    "170 gram spring mix",
    "8 ounce boneless, skinless chicken breast",
    "1 cup sour cream",
    "1 teaspoon garlic powder",
    "1 tablespoon water",
    "4 tablespoon low-carb bbq sauce",
    "1 medium red bell pepper (diced)",
    "1 medium avocado",
    "1 cup cheddar cheese (shredded)"
  ],
  "instructions": [
    {
      "text": "In a small bowl, mix together your sour cream, garlic powder, water and half of the BBQ sauce. Set aside.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-bbq-salad-with-shredded-chicken/#wprm-recipe-52974-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/04/keto-bbq-chicken-salad-01.jpg"
    },
    {
      "text": "Place the chicken breasts into a pan and fill with water.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-bbq-salad-with-shredded-chicken/#wprm-recipe-52974-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/04/keto-bbq-chicken-salad-03.jpg"
    },
    {
      "text": "Cook on medium-high until breasts are cooked thoroughly.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-bbq-salad-with-shredded-chicken/#wprm-recipe-52974-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/04/keto-bbq-chicken-salad-04.jpg"
    },
    {
      "text": "Using a fork, pull apart your cooked chicken until it has all been shredded.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-bbq-salad-with-shredded-chicken/#wprm-recipe-52974-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/04/keto-bbq-chicken-salad-05.jpg"
    },
    {
      "text": "Add in the rest of the BBQ sauce into the chicken and mix together.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-bbq-salad-with-shredded-chicken/#wprm-recipe-52974-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/04/keto-bbq-chicken-salad-07.jpg"
    },
    {
      "text": "Mix the lettuce, chicken, bell pepper, avocado, and cheddar cheese in a salad bowl.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-bbq-salad-with-shredded-chicken/#wprm-recipe-52974-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/04/keto-bbq-chicken-salad-09.jpg"
    },
    {
      "text": "Serve and top with the BBQ dressing and extra sauce if desired.",
