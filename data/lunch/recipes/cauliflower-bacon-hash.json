  "ingredients": [
    "4 slice bacon (diced)",
    "1 medium onion (diced)",
    "1 teaspoon fresh garlic (minced)",
    "12 ounce cauliflower (chopped)",
    "1/2 teaspoon smoked paprika",
    "2 tablespoon water",
    "1 tablespoon lemon juice",
    "2 ounce cheddar cheese",
    "2 tablespoon butter",
    "4 large egg",
    "2 teaspoon fresh parsley (minced)",
    "salt and pepper (to taste)"
  ],
  "instructions": [
    {
      "text": "Measure out and prepare all the ingredients. In a frying pan over medium heat, cook the chopped bacon until done to your crispy likeness. Remove bacon from frying pan.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cauliflower-bacon-hash/#wprm-recipe-54487-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/10/Keto-Cauliflower-Bacon-Hash-1.jpg"
    },
    {
      "text": "With the same skillet, add in the onion and garlic. Cook until fragrant.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cauliflower-bacon-hash/#wprm-recipe-54487-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/10/Keto-Cauliflower-Bacon-Hash-2.jpg"
    },
    {
      "text": "Add in the chopped cauliflower and let cook for about 2-3 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cauliflower-bacon-hash/#wprm-recipe-54487-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/10/Keto-Cauliflower-Bacon-Hash-3.jpg"
    },
    {
      "text": "Season the cauliflower with paprika, salt, and pepper. Stir to season the cauliflower.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cauliflower-bacon-hash/#wprm-recipe-54487-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/10/Keto-Cauliflower-Bacon-Hash-4.jpg"
    },
    {
      "text": "Add the water to the frying pan. Cover with a lid and let cook for about 5 minutes or until the cauliflower becomes tender.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cauliflower-bacon-hash/#wprm-recipe-54487-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/10/Keto-Cauliflower-Bacon-Hash-5.jpg"
    },
    {
      "text": "Add the cooked bacon into the frying pan. Season with lemon juice. Stir to combine well.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cauliflower-bacon-hash/#wprm-recipe-54487-step-0-5",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/10/Keto-Cauliflower-Bacon-Hash-6.jpg"
    },
    {
      "text": "Cover with a lid and let cook for another 2 minutes. Then remove from heat, sprinkle with cheese, cover again, and set aside until the eggs are cooked.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cauliflower-bacon-hash/#wprm-recipe-54487-step-0-6",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/10/Keto-Cauliflower-Bacon-Hash-7.jpg"
    },
    {
      "text": "In another pan, add the butter and eggs. Fry over medium heat until done.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cauliflower-bacon-hash/#wprm-recipe-54487-step-0-7",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2022/10/Keto-Cauliflower-Bacon-Hash-8.jpg"
    },
    {
      "text": "Serve the cauliflower hash with the fried eggs. Garnish with parsley. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/cauliflower-bacon-hash/#wprm-recipe-54487-step-0-8",
      "imageSource": null
    }
  ],
