  "ingredients": [
    "32 ounce broccoli",
    "3 cup water",
    "1 cup unsweetened almond milk",
    "1 cup heavy cream",
    "3/4 cup parmesan cheese (shredded)",
    "2 tablespoon lemon juice",
    "salt and pepper (to taste)"
  ],
  "instructions": [
    {
      "text": "Add the broccoli and water to a pot and cook over medium-high heat until broccoli is tender.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-broccoli-lemon-parmesan-soup/#wprm-recipe-53275-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/03/lemon-parmesan-broccoli-soup-02.jpg"
    },
    {
      "text": "Reserve 1 cup of the cooking liquid from the pot and discard the rest.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-broccoli-lemon-parmesan-soup/#wprm-recipe-53275-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/03/lemon-parmesan-broccoli-soup-03.jpg"
    },
    {
      "text": "Add half of the broccoli, reserved cooking liquid, unsweetened almond milk, heavy cream, and salt and pepper to a blender. Blend well until smooth.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-broccoli-lemon-parmesan-soup/#wprm-recipe-53275-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/03/lemon-parmesan-broccoli-soup-04.jpg"
    },
    {
      "text": "Add the blended ingredients into the remaining broccoli in the pot and stir together with parmesan cheese and lemon juice. Continue cooking until heated through.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-broccoli-lemon-parmesan-soup/#wprm-recipe-53275-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2020/03/lemon-parmesan-broccoli-soup-05.jpg"
    },
    {
      "text": "Taste and season with additional salt and pepper if needed. Serve with a sprinkle of parmesan cheese over the top.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-broccoli-lemon-parmesan-soup/#wprm-recipe-53275-step-0-4",
      "imageSource": null
    }
