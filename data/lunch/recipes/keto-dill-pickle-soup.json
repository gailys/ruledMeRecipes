  "ingredients": [
    "1 tablespoon butter",
    "1 teaspoon fresh garlic (minced)",
    "1 teaspoon dried parsley",
    "40 gram celery (diced)",
    "1/2 small onion (diced)",
    "90 gram dill pickle (diced)",
    "1/2 cup pickle juice",
    "1/4 cup chicken broth",
    "1 cup heavy whipping cream",
    "3 tablespoon olive oil",
    "1/2 teaspoon xanthan gum",
    "6 slice cooked bacon (crumbled)",
    "1/2 cup cheddar cheese (shredded)"
  ],
  "instructions": [
    {
      "text": "In a deep pot, heat up the butter and minced garlic.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-dill-pickle-soup/#wprm-recipe-52591-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/05/dill-pickle-soup-01.jpg"
    },
    {
      "text": "Add in your parsley, celery, onions and chopped pickles, sauteing for 5 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-dill-pickle-soup/#wprm-recipe-52591-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/05/dill-pickle-soup-02.jpg"
    },
    {
      "text": "Pour in your pickle juice, chicken broth and heavy cream. Bring to a boil.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-dill-pickle-soup/#wprm-recipe-52591-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/05/dill-pickle-soup-05.jpg"
    },
    {
      "text": "In a separate smaller bowl or cup, quickly stir together your olive oil and xanthan gum. Immediately pour it into the soup.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-dill-pickle-soup/#wprm-recipe-52591-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/05/dill-pickle-soup-07.jpg"
    },
    {
      "text": "Stir frequently until the soup begins to thicken. Turn off heat and mix in your bacon bits and cheddar cheese.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-dill-pickle-soup/#wprm-recipe-52591-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/05/dill-pickle-soup-08.jpg"
    },
    {
      "text": "Pour into serving bowls and enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/keto-dill-pickle-soup/#wprm-recipe-52591-step-0-5",
      "imageSource": null
    }
  ],
