  "ingredients": [
    "6 ounce tomato paste",
    "1 teaspoon fresh garlic (minced)",
    "1/4 medium onion (minced)",
    "salt and pepper",
    "1 cup heavy whipping cream",
    "3/4 cup asiago cheese (shredded)",
    "1/4 cup water",
    "1 teaspoon dried oregano"
  ],
  "instructions": [
    {
      "text": "Place your tomato paste, minced onion, and garlic into a pot.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/tomato-asiago-soup/#wprm-recipe-52457-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/01/tomato-asiago-soup-01.jpg"
    },
    {
      "text": "Turn on the heat to medium and pour in your cream.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/tomato-asiago-soup/#wprm-recipe-52457-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/01/tomato-asiago-soup-02.jpg"
    },
    {
      "text": "Bring to a boil while you whisk the mixture together.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/tomato-asiago-soup/#wprm-recipe-52457-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/01/tomato-asiago-soup-03.jpg"
    },
    {
      "text": "Once it’s boiling, add in your Asiago cheese little by little. It should start thickening up. Add in the water and cook for an additional 4-5 minutes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/tomato-asiago-soup/#wprm-recipe-52457-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/01/tomato-asiago-soup-04.jpg"
    },
    {
      "text": "Serve and top with pepper. You can optimally add some green onions too.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/tomato-asiago-soup/#wprm-recipe-52457-step-0-4",
      "imageSource": null
    }
  ],
