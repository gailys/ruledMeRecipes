  "ingredients": [
    "7 ounce cauliflower",
    "1 cup walnuts",
    "1 tablespoon hemp hearts",
    "1 teaspoon cumin",
    "1 teaspoon garlic powder",
    "1 teaspoon onion powder",
    "2 teaspoon smoked paprika",
    "2 teaspoon chipotle peppers in adobo sauce",
    "4 tablespoon avocado oil (divided)",
    "2 tablespoon cheddar cheese (shredded)",
    "salt and pepper (to taste)",
    "2 medium avocado",
    "4 tablespoon sour cream",
    "4 tablespoon cheddar cheese (shredded)"
  ],
  "instructions": [
    {
      "text": "Break the cauliflower into florets and place in a food processor with the raw walnuts, hemp seeds, and seasonings.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/vegetarian-taco-stuffed-avocados/#wprm-recipe-52954-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/03/meatless-taco-stuffed-avocado-01.jpg"
    },
    {
      "text": "Pulse the mixture a few times until the cauliflower and nuts become a crumble.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/vegetarian-taco-stuffed-avocados/#wprm-recipe-52954-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/03/meatless-taco-stuffed-avocado-02.jpg"
    },
    {
      "text": "Working in two batches, heat half of the oil in a large non-stick skillet over medium heat and add half of the taco meat mixture. Stir well as the nuts are toasted and the cauliflower softens.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/vegetarian-taco-stuffed-avocados/#wprm-recipe-52954-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/03/meatless-taco-stuffed-avocado-03.jpg"
    },
    {
      "text": "Add half of the adobo sauce and fold it into the mixture, making sure the mix is browning evenly on both sides. Remove from heat and fold in the shredded cheese, season with salt, and add to a serving bowl. Repeat with the rest of the taco filling.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/vegetarian-taco-stuffed-avocados/#wprm-recipe-52954-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/03/meatless-taco-stuffed-avocado-04.jpg"
    },
    {
      "text": "Slice the avocado in half and remove the stone. Scoop part of the avocado out with a spoon to make room for the taco mixture. Save and add as a topping later.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/vegetarian-taco-stuffed-avocados/#wprm-recipe-52954-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/03/meatless-taco-stuffed-avocado-05.jpg"
    },
    {
      "text": "Fill prepared taco mixture and top with sour cream, shredded cheddar cheese!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/vegetarian-taco-stuffed-avocados/#wprm-recipe-52954-step-0-5",
      "imageSource": null
    }
  ],
