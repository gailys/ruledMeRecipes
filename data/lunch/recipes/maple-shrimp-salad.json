  "ingredients": [
    "6 ounce mixed greens",
    "16 ounce feta cheese (chopped)",
    "2 tablespoon butter",
    "1 teaspoon garlic (minced)",
    "32 ounce shrimp",
    "1/2 medium onion (chopped)",
    "2 medium red bell pepper (diced)",
    "3 teaspoon olive oil",
    "5 teaspoon ruled.me maple syrup",
    "2 teaspoon apple cider vinegar",
    "1 tablespoon lemon juice"
  ],
  "instructions": [
    {
      "text": "Preheat a pan on the stove, then melt the butter.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/maple-shrimp-salad/#wprm-recipe-52870-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/01/keto-maple-shrimp-salad-01.jpg"
    },
    {
      "text": "Add minced garlic to melted butter. Place shrimp in the pan. Sauté until garlic is lightly browned and shrimp is cooked through.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/maple-shrimp-salad/#wprm-recipe-52870-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/01/keto-maple-shrimp-salad-02.jpg"
    },
    {
      "text": "Remove the pan from the stove and allow the shrimp to cool.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/maple-shrimp-salad/#wprm-recipe-52870-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/01/keto-maple-shrimp-salad-03.jpg"
    },
    {
      "text": "Mix field greens, shrimp, chopped feta, onion, and sliced red peppers in a salad bowl.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/maple-shrimp-salad/#wprm-recipe-52870-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/01/keto-maple-shrimp-salad-05.jpg"
    },
    {
      "text": "In a separate bowl, whisk together olive oil, sugar-free maple syrup, apple cider vinegar, and lemon juice.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/maple-shrimp-salad/#wprm-recipe-52870-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2019/01/keto-maple-shrimp-salad-04.jpg"
    },
    {
      "text": "Pour salad dressing onto salad. Toss so ingredients are evenly coated.",
