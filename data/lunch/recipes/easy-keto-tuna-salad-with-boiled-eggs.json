  "ingredients": [
    "1 ounce celery",
    "2 medium green onion",
    "3 ounce canned tuna (drained)",
    "1 tablespoon olive oil",
    "1/2 medium lemon (zest and juice)",
    "1/4 cup sour cream",
    "1 teaspoon dijon mustard",
    "1 ounce cherry tomatoes",
    "2 large egg",
    "salt and pepper (to tate)"
  ],
  "instructions": [
    {
      "text": "Gather and prep all of your ingredients.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/easy-keto-tuna-salad-with-boiled-eggs/#wprm-recipe-56684-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/05/Easy-Keto-Tuna-Salad-with-Boiled-Eggs-1.jpg"
    },
    {
      "text": "Place eggs into a small saucepan and cover with water. Bring water to a boil and let simmer for 6-7 minutes. Then place in ice-cold water immediately when done and set aside to peel.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/easy-keto-tuna-salad-with-boiled-eggs/#wprm-recipe-56684-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/05/Easy-Keto-Tuna-Salad-with-Boiled-Eggs-2.jpg"
    },
    {
      "text": "While eggs are cooking, dice the celery and spring onion. Slice the cherry tomatoes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/easy-keto-tuna-salad-with-boiled-eggs/#wprm-recipe-56684-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/05/Easy-Keto-Tuna-Salad-with-Boiled-Eggs-3.jpg"
    },
    {
      "text": "Combine the tuna, olive oil, lemon zest and juice, sour cream, Dijon mustard, celery, green onion, and tomatoes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/easy-keto-tuna-salad-with-boiled-eggs/#wprm-recipe-56684-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/05/Easy-Keto-Tuna-Salad-with-Boiled-Eggs-4.jpg"
    },
    {
      "text": "Stir together well, then taste and season with salt and pepper as needed.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/easy-keto-tuna-salad-with-boiled-eggs/#wprm-recipe-56684-step-0-4",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2024/05/Easy-Keto-Tuna-Salad-with-Boiled-Eggs-5.jpg"
    },
    {
      "text": "Peel the eggs and slice into halves or wedges. Optionally, scoop the tuna salad onto some butter lettuce leaves. Enjoy!",
      "group": "",
      "sourceUrl": "https://www.ruled.me/easy-keto-tuna-salad-with-boiled-eggs/#wprm-recipe-56684-step-0-5",
      "imageSource": null
    }
  ],
