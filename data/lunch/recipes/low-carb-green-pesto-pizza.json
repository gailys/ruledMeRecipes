  "ingredients": [
    "9 ounce broccoli (chopped)",
    "3 ounce onion (chopped)",
    "3 teaspoon fresh garlic (peeled)",
    "6 tablespoon almond flour",
    "3 tablespoon psyllium husk powder",
    "2 large egg",
    "1 teaspoon salt",
    "3 tablespoon pesto",
    "1/2 cup mozzarella cheese (shredded)",
    "1/3 cup feta cheese (crumbled)",
    "1/4 cup fresh basil (chopped)",
    "olive oil (to taste)"
  ],
  "instructions": [
    {
      "text": "Preheat the oven to 375F. Add the broccoli, onion, and garlic to a food processor. Pulse until the mixture resembles breadcrumbs. Add the rest of the crust ingredients, then pulse together. Scrape down the sides of the bowl if necessary.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-green-pesto-pizza/#wprm-recipe-60000-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/04/low-carb-green-pesto-pizza-step-01.jpg"
    },
    {
      "text": "Place the dough in the center of a piece of parchment paper. Use a second piece of parchment paper on top of the dough. Using a rolling pin, roll it into a flat circle, roughly 1 to 1 1/2 cm thick.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-green-pesto-pizza/#wprm-recipe-60000-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/04/low-carb-green-pesto-pizza-step-02.jpg"
    },
    {
      "text": "Place parchment paper with crust on a baking sheet or pizza pan. Bake for 12-15 minutes, or until the crust is firm and browned. Remove from the oven and spread the pesto sauce evenly over the crust. Top with the cheeses.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-green-pesto-pizza/#wprm-recipe-60000-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/04/low-carb-green-pesto-pizza-step-03.jpg"
    },
    {
      "text": "Bake for another 8–10 minutes, or until the cheese has melted and browned. Garnish with chopped basil and a drizzle of olive oil.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/low-carb-green-pesto-pizza/#wprm-recipe-60000-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2026/04/low-carb-green-pesto-pizza-step-04.jpg"
    }
