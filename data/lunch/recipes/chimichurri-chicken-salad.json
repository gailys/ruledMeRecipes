  "ingredients": [
    "250 gram mixed greens",
    "20 ounce boneless, skinless chicken breast (cubed)",
    "2 medium avocado (diced)",
    "1/4 cup olive oil",
    "3 tablespoon red wine vinegar",
    "1/4 cup fresh parsley (chopped)",
    "1 tablespoon dried oregano",
    "1 teaspoon crushed red pepper flakes",
    "1 teaspoon fresh garlic (minced)",
    "salt and pepper (To taste)"
  ],
  "instructions": [
    {
      "text": "Preheat non-stick pan to medium heat. While pan is heating, place mixed greens and cubed avocado into a salad bowl, reserving some avocado as desired for topping.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chimichurri-chicken-salad/#wprm-recipe-52826-step-0-0",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/12/chimichurri-chicken-salad-01.jpg"
    },
    {
      "text": "Once pan is heated, add cubed chicken and a small amount of oil, if needed. (Some non-stick pans don't require any) Cook chicken until firm and no longer pink, stirring as needed.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chimichurri-chicken-salad/#wprm-recipe-52826-step-0-1",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/12/chimichurri-chicken-salad-02.jpg"
    },
    {
      "text": "In a small bowl, thoroughly mix olive oil, vinegar, parsley, oregano, garlic, and chili flakes.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chimichurri-chicken-salad/#wprm-recipe-52826-step-0-2",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/12/chimichurri-chicken-salad-05.jpg"
    },
    {
      "text": "Add the cubed chicken breasts to the salad and toss to coat with chimichurri dressing, reserving some dressing for topping.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chimichurri-chicken-salad/#wprm-recipe-52826-step-0-3",
      "imageSource": "https://www.ruled.me/wp-content/uploads/2018/12/chimichurri-chicken-salad-04.jpg"
    },
    {
      "text": "Serve and top with additional chimichurri dressing and avocado, as desired. Add salt and pepper to taste.",
      "group": "",
      "sourceUrl": "https://www.ruled.me/chimichurri-chicken-salad/#wprm-recipe-52826-step-0-4",
      "imageSource": null
    }
